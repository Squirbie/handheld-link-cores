diff --git a/cpu_threaded.c b/cpu_threaded.c
index f49167090086..fcb7e8abffa7 100644
--- a/cpu_threaded.c
+++ b/cpu_threaded.c
@@ -243,6 +243,23 @@ typedef struct
   void platform_cache_sync(void *baseaddr, void *endptr) {
     ctr_flush_invalidate_cache();
   }
+#elif defined(ARM64_ARCH) && defined(__linux__)
+  /* hanbang: zig's compiler-rt __clear_cache has no DSB ISH after the IC IVAU loop,
+     so a Cortex-A53 could fetch stale (zero = UDF) words from freshly emitted
+     blocks and die with SIGILL. Do the full architectural sequence here. */
+  void platform_cache_sync(void *baseaddr, void *endptr) {
+    uintptr_t start = (uintptr_t)baseaddr, end = (uintptr_t)endptr;
+    uintptr_t ctr, a, dline, iline;
+    __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+    dline = (uintptr_t)4 << ((ctr >> 16) & 15);
+    iline = (uintptr_t)4 << (ctr & 15);
+    for (a = start & ~(dline - 1); a < end; a += dline)
+      __asm__ volatile("dc cvau, %0" :: "r"(a) : "memory");
+    __asm__ volatile("dsb ish" ::: "memory");
+    for (a = start & ~(iline - 1); a < end; a += iline)
+      __asm__ volatile("ic ivau, %0" :: "r"(a) : "memory");
+    __asm__ volatile("dsb ish\n\tisb" ::: "memory");
+  }
 #elif defined(ARM_ARCH) || defined(ARM64_ARCH)
   void platform_cache_sync(void *baseaddr, void *endptr) {
     __clear_cache(baseaddr, endptr);
