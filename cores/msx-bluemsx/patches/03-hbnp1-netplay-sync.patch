+/* [hbnp1] 남은 소리는 늘 같은 크기(HB_MIXER_SAVE 개)로 저장 — 상태 길이가 바뀌지 않게, 남는 칸은 0 */
+#define HB_MIXER_SAVE 1024
+
+void mixerSaveState(Mixer* mixer)
+{
+    SaveState* state = saveStateOpenForWrite("mixer");
+    Int16 tmp[HB_MIXER_SAVE];
+    UInt32 n = mixer->index < HB_MIXER_SAVE ? mixer->index : HB_MIXER_SAVE;
+
+    memset(tmp, 0, sizeof(tmp));
+    memcpy(tmp, mixer->buffer, n * sizeof(Int16));
+
+    saveStateSet(state, "refTime",     mixer->refTime);
+    saveStateSet(state, "refFrag",     mixer->refFrag);
+    saveStateSet(state, "index",       n);
+    /* 소리 크기 표시(volIndex · volCnt*) 칸은 소리 표본과 무관해 넣지 않음(상태 바이트가 흔들리지 않게) */
+    saveStateSetBuffer(state, "buffer", tmp, sizeof(tmp));
+
+    saveStateClose(state);
+}
+
+void mixerLoadState(Mixer* mixer)
+{
+    SaveState* state = saveStateOpenForRead("mixer");
+    Int16 tmp[HB_MIXER_SAVE];
+    UInt32 n;
+
+    if (saveStateGet(state, "index", 0xffffffff) == 0xffffffff) {
+        /* 옛 상태: 믹서 칸이 없으면 지금 시각부터 다시 셈 */
+        mixer->refTime = boardSystemTime();
+        mixer->refFrag = 0;
+        saveStateClose(state);
+        return;
+    }
+
+    memset(tmp, 0, sizeof(tmp));
+    mixer->refTime     = saveStateGet(state, "refTime",     boardSystemTime());
+    mixer->refFrag     = saveStateGet(state, "refFrag",     0);
+    n                  = saveStateGet(state, "index",       0);
+    saveStateGetBuffer(state, "buffer", tmp, sizeof(tmp));
+
+    saveStateClose(state);
+
+    if (n > HB_MIXER_SAVE || (Int32)n >= mixer->fragmentSize) {
+        n = 0;
+    }
+    memcpy(mixer->buffer, tmp, n * sizeof(Int16));
+    mixer->index = n;
+}
+
