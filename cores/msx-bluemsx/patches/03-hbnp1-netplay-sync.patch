+void boardOnLoadState(void)
+{
+    pendingInt     = hbLoadPendingInt;
+    boardSysTime64 = hbLoadSysTime64;
+    oldTime        = hbLoadOldTime;
+
+    if (boardMixer != NULL) {
+        mixerLoadState(boardMixer);
+    }
+
+    if (mixerTimer != NULL) {
+        if (hbLoadMixerOn == 1) {
+            boardTimerAdd(mixerTimer, hbLoadMixerTimeout);
+        }
+        else if (hbLoadMixerOn == 2) {
+            /* 옛 상태(이 칸 없음): blueMSX 되감기와 같이 지금부터 1/50초 뒤 */
+            boardTimerAdd(mixerTimer, boardSystemTime() + boardFrequency() / 50);
+        }
+    }
+
+    hbRestoreMode   = 0;
+    hbAnchorPending = 0;
+
+    if (timerList != NULL && boardInfo.setCpuTimeout != NULL) {
+        boardInfo.setCpuTimeout(boardInfo.cpuRef, timerList->next->timeout);
+    }
+}
