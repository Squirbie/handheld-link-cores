+/*
+ * [hbnp1] 코어 안 C++ 객체(소리칩 YMF262 · YMF278 · YM2413 등)를 0 으로 채운 메모리에 만든다.
+ * 생성자가 채우지 않는 칸에 쓰레기 값이 남아 상태 묶음이 실행마다 달라졌음(넷플레이 CRC 대조 실패).
+ * link.T 가 retro_* 만 밖으로 내보내므로 이 정의는 코어 안에서만 쓰인다.
+ */
+#include <cstdlib>
+#include <new>
+
+void* operator new(std::size_t n) throw(std::bad_alloc)
+{
+    void* p = std::calloc(1, n ? n : 1);
+    if (!p)
+        std::abort();
+    return p;
+}
+
+void* operator new[](std::size_t n) throw(std::bad_alloc)
+{
+    void* p = std::calloc(1, n ? n : 1);
+    if (!p)
+        std::abort();
+    return p;
+}
+
+void operator delete(void* p) throw()
+{
+    std::free(p);
+}
+
+void operator delete[](void* p) throw()
+{
+    std::free(p);
+}
