+void boardPrepareLoadState(void)
+{
+    SaveState* state = saveStateOpenForRead("board");
+    UInt32 hasAnchor;
+
+    hasAnchor          = saveStateGet(state, "hbTimeAnchorOn", 0);
+    hbAnchorValue      = saveStateGet(state, "hbTimeAnchor", 0);
