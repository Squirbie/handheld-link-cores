+void fdcAudioSaveState(FdcAudio* fdcAudio, const char* section)
+{
+    const void* bufs[2];
+    SaveState* state;
+
+    if (fdcAudio == NULL) {
+        return;
+    }
+    state = saveStateOpenForWrite(section);
+    saveStateSet(state, "hbFdcAudio", 1);
+    saveStateSet(state, "motorOn",    fdcAudio->motorOn);
+    saveStateClose(state);
+
+    bufs[0] = fdcAudio->readSamples;
+    bufs[1] = fdcAudio->motorSamples;
+    samplePlayerSaveState(fdcAudio->samplePlayer, "fdcSamplePlayer", bufs, 2);
+}
+
+void fdcAudioLoadState(FdcAudio* fdcAudio, const char* section)
+{
+    const void* bufs[2];
+    SaveState* state;
+
+    if (fdcAudio == NULL) {
+        return;
+    }
+    state = saveStateOpenForRead(section);
+    if (saveStateGet(state, "hbFdcAudio", 0) == 1) {
+        fdcAudio->motorOn = saveStateGet(state, "motorOn", fdcAudio->motorOn);
+    }
+    saveStateClose(state);
+
+    bufs[0] = fdcAudio->readSamples;
+    bufs[1] = fdcAudio->motorSamples;
+    samplePlayerLoadState(fdcAudio->samplePlayer, "fdcSamplePlayer", bufs, 2);
