+/* [hbnp1] 소리 묶음 포인터 → 번호(-1 = 없음 · 모름) */
+static int hbBufIndex(const void* buf, const void** bufs, int nbufs)
+{
+    int i;
+    for (i = 0; i < nbufs; i++) {
+        if (buf != NULL && buf == bufs[i]) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+void samplePlayerSaveState(SamplePlayer* samplePlayer, const char* section, const void** bufs, int nbufs)
+{
+    SaveState* state = saveStateOpenForWrite(section);
+
+    saveStateSet(state, "hbSamplePlayer",   1);
+    saveStateSet(state, "enabled",          samplePlayer->enabled);
+    saveStateSet(state, "stepCur",          samplePlayer->stepCur);
+    saveStateSet(state, "attackBuf",        (UInt32)hbBufIndex(samplePlayer->attackBuffer, bufs, nbufs));
+    saveStateSet(state, "attackBufferSize", samplePlayer->attackBufferSize);
+    saveStateSet(state, "loopBuf",          (UInt32)hbBufIndex(samplePlayer->loopBuffer, bufs, nbufs));
+    saveStateSet(state, "loopBufferSize",   samplePlayer->loopBufferSize);
+    saveStateSet(state, "index",            samplePlayer->index);
+    saveStateSet(state, "playAttack",       samplePlayer->playAttack);
+    saveStateSet(state, "stopCount",        samplePlayer->stopCount);
+    saveStateSet(state, "ctrlVolume",       (UInt32)samplePlayer->ctrlVolume);
+    saveStateSet(state, "daVolume",         (UInt32)samplePlayer->daVolume);
+
+    saveStateClose(state);
+}
+
+void samplePlayerLoadState(SamplePlayer* samplePlayer, const char* section, const void** bufs, int nbufs)
+{
+    SaveState* state = saveStateOpenForRead(section);
+
+    if (saveStateGet(state, "hbSamplePlayer", 0) == 1) {
+        int a = (int)saveStateGet(state, "attackBuf", (UInt32)-1);
+        int l = (int)saveStateGet(state, "loopBuf",   (UInt32)-1);
+
+        samplePlayer->enabled          = (Int32)saveStateGet(state, "enabled", 0);
+        samplePlayer->stepCur          = (int)saveStateGet(state, "stepCur", 0);
+        samplePlayer->attackBuffer     = (a >= 0 && a < nbufs) ? bufs[a] : NULL;
+        samplePlayer->attackBufferSize = saveStateGet(state, "attackBufferSize", 0);
+        samplePlayer->loopBuffer       = (l >= 0 && l < nbufs) ? bufs[l] : NULL;
+        samplePlayer->loopBufferSize   = saveStateGet(state, "loopBufferSize", 0);
+        samplePlayer->index            = (int)saveStateGet(state, "index", 0);
+        samplePlayer->playAttack       = (int)saveStateGet(state, "playAttack", 0);
+        samplePlayer->stopCount        = (int)saveStateGet(state, "stopCount", 0);
+        samplePlayer->ctrlVolume       = (Int32)saveStateGet(state, "ctrlVolume", 0);
+        samplePlayer->daVolume         = (Int32)saveStateGet(state, "daVolume", 0);
+
+        if (samplePlayer->attackBuffer == NULL) {
+            samplePlayer->attackBufferSize = 0;
+        }
+        if (samplePlayer->loopBuffer == NULL) {
+            samplePlayer->loopBufferSize = 0;
+        }
+        if (samplePlayer->attackBuffer == NULL && samplePlayer->loopBuffer == NULL) {
+            samplePlayer->enabled = 0;
+        }
+    }
+
+    saveStateClose(state);
+}
