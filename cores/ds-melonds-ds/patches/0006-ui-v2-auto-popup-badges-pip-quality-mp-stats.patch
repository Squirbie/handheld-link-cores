diff --git a/src/libretro/hanbang.hpp b/src/libretro/hanbang.hpp
new file mode 100644
index 0000000..62a22da
--- /dev/null
+++ b/src/libretro/hanbang.hpp
@@ -0,0 +1,281 @@
+/*
+    hanbang (10/11, ui-v2): 전용 도우미 두 가지.
+
+    1) 팝업 설정 — DraStic 팝업(hb_dsosd)이 읽는 같은 파일을 게임 켤 때 한 번 읽어요.
+       /userdata/system/configs/advanced_drastic/hb_popup.cfg (MELONDSDS_HB_POPUP_CFG 로 바꿀 수 있음)
+         auto=1   위 화면이 클 때 오른쪽 스틱을 밀면 '누르는 창'이 저절로 떠요 (0 = 끔)
+         fade=40  아래 화면이 클 때 L2 보기 창이, 스틱을 쓰는 동안 이만큼(%)으로 흐려져요
+         alpha=85 창 불투명도(%) — DraStic 과 같은 줄을 같이 써요
+         pip=1    왼쪽 위 작은 화면 줄이는 방식: 0 = 옛것(가까운 점만) 1 = 넓이 평균 2 = 두 배 크기로 내보내고 평균
+       파일이나 줄이 없으면 위 기본값. hb_dsosd 는 모르는 줄(auto/fade/pip)을 그냥 넘겨요.
+       시험용: MELONDSDS_PIP=0|1|2 환경 변수, 또는 /tmp/melonds_pip 파일(숫자 하나)이 있으면 그 값이 먼저예요.
+       /tmp/melonds_pip 는 게임 중 약 1초마다 다시 봐서, 끄지 않고 바로 바꿔 볼 수 있어요.
+
+    2) 같이하기 재는 기록 — /tmp/melonds_mp_stats 파일이 있을 때만 1초마다 /tmp/melonds_mp_stats.log 에 한 줄.
+       파일이 없으면 60장마다 stat() 두 번만 해요 (거의 0 비용). 줄 뜻은 Open() 의 머리말에 적어요.
+*/
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <sys/stat.h>
+#include <sys/time.h>
+
+namespace hanbang {
+
+// ---------------------------------------------------------------- 1) 팝업 설정
+struct PopupSettings {
+    bool autoPopup = true; // auto=
+    int fade = 40;         // fade=  (%)
+    int alpha = 85;        // alpha= (%)
+    int pip = 1;           // pip=   (0/1/2)
+};
+
+inline PopupSettings& Popup() noexcept {
+    static PopupSettings s;
+    return s;
+}
+
+inline int& PipOverride() noexcept {
+    static int v = -1; // -1 = 덮어쓰기 없음
+    return v;
+}
+
+// 지금 작은 화면 방식 (0/1/2)
+inline int PipMode() noexcept {
+    const int o = PipOverride();
+    return o >= 0 ? o : Popup().pip;
+}
+
+inline void LoadPopupSettings() noexcept {
+    PopupSettings s;
+    const char* path = std::getenv("MELONDSDS_HB_POPUP_CFG");
+    if (!path || !*path) path = "/userdata/system/configs/advanced_drastic/hb_popup.cfg";
+    if (FILE* f = std::fopen(path, "r")) {
+        char line[160];
+        while (std::fgets(line, sizeof line, f)) {
+            int v;
+            if (std::sscanf(line, "auto=%d", &v) == 1) s.autoPopup = v != 0;
+            else if (std::sscanf(line, "fade=%d", &v) == 1 && v >= 10 && v <= 100) s.fade = v;
+            else if (std::sscanf(line, "alpha=%d", &v) == 1 && v >= 10 && v <= 100) s.alpha = v;
+            else if (std::sscanf(line, "pip=%d", &v) == 1 && v >= 0 && v <= 2) s.pip = v;
+        }
+        std::fclose(f);
+    }
+    if (const char* env = std::getenv("MELONDSDS_PIP"); env && env[0] >= '0' && env[0] <= '2' && !env[1]) {
+        s.pip = env[0] - '0';
+    }
+    Popup() = s;
+    std::fprintf(stderr, "[hanbang] popup cfg %s: auto=%d fade=%d alpha=%d pip=%d\n",
+                 path, s.autoPopup ? 1 : 0, s.fade, s.alpha, s.pip);
+}
+
+// ---------------------------------------------------------------- 2) 같이하기 재는 기록
+namespace mp {
+using Clock = std::chrono::steady_clock;
+
+struct Counters {
+    // 장면(프레임)
+    uint32_t frames = 0;
+    double runFrameMs = 0;   // nds.RunFrame 전체 (기다림 포함)
+    double renderMs = 0;     // Render() 전체 (아래 vidMs 포함)
+    double vidMs = 0;        // 그중 레트로아크에 장면 넘기기(video_refresh). video_threaded 면 앞 장면을 기다리기도 해요
+    double runMs = 0;        // 코어 Run() 전체
+    double gapMaxMs = 0;     // 장면과 장면 사이 가장 긴 간격
+    // 기다림 (NextPacketBlock)
+    double waitRepMs = 0;    // 방장: 손님 답 기다림
+    double waitHostMs = 0;   // 손님: 방장 신호 기다림
+    double waitMaxMs = 0;    // 한 번에 가장 오래 기다린 시간
+    uint32_t blockCalls = 0, timeouts = 0, waitsOver50 = 0;
+    // 안 기다리는 확인 (NextPacket 의 flush+poll)
+    uint32_t pollCalls = 0, pollHits = 0;
+    double pollMs = 0;
+    // 보냄/받음 — C = 방장 신호(CMD), R = 답(REPLY), O = 그 밖 (b 비컨, d 데이터, m 관리)
+    uint32_t txC = 0, txR = 0, txO = 0, txOb = 0, txOd = 0, txOm = 0, txAck = 0, txBytes = 0;
+    uint32_t rxC = 0, rxAck = 0, rxR = 0, rxO = 0, rxOb = 0, rxOd = 0, rxOm = 0, rxBytes = 0;
+    uint32_t txSameC = 0, txSameR = 0, rxSameC = 0, rxSameR = 0; // 바로 앞과 내용이 같은 것 (다시 보냄일 수 있음)
+    uint32_t txFail = 0;     // 보낼 준비가 안 돼서 못 보냄
+    // 방장: 답 모으기 (MP_RecvReplies)
+    // rrMiss = 기다리다 시간 초과로 끝남(답 안 온 손님 있음), rrPart = 다 답했지만 '준비 안 됨' 빈 답이 섞여 끝남
+    uint32_t rrCalls = 0, rrMiss = 0, rrPart = 0, rrBlank = 0, rrStale = 0, rrDrop = 0;
+    // 손님: 방장 신호 받기 (MP_RecvHostPacket)
+    uint32_t hpCalls = 0, hpEmpty = 0, hpNotCmd = 0;
+    // 큐
+    uint32_t qMax = 0;
+    uint32_t hostChanges = 0;
+};
+
+inline bool on = false;
+inline bool capped = false;   // 기록 파일이 20MB 를 넘어 멈춤 (/tmp 는 메모리라서). 시험 파일을 지우면 풀려요
+inline Counters c{};
+inline FILE* logFile = nullptr;
+inline Clock::time_point windowStart{};
+inline Clock::time_point lastFrame{};
+inline bool haveLastFrame = false;
+inline bool mpActive = false;
+inline int ctx = 0;           // 1 = 답 모으는 중, 2 = 방장 신호 기다리는 중
+inline uint32_t frameCounter = 0;
+inline uint32_t eventsThisWindow = 0;
+inline uint32_t lastHash[4] = {0, 0, 0, 0}; // [0] tx CMD [1] tx REPLY [2] rx CMD [3] rx REPLY
+
+inline double Ms(Clock::duration d) noexcept { return std::chrono::duration<double, std::milli>(d).count(); }
+
+inline void Stamp(char* out, size_t n) noexcept {
+    timeval tv{};
+    gettimeofday(&tv, nullptr);
+    tm t{};
+    localtime_r(&tv.tv_sec, &t);
+    std::snprintf(out, n, "%02d:%02d:%02d.%03d", t.tm_hour, t.tm_min, t.tm_sec, static_cast<int>(tv.tv_usec / 1000));
+}
+
+inline void Event(const char* what) noexcept {
+    if (!on || !logFile || eventsThisWindow >= 10) return;
+    eventsThisWindow++;
+    char ts[24];
+    Stamp(ts, sizeof ts);
+    std::fprintf(logFile, "! %s %s\n", ts, what);
+    // 고침 8: 바로 파일로 내보내요. 굳거나 꺼지기 바로 전 줄이 가장 중요한데, 예전엔 다음 1초 정리 때까지 버퍼에만 있었어요.
+    // 1초에 10줄까지라 비용은 없어요.
+    std::fflush(logFile);
+}
+
+inline void Open() noexcept {
+    logFile = std::fopen("/tmp/melonds_mp_stats.log", "a");
+    if (!logFile) return;
+    on = true;
+    c = Counters{};
+    windowStart = Clock::now();
+    haveLastFrame = false;
+    eventsThisWindow = 0;
+    char ts[24];
+    Stamp(ts, sizeof ts);
+    std::fprintf(logFile,
+        "# %s 같이하기 기록 시작 (끄기: rm /tmp/melonds_mp_stats)\n"
+        "# 한 줄 = 1초. mp=같이하기 연결 fps=초당 장수 frame=한 장 평균 ms\n"
+        "#   emu=에뮬 계산(기다림 뺀 RunFrame) wait=통신 기다림(rep 방장이 답 기다림 / host 손님이 방장 기다림, max 한 번 최대)\n"
+        "#   draw=화면 그리기(우리 코드만) vid=레트로아크에 장면 넘기기(video_threaded 면 앞 장면 기다림 포함)\n"
+        "#   rest=코어 밖(레트로아크 넷플레이·화면·소리) gap=장면 사이 최대 간격  emu 에는 poll 시간도 빼요\n"
+        "#   poll=안 기다리는 확인 횟수/찾음/시간  to=시간 초과(150ms) 횟수 long=50ms 넘게 기다린 횟수\n"
+        "#   tx/rx: C=방장 신호(CMD) R=답 O=그 밖(b 비컨 d 데이터 m 관리) A=확인(ACK)  same=바로 앞과 같은 내용(다시 보냄일 수 있음)\n"
+        "#   rr=답 모으기 횟수 miss=시간 초과로 끝남(답 없는 손님 있음) part=빈 답이 섞여 끝남(둘 다 DS 가 다시 보내는 원인)\n"
+        "#   blank=준비 안 됨 빈 답 수 stale=늦은 답 버림 drop=답 기다리다 버린 다른 패킷\n"
+        "#   hp=손님 신호 받기 횟수/빈손/신호 아닌 것  q=받은 큐 최대 host=방장 바뀜\n",
+        ts);
+    std::fflush(logFile);
+}
+
+inline void Close() noexcept {
+    if (logFile) {
+        char ts[24];
+        Stamp(ts, sizeof ts);
+        std::fprintf(logFile, "# %s 기록 끝\n", ts);
+        std::fclose(logFile);
+    }
+    logFile = nullptr;
+    on = false;
+}
+
+inline void FlushWindow(Clock::time_point now) noexcept {
+    const double sec = Ms(now - windowStart) / 1000.0;
+    if (!logFile || sec <= 0) return;
+    const double n = c.frames ? static_cast<double>(c.frames) : 1.0;
+    const double fps = c.frames / sec;
+    const double frame = c.frames ? sec * 1000.0 / c.frames : 0.0;
+    const double wait = c.waitRepMs + c.waitHostMs;
+    // 고침 9: poll(안 기다리는 확인)도 RunFrame 안에서 일어나서 빼요. 남는 건 순수 에뮬 계산이에요
+    const double emu = (c.runFrameMs - wait - c.pollMs) / n;
+    const double rest = frame - c.runMs / n;
+    char ts[24];
+    Stamp(ts, sizeof ts);
+    std::fprintf(logFile,
+        "%s mp=%d fps=%.1f frame=%.1f emu=%.1f wait=%.1f(rep %.1f host %.1f max %.0f) draw=%.2f vid=%.2f rest=%.1f gap=%.0f"
+        " poll=%u/%u/%.1fms to=%u long=%u"
+        " tx=C%u A%u R%u O%u(b%u d%u m%u) %uB rx=C%u A%u R%u O%u(b%u d%u m%u) %uB same=tC%u tR%u rC%u rR%u fail=%u"
+        " rr=%u miss=%u part=%u blank=%u stale=%u drop=%u hp=%u/%u/%u q=%u host=%u\n",
+        ts, mpActive ? 1 : 0, fps, frame, emu, wait / n, c.waitRepMs / n, c.waitHostMs / n, c.waitMaxMs,
+        (c.renderMs - c.vidMs) / n, c.vidMs / n, rest, c.gapMaxMs,
+        c.pollCalls, c.pollHits, c.pollMs, c.timeouts, c.waitsOver50,
+        c.txC, c.txAck, c.txR, c.txO, c.txOb, c.txOd, c.txOm, c.txBytes,
+        c.rxC, c.rxAck, c.rxR, c.rxO, c.rxOb, c.rxOd, c.rxOm, c.rxBytes,
+        c.txSameC, c.txSameR, c.rxSameC, c.rxSameR, c.txFail,
+        c.rrCalls, c.rrMiss, c.rrPart, c.rrBlank, c.rrStale, c.rrDrop, c.hpCalls, c.hpEmpty, c.hpNotCmd, c.qMax, c.hostChanges);
+    std::fflush(logFile);
+    c = Counters{};
+    windowStart = now;
+    eventsThisWindow = 0;
+    if (std::ftell(logFile) > 20L * 1024 * 1024) {
+        std::fprintf(logFile, "# 기록 파일이 20MB 를 넘어서 멈춰요. rm /tmp/melonds_mp_stats.log /tmp/melonds_mp_stats 뒤 다시 켜세요\n");
+        Close();
+        capped = true;
+    }
+}
+
+// 60장마다: 시험 파일 두 개를 확인 (/tmp/melonds_mp_stats, /tmp/melonds_pip)
+inline void SlowCheck() noexcept {
+    struct stat st {};
+    const bool want = ::stat("/tmp/melonds_mp_stats", &st) == 0;
+    if (!want) capped = false;
+    if (want && !on && !capped) Open();
+    else if (!want && on) Close();
+
+    int pip = -1;
+    if (FILE* f = std::fopen("/tmp/melonds_pip", "r")) {
+        const int ch = std::fgetc(f);
+        if (ch >= '0' && ch <= '2') pip = ch - '0';
+        std::fclose(f);
+    }
+    PipOverride() = pip;
+}
+
+// 코어 Run() 맨 앞에서 한 번
+inline void FrameStart(bool active) noexcept {
+    mpActive = active;
+    if (++frameCounter >= 60) {
+        frameCounter = 0;
+        SlowCheck();
+    }
+    if (!on) return;
+    const Clock::time_point now = Clock::now();
+    if (haveLastFrame) c.gapMaxMs = std::max(c.gapMaxMs, Ms(now - lastFrame));
+    lastFrame = now;
+    haveLastFrame = true;
+    if (now - windowStart >= std::chrono::seconds(1)) FlushWindow(now);
+    c.frames++;
+}
+
+// 짧은 시간 재기 (기록이 꺼져 있으면 시계를 안 읽어요)
+struct Timer {
+    bool active;
+    Clock::time_point start;
+    Timer() noexcept : active(on), start(active ? Clock::now() : Clock::time_point{}) {}
+    double Ms() const noexcept { return active ? mp::Ms(Clock::now() - start) : 0.0; }
+};
+
+// 패킷 내용 지문 (802.11 머리 24바이트·TX 머리 12바이트·순번은 빼고)
+inline uint32_t PayloadHash(const uint8_t* data, size_t len) noexcept {
+    uint32_t h = 2166136261u;
+    for (size_t i = 12 + 24; i < len; i++) h = (h ^ data[i]) * 16777619u;
+    return h ^ static_cast<uint32_t>(len);
+}
+
+// 받은 CMD 형 패킷이 확인(ACK)인가: 802.11 받는 주소 끝 바이트 03 (melonDS Wifi.cpp MPAckMAC)
+inline bool IsAck(const uint8_t* data, size_t len) noexcept {
+    return len >= 12 + 10 && data[12 + 4] == 0x03 && data[12 + 5] == 0x09 && data[12 + 6] == 0xBF && data[12 + 9] == 0x03;
+}
+
+// 그 밖 패킷 종류: 'b' 비컨 'd' 데이터 'm' 관리·제어
+inline char OtherKind(const uint8_t* data, size_t len) noexcept {
+    if (len < 12 + 2) return 'm';
+    const uint16_t fc = static_cast<uint16_t>(data[12] | (data[13] << 8));
+    const unsigned type = (fc >> 2) & 3, sub = (fc >> 4) & 0xF;
+    if (type == 0 && sub == 8) return 'b';
+    if (type == 2) return 'd';
+    return 'm';
+}
+} // namespace mp
+} // namespace hanbang
