+        constexpr int POPUP_ANIM = 9;
+        ScreenLayout layout = screenLayout.Layout();
+        bool single = layout == ScreenLayout::TopOnly || layout == ScreenLayout::BottomOnly;
+        if (single && inputState.PopupHeld()) popupFrames = std::min(popupFrames + 1, POPUP_ANIM);
+        else popupFrames = std::max(popupFrames - 1, 0);
+        if (single && popupFrames > 0) {
+            bool topMain = layout == ScreenLayout::TopOnly;
+            DrawPopup(topMain ? bottomScreenBuffer : topScreenBuffer, popupFrames / static_cast<float>(POPUP_ANIM),
+                      topMain && !nds.IsLidClosed() && inputState.CursorVisible(),
+                      inputState.ConsoleTouchPosition(), config.CursorSize());
