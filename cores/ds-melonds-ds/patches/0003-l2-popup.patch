+void MelonDsDs::SoftwareRenderState::DrawPopup(const uint32_t* src, float t, bool cursor, glm::ivec2 touch, float cursorRadius) noexcept {
+    ZoneScopedN(TracyFunction);
+    const int W = static_cast<int>(buffer.Width()), H = static_cast<int>(buffer.Height());
+    constexpr int SW = NDS_SCREEN_WIDTH, SH = NDS_SCREEN_HEIGHT;
+    if (W < SW || H < SH) return;
+    const int bw = W * 3 / 4, bh = H * 3 / 4;          // 75% of the screen, 4:3 kept
+    const int x0 = (W - bw) / 2;
+    const int yOpen = H - bh - 4;                       // 4px above the bottom edge when fully open
+    const float e = 1.0f - (1.0f - t) * (1.0f - t);     // ease-out slide
+    const int y0 = H + static_cast<int>((yOpen - H) * e);
+    constexpr unsigned A = 218;                         // ~85% opaque
+    constexpr int R = 6;                                // corner radius
+    for (int oy = 0; oy < bh; oy++) {
+        const int dy = y0 + oy;
+        if (dy < 0 || dy >= H) continue;
+        int syf = static_cast<int>((2LL * oy + 1) * SH * 65536 / (2 * bh)) - 32768;
+        if (syf < 0) syf = 0;
+        const int sy = syf >> 16, fy = (syf >> 8) & 0xFF, sy1 = std::min(sy + 1, SH - 1);
+        const uint32_t* r0 = src + sy * SW;
+        const uint32_t* r1 = src + sy1 * SW;
+        uint32_t* d = buffer[static_cast<unsigned>(dy)] + x0;
+        const int cy = oy < R ? R - oy : (oy >= bh - R ? oy - (bh - R - 1) : 0);
+        for (int ox = 0; ox < bw; ox++) {
+            const int cx = ox < R ? R - ox : (ox >= bw - R ? ox - (bw - R - 1) : 0);
+            if (cx && cy && cx * cx + cy * cy > R * R) continue;
+            int sxf = static_cast<int>((2LL * ox + 1) * SW * 65536 / (2 * bw)) - 32768;
+            if (sxf < 0) sxf = 0;
+            const int sx = sxf >> 16, fx = (sxf >> 8) & 0xFF, sx1 = std::min(sx + 1, SW - 1);
+            const uint32_t p00 = r0[sx], p01 = r0[sx1], p10 = r1[sx], p11 = r1[sx1], bg = d[ox];
+            uint32_t res = 0xFF000000;
+            for (int s = 0; s < 24; s += 8) {
+                const int top = static_cast<int>((p00 >> s) & 0xFF) * (256 - fx) + static_cast<int>((p01 >> s) & 0xFF) * fx;
+                const int bot = static_cast<int>((p10 >> s) & 0xFF) * (256 - fx) + static_cast<int>((p11 >> s) & 0xFF) * fx;
+                const unsigned c = static_cast<unsigned>((top * (256 - fy) + bot * fy) >> 16);
+                const unsigned b = (bg >> s) & 0xFF;
+                res |= ((c * A + b * (256 - A)) >> 8) << s;
+            }
+            d[ox] = res;
+        }
+    }
+    if (cursor) {
+        const float r = std::max(1.0f, cursorRadius * 0.75f);
+        const float cxf = x0 + (touch.x + 0.5f) * bw / SW, cyf = y0 + (touch.y + 0.5f) * bh / SH;
+        const int xa = std::max(0, static_cast<int>(std::floor(cxf - r))), xb = std::min(W, static_cast<int>(std::ceil(cxf + r)));
+        const int ya = std::max(0, static_cast<int>(std::floor(cyf - r))), yb = std::min(H, static_cast<int>(std::ceil(cyf + r)));
+        for (int y = ya; y < yb; y++) {
+            uint32_t* row = buffer[static_cast<unsigned>(y)];
+            for (int x = xa; x < xb; x++) row[x] = (0xFFFFFF - row[x]) | 0xFF000000;
+        }
+    }
+}
