+// hanbang: 25ms of process CPU time (std::clock) was far too short for two slow handhelds
+// on Wi-Fi, so the host gave up on replies and the DS game dropped the link.
+// Wait on the wall clock instead; MELONDSDS_MP_TIMEOUT_MS overrides the default.
+constexpr long RECV_TIMEOUT_MS = 150;
+
+static long RecvTimeoutMs() noexcept {
+    static const long timeout = [] {
+        const char* env = std::getenv("MELONDSDS_MP_TIMEOUT_MS");
+        long value = env ? std::strtol(env, nullptr, 10) : 0;
+        return (value >= 5 && value <= 2000) ? value : RECV_TIMEOUT_MS;
+    }();
+    return timeout;
+}
 
