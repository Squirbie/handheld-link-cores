+void MelonDsDs::SoftwareRenderState::DrawPictureInPicture(const uint32_t* src, bool cursor, glm::ivec2 touch, float cursorRadius) noexcept {
+    ZoneScopedN(TracyFunction);
+    const int bw = static_cast<int>(buffer.Width() / 4), bh = static_cast<int>(buffer.Height() / 4);
+    constexpr int SW = NDS_SCREEN_WIDTH, SH = NDS_SCREEN_HEIGHT;
+    if (bw < 3 || bh < 3) return;
+    constexpr uint32_t BORDER = 0xFF03CF03; // opaque RGB(3, 207, 3), outermost output pixels
+    for (int y = 0; y < bh; y++) {
+        uint32_t* row = buffer[static_cast<unsigned>(y)];
+        const int sy = y * SH / bh;
+        for (int x = 0; x < bw; x++) {
+            row[x] = (x == 0 || y == 0 || x == bw - 1 || y == bh - 1)
+                ? BORDER : src[sy * SW + x * SW / bw] | 0xFF000000;
+        }
+    }
+    if (cursor) {
+        touch = glm::clamp(touch, glm::ivec2(0), glm::ivec2(SW - 1, SH - 1));
+        const float rx = std::max(0.5f, cursorRadius * bw / SW);
+        const float ry = std::max(0.5f, cursorRadius * bh / SH);
+        const float cx = std::clamp((touch.x + 0.5f) * bw / SW, 1.5f, bw - 1.5f);
+        const float cy = std::clamp((touch.y + 0.5f) * bh / SH, 1.5f, bh - 1.5f);
+        // Clip to the interior so the opaque one-pixel border stays intact.
+        const int xa = std::clamp(static_cast<int>(std::floor(cx - rx)), 1, bw - 1);
+        const int xb = std::clamp(static_cast<int>(std::ceil(cx + rx)), 1, bw - 1);
+        const int ya = std::clamp(static_cast<int>(std::floor(cy - ry)), 1, bh - 1);
+        const int yb = std::clamp(static_cast<int>(std::ceil(cy + ry)), 1, bh - 1);
+        for (int y = ya; y < yb; y++) {
+            uint32_t* row = buffer[static_cast<unsigned>(y)];
+            for (int x = xa; x < xb; x++) row[x] = (0xFFFFFF - row[x]) | 0xFF000000;
+        }
+    }
+}
