+
+retro::GameInfo& retro::GameInfo::operator=(GameInfo&& other) noexcept {
+    if (this != &other) {
+        if (_map) munmap(_map, _size);
+        _path = std::move(other._path);
+        _data = std::move(other._data);
+        _size = other._size;
+        _meta = std::move(other._meta);
+        _map = other._map;
+        other._map = nullptr;
+        other._size = 0;
+    }
+    return *this;
+}
