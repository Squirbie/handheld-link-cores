+// hanbang: put the ROM file itself (a private, copy-on-write file mapping) in the cart buffer,
+// so the ROM lives in the page cache instead of anonymous memory. 512 MB ROMs don't fit in
+// this device's RAM otherwise. The block comes from posix_memalign, which glibc serves with its
+// own mmap for anything this big; melonDS later frees it with delete[] -> free(), and glibc's
+// munmap_chunk() then unmaps the whole region, file mapping included.
+static std::unique_ptr<uint8_t[]> MapRomFile(std::string_view path, size_t size, size_t padded) noexcept {
+    if (path.empty() || size < (size_t(32) << 20) || padded < size)
+        return nullptr;
+
+    std::string p(path);
+    int fd = open(p.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return nullptr;
+
+    struct stat st {};
+    if (fstat(fd, &st) != 0 || (size_t)st.st_size != size) {
+        close(fd);
+        return nullptr;
+    }
+
+    void* mem = nullptr;
+    if (posix_memalign(&mem, 4096, padded) != 0 || !mem) {
+        close(fd);
+        return nullptr;
+    }
+
+    size_t mapped = (size + 4095) & ~size_t(4095);
+    void* m = mmap(mem, mapped, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_FIXED, fd, 0);
+    close(fd);
+    if (m != mem) {
+        free(mem);
+        return nullptr;
+    }
+
+    retro::info("hanbang: mapped {}-byte ROM file into a {}-byte cart buffer", size, padded);
+    return std::unique_ptr<uint8_t[]>(static_cast<uint8_t*>(mem));
+}
