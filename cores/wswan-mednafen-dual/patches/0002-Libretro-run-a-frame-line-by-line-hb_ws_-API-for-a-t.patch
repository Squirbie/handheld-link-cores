+/* 시험용(한방 10/20): 물리 주소 범위 쓰기 감시 — 켜져 있을 때만 stderr 로 */
+uint32 hb_watch_lo = 0xFFFFFFFF, hb_watch_hi = 0;
+void hb_watch_hit(uint32 A, uint8 V);
+
 void WSwan_writemem20(uint32 A, uint8 V)
 {
+   if(A >= hb_watch_lo && A <= hb_watch_hi)
+      hb_watch_hit(A, V);
    WriteMemCore(A, V, false);
 }
 
