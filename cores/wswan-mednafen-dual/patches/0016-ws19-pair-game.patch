diff -ruN src18/dual/hb_romfile.h src19/dual/hb_romfile.h
--- src18/dual/hb_romfile.h	1970-01-01 09:00:00.000000000 +0900
+++ src19/dual/hb_romfile.h	2026-10-26 05:30:15.452037814 +0900
@@ -0,0 +1,57 @@
+/* 두 대 코어(네오지오 포켓 · 게임기어) — 2P 짝 롬 읽기(10/22)
+ *
+ * 보통 파일 하나를 통째로 읽고 CRC32 를 셈(= ZIP 항목 CRC = hb_ownsave.py rom_crc 가 보는 값).
+ * ZIP 은 읽지 않음 — 짝 롬은 도우미(hb_ownsave.py 방장 · hb_joinask 손님)가 /tmp 에 풀어 그 경로를 줌.
+ * GBA 코어의 hb_romfile.h(mGBA zlib 로 ZIP 도 읽음)와 같은 이름 · 같은 꼴(hb_rom_load · mappedMemoryFree).
+ */
+#ifndef HB_ROMFILE_H
+#define HB_ROMFILE_H
+
+#define HB_ROM_MAX (8u * 1024u * 1024u)
+
+static void *hb_rom_load(const char *path, size_t *size, uint32_t *crc, const char **why)
+{
+   struct stat st;
+   uint8_t *data;
+   size_t got = 0;
+   int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+   *size = 0;
+   *crc = 0;
+   if (fd < 0) {
+      *why = "파일 없음";
+      return NULL;
+   }
+   if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 0 || st.st_size > (off_t)HB_ROM_MAX) {
+      close(fd);
+      *why = "보통 파일이 아니거나 크기 초과";
+      return NULL;
+   }
+   data = (uint8_t *)malloc((size_t)st.st_size);
+   if (!data) {
+      close(fd);
+      *why = "메모리 부족";
+      return NULL;
+   }
+   while (got < (size_t)st.st_size) {
+      ssize_t n = read(fd, data + got, (size_t)st.st_size - got);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) break;
+      got += (size_t)n;
+   }
+   close(fd);
+   if (got != (size_t)st.st_size) {
+      free(data);
+      *why = "읽기 실패";
+      return NULL;
+   }
+   *size = got;
+   *crc = hb_crc32(data, got);
+   return data;
+}
+
+static void mappedMemoryFree(void *memory, size_t size)
+{
+   (void)size;
+   free(memory);
+}
