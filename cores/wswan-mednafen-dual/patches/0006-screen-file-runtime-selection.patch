+
+/* Local presentation policy, deliberately outside all serialized state.
+ * Normal playback: one stat per 30 retro_run calls, open only on change.
+ * Also refresh immediately before an actual 2P save write: a guest switch
+ * during the polling interval must not overwrite the host-owned save. */
+#define HB_SCREEN_FILE "/tmp/hb_dual_screen"
+#define HB_SCREEN_POLL_FRAMES 30
+static int screenFilePlayer = -1;
+static unsigned screenFileCountdown;
+static bool screenFileStatValid;
+static struct stat screenFileStat;
+static int screenFileLogged = -2;
+static int screenLogged = -1;
+
+static void screenFileReset(void)
+{
+   screenFilePlayer = -1;
+   screenFileCountdown = HB_SCREEN_POLL_FRAMES;
+   screenFileStatValid = false;
+   screenFileLogged = -2;
+   screenLogged = -1;
+}
+
+static bool screenFileSame(const struct stat *a, const struct stat *b)
+{
+   return a->st_dev == b->st_dev && a->st_ino == b->st_ino &&
+      a->st_mode == b->st_mode && a->st_size == b->st_size &&
+      a->st_mtime == b->st_mtime && a->st_ctime == b->st_ctime
+#if defined(__linux__)
+      && a->st_mtim.tv_nsec == b->st_mtim.tv_nsec
+      && a->st_ctim.tv_nsec == b->st_ctim.tv_nsec
+#elif defined(__APPLE__)
+      && a->st_mtimespec.tv_nsec == b->st_mtimespec.tv_nsec
+      && a->st_ctimespec.tv_nsec == b->st_ctimespec.tv_nsec
+#endif
+      ;
+}
+
+static void screenFileRefresh(void)
+{
+   struct stat st;
+   FILE *file;
+   char data[5];
+   size_t size;
+   int fd;
+   if (!linkOn)
+      return;
+   if (stat(HB_SCREEN_FILE, &st) != 0)
+   {
+      screenFilePlayer = -1;
+      screenFileStatValid = false;
+      return;
+   }
+   if (screenFileStatValid && screenFileSame(&st, &screenFileStat))
+      return;
+   screenFileStat = st;
+   screenFileStatValid = true;
+   screenFilePlayer = -1;
+   if (!S_ISREG(st.st_mode) || st.st_size < 2 || st.st_size > 4)
+      return;
+   /* O_NONBLOCK also avoids hanging if a regular file becomes a FIFO
+    * between stat and open. Failed reads are retried at the next poll. */
+   fd = open(HB_SCREEN_FILE, O_RDONLY | O_NONBLOCK);
+   if (fd < 0)
+   {
+      screenFileStatValid = false;
+      return;
+   }
+   file = fdopen(fd, "rb");
+   if (!file)
+   {
+      close(fd);
+      screenFileStatValid = false;
+      return;
+   }
+   size = fread(data, 1, sizeof(data), file);
+   if (ferror(file))
+      screenFileStatValid = false;
+   else if ((size == 2 || (size == 3 && data[2] == '\n') ||
+            (size == 4 && data[2] == '\r' && data[3] == '\n')) &&
+            data[1] == 'P' && (data[0] == '1' || data[0] == '2'))
+      screenFilePlayer = data[0] - '1';
+   fclose(file);
+}
+
+static void screenFileTick(void)
+{
+   if (linkOn && --screenFileCountdown == 0)
+   {
+      screenFileCountdown = HB_SCREEN_POLL_FRAMES;
+      screenFileRefresh();
+   }
+}
+
+static int selectedScreen(void)
+{
+   return linkOn ? (screenFilePlayer >= 0 ? screenFilePlayer : screenOption) : 0;
+}
+
+static void applyScreen(void)
+{
+   shown = selectedScreen();
+   if (shown != screenLogged || screenFilePlayer != screenFileLogged)
+      dual_log(RETRO_LOG_INFO, "screen %dP (%s)", shown + 1,
+            !linkOn ? "link off" : screenFilePlayer >= 0 ? HB_SCREEN_FILE : "core option");
+   screenLogged = shown;
+   screenFileLogged = screenFilePlayer;
+   stats.screen = (uint32_t)shown;
+}
