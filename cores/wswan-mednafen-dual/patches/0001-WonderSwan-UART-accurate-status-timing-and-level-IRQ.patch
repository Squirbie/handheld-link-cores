diff --git a/mednafen/wswan/interrupt.c b/mednafen/wswan/interrupt.c
index 11e1140..03306f3 100644
--- a/mednafen/wswan/interrupt.c
+++ b/mednafen/wswan/interrupt.c
@@ -1,14 +1,17 @@
 #include "wswan.h"
 #include "interrupt.h"
 #include "v30mz.h"
+#include "comm.h"
 #include "../state.h"
 
 static uint8 IStatus;
 static uint8 IEnable;
 static uint8 IVectorBase;
 
-/* Level-triggered interrupt lines (currently only serial receive). */
-static const uint8 LevelTriggeredMask = (1U << WSINT_SERIAL_RECV);
+/* Level-triggered interrupt lines: serial send (transmit buffer empty)
+ * and serial receive (receive buffer full), as on hardware
+ * (https://ws.nesdev.org/wiki/Interrupts). 한방 10/20: 송신도 레벨로. */
+static const uint8 LevelTriggeredMask = (1U << WSINT_SERIAL_RECV) | (1U << WSINT_SERIAL_SEND);
 static uint8 IAsserted;
 
 static bool IOn_Cache;
@@ -57,6 +60,8 @@ void WSwan_Interrupt(int which)
 
 void WSwan_InterruptWrite(uint32 A, uint8 V)
 {
+   if(A == 0xB2 || A == 0xB0)
+      Comm_TraceIRQ("인터럽트포트", A, V);
    switch(A)
    {
       case 0xB0:
@@ -93,7 +98,12 @@ uint8 WSwan_InterruptRead(uint32 A)
 void WSwan_InterruptCheck(void)
 {
    if(IOn_Cache)
+   {
+      if((IOn_Which == WSINT_SERIAL_RECV || IOn_Which == WSINT_SERIAL_SEND) &&
+            (v30mz_get_reg(NEC_FLAGS) & 0x200))
+         Comm_TraceIRQ("직렬인터럽트", IOn_Which, IStatus);
       v30mz_int(IVector_Cache, false);
+   }
 }
 
 void WSwan_InterruptReset(void)
