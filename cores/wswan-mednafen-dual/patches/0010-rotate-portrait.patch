+/* ---- 세로 게임(0010): 화면 · 단추 돌리기 — 래퍼에서만 ----
+ * 안쪽 두 기계는 그대로 가로(fixedOptions: landscape · keymap disabled)라서 에뮬 상태 ·
+ * 소리는 가로 때와 같고, 래퍼가 (1) 안쪽 코어가 읽는 단추를 원래 코어 세로 표대로 바꿔
+ * 주고 (2) 보이는 기계 화면을 앞단이 돌리게 하거나(앞단 회전) 직접 돌려 그림. */
+
+/* 원래 코어(libretro.c update_input)의 단추 표 그대로: [0] 가로, [1] 세로(portrait + auto).
+ * 원더스완 단추 X1 X2 X3 X4 Y1 Y2 Y3 Y4 START A B 마다 읽는 앞단 단추 번호 */
+static const unsigned rotateMaps[2][11] = {
+   {
+      RETRO_DEVICE_ID_JOYPAD_UP, RETRO_DEVICE_ID_JOYPAD_RIGHT, RETRO_DEVICE_ID_JOYPAD_DOWN,
+      RETRO_DEVICE_ID_JOYPAD_LEFT, RETRO_DEVICE_ID_JOYPAD_R2, RETRO_DEVICE_ID_JOYPAD_R,
+      RETRO_DEVICE_ID_JOYPAD_L2, RETRO_DEVICE_ID_JOYPAD_L, RETRO_DEVICE_ID_JOYPAD_START,
+      RETRO_DEVICE_ID_JOYPAD_A, RETRO_DEVICE_ID_JOYPAD_B,
+   },
+   {
+      RETRO_DEVICE_ID_JOYPAD_Y, RETRO_DEVICE_ID_JOYPAD_X, RETRO_DEVICE_ID_JOYPAD_A,
+      RETRO_DEVICE_ID_JOYPAD_B, RETRO_DEVICE_ID_JOYPAD_LEFT, RETRO_DEVICE_ID_JOYPAD_UP,
+      RETRO_DEVICE_ID_JOYPAD_RIGHT, RETRO_DEVICE_ID_JOYPAD_DOWN, RETRO_DEVICE_ID_JOYPAD_START,
+      RETRO_DEVICE_ID_JOYPAD_L, RETRO_DEVICE_ID_JOYPAD_R,
+   },
+};
+static int rotateFrom[16];      /* 안쪽 코어(가로 표)가 묻는 단추 → 대신 읽을 앞단 단추(-1 = 늘 뗌) */
+static bool rotateTall;         /* 지금 세로(화면 · 단추) */
+static bool rotateHw;           /* 앞단이 회전을 받음 = 앞단이 돌림(아니면 래퍼가 돌려 그림) */
+static bool rotateMaxTall;      /* 앞단에 알린 최대 크기에 세운 그림(144x224)이 들어감 */
+static bool rotatePending;      /* 상태를 따라 바뀜 → 다음 retro_run 처음에 앞단에 알림 */
+static uint16_t rotateBuf[DUAL_WIDTH * DUAL_HEIGHT];
+
+static void rotateInitMap(void)
+{
+   unsigned i;
+
+   for (i = 0; i < 16; i++)
+      rotateFrom[i] = -1;
+   /* 안쪽 코어가 가로 표 [0][i] 단추를 물으면 세로 표 [1][i] 단추 값을 줌
+    * → 원더스완 단추 i = 앞단 [1][i] (원래 코어 세로와 같은 결과) */
+   for (i = 0; i < 11; i++)
+      rotateFrom[rotateMaps[0][i]] = (int)rotateMaps[1][i];
+}
+
+static int16_t rotateInput(unsigned port, unsigned index, unsigned id)
+{
+   if (id == RETRO_DEVICE_ID_JOYPAD_MASK)
+   {
+      uint16_t from = (uint16_t)inputCallback(port, RETRO_DEVICE_JOYPAD, index, RETRO_DEVICE_ID_JOYPAD_MASK);
+      uint16_t to = 0;
+      unsigned i;
+
+      for (i = 0; i < 16; i++)
+         if (rotateFrom[i] >= 0 && ((from >> rotateFrom[i]) & 1))
+            to |= (uint16_t)(1u << i);
+      return (int16_t)to;
+   }
+   if (id < 16)
+      return rotateFrom[id] >= 0 ? inputCallback(port, RETRO_DEVICE_JOYPAD, index, (unsigned)rotateFrom[id]) : 0;
+   return inputCallback(port, RETRO_DEVICE_JOYPAD, index, id);
+}
+
+/* 원래 코어 ROTATE_PIXEL_BUF 와 같은 방향(반시계 90도 = 앞단 회전 1):
+ * 입력 (x, y) → 출력 (y, width - 1 - x), 출력 크기 height x width */
+static void rotateFrame(const void *data, unsigned width, unsigned height, size_t pitch)
+{
+   const uint16_t *in = (const uint16_t *)data;
+   size_t stride = pitch / sizeof(uint16_t);
+   unsigned x, y;
+
+   if (!data || width * height > DUAL_WIDTH * DUAL_HEIGHT || stride < width)
+   {
+      videoCallback(NULL, height, width, height * sizeof(uint16_t));
+      return;
+   }
+   for (y = 0; y < height; y++)
+      for (x = 0; x < width; x++)
+         rotateBuf[y + (size_t)(width - 1 - x) * height] = in[x + (size_t)y * stride];
+   videoCallback(rotateBuf, height, width, height * sizeof(uint16_t));
+}
+
+/* 원래 코어 retro_get_system_av_info 와 같은 크기 · 화면비(가로면 안쪽 값 그대로) */
+static void rotateGeometry(struct retro_game_geometry *geometry)
+{
+   if (rotateTall)
+   {
+      geometry->base_width   = rotateHw ? DUAL_WIDTH : DUAL_HEIGHT;
+      geometry->base_height  = rotateHw ? DUAL_HEIGHT : DUAL_WIDTH;
+      geometry->aspect_ratio = 1.0f / (14.0 / 9.0);
+   }
+   if (rotateMaxTall)
+   {
+      geometry->max_width  = DUAL_WIDTH;
+      geometry->max_height = DUAL_WIDTH;
+   }
 }
 
+/* 원래 코어처럼 먼저 0도로 떠보고(앞단이 회전을 받는지), 받을 때만 90도를 요청.
+ * 안 받는 앞단에 90도를 요청해 두면 레트로아크는 '코어가 요청한 회전'만큼 화면비를 뒤집어
+ * 세운 그림이 납작해짐. 레트로아크는 명령줄로 켤 때 retro_load_game 이 화면 드라이버보다
+ * 먼저라 처음엔 늘 '안 받음' → 래퍼가 돌려 그림(원래 코어도 같음). */
+static void rotateProbe(void)
+{
+   unsigned angle = 0;
+
+   rotateHw = environCallback(RETRO_ENVIRONMENT_SET_ROTATION, &angle);
+   if (rotateHw)
+   {
+      angle = 1;
+      environCallback(RETRO_ENVIRONMENT_SET_ROTATION, &angle);
+   }
+}
+
+/* 상태를 따라 세로/가로가 바뀐 뒤 retro_run 처음에: 앞단에 회전 · 크기를 알림 */
+static void rotateNotify(void)
+{
+   struct retro_system_av_info av;
+   bool grow;
+
+   rotatePending = false;
+   if (rotateTall)
+      rotateProbe();
+   else if (rotateHw)
+   {
+      unsigned angle = 0;
+      environCallback(RETRO_ENVIRONMENT_SET_ROTATION, &angle);
+      rotateHw = false;
+   }
+   /* 직접 돌려 그리는데 앞단 최대 크기가 가로(224x144)뿐이면 최대 크기부터 키움 */
+   grow = rotateTall && !rotateHw && !rotateMaxTall;
+   if (grow)
+      rotateMaxTall = true;
+   retro_get_system_av_info(&av);
+   if (grow)
+      environCallback(RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO, &av);
+   else
+      environCallback(RETRO_ENVIRONMENT_SET_GEOMETRY, &av.geometry);
+   dual_log(RETRO_LOG_INFO, "화면 %s(%s) %ux%u 화면비 %.3f", rotateTall ? "세로" : "가로",
+         !rotateTall ? "돌리기 없음" : rotateHw ? "앞단이 90도 돌림" : "래퍼가 돌려 그림",
+         av.geometry.base_width, av.geometry.base_height, av.geometry.aspect_ratio);
+}
+
+/* 불러온 상태의 세로 비트를 따름(넷플레이: 손님은 방장 상태를 받음 → 단추 해석이 방장과 같아짐).
+ * 단추는 바로(다음 장 입력부터), 앞단 알림은 다음 retro_run 처음에(상태 불러오기 안에서는 안 부름). */
+static void rotateFollow(bool tall)
+{
+   if (tall == rotateTall)
+      return;
+   rotateTall = tall;
+   rotatePending = true;
+   dual_log(RETRO_LOG_INFO, "불러온 상태를 따라 %s로 바꿈(넷플레이면 방장 상태 — 두 기기 단추 해석을 맞춤)",
+         tall ? "세로" : "가로");
+}
