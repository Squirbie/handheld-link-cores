From 67de62451fa06cdcb779c195ca15b10bb5e801cd Mon Sep 17 00:00:00 2001
From: hanbang <hanbang@localhost>
Date: Tue, 20 Oct 2026 01:09:08 +0900
Subject: [PATCH 3/5] Libretro: zero the unused tail of the 60Hz audio cache in
 savestates

The LRAV section stores all 8192 entries of a static staging array but
only lrav_60hz_pos of them are refreshed on save. The rest kept bytes
from earlier saves or from the last loaded state, so two runs with the
same emulation state could serialize different bytes (netplay CRC
mismatch and resync after every rollback).

---
 libretro.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/libretro.c b/libretro.c
index 7283db7..3410087 100644
--- a/libretro.c
+++ b/libretro.c
@@ -715,9 +715,16 @@ int StateAction(StateMem *sm, int load, int data_only)
          lrav_60hz_pos = retro_60hz_audio.samples_buf_pos;
          if(lrav_60hz_pos > 8192)
             lrav_60hz_pos = 8192;
+         if(lrav_60hz_pos < 0)
+            lrav_60hz_pos = 0;
          if(lrav_60hz_pos > 0)
             memcpy(lrav_60hz_stage, retro_60hz_audio.samples_buf,
                   lrav_60hz_pos * sizeof(int16_t));
+         /* 한방 10/20: 쓰지 않는 뒷부분은 0 으로. 안 지우면 예전 저장 ·
+          * 불러온 상태의 찌꺼기가 남아, 에뮬 결과가 같아도 상태 바이트가
+          * 달라짐(넷플레이 CRC 불일치 · 되감기 뒤 다시 받기). */
+         memset(lrav_60hz_stage + lrav_60hz_pos, 0,
+               (8192 - lrav_60hz_pos) * sizeof(int16_t));
       }
       else
       {
