+/* 줄마다: 다 보낸 바이트를 상대 수신으로(두 기계가 그 줄을 다 돈 뒤 — 대칭) */
+static void exchange(void)
+{
+   for (;;)
+   {
+      int a = inner[0].link_take();
+      int b = inner[1].link_take();
+
+      if (a < 0 && b < 0)
+         break;
+      if (a >= 0)
+      {
+         inner[1].link_give((unsigned)a);
+         stats.bytes[0]++;
+      }
+      if (b >= 0)
+      {
+         inner[0].link_give((unsigned)b);
+         stats.bytes[1]++;
+      }
+   }
+}
+
+/* 두 기계를 한 줄씩 번갈아. 60Hz 장 수(1 또는 2)가 다르면 남는 장(앞쪽의
+ * '건너뛴 장')은 그 기계 혼자 돌림 — 어느 기기에서나 같은 순서. */
+static void runLinked(void)
+{
+   int nA, nB, n, s;
+
+   inner[0].run_pre();
+   inner[1].run_pre();
+   nA = inner[0].subframes();
+   nB = inner[1].subframes();
+   n = nA > nB ? nA : nB;
+   if (nA != nB)
+      stats.subframeSkew++;
+
+   for (s = 0; s < n; s++)
+   {
+      int runA = s >= n - nA;
+      int runB = s >= n - nB;
+      int subA = s - (n - nA);
+      int subB = s - (n - nB);
+      int doneA = !runA;
+      int doneB = !runB;
+      unsigned lines = 0;
+
+      if (runA)
+         inner[0].emu_begin(subA, nA);
+      if (runB)
+         inner[1].emu_begin(subB, nB);
+      while (!doneA || !doneB)
+      {
+         if (!doneA)
+            doneA = inner[0].emu_line();
+         if (!doneB)
+            doneB = inner[1].emu_line();
+         exchange();
+         if (++lines >= DUAL_MAX_LINES)
+         {
+            if (stats.stalls < 4)
+               dual_log(RETRO_LOG_ERROR, "한 장이 %u 줄을 넘음(%d/%d) — 멈춤으로 셈", lines, doneA, doneB);
+            stats.stalls++;
+            break;
+         }
+      }
+      stats.linesLast = lines;
+      if (lines > stats.linesMax)
+         stats.linesMax = lines;
+      if (runA)
+         inner[0].emu_end(subA, nA);
+      if (runB)
+         inner[1].emu_end(subB, nB);
+   }
+
+   inner[0].run_post();
+   inner[1].run_post();
+}
+
+void retro_run(void)
+{
+   bool updated = false;
+   int av = 3;
+   bool videoOn;
+
+   if (!gameLoaded)
+      return;
+
+   inputPollCallback();
+   if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated) && updated)
+      readScreenOption();
+   if (!environCallback(RETRO_ENVIRONMENT_GET_AUDIO_VIDEO_ENABLE, &av))
+      av = 3;
+   videoOn = (av & 1) != 0;
+   audioOn = (av & 2) != 0;
+   shown = linkOn ? screenOption : 0;
+   stats.screen = (uint32_t)screenOption;
+
+   if (p2CopyPending)
+   {
+      /* .p2.sav 가 없음: 앞단이 1P 세이브(.srm)를 넣은 뒤인 첫 장 전에 복사 */
+      memcpy(saveMemory(1), saveMemory(0), saveSize);
+      p2CopyPending = false;
+      stats.p2Copied = 1;
+      dual_log(RETRO_LOG_INFO, "2P 세이브가 없어 1P 세이브를 2P 기계에 복사함");
+   }
+
+   /* 그리기는 에뮬 결과와 무관하고 상태에도 없음: 보이는 기계만 그림 */
+   inner[0].set_render(renderBoth || (videoOn && shown == 0));
+   inner[1].set_render(renderBoth || (videoOn && shown == 1));
+
+   if (linkOn)
+      runLinked();
+   else
+   {
+      inner[0].run();
+      while (inner[0].link_take() >= 0); /* 선 없음: 보낸 바이트는 사라짐 */
+   }
+   stats.frames++;
+   inner[0].link_stats(stats.comm[0], 10);
+   inner[1].link_stats(stats.comm[1], 10);
+
+   if (linkOn && --p2Countdown == 0)
+   {
+      p2Countdown = DUAL_P2_SAVE_EVERY;
+      writeP2Save(false);
+   }
+}
+
+/* ---- 상태 저장 ---- */
+
+size_t retro_serialize_size(void)
+{
+   if (!gameLoaded)
+      return 0;
+   return DUAL_HEADER_SIZE + 2 * innerSize;
+}
+
+static void store32(uint8_t *p, uint32_t v)
+{
+   p[0] = (uint8_t)v;
+   p[1] = (uint8_t)(v >> 8);
+   p[2] = (uint8_t)(v >> 16);
+   p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t load32(const uint8_t *p)
+{
+   return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint64_t hashState(const void *data, size_t size)
+{
+   const uint8_t *bytes = (const uint8_t *)data;
+   uint64_t hash = 0xCBF29CE484222325ULL;
+   size_t i;
+
+   for (i = 0; i < size; i++)
+      hash = (hash ^ bytes[i]) * 0x100000001B3ULL;
+   return hash;
+}
+
+static void rememberState(uint64_t hash)
+{
+   seenStates[seenNext] = hash;
+   seenNext = (seenNext + 1) % DUAL_SEEN_STATES;
+}
+
+static bool stateSeen(uint64_t hash)
+{
+   unsigned i;
+
+   for (i = 0; i < DUAL_SEEN_STATES; i++)
+      if (seenStates[i] == hash)
+         return true;
+   return false;
+}
+
+bool retro_serialize(void *data, size_t size)
+{
+   size_t total = retro_serialize_size();
+   uint8_t *p = (uint8_t *)data;
+
+   if (!total || size < total)
+      return false;
+
+   memset(p, 0, DUAL_HEADER_SIZE);
+   store32(p + 0, DUAL_STATE_MAGIC);
+   store32(p + 4, DUAL_STATE_VERSION);
+   store32(p + 8, 2);
+   store32(p + 12, (uint32_t)innerSize);
+   if (!inner[0].serialize(p + DUAL_HEADER_SIZE, innerSize))
+      return false;
+   if (!inner[1].serialize(p + DUAL_HEADER_SIZE + innerSize, innerSize))
+      return false;
+   if (size > total)
+      memset(p + total, 0, size - total);
+   if (traceFile)
+      rememberState(hashState(data, total));
+   return true;
+}
+
+bool retro_unserialize(const void *data, size_t size)
+{
+   size_t total = retro_serialize_size();
+   const uint8_t *p = (const uint8_t *)data;
+
+   if (!total || size < total)
+      return false;
+   if (load32(p) != DUAL_STATE_MAGIC)
+   {
+      dual_log(RETRO_LOG_ERROR, "WonderSwan Dual 상태가 아님");
+      return false;
+   }
+   if (load32(p + 4) != DUAL_STATE_VERSION || load32(p + 8) != 2 || load32(p + 12) != innerSize)
+   {
+      dual_log(RETRO_LOG_ERROR, "상태 판/크기가 다름");
+      return false;
+   }
+   if (traceFile)
+   {
+      uint64_t hash = hashState(data, total);
+      if (!stateSeen(hash))
+      {
+         stats.outsideLoads++;
+         rememberState(hash);
+         dual_log(RETRO_LOG_INFO, "밖에서 온 상태 #%u (넷플레이 접속 또는 CRC 재동기)", stats.outsideLoads);
+      }
+   }
+   if (!inner[0].unserialize(p + DUAL_HEADER_SIZE, innerSize))
+      return false;
+   if (!inner[1].unserialize(p + DUAL_HEADER_SIZE + innerSize, innerSize))
+      return false;
+   /* 불러온 상태에 두 세이브가 다 들어 있음 */
+   p2CopyPending = false;
+   return true;
+}
+
+/* ---- 그 밖 ---- */
+
+void retro_cheat_reset(void)
+{
+   inner[0].cheat_reset();
+   inner[1].cheat_reset();
+}
