+
+static void setP2SavePath(const struct retro_game_info *game)
+{
+   const char *base;
+   const char *inner_name = NULL;
+   const char *hash;
+   const char *dir = NULL;
+   char name[DUAL_PATH_MAX];
+   char romDir[DUAL_PATH_MAX];
+   char *dot;
+   size_t len;
+   int written;
+
+   p2SavePath[0] = '\0';
+   if (!game->path || !game->path[0])
+      return;
+
+   base = strrchr(game->path, '/');
+   base = base ? base + 1 : game->path;
+
+   /* 레트로아크는 압축 파일 안의 롬이면 그 안 파일 이름으로 세이브를 만듦
+    * ("x.zip#y.wsc" → "y") */
+   for (hash = strchr(base, '#'); hash; hash = strchr(hash + 1, '#'))
+   {
+      size_t at = (size_t)(hash - base);
+      if ((at >= 4 && (!strncasecmp(hash - 4, ".zip", 4) || !strncasecmp(hash - 4, ".apk", 4))) ||
+          (at >= 3 && !strncasecmp(hash - 3, ".7z", 3)))
+      {
+         inner_name = hash + 1;
+         break;
+      }
+   }
+   snprintf(name, sizeof(name), "%s", (inner_name && inner_name[0]) ? inner_name : base);
+   dot = strrchr(name, '.');
+   if (dot && dot != name)
+      *dot = '\0';
+
+   if (!environCallback(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &dir) || !dir || !dir[0])
+   {
+      snprintf(romDir, sizeof(romDir), "%.*s", (int)(base - game->path), game->path);
+      dir = romDir;
+   }
+   len = strlen(dir);
+   written = snprintf(p2SavePath, sizeof(p2SavePath), "%s%s%s.p2.sav", dir,
+         (len && dir[len - 1] != '/') ? "/" : "", name);
+   if (written < 0 || (size_t)written >= sizeof(p2SavePath))
+   {
+      dual_log(RETRO_LOG_ERROR, "2P 세이브 경로가 너무 김 — 2P 세이브 안 씀");
+      p2SavePath[0] = '\0';
+   }
+}
+
+static void loadP2Save(void)
+{
+   FILE *f;
+   size_t got;
+   uint8_t *save = saveMemory(1);
+
+   p2WrittenSize = 0;
+   if (!p2SavePath[0] || !saveSize || !save)
+      return;
+
+   f = fopen(p2SavePath, "rb");
+   if (!f)
+   {
+      dual_log(RETRO_LOG_INFO, "2P 세이브 아직 없음: %s", p2SavePath);
+      return;
+   }
+   got = fread(save, 1, saveSize, f);
+   fclose(f);
+   if (got != saveSize)
+      dual_log(RETRO_LOG_WARN, "2P 세이브 크기가 다름(%u / %u 바이트) — 읽은 만큼만 씀",
+            (unsigned)got, (unsigned)saveSize);
+   if (!got)
+      return;
+   memcpy(p2Written, save, saveSize);
+   p2WrittenSize = saveSize;
+   stats.p2Loaded = 1;
+   dual_log(RETRO_LOG_INFO, "2P 세이브 읽음(%u 바이트): %s", (unsigned)got, p2SavePath);
+}
+
+static bool writeAll(const char *path, const uint8_t *data, size_t size)
+{
+   FILE *f = fopen(path, "wb");
+   bool ok;
+
+   if (!f)
+      return false;
+   ok = fwrite(data, 1, size, f) == size;
+   ok = fflush(f) == 0 && ok;
+#ifndef _WIN32
+   ok = fsync(fileno(f)) == 0 && ok;
+#endif
+   ok = fclose(f) == 0 && ok;
+   return ok;
+}
+
+/* 기기 /userdata 는 FUSE 위 exFAT — fsync 해야 디렉터리 항목까지 확정됨 */
+static void syncPath(const char *path)
+{
+#ifndef _WIN32
+   int fd = open(path, O_RDONLY);
+   if (fd >= 0)
+   {
+      fsync(fd);
+      close(fd);
+   }
+#else
+   (void)path;
+#endif
+}
+
+static void writeP2Save(bool force)
+{
+   char tmpPath[DUAL_PATH_MAX + 8];
+   const uint8_t *save;
+   bool ok;
+
+   /* 2P 화면(손님)이면 2P 세이브는 방장 기기 것 · link off 면 2P 기계가 안 돔 */
+   if (!gameLoaded || !linkOn || screenOption == 1 || !p2SavePath[0] || !saveSize)
+      return;
+   save = saveMemory(1);
+   if (!save)
+      return;
+   if (!force && p2WrittenSize == saveSize && !memcmp(p2Written, save, saveSize))
+      return;
+   if (p2WrittenSize == 0)
+   {
+      /* 디스크에 아직 없음: 게임이 무언가 쓴 뒤에만 만듦 */
+      size_t i;
+      for (i = 0; i < saveSize && save[i] == 0x00; i++);
+      if (i == saveSize)
+         return;
+   }
+
+   snprintf(tmpPath, sizeof(tmpPath), "%s.tmp", p2SavePath);
+   ok = writeAll(tmpPath, save, saveSize);
+   if (ok && rename(tmpPath, p2SavePath) != 0)
+   {
+      /* 이름 바꾸기로 덮어쓰기를 거부하는 FUSE 면 제자리 쓰기 */
+      ok = writeAll(p2SavePath, save, saveSize);
+      remove(tmpPath);
+   }
+   if (!ok)
+   {
+      dual_log(RETRO_LOG_ERROR, "2P 세이브 쓰기 실패: %s", p2SavePath);
+      remove(tmpPath);
+      return;
+   }
+   syncPath(p2SavePath);
+   memcpy(p2Written, save, saveSize);
+   p2WrittenSize = saveSize;
+   stats.p2Writes++;
+   dual_log(RETRO_LOG_INFO, "2P 세이브 씀(%u 바이트): %s", (unsigned)saveSize, p2SavePath);
+}
