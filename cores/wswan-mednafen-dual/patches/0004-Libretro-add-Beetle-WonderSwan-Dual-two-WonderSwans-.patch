+}
+
+void *retro_get_memory_data(unsigned id)
+{
+   if (!gameLoaded)
+      return NULL;
+
+   switch (id)
+   {
+      case RETRO_MEMORY_SAVE_RAM:
+      case RETRO_MEMORY_SYSTEM_RAM:
+         return inner[0].get_memory_data(id);
+      case DUAL_MEMORY_WRAM:
+      case DUAL_MEMORY_WRAM + 1:
+         return inner[id - DUAL_MEMORY_WRAM].get_memory_data(RETRO_MEMORY_SYSTEM_RAM);
+      case DUAL_MEMORY_SAVE:
+      case DUAL_MEMORY_SAVE + 1:
+         return inner[id - DUAL_MEMORY_SAVE].get_memory_data(RETRO_MEMORY_SAVE_RAM);
+      case DUAL_MEMORY_FRAME:
+      case DUAL_MEMORY_FRAME + 1:
+         return (void *)inner[id - DUAL_MEMORY_FRAME].framebuffer();
+      case DUAL_MEMORY_STATS:
+         return &stats;
+      default:
+         return NULL;
+   }
+}
+
+size_t retro_get_memory_size(unsigned id)
+{
+   if (!gameLoaded)
+      return 0;
+
+   switch (id)
+   {
+      case RETRO_MEMORY_SAVE_RAM:
+      case RETRO_MEMORY_SYSTEM_RAM:
+         return inner[0].get_memory_size(id);
+      case DUAL_MEMORY_WRAM:
+      case DUAL_MEMORY_WRAM + 1:
+         return inner[id - DUAL_MEMORY_WRAM].get_memory_size(RETRO_MEMORY_SYSTEM_RAM);
+      case DUAL_MEMORY_SAVE:
+      case DUAL_MEMORY_SAVE + 1:
+         return inner[id - DUAL_MEMORY_SAVE].get_memory_size(RETRO_MEMORY_SAVE_RAM);
+      case DUAL_MEMORY_FRAME:
+      case DUAL_MEMORY_FRAME + 1:
+         return DUAL_WIDTH * DUAL_HEIGHT * 2;
+      case DUAL_MEMORY_STATS:
+         return sizeof(stats);
+      default:
+         return 0;
+   }
+}
