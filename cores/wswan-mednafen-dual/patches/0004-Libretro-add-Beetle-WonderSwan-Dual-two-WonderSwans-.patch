diff --git a/dual/build_dual.sh b/dual/build_dual.sh
new file mode 100644
index 0000000..f160499
--- /dev/null
+++ b/dual/build_dual.sh
@@ -0,0 +1,64 @@
+#!/bin/bash
+# 래퍼 코어(원더스완 두 대) 빌드 — build_mac.sh / build_linux.sh 가 부름
+#   bash dual/build_dual.sh mac|linux 빌드폴더 "안쪽 소스 목록"
+# 빌드폴더에 inner_*.o(안쪽 코어 보통 빌드 결과)와 flags(컴파일 옵션 파일)가 있어야 함.
+# 1) inner_*.o 에서 밖으로 보이는 이름(정의된 전역 이름)을 뽑아 머리 파일 두 개를 만듦:
+#    prefix_wsA.h = '#define 이름 wsA_이름' …, prefix_wsB.h = wsB_ …
+# 2) 안쪽 소스를 두 번 컴파일(-include 머리 파일) → 전역 변수가 따로인 두 대
+# 3) dual/libretro_dual.c + 두 벌을 묶어 하나의 코어로. 밖으로는 retro_* 만 내보냄(확인까지).
+# 빠진 이름이 있으면 두 벌이 같은 이름을 정의해 링크가 실패하므로 조용히 섞일 일은 없음.
+set -euo pipefail
+PLAT="$1"; B="$2"; SRCS="$3"
+D="$(cd "$(dirname "$0")" && pwd)"
+SRC="$(dirname "$D")"
+cd "$SRC"
+CC="${CC:-cc}"; NM="${NM:-nm}"
+
+# 1) 이름 목록
+if [ "$PLAT" = mac ]; then
+  "$NM" -g "$B"/inner_*.o | awk 'NF==3 && $2 != "U" {print $3}' | sed 's/^_//'
+else
+  "$NM" -g --defined-only "$B"/inner_*.o | awk 'NF==3 {print $3}'
+fi | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' | sort -u > "$B/inner_syms.txt"
+N=$(wc -l < "$B/inner_syms.txt" | tr -d ' ')
+grep -qx retro_run "$B/inner_syms.txt" && grep -qx hb_ws_emu_line "$B/inner_syms.txt" || { echo "이름 목록 이상($N개)"; exit 1; }
+for P in wsA wsB; do
+  { echo "/* 자동 생성(build_dual.sh): 안쪽 코어 바깥 이름 ${N}개에 ${P}_ 붙이기 */"
+    awk -v p="$P" '{printf "#define %s %s_%s\n", $1, p, $1}' "$B/inner_syms.txt"; } > "$B/prefix_$P.h"
+done
+echo "  안쪽 바깥 이름 ${N}개 → wsA_ / wsB_"
+
+# 2) 두 벌 컴파일(두 개씩)
+: > "$B/dual_jobs.txt"
+for P in wsA wsB; do
+  for s in $SRCS; do
+    echo "$CC @$B/flags -fno-common -include $B/prefix_$P.h -c -o $B/${P}_$(echo "$s" | tr / _).o $s" >> "$B/dual_jobs.txt"
+  done
+done
+while read -r a; do
+  read -r b || b=""
+  bash -c "$a" &
+  if [ -n "$b" ]; then bash -c "$b" & fi
+  wait
+done < "$B/dual_jobs.txt"
+NS=$(echo $SRCS | wc -w | tr -d ' ')
+NA=$(ls "$B"/wsA_*.o 2>/dev/null | wc -l | tr -d ' '); NB=$(ls "$B"/wsB_*.o 2>/dev/null | wc -l | tr -d ' ')
+[ "$NA" = "$NS" ] && [ "$NB" = "$NS" ] || { echo "두 벌 컴파일 실패(wsA $NA · wsB $NB / $NS)"; exit 1; }
+"$CC" @"$B/flags" -c -o "$B/dual_wrapper.o" dual/libretro_dual.c
+
+# 3) 묶기 + 내보낸 이름 확인
+if [ "$PLAT" = mac ]; then
+  OUT="$B/mednafen_wswan_dual_libretro.dylib"
+  "$CC" -dynamiclib -o "$OUT" "$B/dual_wrapper.o" "$B"/wsA_*.o "$B"/wsB_*.o -Wl,-exported_symbols_list,"$D/exports_mac.txt"
+  "$NM" -gU "$OUT" | awk '{print $3}' | sed 's/^_//' > "$B/exported.txt"
+else
+  OUT="$B/mednafen_wswan_dual_libretro.so"
+  "$CC" -shared -o "$OUT" "$B/dual_wrapper.o" "$B"/wsA_*.o "$B"/wsB_*.o \
+    -Wl,--version-script="$D/link_dual.T" -Wl,--no-undefined -lm
+  "$NM" -D --defined-only "$OUT" | awk 'NF==3 {print $3}' | grep -v '^_\|^GLIBC' > "$B/exported.txt" || true
+fi
+NE=$(grep -c '^retro_' "$B/exported.txt" || true)
+if grep -v '^retro_' "$B/exported.txt" | grep -q .; then
+  echo "retro_* 아닌 이름이 밖으로 나감:"; grep -v '^retro_' "$B/exported.txt" | head; exit 1
+fi
+echo "  래퍼 코어: 내보낸 이름 retro_* ${NE}개뿐"
