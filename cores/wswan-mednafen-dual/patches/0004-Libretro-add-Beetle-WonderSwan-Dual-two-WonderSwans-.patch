+bool retro_load_game(const struct retro_game_info *game)
+{
+   const char *value;
+   size_t sizeB;
+
+   if (!game || !game->data || !game->size)
+   {
+      dual_log(RETRO_LOG_ERROR, "롬을 메모리로 받아야 함");
+      return false;
+   }
+
+   memset(&stats, 0, sizeof(stats));
+   stats.magic = 0x54535748u; /* "HWST" */
+   stats.version = 1;
+   memset(seenStates, 0, sizeof(seenStates));
+   seenNext = 0;
+
+   value = getVariable("wswan_dual_link");
+   linkOn = !(value && !strcmp(value, "off"));
+   readScreenOption();
+   shown = linkOn ? screenOption : 0;
+
+   if (!inner[0].load_game(game))
+   {
+      dual_log(RETRO_LOG_ERROR, "1P 원더스완을 못 켬");
+      return false;
+   }
+   if (!inner[1].load_game(game))
+   {
+      dual_log(RETRO_LOG_ERROR, "2P 원더스완을 못 켬");
+      inner[0].unload_game();
+      return false;
+   }
+
+   innerSize = inner[0].serialize_size();
+   sizeB = inner[1].serialize_size();
+   if (!innerSize || innerSize != sizeB)
+   {
+      dual_log(RETRO_LOG_ERROR, "두 기계 상태 크기가 다름(%u / %u)", (unsigned)innerSize, (unsigned)sizeB);
+      inner[1].unload_game();
+      inner[0].unload_game();
+      return false;
+   }
+
+   saveSize = inner[0].get_memory_size(RETRO_MEMORY_SAVE_RAM);
+   if (saveSize != inner[1].get_memory_size(RETRO_MEMORY_SAVE_RAM) || !saveMemory(0) || !saveMemory(1))
+      saveSize = 0;
+   p2Written = saveSize ? (uint8_t *)calloc(1, saveSize) : NULL;
+   if (saveSize && !p2Written)
+      saveSize = 0;
+   p2WrittenSize = 0;
+   setP2SavePath(game);
+   if (linkOn)
+      loadP2Save();
+   p2CopyPending = linkOn && saveSize && !stats.p2Loaded;
+   p2Countdown = DUAL_P2_SAVE_EVERY;
+
+   stats.linkOn = linkOn;
+   stats.screen = (uint32_t)screenOption;
+   gameLoaded = true;
+   dual_log(RETRO_LOG_INFO, "켬: 원더스완 %s, 화면 %dP, 세이브 %u 바이트, 상태 %u 바이트",
+         linkOn ? "두 대(통신 케이블 연결)" : "한 대(link off)", shown + 1,
+         (unsigned)saveSize, (unsigned)retro_serialize_size());
+   return true;
+}
