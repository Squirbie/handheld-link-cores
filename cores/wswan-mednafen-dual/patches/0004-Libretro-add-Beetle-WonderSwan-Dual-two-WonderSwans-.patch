+
+/* 무엇: 같은 롬을 돌리는 원더스완 두 대(1P 기계 · 2P 기계)를 EXT 포트 시리얼
+ * (UART)로 이은 libretro 코어. 두 기기는 레트로아크 넷플레이로 패드 입력만
+ * 맞추고, 두 대의 에뮬은 양쪽 기기에서 똑같이 돌아감(GBA 때 만든 mGBA Dual 과
+ * 같은 생각).
+ *
+ * 어떻게:
+ * - 안쪽 코어(beetle-wswan + UART 다시 쓰기 + hb_ws_* 줄 단위 실행)를 빌드 때
+ *   두 번 컴파일함. 한 번은 모든 바깥 이름 앞에 wsA_, 한 번은 wsB_ 를 붙여서
+ *   (dual/build_dual.sh 가 이름 목록을 뽑아 머리 파일을 만듦) → 전역 변수가
+ *   완전히 따로인 두 대가 한 .so 안에 들어감. 밖으로 내보내는 건 이 파일의
+ *   retro_* 뿐.
+ * - 한 번의 retro_run 에서 두 기계를 한 줄(256 CPU 사이클)씩 번갈아 돌리고,
+ *   줄마다 다 보낸 시리얼 바이트를 상대 수신으로 넘김(두 기계가 그 줄을 다 돈
+ *   뒤 — 양쪽 대칭). 결과는 두 패드 입력만의 함수라서 넷플레이 되감기와 맞음.
+ * - 0번 패드 → 1P 기계, 1번 패드 → 2P 기계. 옵션 wswan_dual_screen(1P|2P)은
+ *   어느 기계의 화면 · 소리를 내보낼지만 고름(에뮬 상태에는 영향 없음 —
+ *   안 보이는 기계는 그리기만 건너뜀).
+ * - 옵션 wswan_dual_link(on|off): off 면 2P 기계를 아예 안 돌림(혼자 할 때 —
+ *   한 대짜리와 같은 속도). 게임을 불러올 때만 읽음.
+ * - 두 기기가 같아야 하는 안쪽 옵션(언어 · 이름 · 회전 · 60Hz · 표본율 등)은
+ *   이 래퍼가 고정값으로 대답함(fixedOptions).
+ * - 상태 저장 = 머리 64바이트 + 1P 기계 + 2P 기계(크기 고정).
+ * - 1P 세이브 = 보통 .srm(RETRO_MEMORY_SAVE_RAM = 1P 기계 SRAM/EEPROM).
+ *   2P 세이브 = <세이브 폴더>/<롬 이름>.p2.sav — 이 코어가 직접 읽고 씀
+ *   (mGBA Dual 0007 · 0009 방식: 압축 안 파일 이름 따름 · 임시 파일 후 이름
+ *   바꾸기, 안 되면 제자리 쓰기 · fsync). 2P 화면(손님)이거나 link off 면
+ *   안 씀. 2P 세이브가 없으면 첫 장 전에 1P 세이브를 2P 기계에 복사함
+ *   (원피스 그랜드 배틀은 한 번도 대전 안 한 빈 세이브로 통신 대전을 시작하면
+ *   게임 쪽 빈 포인터 때문에 멈춤 — BUILD_REPORT 참고).
+ *
+ * 시험용 환경 변수: WSWAN_DUAL_RENDER_BOTH=1(두 기계 다 그림) ·
+ * WSWAN_DUAL_TRACE=<파일>(밖에서 온 상태 · 2P 세이브 기록).
+ * 시험용 메모리 번호(레트로아크는 안 씀): 아래 DUAL_MEMORY_*. */
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <fcntl.h>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
+#include <libretro.h>
+
+#ifndef GIT_VERSION
+#define GIT_VERSION ""
+#endif
+
+#define DUAL_LIBRARY_NAME  "Beetle WonderSwan Dual"
+#define DUAL_VERSION       "1.0"
+#define DUAL_EXTENSIONS    "ws|wsc|pc2"
+#define DUAL_WIDTH         224
+#define DUAL_HEIGHT        144
+#define DUAL_MAX_LINES     1024   /* 한 장은 길어야 256줄 — 넘으면 멈춤으로 셈 */
+#define DUAL_P2_SAVE_EVERY 7200   /* retro_run 7200번(약 2분)마다, 2P 세이브가 바뀌었으면 씀 */
+#define DUAL_PATH_MAX      4096
+
+#define DUAL_STATE_MAGIC   0x31445748u /* "HWD1" */
+#define DUAL_STATE_VERSION 1u
+#define DUAL_HEADER_SIZE   64
+
+/* 시험 도구용 메모리 번호 */
+#define DUAL_MEMORY_WRAM   0x5700 /* + 기계(0 = 1P, 1 = 2P): 내부 RAM 64KB */
+#define DUAL_MEMORY_SAVE   0x5710 /* + 기계: 세이브 메모리(SRAM/EEPROM) */
+#define DUAL_MEMORY_FRAME  0x5720 /* + 기계: 화면 RGB565 224x144 */
+#define DUAL_MEMORY_STATS  0x5730
+
+/* ---- 안쪽 코어 두 벌(빌드 때 이름 앞에 wsA_ / wsB_ 가 붙음) ---- */
+#define INNER_DECLS(P) \
+   void P##retro_init(void); \
+   void P##retro_deinit(void); \
+   void P##retro_set_environment(retro_environment_t); \
+   void P##retro_set_video_refresh(retro_video_refresh_t); \
+   void P##retro_set_audio_sample(retro_audio_sample_t); \
+   void P##retro_set_audio_sample_batch(retro_audio_sample_batch_t); \
+   void P##retro_set_input_poll(retro_input_poll_t); \
+   void P##retro_set_input_state(retro_input_state_t); \
+   void P##retro_get_system_av_info(struct retro_system_av_info *); \
+   bool P##retro_load_game(const struct retro_game_info *); \
+   void P##retro_unload_game(void); \
+   void P##retro_run(void); \
+   void P##retro_reset(void); \
+   size_t P##retro_serialize_size(void); \
+   bool P##retro_serialize(void *, size_t); \
+   bool P##retro_unserialize(const void *, size_t); \
+   void *P##retro_get_memory_data(unsigned); \
+   size_t P##retro_get_memory_size(unsigned); \
+   void P##retro_cheat_reset(void); \
+   void P##retro_cheat_set(unsigned, bool, const char *); \
+   void P##hb_ws_run_pre(void); \
+   int P##hb_ws_subframes(void); \
+   void P##hb_ws_emu_begin(int, int); \
+   int P##hb_ws_emu_line(void); \
+   void P##hb_ws_emu_end(int, int); \
+   void P##hb_ws_run_post(void); \
+   int P##hb_ws_link_take(void); \
+   void P##hb_ws_link_give(unsigned); \
+   void P##hb_ws_link_stats(uint32_t *, unsigned); \
+   void P##hb_ws_set_render(int); \
+   const void *P##hb_ws_framebuffer(void);
+
+INNER_DECLS(wsA_)
+INNER_DECLS(wsB_)
+
+struct Inner
+{
+   void (*init)(void);
+   void (*deinit)(void);
+   void (*set_environment)(retro_environment_t);
+   void (*set_video_refresh)(retro_video_refresh_t);
+   void (*set_audio_sample)(retro_audio_sample_t);
+   void (*set_audio_sample_batch)(retro_audio_sample_batch_t);
+   void (*set_input_poll)(retro_input_poll_t);
+   void (*set_input_state)(retro_input_state_t);
+   void (*get_system_av_info)(struct retro_system_av_info *);
+   bool (*load_game)(const struct retro_game_info *);
+   void (*unload_game)(void);
+   void (*run)(void);
+   void (*reset)(void);
+   size_t (*serialize_size)(void);
+   bool (*serialize)(void *, size_t);
+   bool (*unserialize)(const void *, size_t);
+   void *(*get_memory_data)(unsigned);
+   size_t (*get_memory_size)(unsigned);
+   void (*cheat_reset)(void);
+   void (*cheat_set)(unsigned, bool, const char *);
+   void (*run_pre)(void);
+   int (*subframes)(void);
+   void (*emu_begin)(int, int);
+   int (*emu_line)(void);
+   void (*emu_end)(int, int);
+   void (*run_post)(void);
+   int (*link_take)(void);
+   void (*link_give)(unsigned);
+   void (*link_stats)(uint32_t *, unsigned);
+   void (*set_render)(int);
+   const void *(*framebuffer)(void);
+};
+
+#define INNER_TABLE(P) { \
+   P##retro_init, P##retro_deinit, P##retro_set_environment, \
+   P##retro_set_video_refresh, P##retro_set_audio_sample, \
+   P##retro_set_audio_sample_batch, P##retro_set_input_poll, \
+   P##retro_set_input_state, P##retro_get_system_av_info, \
+   P##retro_load_game, P##retro_unload_game, P##retro_run, P##retro_reset, \
+   P##retro_serialize_size, P##retro_serialize, P##retro_unserialize, \
+   P##retro_get_memory_data, P##retro_get_memory_size, \
+   P##retro_cheat_reset, P##retro_cheat_set, \
+   P##hb_ws_run_pre, P##hb_ws_subframes, P##hb_ws_emu_begin, \
+   P##hb_ws_emu_line, P##hb_ws_emu_end, P##hb_ws_run_post, \
+   P##hb_ws_link_take, P##hb_ws_link_give, P##hb_ws_link_stats, \
+   P##hb_ws_set_render, P##hb_ws_framebuffer }
+
+static const struct Inner inner[2] = { INNER_TABLE(wsA_), INNER_TABLE(wsB_) };
+
+/* 링크 진단(상태 저장에 안 들어감 · 에뮬에 영향 없음) */
+struct DualStats
+{
+   uint32_t magic;          /* "HWST" */
+   uint32_t version;
+   uint32_t frames;         /* retro_run 횟수 */
+   uint32_t linkOn;
+   uint32_t screen;         /* 0 = 1P, 1 = 2P */
+   uint32_t linesLast;      /* 마지막 장(부분 장)의 줄 단계 수 */
+   uint32_t linesMax;
+   uint32_t stalls;         /* 줄 수 한도에 걸린 횟수(0 이어야 함) */
+   uint32_t bytes[2];       /* 넘긴 바이트: [0] 1P→2P, [1] 2P→1P */
+   uint32_t outsideLoads;   /* WSWAN_DUAL_TRACE 일 때만: 이 코어가 만든 적 없는 상태를 불러온 횟수 */
+   uint32_t p2Loaded;       /* 1 = .p2.sav 를 읽음 */
+   uint32_t p2Copied;       /* 1 = .p2.sav 가 없어 1P 세이브를 2P 기계에 복사함 */
+   uint32_t p2Writes;       /* .p2.sav 를 쓴 횟수 */
+   uint32_t subframeSkew;   /* 두 기계의 60Hz 장 수가 달랐던 retro_run 수 */
+   uint32_t reserved;
+   uint32_t comm[2][10];    /* 기계별 UART 통계(hb_ws_link_stats) */
+};
+
+/* 두 기기가 같아야 하는 안쪽 옵션 — 래퍼가 고정. 없는 키(생일 · 성별 · 혈액형)는
+ * 코어 기본값(1989-06-23 · 2 · 3). 이름 = "Mednafen"(앞단 사용자 이름을 쓰면
+ * 기기마다 달라지고, 리셋 때 내부 EEPROM 이 다시 만들어지면 어긋날 수 있음). */
+struct FixedOption
+{
+   const char *key;
+   const char *value;
+};
+
+static const struct FixedOption fixedOptions[] = {
+   { "wswan_language",            "english"   },
+   { "wswan_name_source",         "default"   },
+   { "wswan_rotate_display",      "landscape" }, /* SELECT 로 회전(상태 저장 밖) 끔 */
+   { "wswan_rotate_keymap",       "disabled"  },
+   { "wswan_mono_palette",        "default"   },
+   { "wswan_gfx_colors",          "16bit"     },
+   { "wswan_frameskip",           "disabled"  },
+   { "wswan_frameskip_threshold", "33"        },
+   { "wswan_60hz_mode",           "enabled"   },
+   { "wswan_sound_sample_rate",   "44100"     },
+   { "wswan_sound_low_pass",      "disabled"  },
+   { NULL, NULL }
+};
+
+static retro_environment_t environCallback;
+static retro_video_refresh_t videoCallback;
+static retro_audio_sample_batch_t audioCallback;
+static retro_input_poll_t inputPollCallback;
+static retro_input_state_t inputCallback;
+static retro_log_printf_t logCallback;
+
+static bool useBitmasks;
+static bool rgb565;
+static bool renderBoth;
+static bool gameLoaded;
+static bool linkOn = true;
+static int screenOption;       /* 옵션: 0 = 1P, 1 = 2P */
+static int shown;              /* 이번 장에 내보내는 기계 */
+static bool audioOn = true;
+static size_t innerSize;       /* 기계 하나의 상태 크기 */
+static struct DualStats stats;
+
+static char p2SavePath[DUAL_PATH_MAX];
+static uint8_t *p2Written;     /* 마지막으로 쓴(또는 읽은) .p2.sav 내용 */
+static size_t p2WrittenSize;   /* 0 = 디스크에 아직 없음 */
+static size_t saveSize;        /* 기계 하나의 세이브 크기(0 = 세이브 없는 게임) */
+static bool p2CopyPending;
+static unsigned p2Countdown;
+
+static FILE *traceFile;
+#define DUAL_SEEN_STATES 256
+static uint64_t seenStates[DUAL_SEEN_STATES];
+static unsigned seenNext;
+
+static void dual_log(enum retro_log_level level, const char *fmt, ...)
+{
+   char message[512];
+   va_list args;
+
+   va_start(args, fmt);
+   vsnprintf(message, sizeof(message), fmt, args);
+   va_end(args);
+
+   if (traceFile)
+   {
+      fprintf(traceFile, "f=%u %s\n", stats.frames, message);
+      fflush(traceFile);
+   }
+   if (logCallback)
+      logCallback(level, "[WonderSwan Dual] %s\n", message);
+}
