+void retro_init(void)
+{
+   struct retro_log_callback log;
+   enum retro_pixel_format fmt = RETRO_PIXEL_FORMAT_RGB565;
+   const char *env;
+   int m;
+
+#define DESC(PORT, ID, NAME) { PORT, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_ ## ID, NAME }
+#define PORT_DESCS(PORT) \
+   DESC(PORT, LEFT, "X Cursor Left"), DESC(PORT, UP, "X Cursor Up"), \
+   DESC(PORT, DOWN, "X Cursor Down"), DESC(PORT, RIGHT, "X Cursor Right"), \
+   DESC(PORT, L, "Y Cursor Left"), DESC(PORT, R2, "Y Cursor Up"), \
+   DESC(PORT, L2, "Y Cursor Down"), DESC(PORT, R, "Y Cursor Right"), \
+   DESC(PORT, A, "A"), DESC(PORT, B, "B"), DESC(PORT, START, "Start")
+   struct retro_input_descriptor desc[] = {
+      PORT_DESCS(0),
+      PORT_DESCS(1),
+      { 0, 0, 0, 0, NULL },
+   };
+#undef PORT_DESCS
+#undef DESC
+
+   logCallback = environCallback(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log) ? log.log : NULL;
+   rgb565 = environCallback(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &fmt);
+   useBitmasks = environCallback(RETRO_ENVIRONMENT_GET_INPUT_BITMASKS, NULL);
+   environCallback(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, desc);
+
+   env = getenv("WSWAN_DUAL_RENDER_BOTH");
+   renderBoth = env && env[0] == '1';
+   env = getenv("WSWAN_DUAL_TRACE");
+   if (env && env[0] && !traceFile)
+      traceFile = fopen(env, "w");
+
+   for (m = 0; m < 2; m++)
+   {
+      inner[m].set_video_refresh(videos[m]);
+      inner[m].set_audio_sample(audioSampleNop);
+      inner[m].set_audio_sample_batch(audios[m]);
+      inner[m].set_input_poll(pollNop);
+      inner[m].set_input_state(inputs[m]);
+      inner[m].init();
+   }
+}
