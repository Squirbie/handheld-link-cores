+/* ---- 안쪽 코어 두 벌에게 주는 콜백 ---- */
+
+static bool envProxy(int m, unsigned cmd, void *data)
+{
+   (void)m;
+
+   switch (cmd)
+   {
+      case RETRO_ENVIRONMENT_GET_VARIABLE:
+      {
+         struct retro_variable *var = (struct retro_variable *)data;
+         const struct FixedOption *o;
+
+         var->value = NULL;
+         for (o = fixedOptions; o->key; o++)
+         {
+            if (!strcmp(o->key, var->key))
+            {
+               var->value = o->value;
+               return true;
+            }
+         }
+         return false;
+      }
+      case RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE:
+         /* 안쪽 옵션은 고정. 앞단의 '바뀜' 표시는 래퍼만 읽음 */
+         *(bool *)data = false;
+         return true;
+      case RETRO_ENVIRONMENT_GET_CORE_OPTIONS_VERSION:
+         *(unsigned *)data = 2;
+         return true;
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2_INTL:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_INTL:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS:
+      case RETRO_ENVIRONMENT_SET_VARIABLES:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_DISPLAY:
+         /* 메뉴에는 래퍼 옵션만 */
+         return false;
+      case RETRO_ENVIRONMENT_GET_LOG_INTERFACE:
+         if (!logCallback)
+            return false;
+         ((struct retro_log_callback *)data)->log = logCallback;
+         return true;
+      case RETRO_ENVIRONMENT_GET_INPUT_BITMASKS:
+         return useBitmasks;
+      case RETRO_ENVIRONMENT_SET_PIXEL_FORMAT:
+      {
+         enum retro_pixel_format fmt = *(const enum retro_pixel_format *)data;
+         if (fmt == RETRO_PIXEL_FORMAT_RGB565)
+            return rgb565;
+         return fmt == RETRO_PIXEL_FORMAT_0RGB1555 && !rgb565;
+      }
+      case RETRO_ENVIRONMENT_SET_ROTATION:
+         /* 가로 고정 — 0도만 받음(앞단 회전은 기본 0) */
+         return *(const unsigned *)data == 0;
+      case RETRO_ENVIRONMENT_SET_PERFORMANCE_LEVEL:
+      case RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS:
+      case RETRO_ENVIRONMENT_SET_GEOMETRY:
+      case RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO:
+         /* 입력 설명은 래퍼가 두 포트로 따로 냄. 화면 크기 · 표본율은 고정이라
+          * 바뀔 일이 없음 */
+         return true;
+      case RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY:
+      case RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY:
+         return environCallback ? environCallback(cmd, data) : false;
+      default:
+         /* 사용자 이름 · 언어 · 소리 버퍼 상태(프레임 건너뛰기) 등은 모름 = 기본값 */
+         return false;
+   }
+}
+
+static bool envA(unsigned cmd, void *data) { return envProxy(0, cmd, data); }
+static bool envB(unsigned cmd, void *data) { return envProxy(1, cmd, data); }
+
+static void videoProxy(int m, const void *data, unsigned width, unsigned height, size_t pitch)
+{
+   if (m == shown && videoCallback)
+      videoCallback(data, width, height, pitch);
+}
+
+static void videoA(const void *d, unsigned w, unsigned h, size_t p) { videoProxy(0, d, w, h, p); }
+static void videoB(const void *d, unsigned w, unsigned h, size_t p) { videoProxy(1, d, w, h, p); }
+
+static size_t audioProxy(int m, const int16_t *data, size_t frames)
+{
+   if (m == shown && audioOn && audioCallback)
+   {
+      size_t taken = audioCallback(data, frames);
+      /* 0 을 돌려주는 앞단이면 안쪽 코어가 영영 다시 보내므로 다 받은 것으로 */
+      return taken ? taken : frames;
+   }
+   return frames;
+}
+
+static size_t audioA(const int16_t *d, size_t f) { return audioProxy(0, d, f); }
+static size_t audioB(const int16_t *d, size_t f) { return audioProxy(1, d, f); }
+
+static void audioSampleNop(int16_t left, int16_t right)
+{
+   (void)left;
+   (void)right;
+}
