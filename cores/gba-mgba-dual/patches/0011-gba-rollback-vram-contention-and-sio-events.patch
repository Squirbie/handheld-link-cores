index 94448c32b572..993bbb9a1622 100644
--- a/src/gba/sio/lockstep.c
+++ b/src/gba/sio/lockstep.c
@@ -28,6 +28,7 @@ DECL_BITS(GBASIOLockstepSerializedFlags, Player0Mode, 10, 3);
 DECL_BITS(GBASIOLockstepSerializedFlags, Player1Mode, 13, 3);
 DECL_BITS(GBASIOLockstepSerializedFlags, Player2Mode, 16, 3);
 DECL_BITS(GBASIOLockstepSerializedFlags, Player3Mode, 19, 3);
+DECL_BIT(GBASIOLockstepSerializedFlags, BeforeSioComplete, 22);
 DECL_BITS(GBASIOLockstepSerializedFlags, TransferMode, 28, 3);
 DECL_BIT(GBASIOLockstepSerializedFlags, TransferActive, 31);
 
@@ -356,7 +357,20 @@ static bool GBASIOLockstepDriverLoadState(struct GBASIODriver* driver, const voi
 	if (GBASIOLockstepSerializedFlagsGetEventScheduled(flags)) {
 		int32_t when;
 		LOAD_32LE(when, 0, &state->driver.nextEvent);
+		struct mTiming* timing = &driver->p->p->timing;
+		struct mTimingEvent* complete = &driver->p->completeEvent;
+		/* These two events have the same priority. Keep their original
+		 * order when their deadlines coincide, instead of letting the
+		 * order of deserialization choose the winner. */
+		bool beforeComplete = GBASIOLockstepSerializedFlagsIsBeforeSioComplete(flags)
+		    && mTimingIsScheduled(timing, complete) && mTimingUntil(timing, complete) == when;
+		if (beforeComplete) {
+			mTimingDeschedule(timing, complete);
+		}
 		mTimingSchedule(&driver->p->p->timing, &lockstep->event, when);
+		if (beforeComplete) {
+			mTimingSchedule(timing, complete, when);
+		}
 	}
 
 	if (GBASIOLockstepSerializedFlagsGetAsleep(flags)) {
@@ -375,6 +389,7 @@ static bool GBASIOLockstepDriverLoadState(struct GBASIODriver* driver, const voi
 	for (i = 0; i < MAX_LOCKSTEP_EVENTS - 1; ++i) {
 		player->buffer[i].next = &player->buffer[i + 1];
 	}
+	player->buffer[MAX_LOCKSTEP_EVENTS - 1].next = NULL;
 	player->freeList = &player->buffer[0];
 	player->queue = NULL;
 
@@ -404,6 +419,9 @@ static bool GBASIOLockstepDriverLoadState(struct GBASIODriver* driver, const voi
 			break;
 		}
 	}
+	/* The queued and free nodes must be disjoint terminated lists. The
+	 * last queued node otherwise still points into the rebuilt free list. */
+	*lastEvent = NULL;
 
 	if (player->playerId == 0) {
 		LOAD_32LE(coordinator->cycle, 0, &state->coordinator.cycle);
@@ -442,6 +460,20 @@ static void GBASIOLockstepDriverSaveState(struct GBASIODriver* driver, void** st
 	flags = GBASIOLockstepSerializedFlagsSetDataReceived(flags, player->dataReceived);
 	flags = GBASIOLockstepSerializedFlagsSetDriverMode(flags, _modeEnumToInt(player->mode));
 	flags = GBASIOLockstepSerializedFlagsSetEventScheduled(flags, mTimingIsScheduled(&driver->p->p->timing, &lockstep->event));
+	const struct mTiming* timing = &driver->p->p->timing;
+	const struct mTimingEvent* complete = &driver->p->completeEvent;
+	if (lockstep->event.when == complete->when && mTimingIsScheduled(timing, complete)) {
+		const struct mTimingEvent* event = timing->root ? timing->root : timing->reroot;
+		for (; event; event = event->next) {
+			if (event == complete) {
+				break;
+			}
+			if (event == &lockstep->event) {
+				flags = GBASIOLockstepSerializedFlagsFillBeforeSioComplete(flags);
+				break;
+			}
+		}
+	}
 
 	flags = GBASIOLockstepSerializedFlagsSetPlayer0Mode(flags, _modeEnumToInt(player->otherModes[0]));
 	flags = GBASIOLockstepSerializedFlagsSetPlayer1Mode(flags, _modeEnumToInt(player->otherModes[1]));
