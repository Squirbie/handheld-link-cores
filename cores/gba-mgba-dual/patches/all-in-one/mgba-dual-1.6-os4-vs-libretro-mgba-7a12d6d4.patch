+void retro_init(void) {
+	enum retro_pixel_format fmt = RETRO_PIXEL_FORMAT_RGB565;
+	environCallback(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &fmt);
+
+#define DESC(PORT, ID, NAME) { PORT, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_ ## ID, NAME }
+#define PORT_DESCS(PORT) \
+	DESC(PORT, A, "A"), DESC(PORT, B, "B"), DESC(PORT, SELECT, "Select"), DESC(PORT, START, "Start"), \
+	DESC(PORT, RIGHT, "Right"), DESC(PORT, LEFT, "Left"), DESC(PORT, UP, "Up"), DESC(PORT, DOWN, "Down"), \
+	DESC(PORT, R, "R"), DESC(PORT, L, "L")
+	struct retro_input_descriptor inputDescriptors[] = {
+		PORT_DESCS(0),
+		PORT_DESCS(1),
+		{ 0 }
+	};
+#undef PORT_DESCS
+#undef DESC
+	environCallback(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, &inputDescriptors);
+	useBitmasks = environCallback(RETRO_ENVIRONMENT_GET_INPUT_BITMASKS, NULL);
+
+	struct retro_log_callback log;
+	logCallback = environCallback(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log) ? log.log : NULL;
+
+	mLogFilterInit(&logFilter);
+	logFilter.defaultLevels = mLOG_FATAL | mLOG_ERROR | mLOG_WARN;
+	const char* trace = getenv("MGBA_DUAL_TRACE");
+	if (trace && trace[0]) {
+		traceFile = fopen(trace, "w");
+		if (traceFile) {
+			mLogFilterSet(&logFilter, "gba.sio", mLOG_FATAL | mLOG_ERROR | mLOG_WARN | mLOG_DEBUG);
+		}
+	}
+	const char* both = getenv("MGBA_DUAL_RENDER_BOTH");
+	renderBoth = both && both[0] == '1';
+	logger.log = _coreLog;
+	logger.filter = &logFilter;
+	mLogSetDefaultLogger(&logger);
+}
