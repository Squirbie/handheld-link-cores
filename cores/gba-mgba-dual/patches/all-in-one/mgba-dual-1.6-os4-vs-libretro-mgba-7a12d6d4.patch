+/* --- player 2 save file (.p2.srm) --- */
+
+static size_t _saveSize(int i) {
+	struct GBA* gba = players[i].core->board;
+	if (gba->memory.savedata.type == GBA_SAVEDATA_AUTODETECT) {
+		return DUAL_SAVE_SIZE;
+	}
+	return GBASavedataSize(&gba->memory.savedata);
+}
+
+static void _loadP2Save(void) {
+	memset(players[1].save, 0xFF, DUAL_SAVE_SIZE);
+	if (!p2SavePath[0]) {
+		return;
+	}
+	FILE* f = fopen(p2SavePath, "rb");
+	if (!f) {
+		_log(RETRO_LOG_INFO, "no 2P save yet: %s", p2SavePath);
+		return;
+	}
+	size_t got = fread(players[1].save, 1, DUAL_SAVE_SIZE, f);
+	fclose(f);
+	_log(RETRO_LOG_INFO, "2P save loaded (%u bytes): %s", (unsigned) got, p2SavePath);
+	p2SaveWrittenSize = got;
+	memcpy(p2SaveWritten, players[1].save, DUAL_SAVE_SIZE);
+}
+
+static void _writeP2Save(bool force) {
+	if (!linkOn || !p2SavePath[0]) {
+		/* 2P (guest) mode: the 2P save belongs to the host device */
+		return;
+	}
+	/* 손님 역할이면(화면 선택과 상관없이) 2P 칸은 방장 기기 것 — 쓰지 않음 */
+	if (hb_own_guest) {
+		return;
+	}
+	/* 손님 자기 세이브가 든 2P: 방장의 2P 칸을 손님 세이브로 바꾸지 않음(손님 기기가 자기 것으로 되씀) */
+	if (hb_own_applied || hb_has_token()) {
+		if (!hb_own_p2_skip_logged) {
+			hb_own_p2_skip_logged = true;
+			_log(RETRO_LOG_INFO, "손님 세이브가 든 2P — 방장 2P 칸은 그대로: %s", p2SavePath);
+		}
+		return;
+	}
+	size_t size = _saveSize(1);
+	if (!force && size == p2SaveWrittenSize && !memcmp(p2SaveWritten, players[1].save, size)) {
+		return;
+	}
+	if (p2SaveWrittenSize == 0) {
+		/* Nothing on disk yet: only create the file once the game wrote something */
+		size_t i;
+		for (i = 0; i < size && players[1].save[i] == 0xFF; ++i);
+		if (i == size) {
+			return;
+		}
+	}
+	screenFileRefresh();
+	if (selectedScreen() == 1) {
+		return;
+	}
+	/* 처음 바꾸기 전 지금 파일을 .bak 으로 한 번 · 임시 파일 확인 뒤 이름 바꾸기.
+	 * 실패하면 원본을 열어 잘라 쓰지 않고 그대로 둔다(다음 저장 때 다시). */
+	if (!hb_p2_store(p2SavePath, players[1].save, size)) {
+		_log(RETRO_LOG_ERROR, "2P save write failed (original kept): %s", p2SavePath);
+		return;
+	}
+	memcpy(p2SaveWritten, players[1].save, size);
+	p2SaveWrittenSize = size;
+	_log(RETRO_LOG_INFO, "2P save written (%u bytes): %s", (unsigned) size, p2SavePath);
+}
+
+static void _setP2SavePath(const struct retro_game_info* game) {
+	p2SavePath[0] = '\0';
+	if (!game->path || !game->path[0]) {
+		return;
+	}
+	const char* base = strrchr(game->path, '/');
+#ifdef _WIN32
+	const char* base2 = strrchr(game->path, '\\');
+	if (base2 > base) {
+		base = base2;
+	}
+#endif
+	base = base ? base + 1 : game->path;
+	char name[PATH_MAX];
+	/* RetroArch names saves after the file inside an archive ("x.zip#y.gba" -> "y") */
+	const char* inner = NULL;
+	const char* hash;
+	for (hash = strchr(base, '#'); hash; hash = strchr(hash + 1, '#')) {
+		size_t at = hash - base;
+		if ((at >= 4 && (!strncasecmp(hash - 4, ".zip", 4) || !strncasecmp(hash - 4, ".apk", 4))) ||
+		    (at >= 3 && !strncasecmp(hash - 3, ".7z", 3))) {
+			inner = hash + 1;
+			break;
+		}
+	}
+	snprintf(name, sizeof(name), "%s", inner && inner[0] ? inner : base);
+	char* dot = strrchr(name, '.');
+	if (dot && dot != name) {
+		*dot = '\0';
+	}
+	const char* dir = NULL;
+	char romDir[PATH_MAX];
+	if (!environCallback(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &dir) || !dir || !dir[0]) {
+		snprintf(romDir, sizeof(romDir), "%.*s", (int) (base - game->path), game->path);
+		dir = romDir;
+	}
+	size_t len = strlen(dir);
+	int written = snprintf(p2SavePath, sizeof(p2SavePath), "%s%s%s.p2.srm", dir, (len && dir[len - 1] != '/') ? "/" : "", name);
+	if (written < 0 || (size_t) written >= sizeof(p2SavePath)) {
+		_log(RETRO_LOG_ERROR, "2P save path too long, 2P save disabled");
+		p2SavePath[0] = '\0';
+	}
+}
