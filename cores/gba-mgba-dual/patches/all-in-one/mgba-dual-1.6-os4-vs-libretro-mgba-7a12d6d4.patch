+	if(LIBRETRO_DUAL)
+		set_target_properties(${BINARY_NAME}_libretro PROPERTIES OUTPUT_NAME ${BINARY_NAME}_dual_libretro)
+	endif()
 	# The make-era libretro builds all used the gnu dialect (-std=gnu99) plus
