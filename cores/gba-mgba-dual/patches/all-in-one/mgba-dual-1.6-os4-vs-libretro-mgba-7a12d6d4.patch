+/* --- lockstep user: cooperative, only flips a flag --- */
+
+/* The lockstep driver force-exits a sleeping core's run slice by itself
+ * (cpu->nextEvent = 0 + GBAInterrupt); retro_run then skips it while
+ * players[i].link->asleep is set. Nothing has to block here. */
+static void _userSleep(struct mLockstepUser* user) {
+	struct DualUser* u = (struct DualUser*) user;
+	++stats.p[u->index].sleeps;
+}
+
+static void _userWake(struct mLockstepUser* user) {
+	UNUSED(user);
+}
+
+static int _userRequestedId(struct mLockstepUser* user) {
+	return ((struct DualUser*) user)->index;
+}
+
+static void _userPlayerIdChanged(struct mLockstepUser* user, int id) {
+	struct DualUser* u = (struct DualUser*) user;
+	stats.p[u->index].playerId = id;
+}
+
+/* --- diagnostic wrappers around the lockstep driver --- */
+
+static int _driverIndex(struct GBASIODriver* driver) {
+	return driver == &players[1].driver.d ? 1 : 0;
+}
+
+static void _wrapSetMode(struct GBASIODriver* driver, enum GBASIOMode mode) {
+	int i = _driverIndex(driver);
+	++stats.p[i].modeSets;
+	stats.p[i].mode = mode;
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d mode %d\n", stats.frames, i, (int) mode);
+	}
+	players[i].setMode(driver, mode);
+}
+
+static bool _wrapStart(struct GBASIODriver* driver) {
+	int i = _driverIndex(driver);
+	bool started = players[i].start(driver);
+	if (started) {
+		++stats.p[i].starts;
+		if (traceFile) {
+			const uint16_t* io = ((struct GBA*) players[i].core->board)->memory.io;
+			fprintf(traceFile, "f=%u p%d start send=%04X d8=%02X d32=%04X%04X\n", stats.frames, i,
+			        io[GBA_REG(SIOMLT_SEND)], io[GBA_REG(SIODATA8)] & 0xFF,
+			        io[GBA_REG(SIODATA32_HI)], io[GBA_REG(SIODATA32_LO)]);
+		}
+	}
+	return started;
+}
+
+static void _wrapFinishMultiplayer(struct GBASIODriver* driver, uint16_t data[4]) {
+	int i = _driverIndex(driver);
+	players[i].finishMultiplayer(driver, data);
+	++stats.p[i].multiDone;
+	memcpy(stats.p[i].lastMulti, data, sizeof(stats.p[i].lastMulti));
+	if (data[1 - i] != 0xFFFF) {
+		++stats.p[i].multiFromPartner;
+	}
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d multi %04X %04X %04X %04X\n", stats.frames, i, data[0], data[1], data[2], data[3]);
+	}
+}
+
+static uint8_t _wrapFinishNormal8(struct GBASIODriver* driver) {
+	int i = _driverIndex(driver);
+	uint8_t data = players[i].finishNormal8(driver);
+	++stats.p[i].normalDone;
+	stats.p[i].lastNormal = data;
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d normal8 %02X\n", stats.frames, i, data);
+	}
+	return data;
+}
+
+static uint32_t _wrapFinishNormal32(struct GBASIODriver* driver) {
+	int i = _driverIndex(driver);
+	uint32_t data = players[i].finishNormal32(driver);
+	++stats.p[i].normalDone;
+	stats.p[i].lastNormal = data;
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d normal32 %08X\n", stats.frames, i, data);
+	}
+	return data;
+}
