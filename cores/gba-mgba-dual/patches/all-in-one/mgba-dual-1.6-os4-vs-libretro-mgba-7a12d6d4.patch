diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9d528e790ed3..1b8e2b6e1ab4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1029,6 +1029,19 @@ if(BUILD_LIBRETRO)
 	file(GLOB RETRO_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/libretro/*.c)
 	set(LIBRETRO_CORE_SRC ${CORE_SRC})
 	list(APPEND LIBRETRO_CORE_SRC ${VFS_SRC})
+	# mGBA Dual (hanbang): two GBAs on one lockstep link cable in one core
+	option(LIBRETRO_DUAL "Build mgba_dual_libretro (two linked GBAs) instead of mgba_libretro" OFF)
+	if(LIBRETRO_DUAL)
+		set(RETRO_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/libretro/libretro-audio.c
+		              ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/libretro/libretro-vfs.c
+		              ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/libretro/dual/libretro_dual.c)
+		list(APPEND LIBRETRO_CORE_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/gba/sio/lockstep.c)
+		# 1.5 짝 게임: 2P 짝 롬 ZIP 풀기(hb_romfile.h) — 들어 있는 zlib 의 inflate 만(이름은 link.T 로 안 내보냄)
+		foreach(HB_ZLIB_FILE adler32 crc32 inffast inflate inftrees zutil)
+			list(APPEND RETRO_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/third-party/zlib/${HB_ZLIB_FILE}.c)
+			set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/src/third-party/zlib/${HB_ZLIB_FILE}.c PROPERTIES COMPILE_DEFINITIONS Z_PREFIX)
+		endforeach()
+	endif()
 	list(FILTER LIBRETRO_CORE_SRC EXCLUDE REGEX "/core/(scripting|library|mem-search|rewind|input)\\.c$")
 	list(FILTER LIBRETRO_CORE_SRC EXCLUDE REGEX "/util/(audio-resampler|interpolator)\\.c$")
 	if(CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "STATIC_LIBRARY" AND NOT APPLE)
@@ -1100,6 +1113,9 @@ if(BUILD_LIBRETRO)
 		endif()
 	endif()
