+void retro_deinit(void) {
+	hb_own_deinit();
+	mLogSetDefaultLogger(NULL);
+	if (traceFile) {
+		fclose(traceFile);
+		traceFile = NULL;
+	}
+	mLogFilterDeinit(&logFilter);
+}
+
+static bool _setupPlayer(int i, const char* biosPath, const struct mCoreOptions* opts) {
+	struct DualPlayer* player = &players[i];
+	struct mCore* core = GBACoreCreate();
+	if (!core) {
+		return false;
+	}
+	player->core = core;
+	mCoreInitConfig(core, NULL);
+	core->init(core);
+	mCoreConfigLoadDefaults(&core->config, opts);
+	mCoreConfigSetDefaultValue(&core->config, "idleOptimization", "remove");
+	mCoreLoadConfig(core);
+
+	player->videoBuffer = calloc(DUAL_WIDTH * DUAL_HEIGHT, sizeof(mColor));
+	player->frameBuffer = calloc(DUAL_WIDTH * DUAL_HEIGHT, sizeof(mColor));
+	player->save = anonymousMemoryMap(DUAL_SAVE_SIZE);
+	if (!player->videoBuffer || !player->frameBuffer || !player->save) {
+		return false;
+	}
+	memset(player->save, 0xFF, DUAL_SAVE_SIZE);
+	core->setVideoBuffer(core, player->videoBuffer, DUAL_WIDTH);
+
+	/* 1.6 싱글팩: 2P 는 팩(롬) 없이 진짜 바이오스로. 바이오스를 먼저 넣어 보고, 못 넣으면 팩으로 켬(기록만).
+	 * 롬을 안 넣으면 mGBA 의 카트 자리는 실제 GBA 처럼 열린 버스(롬 크기 0)이고, 롬 영역 쓰기는 무시됨. */
+	bool noCart = i == 1 && p2NoCart;
+	if (noCart) {
+		struct VFile* bios = biosPath && opts->useBios ? VFileOpen(biosPath, O_RDONLY) : NULL;
+		if (bios && core->loadBIOS(core, bios, 0) && ((struct GBA*) core->board)->memory.fullBios) {
+			biosLoaded = true;
+		} else {
+			if (bios && !((struct GBA*) core->board)->biosVf) {
+				bios->close(bios);
+			}
+			_log(RETRO_LOG_WARN, "2P 팩 없음: 바이오스를 못 넣음 — 2P 를 팩으로 켬(싱글팩 같이하기 안 됨)");
+			p2NoCart = false;
+			noCart = false;
+		}
+	}
+	if (!noCart) {
+		/* Both cores read the same ROM image; mGBA copies on write if a game ever writes ROM
+		 * (1.5: 짝 게임이면 2P 만 짝 롬) */
+		struct VFile* rom = (i == 1 && p2RomData) ? VFileFromMemory(p2RomData, p2RomSize) : VFileFromMemory(romData, romSize);
+		if (!rom || !core->loadROM(core, rom)) {
+			return false;
+		}
+		if (biosPath && opts->useBios) {
+			struct VFile* bios = VFileOpen(biosPath, O_RDONLY);
+			if (bios && core->loadBIOS(core, bios, 0)) {
+				biosLoaded = true;
+			} else if (bios) {
+				bios->close(bios);
+			}
+		}
+	}
+	core->rtc.override = RTC_FAKE_EPOCH;
+	core->rtc.value = DUAL_RTC_EPOCH_MS;
+
+	player->callbacks.context = player;
+	player->callbacks.videoFrameEnded = _frameEnded;
+	player->callbacks.savedataUpdated = _savedataUpdated;
+	core->addCoreCallbacks(core, &player->callbacks);
+
+	if (linkOn) {
+		/* Link cable: cooperative lockstep user + driver, wrapped for diagnostics */
+		player->user.index = i;
+		player->user.d.sleep = _userSleep;
+		player->user.d.wake = _userWake;
+		player->user.d.requestedId = _userRequestedId;
+		player->user.d.playerIdChanged = _userPlayerIdChanged;
+		GBASIOLockstepDriverCreate(&player->driver, &player->user.d);
+		player->setMode = player->driver.d.setMode;
+		player->start = player->driver.d.start;
+		player->finishMultiplayer = player->driver.d.finishMultiplayer;
+		player->finishNormal8 = player->driver.d.finishNormal8;
+		player->finishNormal32 = player->driver.d.finishNormal32;
+		player->driver.d.setMode = _wrapSetMode;
+		player->driver.d.start = _wrapStart;
+		player->driver.d.finishMultiplayer = _wrapFinishMultiplayer;
+		player->driver.d.finishNormal8 = _wrapFinishNormal8;
+		player->driver.d.finishNormal32 = _wrapFinishNormal32;
+		GBASIOLockstepCoordinatorAttach(&coordinator, &player->driver);
+		core->setPeripheral(core, mPERIPH_GBA_LINK_PORT, &player->driver.d);
+		player->link = TableLookup(&coordinator.players, player->driver.lockstepId);
+		if (!player->link) {
+			return false;
+		}
+	}
+
+	/* Same order as mgba-rollback: attach, then reset, one core after the other */
+	core->reset(core);
+	if (i == 1 && p2RomData && !((struct GBA*) core->board)->memory.biosPrefetch) {
+		/* 1.5 짝 게임: 게임 중에 새로 만든 2P 는 BIOS 열린 버스 값이 0 인데, mGBA 는 상태의 이 칸이 0 이면
+		 * 읽지 않고 지금 값을 둔다(serialize.c). 그대로면 막 만든 2P 상태로 되감을 때 앞 값이 남아 어긋남
+		 * → 실제 GBA 가 켜진 뒤의 값으로 둠(짝이 아니면 이 줄을 지나지 않음) */
+		((struct GBA*) core->board)->memory.biosPrefetch = 0xE129F000;
+	}
+	if (noCart && !((struct GBA*) core->board)->memory.biosPrefetch) {
+		/* 1.6 싱글팩: 팩 없는 2P 는 바이오스 안에서만 돌다가(받기 끝날 때까지) 처음 바이오스를 벗어날 때
+		 * 이 값이 정해짐. 0 인 상태로 되감으면 mGBA 가 읽지 않고 지금 값을 둠(serialize.c) → 1.5 짝 게임과 같은
+		 * 까닭으로 상태 대조가 어긋남. 켜진 뒤의 값으로 둠(바이오스 안에서는 이 값을 읽는 일이 없어 동작은 같음). */
+		((struct GBA*) core->board)->memory.biosPrefetch = 0xE129F000;
+	}
+	struct VFile* save = VFileFromMemory(player->save, DUAL_SAVE_SIZE);
+	if (!save || !core->loadSave(core, save)) {
+		return false;
+	}
+	if (noCart) {
+		/* 팩이 없으니 세이브 칩도 없음(세이브 영역 읽기 = 0xFF, 쓰기 무시) — 2P 세이브는 늘 비어 있음 */
+		GBASavedataForceType(&((struct GBA*) core->board)->memory.savedata, GBA_SAVEDATA_FORCE_NONE);
+	}
+	return true;
+}
+
+static void _freePlayers(void) {
+	int i;
+	for (i = DUAL_PLAYERS - 1; i >= 0; --i) {
+		struct DualPlayer* player = &players[i];
+		if (player->core) {
+			mCoreConfigDeinit(&player->core->config);
+			player->core->deinit(player->core);
+			player->core = NULL;
+		}
+		free(player->videoBuffer);
+		free(player->frameBuffer);
+		if (player->save) {
+			mappedMemoryFree(player->save, DUAL_SAVE_SIZE);
+		}
+		memset(player, 0, sizeof(*player));
+	}
+	GBASIOLockstepCoordinatorDeinit(&coordinator);
+	if (romData) {
+		mappedMemoryFree(romData, romSize);
+		romData = NULL;
+	}
+	if (p2SaveWritten) {
+		mappedMemoryFree(p2SaveWritten, DUAL_SAVE_SIZE);
+		p2SaveWritten = NULL;
+	}
+	if (p2RomData) {
+		mappedMemoryFree(p2RomData, p2RomSize);
+		p2RomData = NULL;
+	}
+	p2RomSize = 0;
+	p2RomCrc = 0;
+	hb_pair_on = false;
+	p2NoCart = false;
+	hb_nocart = false;
+}
+
+/* 1.5 손님: /tmp/hb_dual_p2rom(한 줄 = 2P 롬 경로, ZIP 이면 안의 .gba 하나)이 있으면 2P 게임기에 그 롬.
+ * 손님 도우미(hb_joinask)가 방장 받음 확인 뒤 막 쓴 파일만: 실행 명령에 --connect · 180초 안. */
+#define HB_P2ROM_FILE "/tmp/hb_dual_p2rom"
+#define HB_P2ROM_AGE 180
+static void _p2RomFromFile(void) {
+	struct stat st;
+	char line[1100];
+	if (stat(HB_P2ROM_FILE, &st) != 0) {
+		return;
+	}
+	if (!hb_launched_as_guest()) {
+		_log(RETRO_LOG_INFO, "2P 짝 롬 파일이 있지만 넷플레이 손님(--connect)이 아님 — 무시");
+		return;
+	}
+	long long age = (long long) time(NULL) - (long long) st.st_mtime;
+	if (!S_ISREG(st.st_mode) || st.st_size < 2 || st.st_size >= (off_t) sizeof(line) || age < -5 || age > HB_P2ROM_AGE) {
+		_log(RETRO_LOG_WARN, "2P 짝 롬 파일 형식 오류 · 오래됨(%lld초) — 무시", age);
+		return;
+	}
+	int fd = open(HB_P2ROM_FILE, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		return;
+	}
+	ssize_t n = read(fd, line, sizeof(line) - 1);
+	close(fd);
+	if (n < 2) {
+		return;
+	}
+	line[n] = '\0';
+	if (line[n - 1] == '\n') {
+		line[--n] = '\0';
+		if (n && line[n - 1] == '\r') {
+			line[--n] = '\0';
+		}
+	}
+	if (n < 2 || line[0] != '/' || strlen(line) != (size_t) n || strchr(line, '\n') || strchr(line, '\r')) {
+		_log(RETRO_LOG_WARN, "2P 짝 롬 파일 내용 오류 — 무시");
+		return;
+	}
+	const char* why = "";
+	size_t size = 0;
+	uint32_t crc = 0;
+	void* rom = hb_rom_load(line, &size, &crc, &why);
+	if (!rom) {
+		_log(RETRO_LOG_ERROR, "2P 짝 롬을 못 읽음(%s): %s — 같은 롬으로 켬(방장 짝 상태는 거절됨)", why, line);
+		return;
+	}
+	if (crc == (uint32_t) crc32(0L, (const Bytef*) romData, (uInt) romSize)) {
+		_log(RETRO_LOG_INFO, "2P 짝 롬이 1P 와 같은 롬 — 보통 두 대로 켬: %s", line);
+		mappedMemoryFree(rom, size);
+		return;
+	}
+	p2RomData = rom;
+	p2RomSize = size;
+	p2RomCrc = crc;
+	_log(RETRO_LOG_INFO, "2P 짝 롬: %s (CRC %08x, %u 바이트)", line, (unsigned) crc, (unsigned) size);
+}
+
+
+/* 1P의 CPU와 저장은 그대로 두고 케이블과 2P 전원만 다시 켠다. */
+static bool _ownSaveApply(const uint8_t* data, size_t size) {
+    int i;
+    if (!linkOn || size > DUAL_SAVE_SIZE) return false;
+    if (size && size != 512 && size != 8192 && size != 32768 &&
+        size != 65536 && size != 131072) return false;
+    for (i = 0; i < 2; i++) {
+        struct GBA* gba = players[i].core->board;
+        players[i].core->setPeripheral(players[i].core, mPERIPH_GBA_LINK_PORT, NULL);
+        mTimingDeschedule(&gba->timing, &gba->sio.completeEvent);
+        gba->sio.siocnt &= ~0x80;
+        gba->memory.io[GBA_REG_SIOCNT >> 1] = gba->sio.siocnt;
+    }
+    GBASIOLockstepCoordinatorDeinit(&coordinator);
+    GBASIOLockstepCoordinatorInit(&coordinator);
+    memset(players[1].save, 0xFF, DUAL_SAVE_SIZE);
+    memcpy(players[1].save, data, size);
+    players[1].core->reset(players[1].core);
+    for (i = 0; i < 2; i++) {
+        players[i].driver.lockstepId = 0;
+        GBASIOLockstepCoordinatorAttach(&coordinator, &players[i].driver);
+        players[i].core->setPeripheral(players[i].core, mPERIPH_GBA_LINK_PORT, &players[i].driver.d);
+        players[i].link = TableLookup(&coordinator.players, players[i].driver.lockstepId);
+    }
+    players[1].saveUpdated = false;
+    memset(players[1].frameBuffer, 0, DUAL_WIDTH * DUAL_HEIGHT * sizeof(mColor));
+    _log(RETRO_LOG_INFO, "손님 자기 세이브 받음: %u 바이트, 2P 전원과 케이블 초기화", (unsigned)size);
+    return true;
+}
+
+static void _freePlayer(int i) {
+	struct DualPlayer* player = &players[i];
+	if (player->core) {
+		mCoreConfigDeinit(&player->core->config);
+		player->core->deinit(player->core);
+	}
+	free(player->videoBuffer);
+	free(player->frameBuffer);
+	if (player->save) {
+		mappedMemoryFree(player->save, DUAL_SAVE_SIZE);
+	}
+	memset(player, 0, sizeof(*player));
+}
+
+/* 1.5 방장 짝 게임: 1P 의 CPU · 저장은 그대로, 2P 게임기를 짝 롬으로 처음부터 다시 만들고(손님 기기가
+ * 켤 때 만드는 것과 같은 _setupPlayer) 손님 세이브를 넣는다. 성공하면 rom 은 코어 것. */
+static bool _ownSaveApplyPair(const uint8_t* data, size_t size, void* rom, size_t romBytes, uint32_t crc) {
+	int i;
+	if (!linkOn || size > DUAL_SAVE_SIZE || !rom || !romBytes) {
+		return false;
+	}
+	if (size && size != 512 && size != 8192 && size != 32768 && size != 65536 && size != 131072) {
+		return false;
+	}
+	struct VFile* probe = VFileFromMemory(rom, romBytes);
+	bool isRom = probe && GBAIsROM(probe);
+	if (probe) {
+		probe->close(probe);
+	}
+	if (!isRom) {
+		_log(RETRO_LOG_ERROR, "짝 롬이 GBA 롬이 아님 — 2P 그대로");
+		return false;
+	}
+	for (i = 0; i < 2; i++) {
+		struct GBA* gba = players[i].core->board;
+		players[i].core->setPeripheral(players[i].core, mPERIPH_GBA_LINK_PORT, NULL);
+		mTimingDeschedule(&gba->timing, &gba->sio.completeEvent);
+		gba->sio.siocnt &= ~0x80;
+		gba->memory.io[GBA_REG_SIOCNT >> 1] = gba->sio.siocnt;
+	}
+	GBASIOLockstepCoordinatorDeinit(&coordinator);
+	GBASIOLockstepCoordinatorInit(&coordinator);
+	_freePlayer(1);
+	void* oldRom = p2RomData;
+	size_t oldRomSize = p2RomSize;
+	p2RomData = rom;
+	p2RomSize = romBytes;
+	/* 켤 때와 같은 순서: 1P 케이블 먼저, 그다음 2P 를 만들며 케이블 */
+	players[0].driver.lockstepId = 0;
+	GBASIOLockstepCoordinatorAttach(&coordinator, &players[0].driver);
+	players[0].core->setPeripheral(players[0].core, mPERIPH_GBA_LINK_PORT, &players[0].driver.d);
+	players[0].link = TableLookup(&coordinator.players, players[0].driver.lockstepId);
+	bool ok = _setupPlayer(1, biosPathValid ? biosPathSaved : NULL, &optsSaved);
+	if (!ok) {
+		/* 거의 없는 일(메모리 부족): 2P 를 원래 롬으로 다시 만들어 코어는 계속 돌게 */
+		_log(RETRO_LOG_ERROR, "짝 롬으로 2P 게임기를 못 켬 — 원래 롬으로 되돌림");
+		if (players[1].core) {
+			players[1].core->setPeripheral(players[1].core, mPERIPH_GBA_LINK_PORT, NULL);
+		}
+		_freePlayer(1);
+		players[0].core->setPeripheral(players[0].core, mPERIPH_GBA_LINK_PORT, NULL);
+		GBASIOLockstepCoordinatorDeinit(&coordinator);
+		GBASIOLockstepCoordinatorInit(&coordinator);
+		players[0].driver.lockstepId = 0;
+		GBASIOLockstepCoordinatorAttach(&coordinator, &players[0].driver);
+		players[0].core->setPeripheral(players[0].core, mPERIPH_GBA_LINK_PORT, &players[0].driver.d);
+		players[0].link = TableLookup(&coordinator.players, players[0].driver.lockstepId);
+		p2RomData = oldRom;
+		p2RomSize = oldRomSize;
+		if (!_setupPlayer(1, biosPathValid ? biosPathSaved : NULL, &optsSaved)) {
+			_log(RETRO_LOG_ERROR, "2P 게임기를 다시 켜지 못함");
+		}
+		return false;
+	}
+	if (oldRom) {
+		mappedMemoryFree(oldRom, oldRomSize);
+	}
+	p2RomCrc = crc;
+	memcpy(players[1].save, data, size);
+	players[1].saveUpdated = false;
+	/* 방장 2P 칸(<1P 롬>.p2.srm)은 이 판에서 읽지도 쓰지도 않음(2P 가 다른 게임) */
+	p2SavePath[0] = '\0';
+	hb_pair_on = true;
+	hb_pair_crc = crc;
+	hb_own_p2crc = crc;
+	_log(RETRO_LOG_INFO, "짝 게임: 2P 롬 바꿈(CRC %08x, %u 바이트) · 손님 세이브 %u 바이트 · 2P 처음부터",
+	     (unsigned) crc, (unsigned) romBytes, (unsigned) size);
+	return true;
+}
+
+bool retro_load_game(const struct retro_game_info* game) {
+	if (!game || !game->data || !game->size) {
+		_log(RETRO_LOG_ERROR, "needs the ROM in memory");
+		return false;
+	}
+	memset(players, 0, sizeof(players));
+	memset(&stats, 0, sizeof(stats));
+	memset(seenStates, 0, sizeof(seenStates));
+	seenNext = 0;
+	outsideLoads = 0;
+	biosLoaded = false;
+	stats.magic = 0x54534448; /* "HDST" */
+	stats.version = 1;
+	stats.p[0].playerId = -1;
+	stats.p[1].playerId = -1;
+
+	romSize = game->size;
+	romData = anonymousMemoryMap(romSize);
+	if (!romData) {
+		return false;
+	}
+	memcpy(romData, game->data, romSize);
+
+	struct mCoreOptions opts = {
+		.useBios = true,
+		.skipBios = false,
+		.volume = 0x100,
+	};
+	const char* value = _getVariable("mgba_dual_use_bios");
+	if (value) {
+		opts.useBios = strcmp(value, "ON") == 0;
+	}
+	value = _getVariable("mgba_dual_skip_bios");
+	if (value) {
+		opts.skipBios = strcmp(value, "ON") == 0;
+	}
+	value = _getVariable("mgba_dual_link");
+	linkOn = !(value && strcmp(value, "off") == 0);
+	_readScreenOption();
+	screenFileReset();
+	screenFileRefresh();
+	_applyScreen();
+
+	const char* sysDir = NULL;
+	char biosPath[PATH_MAX];
+	const char* bios = NULL;
+	if (environCallback(RETRO_ENVIRONMENT_GET_SYSTEM_DIRECTORY, &sysDir) && sysDir) {
+		snprintf(biosPath, sizeof(biosPath), "%s%s%s", sysDir, PATH_SEP, "gba_bios.bin");
+		bios = biosPath;
+	}
+
+	/* 1.5: 2P 를 다시 만들 때(짝 게임 방장) 켤 때와 같은 바이오스 · 설정을 쓰도록 남겨 둠 */
+	biosPathValid = bios != NULL;
+	snprintf(biosPathSaved, sizeof(biosPathSaved), "%s", bios ? bios : "");
+	optsSaved = opts;
+	hb_pair_on = false;
+	hb_logger = _log;
+	/* 1.6 싱글팩: 켤 때 한 번(게임별 .opt). 케이블이 켜져 있고 바이오스를 쓸 수 있을 때만 — 아니면 기록만 */
+	p2NoCart = false;
+	value = _getVariable("mgba_dual_p2_nocart");
+	if (value && strcmp(value, "enabled") == 0) {
+		if (!linkOn) {
+			_log(RETRO_LOG_INFO, "2P 팩 없음 옵션: 케이블 꺼짐(혼자) — 쓰지 않음");
+		} else if (!bios || !opts.useBios) {
+			_log(RETRO_LOG_WARN, "2P 팩 없음 옵션: 바이오스 %s — 2P 를 팩으로 켬(싱글팩 같이하기 안 됨)",
+			     opts.useBios ? "폴더 없음" : "끔(mgba_dual_use_bios)");
+		} else {
+			p2NoCart = true;
+		}
+	}
+	hb_nocart = false;
+	if (linkOn && !p2NoCart) {
+		_p2RomFromFile();
+	}
+
+	GBASIOLockstepCoordinatorInit(&coordinator);
+	p2SaveWritten = linkOn ? anonymousMemoryMap(DUAL_SAVE_SIZE) : NULL;
+	if (linkOn && !p2SaveWritten) {
+		_freePlayers();
+		return false;
+	}
+	p2SaveWrittenSize = 0;
+	int i;
+	for (i = 0; i < _activePlayers(); ++i) {
+		if (!_setupPlayer(i, bios, &opts)) {
+			_log(RETRO_LOG_ERROR, "could not set up GBA #%d", i + 1);
+			_freePlayers();
+			return false;
+		}
+	}
+	hb_pair_on = p2RomData != NULL;
+	hb_pair_crc = p2RomCrc;
+	/* 1.6: 2P 를 실제로 팩 없이 켰을 때만(바이오스를 못 넣어 팩으로 켰으면 보통 두 대) */
+	hb_nocart = linkOn && p2NoCart;
+	hb_own_init(game->data, game->size, 1, linkOn ? DUAL_SAVE_SIZE : 0);
+	p2SavePath[0] = '\0';
+	if (linkOn) {
+		_setP2SavePath(game);
+		if (p2NoCart) {
+			/* 싱글팩: 2P 에 팩(세이브)이 없음 — 2P 칸(<롬>.p2.srm)은 읽지도 쓰지도 않음 */
+			p2SavePath[0] = '\0';
+			_log(RETRO_LOG_INFO, "2P 팩 없음: 2P 게임기를 롬 없이 바이오스로 켬(싱글팩 받기) — 2P 칸 · 손님 되쓰기 없음");
+		} else if (p2RomData) {
+			/* 짝 게임 손님: 2P 는 방장 상태로 받음 — 1P 롬 이름의 2P 칸은 읽지도 쓰지도 않음 */
+			p2SavePath[0] = '\0';
+		} else {
+			_loadP2Save();
+		}
+	}
+
+	void* state = NULL;
+	size_t size = 0;
+	coreStateSize = players[0].core->stateSize(players[0].core);
+	if (linkOn) {
+		players[0].driver.d.saveState(&players[0].driver.d, &state, &size);
+	}
+	free(state);
+	driverStateSize = size;
+
+	audioConverterReset(&audioConverter, players[screenPlayer].core->audioSampleRate(players[screenPlayer].core));
+	gameLoaded = true;
+	_log(RETRO_LOG_INFO, "loaded: %d GBA(s), link %s, screen %dP, BIOS %s, state %u bytes",
+	     _activePlayers(), linkOn ? "on" : "off", screenPlayer + 1, biosLoaded ? "file" : "built-in (HLE)", (unsigned) retro_serialize_size());
+	return true;
+}
+
+bool retro_load_game_special(unsigned game_type, const struct retro_game_info* info, size_t num_info) {
+	UNUSED(game_type);
+	UNUSED(info);
+	UNUSED(num_info);
+	return false;
+}
+
+void retro_unload_game(void) {
+	if (!gameLoaded) {
+		return;
+	}
+	/* 저장 종류 판별 전 빠른 종료는 보냈던 원본 길이를 지킨다. */
+	size_t ownSize = linkOn ? _saveSize(1) : 0;
+	if (linkOn && ((struct GBA*)players[1].core->board)->memory.savedata.type == GBA_SAVEDATA_AUTODETECT
+	    && hb_own_save_hint && hb_own_save_hint <= ownSize) ownSize = hb_own_save_hint;
+	hb_own_export(linkOn ? players[1].save : NULL, ownSize);
+	_writeP2Save(false);
+	gameLoaded = false;
+	_freePlayers();
+}
+
+void retro_reset(void) {
+	int i;
+	for (i = 0; i < _activePlayers(); ++i) {
+		players[i].core->reset(players[i].core);
+	}
+}
+
+static uint16_t _readKeys(unsigned port) {
+	uint16_t keys = 0;
+	size_t i;
+	if (useBitmasks) {
+		int16_t mask = inputCallback(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_MASK);
+		for (i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= ((mask >> keymap[i]) & 1) << i;
+		}
+	} else {
+		for (i = 0; i < sizeof(keymap) / sizeof(*keymap); ++i) {
+			keys |= (!!inputCallback(port, RETRO_DEVICE_JOYPAD, 0, keymap[i])) << i;
+		}
+	}
+	return keys;
+}
+
+/* Interleave run-loop slices of the awake cores until core 0 ends a frame.
+ * Identical on every peer: it only depends on emulation state. */
+static void _runLinkedFrame(void) {
+	struct mCore* reference = players[0].core;
+	uint32_t target = reference->frameCounter(reference) + 1;
+	unsigned slices = 0;
+	while (reference->frameCounter(reference) != target) {
+		bool progressed = false;
+		int i;
+		for (i = 0; i < _activePlayers(); ++i) {
+			if (players[i].link->asleep) {
+				continue;
+			}
+			if (i == 0 && reference->frameCounter(reference) == target) {
+				continue;
+			}
+			players[i].core->runLoop(players[i].core);
+			progressed = true;
+			++slices;
+		}
+		if (!progressed || slices > DUAL_MAX_SLICES) {
+			if (stats.stalls < 8) {
+				_log(RETRO_LOG_ERROR, "link stalled (%s) at frame %u", progressed ? "slice limit" : "both asleep", stats.frames);
+			}
+			++stats.stalls;
+			break;
+		}
+	}
+	stats.slicesLastFrame = slices;
+	if (slices > stats.slicesMax) {
+		stats.slicesMax = slices;
+	}
+}
+
+static void _outputAudio(bool enabled) {
+	int i;
+	for (i = 0; i < _activePlayers(); ++i) {
+		struct mAudioBuffer* buffer = players[i].core->getAudioBuffer(players[i].core);
+		if (i != screenPlayer) {
+			mAudioBufferClear(buffer);
+			continue;
+		}
+		unsigned rate = players[i].core->audioSampleRate(players[i].core);
+		if (rate != audioConverter.inputRate) {
+			audioConverterReset(&audioConverter, rate);
+		}
+		while (true) {
+			size_t read = mAudioBufferRead(buffer, audioSamples, DUAL_AUDIO_CHUNK);
+			if (!read) {
+				break;
+			}
+			if (!enabled) {
+				continue;
+			}
+			size_t produced = audioConverterProcess(&audioConverter, audioSamples, read, audioOut);
+			if (produced) {
+				audioCallback(audioOut, produced);
+			}
+		}
+	}
+}
+
+void retro_run(void) {
+	hb_own_poll(linkOn, _ownSaveApply, _ownSaveApplyPair);
+	inputPollCallback();
+	bool updated = false;
+	if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated) && updated) {
+		_readScreenOption();
+	}
+
+	screenFileTick();
+	_applyScreen();
+
+	int av = RETRO_AV_ENABLE_VIDEO | RETRO_AV_ENABLE_AUDIO;
+	if (!environCallback(RETRO_ENVIRONMENT_GET_AUDIO_VIDEO_ENABLE, &av)) {
+		av = RETRO_AV_ENABLE_VIDEO | RETRO_AV_ENABLE_AUDIO;
+	}
+	bool videoOn = av & RETRO_AV_ENABLE_VIDEO;
+
+	int i;
+	for (i = 0; i < _activePlayers(); ++i) {
+		struct mCore* core = players[i].core;
+		core->setKeys(core, _readKeys(i));
+		/* Rendering is invisible to emulation and not serialized: only draw what is shown */
+		bool draw = renderBoth || (videoOn && i == screenPlayer);
+		((struct GBA*) core->board)->video.frameskipCounter = draw ? 0 : 0x10000;
+	}
+
+	if (linkOn) {
+		_runLinkedFrame();
+	} else {
+		players[0].core->runFrame(players[0].core);
+	}
+	++stats.frames;
+	for (i = 0; i < _activePlayers(); ++i) {
+		stats.p[i].frameCounter = players[i].core->frameCounter(players[i].core);
+	}
+
+	if (videoOn) {
+		const mColor* frame = screenPlayer == 0 ? players[0].videoBuffer : players[1].frameBuffer;
+		videoCallback(frame, DUAL_WIDTH, DUAL_HEIGHT, DUAL_WIDTH * sizeof(mColor));
+	} else {
+		videoCallback(NULL, DUAL_WIDTH, DUAL_HEIGHT, DUAL_WIDTH * sizeof(mColor));
+	}
+	_outputAudio(av & RETRO_AV_ENABLE_AUDIO);
+
+	if (linkOn && players[1].saveUpdated) {
+		players[1].saveUpdated = false;
+		_writeP2Save(false);
+	}
+	players[0].saveUpdated = false;
+	/* 손님 자기 세이브: 장 번호(상태에 들어감) · 확인된 2P 의 중간 저장 */
+	if (linkOn) {
+		size_t ownSize = _saveSize(1);
+		if (((struct GBA*) players[1].core->board)->memory.savedata.type == GBA_SAVEDATA_AUTODETECT
+		    && hb_own_save_hint && hb_own_save_hint <= ownSize) {
+			ownSize = hb_own_save_hint;
+		}
+		hb_own_tick(players[1].save, ownSize);
+	}
+}
+
+/* --- savestates --- */
+
+static size_t _playerStateSize(void) {
+	return coreStateSize + driverStateSize + DUAL_SAVE_SIZE + sizeof(struct DualExtra);
+}
+
+size_t retro_serialize_size(void) {
+	if (!gameLoaded) {
+		return 0;
+	}
+	return sizeof(struct DualStateHeader) + _activePlayers() * _playerStateSize();
+}
+
+static void _saveExtra(struct GBA* gba, struct DualExtra* extra) {
+	const struct GBAAudioFIFO* fifos[2] = { &gba->audio.chA, &gba->audio.chB };
+	int i, j;
+	for (i = 0; i < 2; ++i) {
+		for (j = 0; j < GBA_AUDIO_FIFO_SIZE; ++j) {
+			STORE_32LE(fifos[i]->fifo[j], 0, &extra->fifo[i].fifo[j]);
+		}
+		STORE_32LE(fifos[i]->fifoWrite, 0, &extra->fifo[i].write);
+		STORE_32LE(fifos[i]->fifoRead, 0, &extra->fifo[i].read);
+		STORE_32LE(fifos[i]->internalRemaining, 0, &extra->fifo[i].internalRemaining);
+	}
+	for (i = 0; i < 4; ++i) {
+		const struct GBADMA* dma = &gba->memory.dma[i];
+		STORE_32LE(dma->reg, 0, &extra->dma[i].reg);
+		STORE_32LE(dma->cycles, 0, &extra->dma[i].cycles);
+		STORE_32LE(dma->sourceOffset, 0, &extra->dma[i].sourceOffset);
+		STORE_32LE(dma->destOffset, 0, &extra->dma[i].destOffset);
+	}
+}
+
+static void _loadExtra(struct GBA* gba, const struct DualExtra* extra) {
+	struct GBAAudioFIFO* fifos[2] = { &gba->audio.chA, &gba->audio.chB };
+	int i, j;
+	for (i = 0; i < 2; ++i) {
+		for (j = 0; j < GBA_AUDIO_FIFO_SIZE; ++j) {
+			LOAD_32LE(fifos[i]->fifo[j], 0, &extra->fifo[i].fifo[j]);
+		}
+		int32_t value;
+		LOAD_32LE(value, 0, &extra->fifo[i].write);
+		fifos[i]->fifoWrite = value;
+		LOAD_32LE(value, 0, &extra->fifo[i].read);
+		fifos[i]->fifoRead = value;
+		LOAD_32LE(value, 0, &extra->fifo[i].internalRemaining);
+		fifos[i]->internalRemaining = value;
+	}
+	for (i = 0; i < 4; ++i) {
+		struct GBADMA* dma = &gba->memory.dma[i];
+		uint32_t reg;
+		LOAD_32LE(reg, 0, &extra->dma[i].reg);
+		dma->reg = reg;
+		LOAD_32LE(dma->cycles, 0, &extra->dma[i].cycles);
+		int32_t value;
+		LOAD_32LE(value, 0, &extra->dma[i].sourceOffset);
+		dma->sourceOffset = value;
+		LOAD_32LE(value, 0, &extra->dma[i].destOffset);
+		dma->destOffset = value;
+	}
+}
+
+static uint64_t _hashState(const void* data, size_t size) {
+	const uint8_t* bytes = data;
+	uint64_t hash = 0xCBF29CE484222325ULL;
+	size_t i;
+	for (i = 0; i < size; ++i) {
+		hash = (hash ^ bytes[i]) * 0x100000001B3ULL;
+	}
+	return hash;
+}
+
+static void _rememberState(uint64_t hash) {
+	seenStates[seenNext] = hash;
+	seenNext = (seenNext + 1) % DUAL_SEEN_STATES;
+}
+
+static bool _stateSeen(uint64_t hash) {
+	unsigned i;
+	for (i = 0; i < DUAL_SEEN_STATES; ++i) {
+		if (seenStates[i] == hash) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool retro_serialize(void* data, size_t size) {
+	size_t total = retro_serialize_size();
+	if (!total || size < total) {
+		return false;
+	}
+	/* Zero first: mGBA leaves reserved and unused fields untouched, and
+	 * netplay compares CRCs of the whole buffer between peers */
+	memset(data, 0, total);
+	struct DualStateHeader* header = data;
+	STORE_32LE(DUAL_STATE_MAGIC, 0, &header->magic);
+	bool pair = linkOn && p2RomData;
+	bool noCart = linkOn && p2NoCart;
+	STORE_32LE((hb_has_token() ? 3 : DUAL_STATE_VERSION) | (linkOn ? DUAL_STATE_LINK14 : 0) | (pair ? DUAL_STATE_PAIR15 : 0)
+	           | (noCart ? DUAL_STATE_NOCART16 : 0), 0, &header->version);
+	memcpy(header->reserved, hb_own_token, 16);
+	hb_put32((uint8_t*)header->reserved + 16, hb_own_save_hint);
+	hb_put32((uint8_t*)header->reserved + 20, hb_has_token() ? hb_own_frame : 0);
+	if (pair) {
+		hb_put32((uint8_t*)header->reserved + DUAL_PAIR_CRC_AT, p2RomCrc);
+	}
+	STORE_32LE(_activePlayers(), 0, &header->players);
+	STORE_32LE(coreStateSize, 0, &header->coreStateSize);
+	STORE_32LE(driverStateSize, 0, &header->driverStateSize);
+	STORE_32LE(DUAL_SAVE_SIZE, 0, &header->saveSize);
+	STORE_32LE(sizeof(struct DualExtra), 0, &header->extraSize);
+
+	uint8_t* cursor = (uint8_t*) data + sizeof(*header);
+	int i;
+	for (i = 0; i < _activePlayers(); ++i) {
+		struct DualPlayer* player = &players[i];
+		if (!player->core->saveState(player->core, cursor)) {
+			return false;
+		}
+		if (linkOn) {
+			/* 1.4.1: 출력용 소리 샘플(currentSamples)은 게임 진행에 안 쓰이는데 되감기 뒤 다시 그린 값이
+			 * 몇 칸 달라질 수 있어(매지컬 베케이션 12_A) 넷플레이 상태 대조를 흔듦 → 두 대 상태에서는 0 */
+			memset(cursor + offsetof(struct GBASerializedState, currentSamples), 0,
+			       sizeof(((struct GBASerializedState*) 0)->currentSamples));
+		}
+		cursor += coreStateSize;
+
+		if (linkOn) {
+			void* blob = NULL;
+			size_t blobSize = 0;
+			player->driver.d.saveState(&player->driver.d, &blob, &blobSize);
+			if (!blob || blobSize != driverStateSize) {
+				free(blob);
+				return false;
+			}
+			memcpy(cursor, blob, blobSize);
+			free(blob);
+			cursor += driverStateSize;
+		}
+
+		memcpy(cursor, player->save, DUAL_SAVE_SIZE);
+		cursor += DUAL_SAVE_SIZE;
+
+		_saveExtra(player->core->board, (struct DualExtra*) cursor);
+		cursor += sizeof(struct DualExtra);
+	}
+	if (traceFile) {
+		_rememberState(_hashState(data, total));
+	}
+	return true;
+}
+
+bool retro_unserialize(const void* data, size_t size) {
+	size_t total = retro_serialize_size();
+	if (!total || size < total) {
+		return false;
+	}
+	if (traceFile) {
+		uint64_t hash = _hashState(data, total);
+		if (!_stateSeen(hash)) {
+			++outsideLoads;
+			_rememberState(hash);
+			fprintf(traceFile, "f=%u state from outside #%u (netplay join or CRC resync)\n", stats.frames, outsideLoads);
+			fflush(traceFile);
+			_log(RETRO_LOG_INFO, "state from outside #%u at frame %u (netplay join or CRC resync)", outsideLoads, stats.frames);
+		}
+	}
+	const struct DualStateHeader* header = data;
+	uint32_t value;
+	LOAD_32LE(value, 0, &header->magic);
+	if (value != DUAL_STATE_MAGIC) {
+		_log(RETRO_LOG_ERROR, "not an mGBA Dual state");
+		return false;
+	}
+	LOAD_32LE(value, 0, &header->version);
+	if (!!(value & DUAL_STATE_LINK14) != linkOn) {
+		/* 두 대 상태인데 1.4 표시가 없음 = 1.3 이하 코어가 만든 상태(넷플레이 상대가 옛 판) */
+		_log(RETRO_LOG_ERROR, "state from a different link-timing version (1.3 vs 1.4); update both devices");
+		return false;
+	}
+	/* 1.5: 짝 게임 상태는 같은 2P 짝 롬을 켠 쪽만 읽음(짝 아닌 상태 ↔ 짝 코어도 서로 거절) */
+	bool pair = linkOn && p2RomData;
+	if (!!(value & DUAL_STATE_PAIR15) != pair) {
+		_log(RETRO_LOG_ERROR, "%s", pair ? "state is not a pair-game state (2P ROM differs); both sides must use the same pair"
+		                                 : "pair-game state (2P has another ROM); load the same pair or update both devices to 1.5");
+		return false;
+	}
+	if (pair && hb_u32((const uint8_t*)header->reserved + DUAL_PAIR_CRC_AT) != p2RomCrc) {
+		_log(RETRO_LOG_ERROR, "pair-game state with a different 2P ROM (CRC %08x, mine %08x)",
+		     (unsigned) hb_u32((const uint8_t*)header->reserved + DUAL_PAIR_CRC_AT), (unsigned) p2RomCrc);
+		return false;
+	}
+	/* 1.6: 2P 팩 없음(싱글팩) 상태는 2P 를 팩 없이 켠 쪽만 읽음(1.5 · 팩 있는 2P 와 서로 거절) */
+	bool noCart = linkOn && p2NoCart;
+	if (!!(value & DUAL_STATE_NOCART16) != noCart) {
+		_log(RETRO_LOG_ERROR, "%s", noCart ? "state has a 2P cartridge; both sides need mgba_dual_p2_nocart (and the BIOS)"
+		                                   : "2P-without-cartridge (single-pak) state; set mgba_dual_p2_nocart on both devices (1.6)");
+		return false;
+	}
+	value &= ~(DUAL_STATE_LINK14 | DUAL_STATE_PAIR15 | DUAL_STATE_NOCART16);
+	if (value != DUAL_STATE_VERSION && value != 2 && value != 3) {
+		return false;
+	}
+	LOAD_32LE(value, 0, &header->players);
+	if (value != (uint32_t) _activePlayers()) {
+		_log(RETRO_LOG_ERROR, "state link mode differs; reload content with matching mgba_dual_link");
+		return false;
+	}
+	LOAD_32LE(value, 0, &header->saveSize);
+	if (value != DUAL_SAVE_SIZE) {
+		return false;
+	}
+	LOAD_32LE(value, 0, &header->extraSize);
+	if (value != sizeof(struct DualExtra)) {
+		return false;
+	}
+	LOAD_32LE(value, 0, &header->coreStateSize);
+	if (value != coreStateSize) {
+		return false;
+	}
+	LOAD_32LE(value, 0, &header->driverStateSize);
+	if (value != driverStateSize) {
+		return false;
+	}
+
+	uint32_t ownVersion;
+	LOAD_32LE(ownVersion, 0, &header->version);
+	ownVersion &= ~(DUAL_STATE_LINK14 | DUAL_STATE_PAIR15 | DUAL_STATE_NOCART16);
+	if (ownVersion >= 2 && hb_u32((const uint8_t*)header->reserved + 16) > DUAL_SAVE_SIZE) return false;
+	const uint8_t* base = (const uint8_t*) data + sizeof(*header);
+	size_t stride = _playerStateSize();
+	int i;
+	/* 1) cores: a core load rebuilds its timing list */
+	for (i = 0; i < _activePlayers(); ++i) {
+		const uint8_t* cursor = base + i * stride;
+		if (!players[i].core->loadState(players[i].core, cursor)) {
+			_log(RETRO_LOG_ERROR, "GBA #%d state rejected", i + 1);
+			return false;
+		}
+	}
+	/* 2) save memory, exactness extras */
+	for (i = 0; i < _activePlayers(); ++i) {
+		const uint8_t* cursor = base + i * stride + coreStateSize + driverStateSize;
+		memcpy(players[i].save, cursor, DUAL_SAVE_SIZE);
+		_loadExtra(players[i].core->board, (const struct DualExtra*) (cursor + DUAL_SAVE_SIZE));
+	}
+	/* 3) lockstep drivers re-schedule into the rebuilt timing lists
+	 *    (player 0's blob also restores the shared coordinator) */
+	for (i = 0; linkOn && i < DUAL_PLAYERS; ++i) {
+		const uint8_t* cursor = base + i * stride + coreStateSize;
+		if (!players[i].driver.d.loadState(&players[i].driver.d, cursor, driverStateSize)) {
+			_log(RETRO_LOG_ERROR, "link state %d rejected", i + 1);
+			return false;
+		}
+	}
+	memset(hb_own_token, 0, 16);
+	hb_own_save_hint = 0;
+	if (ownVersion >= 2) {
+		memcpy(hb_own_token, header->reserved, 16);
+		hb_own_save_hint = hb_u32((const uint8_t*)header->reserved + 16);
+	}
+	hb_own_restored(ownVersion == 3 ? hb_u32((const uint8_t*)header->reserved + 20) : 0);
+	return true;
+}
