+static int hb_role;                 /* 0 모름 · 2 = 2P 확인 · -1 = 2P 아님(관전 · 다른 번호 · 나감 · 오류) */
+static char hb_tee_line[1024];
+static size_t hb_tee_used;
+static bool hb_tee_overflow;
+/* 코어의 기록 함수(레트로아크 기록 → 기기 es_launch_stderr.log). 스레드에서는 부르지 않는다. */
+static void (*hb_logger)(enum retro_log_level, const char *, ...);
+static int hb_role_logged;
+static bool hb_token_logged;
+#define HB_LOG(level, ...) do { if (hb_logger) hb_logger(level, __VA_ARGS__); } while (0)
+
+static uint32_t hb_u32(const uint8_t *p)
+{
+   return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+      ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void hb_put32(uint8_t *p, uint32_t value)
+{
+   unsigned i;
+   for (i = 0; i < 4; i++) p[i] = (uint8_t)(value >> (8 * i));
+}
+
+static uint64_t hb_millis(void)
+{
+   struct timespec t;
+   if (clock_gettime(CLOCK_MONOTONIC, &t)) return 0;
+   return (uint64_t)t.tv_sec * 1000 + (uint64_t)t.tv_nsec / 1000000;
+}
+
+static bool hb_has_token(void)
+{
+   unsigned i;
+   for (i = 0; i < sizeof(hb_own_token); i++)
+      if (hb_own_token[i]) return true;
+   return false;
+}
+
+static bool hb_atomic(const char *name, const void *data, size_t size)
+{
+   char path[512];
+   if ((size_t)snprintf(path, sizeof(path), HB_OWN_DIR "/%s", name) >= sizeof(path)) return false;
+   return hb_store_path(path, (const uint8_t *)data, size);
+}
+
+static int hb_role_get(void)
+{
+   return __atomic_load_n(&hb_role, __ATOMIC_SEQ_CST);
+}
+
+static void hb_role_set(int value)
+{
+   /* -1 은 끝까지 유지(한 번이라도 2P 가 아니었으면 되쓰기 안 함) */
+   if (value == 2) {
+      int expected = 0;
+      __atomic_compare_exchange_n(&hb_role, &expected, 2, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+   } else {
+      __atomic_store_n(&hb_role, -1, __ATOMIC_SEQ_CST);
+   }
+}
+
+static bool hb_starts(const char *text, const char *prefix)
+{
+   return !strncmp(text, prefix, strlen(prefix));
+}
+
+/* 레트로아크 1.22.2 넷플레이 문구(영어 · 한국어). 다른 사람 문구('<이름> 사용자가 …', '<이름> has joined …')는 보지 않는다. */
+static void hb_role_parse(const char *line)
+{
+   const char *m = strstr(line, "[Netplay] ");
+   unsigned player = 0;
+   int end = 0;
+   if (!m) return;
+   m += strlen("[Netplay] ");
+   if ((sscanf(m, "You have joined as player %u%n", &player, &end) == 1 && end > 0) ||
+       (sscanf(m, "%u 플레이어로 입장했습니다%n", &player, &end) == 1 && end > 0)) {
+      hb_role_set(player == 2 ? 2 : -1);
+      return;
+   }
+   if (hb_starts(m, "You have left the game") || hb_starts(m, "게임을 나왔습니다") ||
+       hb_starts(m, "You have joined with input devices") ||
+       (strstr(m, "입력장치로 접속했습니다") && !strstr(m, "사용자가")) ||
+       hb_starts(m, "There are no free player slots") || hb_starts(m, "여유 플레이어 슬롯이 없습니다") ||
+       hb_starts(m, "The input devices requested are not available") ||
+       hb_starts(m, "입력장치 요청을 사용할 수 없습니다") ||
+       hb_starts(m, "Cannot switch to play mode") || hb_starts(m, "플레이 모드로 전환하지 못했습니다") ||
+       hb_starts(m, "You do not have permission to play") || hb_starts(m, "플레이 권한이 없습니다"))
+      hb_role_set(-1);
+}
+
+static void hb_tee_feed(const char *data, size_t size)
+{
+   size_t i;
+   for (i = 0; i < size; i++) {
+      if (data[i] == '\n') {
+         hb_tee_line[hb_tee_used] = 0;
+         if (!hb_tee_overflow) hb_role_parse(hb_tee_line);
+         hb_tee_used = 0;
+         hb_tee_overflow = false;
+      } else if (hb_tee_used + 1 < sizeof(hb_tee_line)) {
+         hb_tee_line[hb_tee_used++] = data[i];
+      } else {
+         hb_tee_overflow = true;   /* 아주 긴 줄은 넷플레이 문구가 아니다 — 버림 */
+      }
+   }
+}
+
+/* stderr 로 들어온 것을 원래 대상(에뮬 실행기 파이프 · 시험 기록 파일)에 그대로 넘기며 줄을 본다.
+ * 비정상으로 끝나야 하면 먼저 stderr 를 원래대로 돌려 레트로아크가 막히지 않게 한다. */
+static void *hb_tee_main(void *arg)
+{
+   char buf[4096];
+   sigset_t set;
+   bool broken = false;
+   (void)arg;
+   sigemptyset(&set);
+   sigaddset(&set, SIGPIPE);
+   pthread_sigmask(SIG_BLOCK, &set, NULL);
+   for (;;) {
+      struct pollfd p;
+      int r;
+      ssize_t n;
+      p.fd = hb_tee_rd;
+      p.events = POLLIN;
+      p.revents = 0;
+      r = poll(&p, 1, 100);
+      if (r < 0) {
+         if (errno == EINTR) continue;
+         broken = true;
+         break;
+      }
+      if (r == 0) {
+         if (hb_tee_stop) break;
+         continue;
+      }
+      n = read(hb_tee_rd, buf, sizeof(buf));
+      if (n < 0) {
+         if (errno == EINTR || errno == EAGAIN) continue;
+         broken = true;
+         break;
+      }
+      if (n == 0) break;
+      hb_write_all(hb_tee_saved, (const uint8_t *)buf, (size_t)n);
+      hb_tee_feed(buf, (size_t)n);
+   }
+   if (broken) {
+      dup2(hb_tee_saved, 2);
+      hb_role_set(-1);
+   }
+   return NULL;
+}
+
+static void hb_tee_start(void)
+{
+   int fds[2], saved, flags;
+   if (hb_tee_on) return;
+   if (pipe(fds)) return;
+   fcntl(fds[0], F_SETFD, FD_CLOEXEC);
+   fcntl(fds[1], F_SETFD, FD_CLOEXEC);
+   saved = fcntl(2, F_DUPFD, 3);
+   if (saved < 0) {
+      close(fds[0]);
+      close(fds[1]);
+      return;
+   }
+   fcntl(saved, F_SETFD, FD_CLOEXEC);
+   flags = fcntl(fds[0], F_GETFL);
+   if (flags >= 0) fcntl(fds[0], F_SETFL, flags | O_NONBLOCK);
+   fflush(stderr);
+   hb_tee_rd = fds[0];
+   hb_tee_saved = saved;
+   hb_tee_stop = 0;
+   hb_tee_used = 0;
+   hb_tee_overflow = false;
+   if (dup2(fds[1], 2) < 0) {
+      close(saved);
+      close(fds[0]);
+      close(fds[1]);
+      hb_tee_rd = hb_tee_saved = -1;
+      return;
+   }
+   close(fds[1]);
+   if (pthread_create(&hb_tee_thread, NULL, hb_tee_main, NULL)) {
+      dup2(saved, 2);
+      close(saved);
+      close(fds[0]);
+      hb_tee_rd = hb_tee_saved = -1;
+      return;
+   }
+   hb_tee_on = true;
+}
+
+/* 남은 기록까지 넘기고 읽은 뒤 stderr 를 원래대로 */
+static void hb_tee_stop_now(void)
+{
+   if (!hb_tee_on) return;
+   fflush(stderr);
+   dup2(hb_tee_saved, 2);
+   hb_tee_stop = 1;
+   pthread_join(hb_tee_thread, NULL);
+   close(hb_tee_rd);
+   close(hb_tee_saved);
+   hb_tee_rd = hb_tee_saved = -1;
+   hb_tee_on = false;
+}
+
+static bool hb_own_inode(unsigned long inode)
+{
+   DIR *dir = opendir("/proc/self/fd");
+   struct dirent *entry;
+   bool found = false;
+   if (!dir) return false;
+   while ((entry = readdir(dir))) {
+      char path[300], value[128];
+      unsigned long candidate = 0;
+      ssize_t n;
+      snprintf(path, sizeof(path), "/proc/self/fd/%s", entry->d_name);
+      n = readlink(path, value, sizeof(value) - 1);
+      if (n <= 0) continue;
+      value[n] = 0;
+      if (sscanf(value, "socket:[%lu]", &candidate) == 1 && candidate == inode) {
+         found = true;
+         break;
+      }
+   }
+   closedir(dir);
+   return found;
+}
+
+static bool hb_host_waiting(unsigned port)
+{
+   const char *tables[2] = { "/proc/net/tcp", "/proc/net/tcp6" };
+   bool listening = false;
+   unsigned i;
+   for (i = 0; i < 2; i++) {
+      char line[1024];
+      FILE *f = fopen(tables[i], "r");
+      if (!f) {
+         if (!i) return false;
+         continue;
+      }
+      while (fgets(line, sizeof(line), f)) {
+         char local[80], remote[80], *colon;
+         unsigned state, lport;
+         unsigned long inode;
+         if (sscanf(line, "%*u: %79s %79s %x %*s %*s %*s %*s %*s %lu",
+                    local, remote, &state, &inode) != 4) continue;
+         colon = strrchr(local, ':');
+         if (!colon || sscanf(colon + 1, "%x", &lport) != 1 || lport != port) continue;
+         /* TIME_WAIT 는 이미 끝난 연결. 접속 중·접속 시도 중이면 거절 */
+         if (state != 0x0A && state != 0x06) {
+            fclose(f);
+            return false;
+         }
+         if (state == 0x0A && hb_own_inode(inode)) listening = true;
+      }
+      fclose(f);
+   }
+   return listening;
+}
+
+/* 넷플레이 손님 표시(hb_direct 감시가 쓴 pid) — 메뉴로 붙은 손님도 2P 칸·1P 세이브를 안 쓰게 */
+static void hb_guest_check(void)
+{
+   unsigned pid = 0;
+   FILE *f = fopen(HB_OWN_DIR "/guest", "r");
+   if (!f) return;
+   if (fscanf(f, "%u", &pid) == 1 && pid == (unsigned)getpid()) hb_own_guest = true;
+   fclose(f);
+}
+
+/* 실행 명령에 --connect(넷플레이 손님)가 있는지 */
+static bool hb_launched_as_guest(void)
+{
+   char command[8192];
+   int fd, i;
+   ssize_t n;
+   bool connect = false;
+
+   fd = open("/proc/self/cmdline", O_RDONLY | O_CLOEXEC);
+   if (fd >= 0) {
+      n = read(fd, command, sizeof(command) - 1);
+      close(fd);
+      if (n > 0) {
+         command[n] = 0;
+         for (i = 0; i < n;) {
+            const char *arg = command + i;
+            if (!strcmp(arg, "--connect") || !strncmp(arg, "--connect=", 10) || !strcmp(arg, "-C"))
+               connect = true;
+            i += (int)strlen(arg) + 1;
+         }
+      }
+   }
+   return connect;
+}
+
+static void hb_local_init(void)
+{
+   uint8_t intent[4200];
+   struct stat st;
+   int fd;
+   ssize_t n;
+   uint64_t when;
+   int64_t age;
+
+   if (!hb_launched_as_guest()) return;
+   hb_own_guest = true;
+   if (hb_nocart) {
+      /* 1.6 싱글팩: 2P 에 팩(세이브)이 없어 이 판 2P 진행은 내 세이브가 아님 — 보낸 거래가 있어도 묶지 않음 */
+      HB_LOG(RETRO_LOG_INFO, "각자 세이브: 2P 팩 없음(싱글팩) — 거래에 묶지 않음(중간 저장 · 끝 되쓰기 없음)");
+      return;
+   }
+
+   /* intent: "HBI3" 표[16] CRC[4] 기종[4] 초[8] 거래 폴더 "\n" */
+   fd = open(HB_OWN_DIR "/intent", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+   if (fd < 0) {
+      HB_LOG(RETRO_LOG_INFO, "각자 세이브: 보낸 세이브 없음 — 보통 손님(1P 세이브는 읽지도 쓰지도 않음)");
+      return;
+   }
+   if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size < 38 || st.st_size >= (off_t)sizeof(intent)) {
+      close(fd);
+      HB_LOG(RETRO_LOG_WARN, "각자 세이브: intent 형식 오류 — 보통 손님");
+      return;
+   }
+   n = read(fd, intent, sizeof(intent) - 1);
+   close(fd);
+   if (n != st.st_size || n < 38 || memcmp(intent, "HBI3", 4) ||
+       hb_u32(intent + 20) != hb_own_p2crc || hb_u32(intent + 24) != hb_own_kind) {
+      HB_LOG(RETRO_LOG_WARN, "각자 세이브: intent 의 롬 CRC · 기종이 다름 — 보통 손님");
+      return;
+   }
+   when = (uint64_t)hb_u32(intent + 28) | ((uint64_t)hb_u32(intent + 32) << 32);
+   age = (int64_t)time(NULL) - (int64_t)when;
+   if (age < -5 || age > HB_OWN_INTENT_AGE) {
+      HB_LOG(RETRO_LOG_WARN, "각자 세이브: intent 가 오래됨(%lld초) — 보통 손님", (long long)age);
+      return;
+   }
+   intent[n] = 0;
+   if (intent[n - 1] != '\n') return;
+   intent[n - 1] = 0;
+   if (intent[36] != '/' || strstr((const char *)intent + 36, "/../") || strstr((const char *)intent + 36, "/./") ||
+       strlen((const char *)intent + 36) + 32 >= sizeof(hb_tx))
+      return;
+   memcpy(hb_tx_token, intent + 4, 16);
+   snprintf(hb_tx, sizeof(hb_tx), "%s", (const char *)intent + 36);
+   hb_tee_start();
+   HB_LOG(RETRO_LOG_INFO, "각자 세이브: 보낸 거래에 묶임(표 %02x%02x%02x%02x…) · 기록 보기 %s",
+          hb_tx_token[0], hb_tx_token[1], hb_tx_token[2], hb_tx_token[3], hb_tee_on ? "켬" : "못 켬(되쓰기 안 함)");
+}
+
+static void hb_own_init(const void *rom, size_t size, uint32_t kind, uint32_t maximum)
+{
+   const uint8_t *p = (const uint8_t *)rom;
+   uint32_t crc = 0xffffffffu;
+   char capability[160], generation[17];
+   int random_fd;
+   size_t i;
+   unsigned bit;
+
+   hb_tee_stop_now();
+   memset(hb_own_token, 0, sizeof(hb_own_token));
+   hb_own_applied = hb_own_guest = hb_own_p2_skip_logged = false;
+   hb_p2_backed_up = false;
+   hb_own_save_hint = 0;
+   hb_own_countdown = 1;
+   hb_own_kind = kind;
+   hb_own_max = maximum;
+   hb_tx[0] = 0;
+   memset(hb_tx_token, 0, sizeof(hb_tx_token));
+   __atomic_store_n(&hb_role, 0, __ATOMIC_SEQ_CST);
+   hb_own_frame = hb_change_frame = 0;
+   hb_role_logged = 0;
+   hb_token_logged = false;
+   hb_seen_valid = false;
+   hb_seen_size = hb_written_size = 0;
+   for (i = 0; i < size; i++) {
+      crc ^= p[i];
+      for (bit = 0; bit < 8; bit++) crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+   }
+   hb_own_crc = ~crc;
+   hb_own_p2crc = hb_pair_on ? hb_pair_crc : hb_own_crc;
+   memset(hb_generation, 0, sizeof(hb_generation));
+   random_fd = open("/dev/urandom", O_RDONLY | O_CLOEXEC);
+   if (random_fd >= 0) {
+      if (read(random_fd, hb_generation, sizeof(hb_generation)) != (ssize_t)sizeof(hb_generation))
+         memset(hb_generation, 0, sizeof(hb_generation));
+      close(random_fd);
+   }
+   hb_local_init();
+   if (!maximum || maximum > HB_OWN_MAX) return;
+   if (mkdir(HB_OWN_DIR, 0700) && errno != EEXIST) return;
+   for (i = 0; i < 8; i++) snprintf(generation + 2 * i, 3, "%02x", hb_generation[i]);
+   snprintf(capability, sizeof(capability), "HBO3 %u %u %u %u %s\n",
+            (unsigned)getpid(), hb_own_crc, maximum, kind, generation);
+   hb_atomic("core", capability, strlen(capability));
+   /* 1.5: 짝 게임 요청(HBQ4)을 알아듣는 코어 표시(GBA 만) — 옛 코어 방장에게는 짝 요청을 보내지 않게 */
+   if (kind == 1) {
+      snprintf(capability, sizeof(capability), "HBP5 %u %s\n", (unsigned)getpid(), generation);
+      hb_atomic("pair", capability, strlen(capability));
+   }
+}
+
+/* 짝 요청 거절: 요청을 지우고 표 · 까닭 번호를 남김(손님 도우미가 바로 알 수 있게) */
+#define HB_PAIR_READ 1      /* 2P 롬을 못 읽음 */
+#define HB_PAIR_CRC 2       /* 2P 롬 CRC 가 손님 것과 다름 */
+#define HB_PAIR_SAME 3      /* 2P 롬이 1P 와 같은 롬(짝 아님) */
+#define HB_PAIR_APPLY 4     /* 2P 게임기를 새 롬으로 못 켬 */
+#define HB_PAIR_NOCART 5    /* 1.6: 방장 2P 가 팩 없음(싱글팩) — 짝 롬을 끼울 수 없음 */
+static void hb_pair_reject(const uint8_t *token, uint32_t why, const char *path, const char *detail)
+{
+   uint8_t reject[24];
+   unlink(HB_OWN_DIR "/request");
+   memcpy(reject, "HBR4", 4);
+   memcpy(reject + 4, token, 16);
+   hb_put32(reject + 20, why);
+   hb_atomic("reject", reject, sizeof(reject));
+   HB_LOG(RETRO_LOG_WARN, "짝 게임 요청 거절(%u %s): %s", (unsigned)why, detail, path);
+}
+
+/* 방장: 30장마다 받은 세이브 요청 확인 → 한 번만 2P 세이브 교체
+ * HBQ3 = 머리 52 + 세이브. HBQ4(1.5 짝) = 머리 52 + 2P 롬 CRC[4] 경로 길이[4] 0[4] + 경로 + 세이브. */
+static void hb_own_poll(bool enabled, bool (*apply)(const uint8_t *, size_t),
+                        bool (*apply_pair)(const uint8_t *, size_t, void *, size_t, uint32_t))
+{
+   uint8_t header[64], *data;
+   char path[1024];
+   uint32_t size, port, p2crc = 0, pathlen = 0, head = 52;
+   uint64_t expires;
+   struct stat st;
+   int fd;
+   ssize_t n;
+   unsigned i;
+   bool token_ok = false, pair;
+   void *rom = NULL;
+   size_t romSize = 0;
+   if (!enabled || --hb_own_countdown) return;
+   hb_own_countdown = 30;
+   hb_guest_check();
+   if (hb_own_applied || hb_own_guest) return;
+   fd = open(HB_OWN_DIR "/request", O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+   if (fd < 0) return;
+   if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size < 52 ||
+       st.st_size > (off_t)(64 + sizeof(path) + HB_OWN_MAX)) {
+      close(fd);
+      return;
+   }
+   n = read(fd, header, 52);
+   pair = n == 52 && !memcmp(header, "HBQ4", 4);
+   if (n != 52 || (memcmp(header, "HBQ3", 4) && !pair) ||
+       memcmp(header + 44, hb_generation, 8) ||
+       hb_u32(header + 4) != (unsigned)getpid() || hb_u32(header + 8) != hb_own_crc) {
+      close(fd);
+      return;
+   }
+   if (pair) {
+      if (!apply_pair || read(fd, header + 52, 12) != 12) {
+         close(fd);
+         return;
+      }
+      p2crc = hb_u32(header + 52);
+      pathlen = hb_u32(header + 56);
+      if (pathlen < 2 || pathlen >= sizeof(path) || hb_u32(header + 60) ||
+          read(fd, path, pathlen) != (ssize_t)pathlen) {
+         close(fd);
+         return;
+      }
+      path[pathlen] = 0;
+      if (strlen(path) != pathlen || path[0] != '/') {
+         close(fd);
+         return;
+      }
+      head = 64 + pathlen;
+   }
+   size = hb_u32(header + 12);
+   port = hb_u32(header + 16);
+   expires = hb_u32(header + 20) | ((uint64_t)hb_u32(header + 24) << 32);
+   for (i = 28; i < 44; i++) if (header[i]) token_ok = true;
+   if (!token_ok || size > hb_own_max || st.st_size != (off_t)head + (off_t)size || port > 65534 ||
+       !port || !hb_millis() || hb_millis() > expires || !hb_host_waiting(port)) {
+      close(fd);
+      return;
+   }
+   data = (uint8_t *)malloc(size ? size : 1);
+   if (!data) {
+      close(fd);
+      return;
+   }
+   n = size ? read(fd, data, size) : 0;
+   close(fd);
+   if (hb_nocart) {
+      /* 1.6 싱글팩 방장: 2P 에 팩이 없어 세이브를 넣지 않음. 짝 요청은 바로 거절(손님 혼자 하기),
+       * 보통 요청은 대기 중일 때 받음 확인만(표 · 크기 힌트는 상태에 안 넣음 → 손님 되쓰기 조건이 안 됨) */
+      if (pair) {
+         hb_pair_reject(header + 28, HB_PAIR_NOCART, path, "방장 2P 팩 없음(싱글팩)");
+      } else if (n == (ssize_t)size && hb_millis() <= expires && hb_host_waiting(port)) {
+         uint8_t ack[20];
+         unlink(HB_OWN_DIR "/request");
+         hb_own_applied = true;
+         memcpy(ack, "HBA3", 4);
+         memcpy(ack + 4, header + 28, 16);
+         hb_atomic("ack", ack, sizeof(ack));
+         HB_LOG(RETRO_LOG_INFO, "2P 팩 없음(싱글팩): 손님 세이브 %u 바이트는 넣지 않고 받음 확인만 — 손님은 바로 같이하기",
+                (unsigned)size);
+      }
+      free(data);
+      return;
+   }
+   if (pair && n == (ssize_t)size) {
+      /* 롬 읽기(몇십 ms)는 마지막 대기 확인보다 앞에서 */
+      uint32_t romCrc = 0;
+      const char *why = "";
+      rom = hb_rom_load(path, &romSize, &romCrc, &why);
+      if (!rom) {
+         hb_pair_reject(header + 28, HB_PAIR_READ, path, why);
+         free(data);
+         return;
+      }
+      if (romCrc != p2crc || romCrc == hb_own_crc) {
+         char detail[64];
+         snprintf(detail, sizeof(detail), "손님 %08x · 이 기기 %08x", (unsigned)p2crc, (unsigned)romCrc);
+         hb_pair_reject(header + 28, romCrc != p2crc ? HB_PAIR_CRC : HB_PAIR_SAME, path, detail);
+         mappedMemoryFree(rom, romSize);
+         free(data);
+         return;
+      }
+   }
+   if (n == (ssize_t)size && hb_millis() <= expires && hb_host_waiting(port)) {
+      bool applied;
+      /* 레트로아크의 같은 실행 스레드 안: 접속 처리보다 앞선 한 번만 바꾼다. */
+      unlink(HB_OWN_DIR "/request");
+      if (pair) {
+         applied = apply_pair(data, size, rom, romSize, p2crc);   /* 성공하면 롬은 코어 것 */
+         if (!applied) {
+            mappedMemoryFree(rom, romSize);
+            hb_pair_reject(header + 28, HB_PAIR_APPLY, path, "2P 게임기 켜기 실패");
+         }
+         rom = NULL;
+      } else {
+         applied = apply(data, size);
+      }
+      if (applied) {
+         uint8_t ack[20];
+         memcpy(hb_own_token, header + 28, 16);
+         hb_own_save_hint = size;
+         hb_own_applied = true;
+         hb_own_frame = 0;
+         memcpy(ack, "HBA3", 4);
+         memcpy(ack + 4, hb_own_token, 16);
+         hb_atomic("ack", ack, sizeof(ack));
+      }
+   }
+   if (rom) mappedMemoryFree(rom, romSize);   /* 짝 롬을 읽었지만 그새 대기가 끝남 */
+   free(data);
+}
+
+/* 손님 거래 폴더에 묶음 하나: 머리 44 + 세이브 + SHA-256 32
+ * 머리 = 종류[4] CRC[4] 기종[4] 크기[4] 표[16] 장[4] 역할(2)[4] 세이브 CRC32[4] */
+static bool hb_packet(const char *name, const char *magic, const uint8_t *save, size_t size, uint32_t frame)
+{
+   uint8_t *packet;
+   char path[4160];
+   bool ok;
+   if (!hb_tx[0] || !save || !size || size > HB_OWN_MAX) return false;
+   packet = (uint8_t *)malloc(HB_OWN_PACKET_HEAD + size + 32);
+   if (!packet) return false;
+   memcpy(packet, magic, 4);
+   hb_put32(packet + 4, hb_own_p2crc);   /* 짝이면 손님 자기 게임(2P 롬) CRC */
+   hb_put32(packet + 8, hb_own_kind);
+   hb_put32(packet + 12, (uint32_t)size);
+   memcpy(packet + 16, hb_own_token, 16);
+   hb_put32(packet + 32, frame);
+   hb_put32(packet + 36, 2);
+   hb_put32(packet + 40, hb_crc32(save, size));
+   memcpy(packet + HB_OWN_PACKET_HEAD, save, size);
+   hb_sha256(packet, HB_OWN_PACKET_HEAD + size, packet + HB_OWN_PACKET_HEAD + size);
+   ok = (size_t)snprintf(path, sizeof(path), "%s/%s.bin", hb_tx, name) < sizeof(path) &&
+        hb_store_path(path, packet, HB_OWN_PACKET_HEAD + size + 32);
+   if (!strcmp(name, "export"))
+      ok = hb_atomic("export", packet, HB_OWN_PACKET_HEAD + size + 32) || ok;   /* 카드가 실패해도 램 사본으로 종료 훅이 살림 */
+   free(packet);
+   return ok;
+}
+
+static bool hb_own_eligible(void)
+{
+   return hb_has_token() && hb_tx[0] && hb_own_guest &&
+          !memcmp(hb_own_token, hb_tx_token, 16) && hb_role_get() == 2;
+}
+
+/* 손님 정상 종료: 기록 줄을 끝까지 읽은 뒤, 확인된 2P 면 2P 세이브를 내보낸다 */
+static void hb_own_export(const uint8_t *save, size_t size)
+{
+   hb_tee_stop_now();
+   if (!hb_tx[0]) return;
+   if (!hb_own_eligible() || !save || !size || size > HB_OWN_MAX) {
+      HB_LOG(RETRO_LOG_INFO, "각자 세이브: 종료 — 이 판은 되쓰지 않음(%s)",
+             !hb_has_token() ? "방장 표 없음" : memcmp(hb_own_token, hb_tx_token, 16) ? "받은 표가 보낸 거래와 다름" :
+             hb_role_get() == 2 ? "2P 세이브 없음" : hb_role_get() < 0 ? "2P 아님(관전 · 3P · 나감)" : "2P 확인 못 함");
+      return;
+   }
+   if (hb_packet("export", "HBE3", save, size, hb_own_frame))
+      HB_LOG(RETRO_LOG_INFO, "각자 세이브: 종료 2P 세이브 %u바이트 남김(장 %u)", (unsigned)size, hb_own_frame);
+   else
+      HB_LOG(RETRO_LOG_ERROR, "각자 세이브: 종료 2P 세이브 남기기 실패: %s", hb_tx);
+}
+
+/* 매 장 끝(방장 · 손님 같음): 표가 있으면 장 번호를 센다(상태에 들어가므로 두 기기가 똑같이).
+ * 확인된 2P 손님만, 바뀐 2P 세이브가 HB_OWN_STABLE 장 그대로면 카드에 중간 저장. */
+static void hb_own_tick(const uint8_t *save, size_t size)
+{
+   int role;
+   if (!hb_has_token()) return;
+   hb_own_frame++;
+   if (!hb_tx[0] || !hb_own_guest) return;
+   role = hb_role_get();
+   if (role != hb_role_logged) {
+      hb_role_logged = role;
+      if (role == 2)
+         HB_LOG(RETRO_LOG_INFO, "각자 세이브: 넷플레이 2P 확인 — 이 판 2P 진행을 내 세이브로 남김");
+      else
+         HB_LOG(RETRO_LOG_WARN, "각자 세이브: 2P 아님(관전 · 3P · 나감) — 이 판은 되쓰지 않음");
+   }
+   if (!hb_token_logged && memcmp(hb_own_token, hb_tx_token, 16)) {
+      hb_token_logged = true;
+      HB_LOG(RETRO_LOG_WARN, "각자 세이브: 받은 상태의 표가 보낸 거래와 다름 — 되쓰지 않음");
+   }
+   if (!hb_own_eligible() || !save || !size || size > HB_OWN_MAX) return;
+   if (!hb_seen_valid) {
+      /* 2P 확인 뒤 첫 장: 받은 세이브를 기준으로 삼는다(바뀐 것이 없으면 중간 저장 안 함) */
+      memcpy(hb_seen, save, size);
+      memcpy(hb_written, save, size);
+      hb_seen_size = hb_written_size = size;
+      hb_seen_valid = true;
+      hb_change_frame = hb_own_frame;
+      return;
+   }
+   if (size != hb_seen_size || memcmp(hb_seen, save, size)) {
+      memcpy(hb_seen, save, size);
+      hb_seen_size = size;
+      hb_change_frame = hb_own_frame;
+      return;
+   }
+   if (hb_own_frame - hb_change_frame < HB_OWN_STABLE) return;
+   if (hb_written_size == size && !memcmp(hb_written, save, size)) return;
+   if (hb_packet("checkpoint", "HBC3", save, size, hb_change_frame)) {
+      memcpy(hb_written, save, size);
+      hb_written_size = size;
+      HB_LOG(RETRO_LOG_INFO, "각자 세이브: 2P 중간 저장 %u바이트(장 %u에 바뀜)", (unsigned)size, hb_change_frame);
+   } else {
+      HB_LOG(RETRO_LOG_ERROR, "각자 세이브: 2P 중간 저장 실패 — 300장 뒤 다시: %s", hb_tx);
+      hb_change_frame = hb_own_frame;   /* 카드 쓰기 실패: 300장 뒤 다시 */
+   }
+}
+
+/* 상태 불러오기(넷플레이 되감기 포함): 장 번호를 상태 값으로. 바뀐 장 이전으로 돌아가면 다시 셈. */
+static void hb_own_restored(uint32_t frame)
+{
+   hb_own_frame = frame;
+   if (frame < hb_change_frame) hb_change_frame = frame;
+}
+
+static void hb_own_deinit(void)
+{
+   hb_tee_stop_now();
+}
+#endif
diff --git a/src/platform/libretro/dual/hb_romfile.h b/src/platform/libretro/dual/hb_romfile.h
new file mode 100644
index 000000000000..0eca9ab82721
--- /dev/null
+++ b/src/platform/libretro/dual/hb_romfile.h
@@ -0,0 +1,204 @@
+/* GBA 두 대 코어 1.5 — 2P 짝 롬 읽기(10/21)
+ *
+ * 낱개 .gba 파일, 또는 .gba 가 정확히 하나 든 ZIP(저장 · deflate)만 읽는다. hb_ownsave.py rom_crc 와 같은 규칙.
+ * ZIP 은 안 항목의 CRC32 를 풀어낸 내용으로 다시 확인한다. 돌려주는 CRC 는 풀어낸 롬 전체의 CRC32
+ * (= ZIP 항목 CRC = 레트로아크 · hb_ownsave 가 보는 값).
+ * 압축 풀기는 mGBA 에 들어 있는 zlib(src/third-party/zlib) 의 inflate 만 쓴다(코어 밖으로 이름을 내보내지 않음).
+ */
+#ifndef HB_ROMFILE_H
+#define HB_ROMFILE_H
+/* mGBA 자체 crc32(src/util/crc32.c)와 이름이 겹치지 않게 zlib 이름에 z_ 를 붙임(CMake 에서 zlib 파일도 같은 정의) */
+#ifndef Z_PREFIX
+#define Z_PREFIX
+#endif
+#include "../../../third-party/zlib/zlib.h"
+
+#define HB_ROM_MAX (32u * 1024u * 1024u)          /* GBA 롬 최대(32MB) */
+#define HB_ROM_FILE_MAX (HB_ROM_MAX + 4u * 1024u * 1024u)
+
+static uint32_t hb_rd16(const uint8_t *p)
+{
+   return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static uint32_t hb_rd32(const uint8_t *p)
+{
+   return hb_rd16(p) | (hb_rd16(p + 2) << 16);
+}
+
+static bool hb_ends_gba(const char *name, size_t len)
+{
+   return len > 4 && name[len - 4] == '.' && (name[len - 3] | 0x20) == 'g' &&
+      (name[len - 2] | 0x20) == 'b' && (name[len - 1] | 0x20) == 'a';
+}
+
+/* 보통 파일만, 크기 한도 안에서 통째로 */
+static uint8_t *hb_rom_read_file(const char *path, size_t *size, const char **why)
+{
+   struct stat st;
+   uint8_t *data;
+   size_t got = 0;
+   int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+   if (fd < 0) {
+      *why = "파일 없음";
+      return NULL;
+   }
+   if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size <= 0 || st.st_size > (off_t)HB_ROM_FILE_MAX) {
+      close(fd);
+      *why = "보통 파일이 아니거나 크기 초과";
+      return NULL;
+   }
+   data = (uint8_t *)malloc((size_t)st.st_size);
+   if (!data) {
+      close(fd);
+      *why = "메모리 부족";
+      return NULL;
+   }
+   while (got < (size_t)st.st_size) {
+      ssize_t n = read(fd, data + got, (size_t)st.st_size - got);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) break;
+      got += (size_t)n;
+   }
+   close(fd);
+   if (got != (size_t)st.st_size) {
+      free(data);
+      *why = "읽기 실패";
+      return NULL;
+   }
+   *size = got;
+   return data;
+}
+
+/* 성공하면 anonymousMemoryMap 으로 잡은 롬(mappedMemoryFree(롬, *romSize) 로 풀기) */
+static void *hb_rom_load(const char *path, size_t *romSize, uint32_t *romCrc, const char **why)
+{
+   size_t fileSize = 0, usize = 0;
+   uint8_t *file;
+   void *rom = NULL;
+   *why = "";
+   file = hb_rom_read_file(path, &fileSize, why);
+   if (!file) return NULL;
+   if (fileSize >= 4 && hb_rd32(file) == 0x04034b50u) {
+      size_t eocd, min, cd, cdEnd, p, local, start;
+      uint32_t entries, k, found = 0, method = 0, flags = 0, crc = 0, csize = 0, loff = 0;
+      if (fileSize < 22) {
+         *why = "ZIP 이 너무 짧음";
+         goto fail;
+      }
+      min = fileSize > 22 + 65535 ? fileSize - 22 - 65535 : 0;
+      for (eocd = fileSize - 22;; --eocd) {
+         if (hb_rd32(file + eocd) == 0x06054b50u) break;
+         if (eocd == min) {
+            *why = "ZIP 끝 기록 없음";
+            goto fail;
+         }
+      }
+      entries = hb_rd16(file + eocd + 10);
+      cd = hb_rd32(file + eocd + 16);
+      cdEnd = cd + hb_rd32(file + eocd + 12);
+      if (cd > eocd || cdEnd > eocd || cdEnd < cd) {
+         *why = "ZIP 목록 위치 오류";
+         goto fail;
+      }
+      for (p = cd, k = 0; k < entries; ++k) {
+         uint32_t nameLen, extraLen, commentLen;
+         const char *name;
+         if (p + 46 > cdEnd || hb_rd32(file + p) != 0x02014b50u) {
+            *why = "ZIP 목록 형식 오류";
+            goto fail;
+         }
+         nameLen = hb_rd16(file + p + 28);
+         extraLen = hb_rd16(file + p + 30);
+         commentLen = hb_rd16(file + p + 32);
+         if (p + 46 + nameLen > cdEnd) {
+            *why = "ZIP 이름 길이 오류";
+            goto fail;
+         }
+         name = (const char *)file + p + 46;
+         if (nameLen && name[nameLen - 1] != '/' && hb_ends_gba(name, nameLen)) {
+            ++found;
+            flags = hb_rd16(file + p + 8);
+            method = hb_rd16(file + p + 10);
+            crc = hb_rd32(file + p + 16);
+            csize = hb_rd32(file + p + 20);
+            usize = hb_rd32(file + p + 24);
+            loff = hb_rd32(file + p + 42);
+         }
+         p += 46 + nameLen + extraLen + commentLen;
+      }
+      if (found != 1) {
+         *why = "ZIP 안 .gba 가 정확히 하나가 아님";
+         goto fail;
+      }
+      if ((flags & 1) || !usize || usize > HB_ROM_MAX || (method != 0 && method != 8)) {
+         *why = "ZIP 항목이 암호 · 크기 · 압축 방식 오류";
+         goto fail;
+      }
+      local = loff;
+      if (local + 30 > fileSize || hb_rd32(file + local) != 0x04034b50u) {
+         *why = "ZIP 항목 머리 오류";
+         goto fail;
+      }
+      start = local + 30 + hb_rd16(file + local + 26) + hb_rd16(file + local + 28);
+      if (start > fileSize || csize > fileSize - start) {
+         *why = "ZIP 항목 길이 오류";
+         goto fail;
+      }
+      rom = anonymousMemoryMap(usize);
+      if (!rom) {
+         *why = "메모리 부족";
+         goto fail;
+      }
+      if (method == 0) {
+         if (csize != usize) {
+            *why = "ZIP 저장 항목 크기 오류";
+            goto fail;
+         }
+         memcpy(rom, file + start, usize);
+      } else {
+         z_stream z;
+         int r;
+         memset(&z, 0, sizeof(z));
+         if (inflateInit2(&z, -MAX_WBITS) != Z_OK) {
+            *why = "압축 풀기 준비 실패";
+            goto fail;
+         }
+         z.next_in = file + start;
+         z.avail_in = csize;
+         z.next_out = (Bytef *)rom;
+         z.avail_out = (uInt)usize;
+         r = inflate(&z, Z_FINISH);
+         inflateEnd(&z);
+         if (r != Z_STREAM_END || z.total_out != usize) {
+            *why = "압축 풀기 실패";
+            goto fail;
+         }
+      }
+      if ((uint32_t)crc32(0L, (const Bytef *)rom, (uInt)usize) != crc) {
+         *why = "ZIP 항목 CRC 불일치(손상)";
+         goto fail;
+      }
+   } else {
+      if (!hb_ends_gba(path, strlen(path)) || fileSize > HB_ROM_MAX) {
+         *why = ".gba · .zip 이 아니거나 크기 초과";
+         goto fail;
+      }
+      usize = fileSize;
+      rom = anonymousMemoryMap(usize);
+      if (!rom) {
+         *why = "메모리 부족";
+         goto fail;
+      }
+      memcpy(rom, file, usize);
+   }
+   free(file);
+   *romSize = usize;
+   *romCrc = (uint32_t)crc32(0L, (const Bytef *)rom, (uInt)usize);
+   return rom;
+fail:
+   if (rom) mappedMemoryFree(rom, usize);
+   free(file);
+   return NULL;
+}
+#endif
diff --git a/src/platform/libretro/dual/hb_storage.h b/src/platform/libretro/dual/hb_storage.h
new file mode 100644
index 000000000000..f80a082a4eee
--- /dev/null
+++ b/src/platform/libretro/dual/hb_storage.h
@@ -0,0 +1,217 @@
+/* 두 대 코어 공통 — 카드·램 파일 쓰기(자기 세이브 4판, 10/21)
+ *
+ * 지키는 것
+ * - 기존 파일을 직접 열어 잘라 쓰지 않는다. 같은 폴더의 고정 임시 이름(<이름>.hbtmp)에 쓰고
+ *   fsync → 다시 읽어 확인 → 이름 바꾸기 → 최종 파일 fsync·다시 읽어 확인 → 폴더 동기화.
+ * - 이름 바꾸기에 실패하면 원본은 그대로 두고, 완전한 새 내용이 든 임시 파일만 남긴다.
+ *   임시 이름이 고정이라 실패가 되풀이돼도 파일이 쌓이지 않는다(다음 쓰기가 덮음).
+ * - 폴더 fsync 가 '지원 안 함'(EINVAL·ENOTSUP·EOPNOTSUPP·ENOSYS)일 때만 syncfs 로 대신한다.
+ *   EIO·ENOSPC·EROFS 같은 진짜 오류는 실패로 돌려준다.
+ */
+#ifndef HB_STORAGE_H
+#define HB_STORAGE_H
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
