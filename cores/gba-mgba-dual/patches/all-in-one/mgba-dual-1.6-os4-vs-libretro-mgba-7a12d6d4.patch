+#define O_CLOEXEC 0
+#endif
+
+static uint32_t hb_crc32(const void *data, size_t size)
+{
+   const uint8_t *p = (const uint8_t *)data;
+   uint32_t crc = ~0u;
+   unsigned bit;
+   while (size--) {
+      crc ^= *p++;
+      for (bit = 0; bit < 8; bit++)
+         crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+   }
+   return ~crc;
+}
+
+static uint32_t hb_rotr(uint32_t n, unsigned b)
+{
+   return (n >> b) | (n << (32 - b));
+}
+
+/* SHA-256(FIPS 180-4). 내보내기 묶음 머리까지 해시해 표·역할·크기 손상도 거절한다. */
+static void hb_sha256(const uint8_t *data, size_t size, uint8_t out[32])
+{
+   static const uint32_t k[64] = {
+      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+   };
+   uint32_t h[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
+                    0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+   size_t padded = (size + 9 + 63) & ~(size_t)63, at;
+   unsigned i;
+   for (at = 0; at < padded; at += 64) {
+      uint8_t block[64];
+      uint32_t w[64], a, b, c, d, e, f, g, v;
+      for (i = 0; i < 64; i++) {
+         size_t n = at + i;
+         block[i] = n < size ? data[n] : n == size ? 0x80 : 0;
+         if (n >= padded - 8)
+            block[i] = (uint8_t)(((uint64_t)size * 8) >> (8 * (padded - 1 - n)));
+      }
+      for (i = 0; i < 16; i++)
+         w[i] = ((uint32_t)block[4*i] << 24) | ((uint32_t)block[4*i+1] << 16) |
+                ((uint32_t)block[4*i+2] << 8) | block[4*i+3];
+      for (i = 16; i < 64; i++)
+         w[i] = w[i-16] + (hb_rotr(w[i-15],7) ^ hb_rotr(w[i-15],18) ^ (w[i-15] >> 3)) +
+                w[i-7] + (hb_rotr(w[i-2],17) ^ hb_rotr(w[i-2],19) ^ (w[i-2] >> 10));
+      a = h[0]; b = h[1]; c = h[2]; d = h[3]; e = h[4]; f = h[5]; g = h[6]; v = h[7];
+      for (i = 0; i < 64; i++) {
+         uint32_t t1 = v + (hb_rotr(e,6) ^ hb_rotr(e,11) ^ hb_rotr(e,25)) + ((e & f) ^ (~e & g)) + k[i] + w[i];
+         uint32_t t2 = (hb_rotr(a,2) ^ hb_rotr(a,13) ^ hb_rotr(a,22)) + ((a & b) ^ (a & c) ^ (b & c));
+         v = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+      }
+      h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += v;
+   }
+   for (i = 0; i < 32; i++)
+      out[i] = (uint8_t)(h[i / 4] >> (24 - 8 * (i % 4)));
+}
+
+static bool hb_write_all(int fd, const uint8_t *data, size_t size)
+{
+   size_t at = 0;
+   while (at < size) {
+      ssize_t n = write(fd, data + at, size - at);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) return false;
+      at += (size_t)n;
+   }
+   return true;
+}
+
+/* 폴더 동기화: '지원 안 함'만 syncfs 로 대신하고 진짜 오류는 실패 */
+static bool hb_sync_dir(const char *path)
+{
+   int fd = open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC), rc, code;
+   if (fd < 0) return false;
+   rc = fsync(fd);
+   code = errno;
+   if (rc && (code == EINVAL || code == ENOTSUP || code == EOPNOTSUPP || code == ENOSYS)) {
+#ifdef SYS_syncfs
+      rc = (int)syscall(SYS_syncfs, fd);
+#endif
+   }
+   close(fd);
+   return rc == 0;
+}
+
+static bool hb_file_equal(const char *path, const uint8_t *data, size_t size)
+{
+   struct stat st;
+   uint8_t buf[4096];
+   size_t at = 0;
+   int fd = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+   if (fd < 0) return false;
+   if (fstat(fd, &st) || !S_ISREG(st.st_mode) || (uint64_t)st.st_size != (uint64_t)size) {
+      close(fd);
+      return false;
+   }
+   while (at < size) {
+      size_t count = size - at < sizeof(buf) ? size - at : sizeof(buf);
+      ssize_t n = read(fd, buf, count);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0 || memcmp(buf, data + at, (size_t)n)) {
+         close(fd);
+         return false;
+      }
+      at += (size_t)n;
+   }
+   close(fd);
+   return true;
+}
+
+static bool hb_store_path(const char *path, const uint8_t *data, size_t size)
+{
+   char temp[4160], parent[4160], *slash;
+   int fd;
+   bool ok;
+   if (!path || (size_t)snprintf(temp, sizeof(temp), "%s.hbtmp", path) >= sizeof(temp) ||
+       (size_t)snprintf(parent, sizeof(parent), "%s", path) >= sizeof(parent))
+      return false;
+   slash = strrchr(parent, '/');
+   if (!slash || slash == parent) return false;
+   *slash = 0;
+   fd = open(temp, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0644);
+   if (fd < 0) return false;
+   ok = hb_write_all(fd, data, size);
+   if (fsync(fd)) ok = false;
+   if (close(fd)) ok = false;
+   if (!ok || !hb_file_equal(temp, data, size)) {
+      /* 덜 쓴 임시 파일은 쓸모가 없다. 원본은 손대지 않았다. */
+      unlink(temp);
+      return false;
+   }
+   if (rename(temp, path))
+      return false;   /* 원본 그대로 + 완전한 새 내용(임시 파일) 보존 */
+   fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+   if (fd < 0) return false;
+   ok = fsync(fd) == 0;
+   close(fd);
+   return ok && hb_file_equal(path, data, size) && hb_sync_dir(parent);
+}
+
+/* 방장 2P 칸(.p2.srm · .p2.sav): 이번 실행에서 처음 바꾸기 전에 지금 파일을 <이름>.bak 으로 한 번 남긴다.
+ * 백업을 못 남기면 바꾸지 않는다. */
+static bool hb_p2_backed_up;
+static bool hb_p2_store(const char *path, const uint8_t *data, size_t size)
+{
+   char backup[4160];
+   if (!hb_p2_backed_up) {
+      struct stat st;
+      int fd = open(path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+      if (fd >= 0) {
+         uint8_t *old;
+         ssize_t n;
+         size_t at = 0;
+         if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_size < 0 || st.st_size > 262144) {
+            close(fd);
+            return false;
+         }
+         old = (uint8_t *)malloc(st.st_size ? (size_t)st.st_size : 1);
+         if (!old) {
+            close(fd);
+            return false;
+         }
+         while (at < (size_t)st.st_size) {
+            n = read(fd, old + at, (size_t)st.st_size - at);
+            if (n < 0 && errno == EINTR) continue;
+            if (n <= 0) break;
+            at += (size_t)n;
+         }
+         close(fd);
+         if (at != (size_t)st.st_size ||
+             (size_t)snprintf(backup, sizeof(backup), "%s.bak", path) >= sizeof(backup) ||
+             !hb_store_path(backup, old, at)) {
+            free(old);
+            return false;
+         }
+         free(old);
+      } else if (errno != ENOENT) {
+         return false;
+      }
+      hb_p2_backed_up = true;
+   }
+   return hb_store_path(path, data, size);
+}
+#endif
