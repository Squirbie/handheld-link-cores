Subject: GBA I/O: restore RCNT's link-pin bits exactly on load; dual: trace resyncs
Series-Step: 8/19 (mgba_dual 1.6-os4)
Origin: hanbang (this project)
요약: 상태를 불러올 때 RCNT 아래 비트(연결선 핀)를 상태 그대로 복원 — 이게 없으면 넷플레이 접속 · 재동기 뒤 CRC 가 계속 달라 30장마다 상태를 다시 받음.

Outside GPIO mode the RCNT write-back during deserialization kept the
low RCNT bits (SC/SD/SI/SO, maintained by the link logic) of the machine
as it was before the load. Loading a state into a different timeline
(RetroArch netplay join, or the savestate it sends after a CRC mismatch)
therefore left RCNT different from the sender's, and the next CRC check
failed again: a resync every check, forever. The state stores the live
register, so restore it as is.

The dual frontend's trace mode now hashes the states it produces and
logs every load of a state it did not produce (netplay join / resync).

---
diff --git a/src/gba/io.c b/src/gba/io.c
index 4ab5d9fe898a..02b2fcd12278 100644
--- a/src/gba/io.c
+++ b/src/gba/io.c
@@ -1068,6 +1068,14 @@ void GBAIODeserialize(struct GBA* gba, const struct GBASerializedState* state) {
 		gba->sio.mode = (enum GBASIOMode) (sioMode & 0xC);
 	}
 	GBASIOWriteRCNT(&gba->sio, gba->memory.io[GBA_REG(RCNT)]);
+	// Outside GPIO mode the write-back keeps the low RCNT bits (the
+	// SC/SD/SI/SO pin mirror the link logic maintains) from the machine
+	// *before* the load. The state stores the live register, so restore
+	// it exactly: a state loaded into a different timeline (netplay join
+	// or resync) must not inherit the old pins.
+	uint16_t rcnt;
+	LOAD_16(rcnt, GBA_REG_RCNT, state->io);
+	gba->sio.rcnt = rcnt;
 
 	LOAD_32(gba->bus, 0, &state->bus);
 	GBADMADeserialize(gba, state);
diff --git a/src/platform/libretro/dual/libretro_dual.c b/src/platform/libretro/dual/libretro_dual.c
index e856fab77e4c..b73705b30248 100644
--- a/src/platform/libretro/dual/libretro_dual.c
+++ b/src/platform/libretro/dual/libretro_dual.c
@@ -175,6 +175,14 @@ static size_t p2SaveWrittenSize;
 static FILE* traceFile;
 static bool biosLoaded;
 
+/* Trace-only netplay check: hashes of the states this core produced (and
+ * received). Loading anything else is a state that came over the network:
+ * one at netplay join, one more for every CRC resync (= a desync). */
+#define DUAL_SEEN_STATES 256
+static uint64_t seenStates[DUAL_SEEN_STATES];
+static unsigned seenNext;
+static unsigned outsideLoads;
+
 static const int keymap[] = {
 	RETRO_DEVICE_ID_JOYPAD_A,
 	RETRO_DEVICE_ID_JOYPAD_B,
@@ -675,6 +683,9 @@ bool retro_load_game(const struct retro_game_info* game) {
 	}
 	memset(players, 0, sizeof(players));
 	memset(&stats, 0, sizeof(stats));
+	memset(seenStates, 0, sizeof(seenStates));
+	seenNext = 0;
+	outsideLoads = 0;
 	biosLoaded = false;
 	stats.magic = 0x54534448; /* "HDST" */
 	stats.version = 1;
@@ -945,6 +956,31 @@ static void _loadExtra(struct GBA* gba, const struct DualExtra* extra) {
 	}
 }
 
+static uint64_t _hashState(const void* data, size_t size) {
+	const uint8_t* bytes = data;
+	uint64_t hash = 0xCBF29CE484222325ULL;
+	size_t i;
+	for (i = 0; i < size; ++i) {
+		hash = (hash ^ bytes[i]) * 0x100000001B3ULL;
+	}
+	return hash;
+}
+
+static void _rememberState(uint64_t hash) {
+	seenStates[seenNext] = hash;
+	seenNext = (seenNext + 1) % DUAL_SEEN_STATES;
+}
+
+static bool _stateSeen(uint64_t hash) {
+	unsigned i;
+	for (i = 0; i < DUAL_SEEN_STATES; ++i) {
+		if (seenStates[i] == hash) {
+			return true;
+		}
+	}
+	return false;
+}
+
 bool retro_serialize(void* data, size_t size) {
 	size_t total = retro_serialize_size();
 	if (!total || size < total) {
@@ -988,6 +1024,9 @@ bool retro_serialize(void* data, size_t size) {
 		_saveExtra(player->core->board, (struct DualExtra*) cursor);
 		cursor += sizeof(struct DualExtra);
 	}
+	if (traceFile) {
+		_rememberState(_hashState(data, total));
+	}
 	return true;
 }
 
@@ -996,6 +1035,16 @@ bool retro_unserialize(const void* data, size_t size) {
 	if (!total || size < total) {
 		return false;
 	}
+	if (traceFile) {
+		uint64_t hash = _hashState(data, total);
+		if (!_stateSeen(hash)) {
+			++outsideLoads;
+			_rememberState(hash);
+			fprintf(traceFile, "f=%u state from outside #%u (netplay join or CRC resync)\n", stats.frames, outsideLoads);
+			fflush(traceFile);
+			_log(RETRO_LOG_INFO, "state from outside #%u at frame %u (netplay join or CRC resync)", outsideLoads, stats.frames);
+		}
+	}
 	const struct DualStateHeader* header = data;
 	uint32_t value;
 	LOAD_32LE(value, 0, &header->magic);
