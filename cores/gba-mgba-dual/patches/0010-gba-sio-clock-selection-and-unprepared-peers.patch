+				}
+				mTimingDeschedule(&sio->p->timing, &sio->completeEvent);
+				mTimingSchedule(&sio->p->timing, &sio->completeEvent, nextEvent);
+			}
 			GBASIOLockstepCoordinatorAckPlayer(coordinator, player);
