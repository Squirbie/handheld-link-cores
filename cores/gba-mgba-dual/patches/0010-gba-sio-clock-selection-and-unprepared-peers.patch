-			mTimingDeschedule(&sio->p->timing, &sio->completeEvent);
-			mTimingSchedule(&sio->p->timing, &sio->completeEvent, nextEvent);
+			// Attachment alone does not connect a shifter. A unit in
+			// GPIO/another mode must not supply stale data or receive
+			// a phantom completion. Normal mode additionally requires
+			// an armed external-clock receiver.
+			bool participating = player->mode == coordinator->transferMode;
+			if (player->mode == GBA_SIO_NORMAL_8 || player->mode == GBA_SIO_NORMAL_32) {
+				participating = participating && GBASIONormalIsStart(sio->siocnt)
+				                && !GBASIONormalGetSc(sio->siocnt);
+			}
+			if (participating) {
+				_setData(coordinator, player->playerId, sio);
+				// CurrentTime already includes callback lateness. Do not
+				// subtract cyclesLate a second time from an absolute end.
+				nextEvent = _cycleDiff(event->finishCycle, GBASIOLockstepTime(player));
+				sio->siocnt |= 0x80;
+				if (player->mode == GBA_SIO_MULTI) {
