+void* retro_get_memory_data(unsigned id) {
+	if (!gameLoaded) {
+		return NULL;
+	}
+	struct GBA* gba0 = players[0].core->board;
+	switch (id) {
+	case RETRO_MEMORY_SAVE_RAM:
+		return players[0].save;
+	case RETRO_MEMORY_SYSTEM_RAM:
+		return gba0->memory.wram;
+	case RETRO_MEMORY_VIDEO_RAM:
+		return gba0->video.renderer->vram;
+	case DUAL_MEMORY_STATS:
+		return &stats;
+	case DUAL_MEMORY_WRAM:
+	case DUAL_MEMORY_WRAM + 1:
+		return ((struct GBA*) players[id - DUAL_MEMORY_WRAM].core->board)->memory.wram;
+	case DUAL_MEMORY_IWRAM:
+	case DUAL_MEMORY_IWRAM + 1:
+		return ((struct GBA*) players[id - DUAL_MEMORY_IWRAM].core->board)->memory.iwram;
+	case DUAL_MEMORY_SAVE:
+	case DUAL_MEMORY_SAVE + 1:
+		return players[id - DUAL_MEMORY_SAVE].save;
+	case DUAL_MEMORY_FRAME:
+		return players[0].videoBuffer;
+	case DUAL_MEMORY_FRAME + 1:
+		return players[1].frameBuffer;
+	default:
+		return NULL;
+	}
+}
+
+size_t retro_get_memory_size(unsigned id) {
+	if (!gameLoaded) {
+		return 0;
+	}
+	switch (id) {
+	case RETRO_MEMORY_SAVE_RAM:
+		return _saveSize(0);
+	case RETRO_MEMORY_SYSTEM_RAM:
+		return GBA_SIZE_EWRAM;
+	case RETRO_MEMORY_VIDEO_RAM:
+		return GBA_SIZE_VRAM;
+	case DUAL_MEMORY_STATS:
+		return sizeof(stats);
+	case DUAL_MEMORY_WRAM:
+	case DUAL_MEMORY_WRAM + 1:
+		return GBA_SIZE_EWRAM;
+	case DUAL_MEMORY_IWRAM:
+	case DUAL_MEMORY_IWRAM + 1:
+		return GBA_SIZE_IWRAM;
+	case DUAL_MEMORY_SAVE:
+	case DUAL_MEMORY_SAVE + 1:
+		return _saveSize(id - DUAL_MEMORY_SAVE);
+	case DUAL_MEMORY_FRAME:
+	case DUAL_MEMORY_FRAME + 1:
+		return DUAL_WIDTH * DUAL_HEIGHT * sizeof(mColor);
+	default:
+		return 0;
+	}
+}
