+/* mGBA Dual: two GBA instances of the same ROM in ONE libretro core,
+ * connected by mGBA's lockstep SIO driver (link cable).
+ *
+ * - Both cores are stepped cooperatively on one thread: the lockstep user's
+ *   sleep/wake only flip a flag, and retro_run interleaves run-loop slices of
+ *   whichever core is awake until core 0 finishes one video frame (the same
+ *   scheme as tangobattle/mgba-rollback). The whole link is therefore a
+ *   deterministic function of the two joypads, which is exactly what plain
+ *   RetroArch netplay (input sync + rollback) needs.
+ * - Port 0 drives core 0 (player 1 / host), port 1 drives core 1 (player 2 /
+ *   guest). The "mgba_dual_screen" option only picks whose picture and sound
+ *   are output; it never touches emulation state.
+ * - Player 1's save is RETRO_MEMORY_SAVE_RAM (the normal .srm). Player 2's
+ *   save lives in <save dir>/<rom>.p2.srm, written by this core (never in 2P
+ *   mode, where the save belongs to the host).
+ * - retro_serialize stores both cores, both lockstep driver blobs (player 0's
+ *   blob carries the coordinator), both save buffers, and the few pieces of
+ *   state that mGBA's savestate encodes lossily (audio FIFO countdown, DMA
+ *   control), in a fixed-size, zero-filled layout. */
+
+#include "../libretro.h"
+#include "../libretro-audio.h"
+#include "../libretro-vfs.h"
+
+#include <mgba-util/common.h>
+
+#include <mgba/core/core.h>
+#include <mgba/core/lockstep.h>
+#include <mgba/core/log.h>
+#include <mgba/core/version.h>
+#include <mgba/gba/core.h>
+#include <mgba/gba/interface.h>
+#include <mgba/internal/gba/gba.h>
+#include <mgba/internal/gba/io.h>
+#include <mgba/internal/gba/serialize.h>
+#include <mgba/internal/gba/sio/lockstep.h>
+#include <mgba-util/audio-buffer.h>
+#include <mgba-util/memory.h>
+#include <mgba-util/vfs.h>
+
+#include <stdio.h>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
+#define DUAL_PLAYERS 2
+#define DUAL_VERSION "1.0"
+#define DUAL_WIDTH GBA_VIDEO_HORIZONTAL_PIXELS
+#define DUAL_HEIGHT GBA_VIDEO_VERTICAL_PIXELS
+#define DUAL_AUDIO_CHUNK 1024
+#define DUAL_SAVE_SIZE GBA_SIZE_FLASH1M
+/* Upper bound on run-loop slices per frame; a 2-player link peaks around
+ * 1.6K (mgba-rollback measurement), so this only trips on a broken state. */
+#define DUAL_MAX_SLICES 100000
+/* Fixed RTC (2004-01-01 00:00 UTC + emulated time): netplay peers must agree. */
+#define DUAL_RTC_EPOCH_MS 1072915200000LL
+
+#define DUAL_STATE_MAGIC 0x31444748 /* "HGD1" */
+#define DUAL_STATE_VERSION 1
+
+/* Extra memory ids for test harnesses (RetroArch never asks for these). */
+#define DUAL_MEMORY_STATS 0x4844
+#define DUAL_MEMORY_WRAM 0x4810 /* + player */
+#define DUAL_MEMORY_IWRAM 0x4820 /* + player */
+#define DUAL_MEMORY_SAVE 0x4830 /* + player */
+#define DUAL_MEMORY_FRAME 0x4840 /* + player, RGB565 240x160 */
+
+struct DualUser {
+	struct mLockstepUser d;
+	int index;
+};
+
+/* Link diagnostics (not part of the savestate). */
+struct DualStats {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t frames;
+	uint32_t slicesLastFrame;
+	uint32_t slicesMax;
+	uint32_t stalls;
+	struct {
+		int32_t playerId;
+		int32_t mode;
+		uint32_t modeSets;
+		uint32_t starts;
+		uint32_t multiDone;
+		uint32_t multiFromPartner;
+		uint32_t normalDone;
+		uint32_t sleeps;
+		uint32_t frameCounter;
+		uint16_t lastMulti[4];
+		uint32_t lastNormal;
+	} p[DUAL_PLAYERS];
+};
+
+struct DualPlayer {
+	struct mCore* core;
+	struct GBASIOLockstepDriver driver;
+	struct DualUser user;
+	struct mCoreCallbacks callbacks;
+	struct GBASIOLockstepPlayer* link; /* lockstep's own record: link->asleep is the truth */
+	bool saveUpdated;
+	mColor* videoBuffer;
+	mColor* frameBuffer;
+	uint8_t* save;
+	/* Original lockstep driver entry points (wrapped for diagnostics) */
+	void (*setMode)(struct GBASIODriver*, enum GBASIOMode);
+	bool (*start)(struct GBASIODriver*);
+	void (*finishMultiplayer)(struct GBASIODriver*, uint16_t data[4]);
+	uint8_t (*finishNormal8)(struct GBASIODriver*);
+	uint32_t (*finishNormal32)(struct GBASIODriver*);
+};
+
+struct DualExtra {
+	struct {
+		uint32_t fifo[GBA_AUDIO_FIFO_SIZE];
+		int32_t write;
+		int32_t read;
+		int32_t internalRemaining;
+		int32_t reserved;
+	} fifo[2];
+	struct {
+		uint32_t reg;
+		int32_t cycles;
+		int32_t sourceOffset;
+		int32_t destOffset;
+	} dma[4];
+	uint32_t reserved[8];
+};
+
+struct DualStateHeader {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t players;
+	uint32_t coreStateSize;
+	uint32_t driverStateSize;
+	uint32_t saveSize;
+	uint32_t extraSize;
+	uint32_t reserved[9];
+};
+
+static retro_environment_t environCallback;
+static retro_video_refresh_t videoCallback;
+static retro_audio_sample_batch_t audioCallback;
+static retro_input_poll_t inputPollCallback;
+static retro_input_state_t inputCallback;
+static retro_log_printf_t logCallback;
+
+static struct DualPlayer players[DUAL_PLAYERS];
+static struct GBASIOLockstepCoordinator coordinator;
+static struct DualStats stats;
+static struct mLogger logger;
+static struct mLogFilter logFilter;
+static struct LibretroAudioConverter audioConverter;
+static int16_t audioSamples[DUAL_AUDIO_CHUNK * 2];
+static int16_t audioOut[DUAL_AUDIO_CHUNK * 2 * 2];
+static void* romData;
+static size_t romSize;
+static bool gameLoaded;
+static bool useBitmasks;
+static bool renderBoth;
+static int screenPlayer;
+static size_t coreStateSize;
+static size_t driverStateSize;
+static char p2SavePath[PATH_MAX];
+static uint8_t* p2SaveWritten;
+static size_t p2SaveWrittenSize;
+static FILE* traceFile;
+static bool biosLoaded;
+
+static const int keymap[] = {
+	RETRO_DEVICE_ID_JOYPAD_A,
+	RETRO_DEVICE_ID_JOYPAD_B,
+	RETRO_DEVICE_ID_JOYPAD_SELECT,
+	RETRO_DEVICE_ID_JOYPAD_START,
+	RETRO_DEVICE_ID_JOYPAD_RIGHT,
+	RETRO_DEVICE_ID_JOYPAD_LEFT,
+	RETRO_DEVICE_ID_JOYPAD_UP,
+	RETRO_DEVICE_ID_JOYPAD_DOWN,
+	RETRO_DEVICE_ID_JOYPAD_R,
+	RETRO_DEVICE_ID_JOYPAD_L,
+};
+
+static void _log(enum retro_log_level level, const char* fmt, ...) {
+	if (!logCallback) {
+		return;
+	}
+	char message[256];
+	va_list args;
+	va_start(args, fmt);
+	vsnprintf(message, sizeof(message), fmt, args);
+	va_end(args);
+	logCallback(level, "[mGBA Dual] %s\n", message);
+}
+
+static void _coreLog(struct mLogger* log, int category, enum mLogLevel level, const char* format, va_list args) {
+	UNUSED(log);
+	char message[160];
+	vsnprintf(message, sizeof(message), format, args);
+	if (traceFile && level == mLOG_DEBUG) {
+		fprintf(traceFile, "f=%u log %s: %s\n", stats.frames, mLogCategoryName(category), message);
+		return;
+	}
+	if (!logCallback) {
+		return;
+	}
+	enum retro_log_level retroLevel = RETRO_LOG_INFO;
+	switch (level) {
+	case mLOG_FATAL:
+	case mLOG_ERROR:
+		retroLevel = RETRO_LOG_ERROR;
+		break;
+	case mLOG_WARN:
+		retroLevel = RETRO_LOG_WARN;
+		break;
+	default:
+		break;
+	}
+	logCallback(retroLevel, "%s: %s\n", mLogCategoryName(category), message);
+}
+
+/* --- lockstep user: cooperative, only flips a flag --- */
+
+/* The lockstep driver force-exits a sleeping core's run slice by itself
+ * (cpu->nextEvent = 0 + GBAInterrupt); retro_run then skips it while
+ * players[i].link->asleep is set. Nothing has to block here. */
+static void _userSleep(struct mLockstepUser* user) {
+	struct DualUser* u = (struct DualUser*) user;
+	++stats.p[u->index].sleeps;
+}
+
+static void _userWake(struct mLockstepUser* user) {
+	UNUSED(user);
+}
+
+static int _userRequestedId(struct mLockstepUser* user) {
+	return ((struct DualUser*) user)->index;
+}
+
+static void _userPlayerIdChanged(struct mLockstepUser* user, int id) {
+	struct DualUser* u = (struct DualUser*) user;
+	stats.p[u->index].playerId = id;
+}
+
+/* --- diagnostic wrappers around the lockstep driver --- */
+
+static int _driverIndex(struct GBASIODriver* driver) {
+	return driver == &players[1].driver.d ? 1 : 0;
+}
+
+static void _wrapSetMode(struct GBASIODriver* driver, enum GBASIOMode mode) {
+	int i = _driverIndex(driver);
+	++stats.p[i].modeSets;
+	stats.p[i].mode = mode;
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d mode %d\n", stats.frames, i, (int) mode);
+	}
+	players[i].setMode(driver, mode);
+}
+
+static bool _wrapStart(struct GBASIODriver* driver) {
+	int i = _driverIndex(driver);
+	bool started = players[i].start(driver);
+	if (started) {
+		++stats.p[i].starts;
+		if (traceFile) {
+			const uint16_t* io = ((struct GBA*) players[i].core->board)->memory.io;
+			fprintf(traceFile, "f=%u p%d start send=%04X d8=%02X d32=%04X%04X\n", stats.frames, i,
+			        io[GBA_REG(SIOMLT_SEND)], io[GBA_REG(SIODATA8)] & 0xFF,
+			        io[GBA_REG(SIODATA32_HI)], io[GBA_REG(SIODATA32_LO)]);
+		}
+	}
+	return started;
+}
+
+static void _wrapFinishMultiplayer(struct GBASIODriver* driver, uint16_t data[4]) {
+	int i = _driverIndex(driver);
+	players[i].finishMultiplayer(driver, data);
+	++stats.p[i].multiDone;
+	memcpy(stats.p[i].lastMulti, data, sizeof(stats.p[i].lastMulti));
+	if (data[1 - i] != 0xFFFF) {
+		++stats.p[i].multiFromPartner;
+	}
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d multi %04X %04X %04X %04X\n", stats.frames, i, data[0], data[1], data[2], data[3]);
+	}
+}
+
+static uint8_t _wrapFinishNormal8(struct GBASIODriver* driver) {
+	int i = _driverIndex(driver);
+	uint8_t data = players[i].finishNormal8(driver);
+	++stats.p[i].normalDone;
+	stats.p[i].lastNormal = data;
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d normal8 %02X\n", stats.frames, i, data);
+	}
+	return data;
+}
+
+static uint32_t _wrapFinishNormal32(struct GBASIODriver* driver) {
+	int i = _driverIndex(driver);
+	uint32_t data = players[i].finishNormal32(driver);
+	++stats.p[i].normalDone;
+	stats.p[i].lastNormal = data;
+	if (traceFile) {
+		fprintf(traceFile, "f=%u p%d normal32 %08X\n", stats.frames, i, data);
+	}
+	return data;
+}
+
+/* --- per-core callbacks --- */
+
+/* Core 1 is not frame-aligned with retro_run: keep its last finished frame */
+static void _frameEnded(void* context) {
+	struct DualPlayer* player = context;
+	if (player == &players[1] && (screenPlayer == 1 || renderBoth)) {
+		memcpy(player->frameBuffer, player->videoBuffer, DUAL_WIDTH * DUAL_HEIGHT * sizeof(mColor));
+	}
+}
+
+static void _savedataUpdated(void* context) {
+	struct DualPlayer* player = context;
+	player->saveUpdated = true;
+}
+
+/* --- options --- */
+
+static const char* _getVariable(const char* key) {
+	struct retro_variable var = { .key = key, .value = NULL };
+	if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		return var.value;
+	}
+	return NULL;
+}
+
+static void _readScreenOption(void) {
+	const char* value = _getVariable("mgba_dual_screen");
+	int newScreen = (value && strcmp(value, "2P") == 0) ? 1 : 0;
+	if (newScreen != screenPlayer && gameLoaded) {
+		mAudioBufferClear(players[newScreen].core->getAudioBuffer(players[newScreen].core));
+		audioConverterReset(&audioConverter, players[newScreen].core->audioSampleRate(players[newScreen].core));
+		memcpy(players[newScreen].frameBuffer, players[newScreen].videoBuffer, DUAL_WIDTH * DUAL_HEIGHT * sizeof(mColor));
+	}
+	screenPlayer = newScreen;
+}
+
+/* --- player 2 save file (.p2.srm) --- */
+
+static size_t _saveSize(int i) {
+	struct GBA* gba = players[i].core->board;
+	if (gba->memory.savedata.type == GBA_SAVEDATA_AUTODETECT) {
+		return DUAL_SAVE_SIZE;
+	}
+	return GBASavedataSize(&gba->memory.savedata);
+}
+
+static void _loadP2Save(void) {
+	memset(players[1].save, 0xFF, DUAL_SAVE_SIZE);
+	if (!p2SavePath[0]) {
+		return;
+	}
+	FILE* f = fopen(p2SavePath, "rb");
+	if (!f) {
+		_log(RETRO_LOG_INFO, "no 2P save yet: %s", p2SavePath);
+		return;
+	}
+	size_t got = fread(players[1].save, 1, DUAL_SAVE_SIZE, f);
+	fclose(f);
+	_log(RETRO_LOG_INFO, "2P save loaded (%u bytes): %s", (unsigned) got, p2SavePath);
+	p2SaveWrittenSize = got;
+	memcpy(p2SaveWritten, players[1].save, DUAL_SAVE_SIZE);
+}
+
+static void _writeP2Save(bool force) {
+	if (screenPlayer == 1 || !p2SavePath[0]) {
+		/* 2P (guest) mode: the 2P save belongs to the host device */
+		return;
+	}
+	size_t size = _saveSize(1);
+	if (!force && size == p2SaveWrittenSize && !memcmp(p2SaveWritten, players[1].save, size)) {
+		return;
+	}
+	if (p2SaveWrittenSize == 0) {
+		/* Nothing on disk yet: only create the file once the game wrote something */
+		size_t i;
+		for (i = 0; i < size && players[1].save[i] == 0xFF; ++i);
+		if (i == size) {
+			return;
+		}
+	}
+	char tmpPath[PATH_MAX + 8];
+	snprintf(tmpPath, sizeof(tmpPath), "%s.tmp", p2SavePath);
+	FILE* f = fopen(tmpPath, "wb");
+	if (!f) {
+		_log(RETRO_LOG_ERROR, "cannot write 2P save: %s", tmpPath);
+		return;
+	}
+	bool ok = fwrite(players[1].save, 1, size, f) == size;
+	ok = fflush(f) == 0 && ok;
+#ifndef _WIN32
+	ok = fsync(fileno(f)) == 0 && ok;
+#endif
+	ok = fclose(f) == 0 && ok;
+	if (!ok || rename(tmpPath, p2SavePath) != 0) {
+		_log(RETRO_LOG_ERROR, "2P save write failed: %s", p2SavePath);
+		remove(tmpPath);
+		return;
+	}
+	memcpy(p2SaveWritten, players[1].save, size);
+	p2SaveWrittenSize = size;
+	_log(RETRO_LOG_INFO, "2P save written (%u bytes): %s", (unsigned) size, p2SavePath);
+}
+
+static void _setP2SavePath(const struct retro_game_info* game) {
+	p2SavePath[0] = '\0';
+	if (!game->path || !game->path[0]) {
+		return;
+	}
+	const char* base = strrchr(game->path, '/');
+#ifdef _WIN32
+	const char* base2 = strrchr(game->path, '\\');
+	if (base2 > base) {
+		base = base2;
+	}
+#endif
+	base = base ? base + 1 : game->path;
+	char name[PATH_MAX];
+	snprintf(name, sizeof(name), "%s", base);
+	char* dot = strrchr(name, '.');
+	if (dot && dot != name) {
+		*dot = '\0';
+	}
+	const char* dir = NULL;
+	char romDir[PATH_MAX];
+	if (!environCallback(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &dir) || !dir || !dir[0]) {
+		snprintf(romDir, sizeof(romDir), "%.*s", (int) (base - game->path), game->path);
+		dir = romDir;
+	}
+	size_t len = strlen(dir);
+	snprintf(p2SavePath, sizeof(p2SavePath), "%s%s%s.p2.srm", dir, (len && dir[len - 1] != '/') ? "/" : "", name);
+}
