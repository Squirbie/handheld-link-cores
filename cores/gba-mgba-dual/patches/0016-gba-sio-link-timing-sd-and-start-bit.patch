 	if (value != DUAL_STATE_VERSION && value != 2 && value != 3) {
 		return false;
 	}
@@ -1285,6 +1295,7 @@ bool retro_unserialize(const void* data, size_t size) {
 
 	uint32_t ownVersion;
 	LOAD_32LE(ownVersion, 0, &header->version);
+	ownVersion &= ~DUAL_STATE_LINK14;
 	if (ownVersion >= 2 && hb_u32((const uint8_t*)header->reserved + 16) > DUAL_SAVE_SIZE) return false;
 	const uint8_t* base = (const uint8_t*) data + sizeof(*header);
 	size_t stride = _playerStateSize();
