 #define DUAL_AUDIO_CHUNK 1024
@@ -68,6 +71,7 @@
 
 #define DUAL_STATE_MAGIC 0x31444748 /* "HGD1" */
 #define DUAL_STATE_VERSION 1
+#define DUAL_STATE_LINK14 0x100
