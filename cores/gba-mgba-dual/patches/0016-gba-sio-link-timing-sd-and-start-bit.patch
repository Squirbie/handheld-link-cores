 /* Extra memory ids for test harnesses (RetroArch never asks for these). */
@@ -1191,7 +1195,7 @@ bool retro_serialize(void* data, size_t size) {
 	memset(data, 0, total);
 	struct DualStateHeader* header = data;
 	STORE_32LE(DUAL_STATE_MAGIC, 0, &header->magic);
-	STORE_32LE(hb_has_token() ? 3 : DUAL_STATE_VERSION, 0, &header->version);
+	STORE_32LE((hb_has_token() ? 3 : DUAL_STATE_VERSION) | (linkOn ? DUAL_STATE_LINK14 : 0), 0, &header->version);
 	memcpy(header->reserved, hb_own_token, 16);
 	hb_put32((uint8_t*)header->reserved + 16, hb_own_save_hint);
 	hb_put32((uint8_t*)header->reserved + 20, hb_has_token() ? hb_own_frame : 0);
@@ -1258,6 +1262,12 @@ bool retro_unserialize(const void* data, size_t size) {
 		return false;
 	}
 	LOAD_32LE(value, 0, &header->version);
+	if (!!(value & DUAL_STATE_LINK14) != linkOn) {
+		/* 두 대 상태인데 1.4 표시가 없음 = 1.3 이하 코어가 만든 상태(넷플레이 상대가 옛 판) */
+		_log(RETRO_LOG_ERROR, "state from a different link-timing version (1.3 vs 1.4); update both devices");
