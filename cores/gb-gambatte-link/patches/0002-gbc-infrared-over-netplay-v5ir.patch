+#define HB_IR_LAG_DEF 4096UL     /* units of 1/4194304 s: 0.98 ms seen-delay each way (Mystery Gift runs at
+                                  * double speed: 256 ticks = 16384 units for an answer, 3904 of them its own pause) */
