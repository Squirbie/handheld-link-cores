+      if (changed || t - ir_last_rep_ >= ir_lag_ / 4) irReport(t, 0);
+   }
+   virtual bool irRead(unsigned long abs, bool ds)
+   {
+      uint64_t t = irTime(abs, ds);
+      if (!irLinked() || !ir_act_) return false;
+      ir_last_rd_any_ = t;
+      if (!ir_reading_) { ir_reading_ = true; irReport(t, 0); }   /* tell the other side we listen now */
+      else if (!ir_act_sent_) irReport(t, 0);   /* port was turned on before the room linked */
+      if (ir_map_ != 2) {
+         /* meet only a Game Boy that listens too: a port left on in a menu (Pokemon Pinball after a
+          * send) must not freeze this one at the meeting point */
