+         irEnd("peer-rewind"); ir_ps_ok_ = false;
+      }
+      ir_prt_ = rt; ir_prt_seen_ = true; ir_pact_ = (p[2] & 1) != 0; ir_pread_ = (p[2] & 2) != 0; ir_pled_ = p[3] & 1;
