+      }
+      uint64_t need = t > ir_lag_ ? t - ir_lag_ : 0;
+      irApply(need);
+      if (ir_map_ != 2) return false;
+      if (irFrontier() < (int64_t)need) {
+         irReport(t, 0);                 /* tell the other side where this one waits */
+         ++ir_waits_;
+         unsigned long w0 = now_ms();
+         unsigned long deadline = now_ms() + HB_IR_WAIT_MS;
+         for (;;) {
+            poll_fn_();
+            irApply(need);
+            if (ir_map_ != 2) return false;
+            if (irFrontier() >= (int64_t)need) { if (now_ms() - w0 >= 20) tr("ir-waited", (unsigned)(now_ms() - w0), 0, (unsigned)t); break; }
+            if (!irLinked()) { irEnd("left"); return false; }
+            if (now_ms() > deadline) { irEnd("wait-timeout"); return false; }
+            irRefresh();
+            sleep_us(100);
