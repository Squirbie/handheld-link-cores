+         irRefresh();
+         sleep_us(100);
+      }
+   }
+   void irRefresh()
+   {
+      unsigned long n = now_ms();
+      if (ir_refresh_ && n - ir_refresh_ms_ >= 16) { ir_refresh_ms_ = n; ir_refresh_(); }
+   }
+   void irEnd(const char *why)
+   {
+      if (ir_map_ != 0) tr(why, ir_my_bs_, 0, ir_map_pbs_);
+      ir_map_ = 0; ir_off_ = 0; ir_seen_led_ = false; ir_off_valid_ = false;
