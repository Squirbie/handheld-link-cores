+private:
+   struct IrEv { uint64_t rt; unsigned char act, led; };
+   bool irLinked() const { return send_fn_ != NULL && peer_ >= 0; }
+   void irReset()
+   {
+      ir_abs_set_ = false; ir_abs_ = 0; ir_ds_ = false; ir_rt_ = 0;
+      ir_act_ = false; ir_led_ = 0; ir_act_sent_ = false; ir_last_rep_ = 0;
+      ir_pact_ = false; ir_prt_ = 0; ir_prt_seen_ = false; ir_pled_ = 0;
+      ir_qh_ = ir_qt_ = 0; ir_map_ = 0; ir_off_ = 0; ir_seen_led_ = false;
