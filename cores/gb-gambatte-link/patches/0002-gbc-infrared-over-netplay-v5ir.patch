+         if (!is_host_ && ir_t_ok_) {
+            ir_off_ = (int64_t)ir_my_s_ - (int64_t)ir_t_rt_;
+            ir_map_ = 2; ir_map_pbs_ = ir_t_bs_; ir_backoff_ms_ = 0; ir_t_ok_ = false;
