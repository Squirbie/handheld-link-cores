diff --git a/src/core/sync_file.h b/src/core/sync_file.h
new file mode 100644
index 0000000..b16ad22
--- /dev/null
+++ b/src/core/sync_file.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// DSperate - Nintendo DS emulator. Copyright (C) 2026 DSperate contributors.
+//
+// hbfam (hanbang): write-then-rename that survives a power cut.
+//
+// Battery saves, save states and the firmware settings sidecar are written
+// to <file>.tmp and renamed over the old file, so a cut mid-write leaves the
+// previous one -- but only if the new bytes are on the card before the
+// rename is. Without fsync both wait in the page cache (or in the FUSE
+// daemon, for an exFAT card) and can land in either order, and a handheld
+// is switched off by its power button or a flat battery, not shut down:
+// ext4's delayed allocation and exFAT can leave an empty or torn file where
+// the old one was. So the file is flushed and fsynced before the rename and
+// its directory fsynced after it. Nothing else about the writes changes.
+#pragma once
+
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace ds {
+
+namespace detail {
+inline void fsync_fd(int fd, const char* what) {
+  // A filesystem without fsync (a FUSE daemon that never implemented it)
+  // already reads as success here: the kernel turns its ENOSYS into 0.
+  if (::fsync(fd) != 0) std::fprintf(stderr, "sync: %s: %s\n", what, std::strerror(errno));
+}
+} // namespace detail
+
+// The FILE's buffered bytes written out and on the medium, before the rename.
+// False only when the write itself failed (a full card): fclose used to
+// swallow that, and the rename then put a short file in place of a good one.
+// A failed fsync is logged, not a failure: the bytes were written, and
+// keeping the old file instead would not make it any safer.
+inline bool sync_file(std::FILE* f, const std::string& path) {
+  if (std::fflush(f) != 0) return false;
+  detail::fsync_fd(::fileno(f), path.c_str());
+  return true;
+}
+
+// The same for a file already closed (std::ofstream has no descriptor).
+inline void sync_path(const std::string& path) {
+  const int fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+  if (fd < 0) return;
+  detail::fsync_fd(fd, path.c_str());
+  ::close(fd);
+}
+
+// After a rename into it: the directory holding `path`, so the new name is
+// on the medium too. Best effort; not every filesystem syncs a directory.
+inline void sync_parent_dir(const std::string& path) {
+  const size_t slash = path.find_last_of('/');
+  const std::string dir = slash == std::string::npos ? std::string(".") : slash == 0 ? std::string("/") : path.substr(0, slash);
+  const int fd = ::open(dir.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (fd < 0) return;
+  ::fsync(fd);
+  ::close(fd);
+}
+
+} // namespace ds
