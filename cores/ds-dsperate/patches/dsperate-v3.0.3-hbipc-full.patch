+// ---- lanfix: ENet throttle, stats --------------------------------------------
+// ENet drops *unreliable* sends at random (enet_protocol_check_outgoing_commands)
+// once its packet throttle falls below ENET_PEER_PACKET_THROTTLE_SCALE, and it
+// lowers the throttle whenever a ping's round trip comes back slower than the
+// last 5 s minimum plus twice its variance. Every MP frame here is unreliable
+// (UNSEQUENCED), and a handheld only services ENet between bursts of emulation,
+// so a slow frame or a present is enough to cost CMDs, replies and acks. Pin it
+// at full scale; DSPERATE_MP_ENET_THROTTLE=1 = stock. Either way thr_fix counts
+// the sends/frames that found it lowered, thr_min the lowest value seen.
+void LanMp::pin_throttle() {
+  if (!host_) return;
+  for (size_t i = 0; i < host_->peerCount; ++i) {
+    ENetPeer& p = host_->peers[i];
+    if (p.state != ENET_PEER_STATE_CONNECTED) continue;
+    if (p.packetThrottle < ENET_PEER_PACKET_THROTTLE_SCALE) {
+      st_.thr_fix++;
+      if (p.packetThrottle < st_.thr_min) st_.thr_min = p.packetThrottle;
+      if (!enet_throttle_) p.packetThrottle = ENET_PEER_PACKET_THROTTLE_SCALE;
+    }
+    if (!enet_throttle_ && p.packetThrottleLimit < ENET_PEER_PACKET_THROTTLE_SCALE) p.packetThrottleLimit = ENET_PEER_PACKET_THROTTLE_SCALE;
+  }
+}
