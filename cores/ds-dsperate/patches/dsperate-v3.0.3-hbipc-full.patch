+// ---- hbfam3: lonely hosts meet (lan_mp.h) ------------------------------------
+static std::set<u32> local_ipv4s() {
+  std::set<u32> out;
+  ifaddrs* ifs = nullptr;
+  if (::getifaddrs(&ifs) != 0) return out;
+  for (ifaddrs* i = ifs; i; i = i->ifa_next) {
+    if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET) continue;
+    out.insert(ntohl(reinterpret_cast<sockaddr_in*>(i->ifa_addr)->sin_addr.s_addr));
+  }
+  ::freeifaddrs(ifs);
+  return out;
+}
+
+u32 LanMp::lonely_host_should_join(std::string* name) {
+  if (!active_ || !is_host_ || num_players_ > 1 || discovery_fd_ < 0) { lonely_fresh_ = false; return 0; }
+  const u32 now = ms_now();
+  if (static_cast<int32_t>(now - lonely_next_ms_) < 0) return 0;
+  lonely_next_ms_ = now + 1000;
+  if (!lonely_fresh_) {
+    // Beacons that queued up while we were not looking (we had guests, or
+    // just started) may be from a host long gone: drop them, look next time.
+    char buf[256];
+    while (::recv(discovery_fd_, buf, sizeof buf, MSG_DONTWAIT) > 0) {}
+    { std::lock_guard<std::mutex> l(sessions_mutex_); sessions_.clear(); }
+    local_ips_ = local_ipv4s();
+    lonely_fresh_ = true;
+    return 0;
+  }
+  poll_discovery(now);
+  std::lock_guard<std::mutex> l(sessions_mutex_);
+  for (const auto& [ip, s] : sessions_) {
+    if (local_ips_.count(ip)) continue;                      // our own beacon
+    if (!lan_session_in_group(s.name, group_)) continue;     // another game's
+    if (s.num_players >= s.max_players) continue;
+    u32 mine = 0;                                            // our address on its network
+    for (u32 a : local_ips_) if ((a >> 8) == (ip >> 8)) { mine = a; break; }
+    if (!mine) continue;
+    if (s.num_players > 1 || ip < mine) { if (name) *name = s.name; return ip; }
+  }
+  return 0;
+}
