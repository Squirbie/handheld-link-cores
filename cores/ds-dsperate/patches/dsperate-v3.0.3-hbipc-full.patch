+// hbfix18: a see-through window over a quarter of the frame or more -- the hbpop popup, 480x360 of 640x480 --
+// blends by reading the frame back, and on the scanout tiers that memory is uncached (fb0, CMA): on the H700
+// a frame's present is 0.2-0.3 ms with an opaque small window and 1.0-1.2 ms with the 160x120 see-through
+// one (10/13-14 logs); the popup has nine times its pixels. While one shows, take_frame stages the frame.
+// The small window alone stays drawn in place. HB_POPUP_DIRECT=1: the popup in place too (to compare).
+bool Display::stage_wanted() const {
+  static const bool off = std::getenv("HB_POPUP_DIRECT") != nullptr;
+  if (off || !scaled_ || inset_alpha_ == 255) return false;
+  const long area = static_cast<long>(scaled_w_) * scaled_h_;
+  for (int i = 0; i < nviews_; ++i) {
+    const View& v = views_[i];
+    if (!v.direct && v.shown && 4L * v.rect.w * v.rect.h >= area) return true;
+  }
+  return false;
+}
