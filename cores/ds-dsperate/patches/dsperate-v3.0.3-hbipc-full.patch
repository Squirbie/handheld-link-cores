+// 256) are the copies they amount to. 8 pixels a step (both loads before the stores: out may be under); the last
+// 0..7 through blend_row3.
+void Display::blend_row3_neon(u32* out, const u32* under, const u32* over, size_t n, u32 alpha) {
+#if HB19_NEON
+  const u32 a = alpha + (alpha >> 7), b = 256 - a;
+  if (a == 0 || a == 256) {
+    const u32* from = a ? over : under;
+    for (size_t i = 0; i < n; ++i) out[i] = 0xFF000000u | from[i];
+    return;
+  }
+  const uint8x8_t va = vdup_n_u8(static_cast<u8>(a)), vb = vdup_n_u8(static_cast<u8>(b));
+  const uint8x16_t qa = vdupq_n_u8(static_cast<u8>(a)), qb = vdupq_n_u8(static_cast<u8>(b));
+  const uint32x4_t opaque = vdupq_n_u32(0xFF000000u);
+  size_t i = 0;
+  for (; i + 8 <= n; i += 8) {
+    const uint8x16_t s0 = vreinterpretq_u8_u32(vld1q_u32(over + i)), s1 = vreinterpretq_u8_u32(vld1q_u32(over + i + 4));
+    const uint8x16_t d0 = vreinterpretq_u8_u32(vld1q_u32(under + i)), d1 = vreinterpretq_u8_u32(vld1q_u32(under + i + 4));
+    const uint16x8_t l0 = vmlal_u8(vmull_u8(vget_low_u8(s0), va), vget_low_u8(d0), vb);
+    const uint16x8_t h0 = vmlal_high_u8(vmull_high_u8(s0, qa), d0, qb);
+    const uint16x8_t l1 = vmlal_u8(vmull_u8(vget_low_u8(s1), va), vget_low_u8(d1), vb);
+    const uint16x8_t h1 = vmlal_high_u8(vmull_high_u8(s1, qa), d1, qb);
+    vst1q_u32(out + i, vorrq_u32(vreinterpretq_u32_u8(vshrn_high_n_u16(vshrn_n_u16(l0, 8), h0, 8)), opaque));
+    vst1q_u32(out + i + 4, vorrq_u32(vreinterpretq_u32_u8(vshrn_high_n_u16(vshrn_n_u16(l1, 8), h1, 8)), opaque));
+  }
+  if (i < n) blend_row3(out + i, under + i, over + i, n - i, alpha);
+#else
+  blend_row3(out, under, over, n, alpha);
+#endif
+}
+
+void Display::blend_row_neon(u32* dst, const u32* src, size_t n, u32 alpha) { blend_row3_neon(dst, dst, src, n, alpha); }
+
+// hbfix19 (display.h): one ghost row from source rows src, src + pitch, src + 2 pitch, every box 3x3 (ghost pixel gx
+// = source columns 3gx..3gx+2): the generic loop's values -- each channel's 9-pixel sum floored by 9, here
+// (s * 7282) >> 16, which equals s / 9 for every s <= 9 * 255 (all 2296 checked). r and b are summed as the two
+// 16-bit halves of a word (each sum <= 2295), g on its own. 4 ghost pixels a step (vld3: the three columns apart).
+void Display::ghost_row3(const u32* src, size_t pitch, int gw, u32* out) {
+  const u32* const rows[3] = {src, src + pitch, src + 2 * pitch};
+  int gx = 0;
+#if HB19_NEON
+  const uint32x4_t mrb = vdupq_n_u32(0x00FF00FFu), mg = vdupq_n_u32(0x0000FF00u), opaque = vdupq_n_u32(0xFF000000u);
+  const uint16x8_t k = vdupq_n_u16(7282);
+  for (; gx + 4 <= gw; gx += 4) {
+    uint32x4_t rb = vdupq_n_u32(0), g = vdupq_n_u32(0);
+    for (const u32* r : rows) {
+      const uint32x4x3_t c = vld3q_u32(r + 3 * gx);
+      for (int t = 0; t < 3; ++t) { rb = vaddq_u32(rb, vandq_u32(c.val[t], mrb)); g = vaddq_u32(g, vandq_u32(c.val[t], mg)); }
+    }
+    const uint16x8_t rb16 = vreinterpretq_u16_u32(rb);   // each lane: b's sum, r's sum
+    const uint16x8_t q = vcombine_u16(vshrn_n_u32(vmull_u16(vget_low_u16(rb16), vget_low_u16(k)), 16), vshrn_n_u32(vmull_high_u16(rb16, k), 16));
+    const uint32x4_t gq = vshrq_n_u32(vmulq_n_u32(vshrq_n_u32(g, 8), 7282u), 16);
+    vst1q_u32(out + gx, vorrq_u32(vorrq_u32(vreinterpretq_u32_u16(q), vshlq_n_u32(gq, 8)), opaque));
+  }
+#endif
+  for (; gx < gw; ++gx) {
+    u32 rb = 0, g = 0;
+    for (const u32* r : rows)
+      for (int t = 0; t < 3; ++t) { const u32 p = r[3 * gx + t]; rb += p & 0x00FF00FFu; g += p & 0x0000FF00u; }
+    out[gx] = 0xFF000000u | ((((rb >> 16) * 7282u) >> 16) << 16) | ((((g >> 8) * 7282u) >> 16) << 8) | (((rb & 0xFFFFu) * 7282u) >> 16);
+  }
+}
+
+// hbfix19 (display.h): scanout memory is write-combined or uncached, where whole 64-byte lines are what the bus
+// takes best; these are memcpy's bytes, written 64 at an instruction.
+void Display::copy_row_neon(u32* dst, const u32* src, size_t n) {
+  size_t i = 0;
+#if HB19_NEON
+  for (; i + 16 <= n; i += 16) vst1q_u32_x4(dst + i, vld1q_u32_x4(src + i));
+  for (; i + 4 <= n; i += 4) vst1q_u32(dst + i, vld1q_u32(src + i));
+#endif
+  for (; i < n; ++i) dst[i] = src[i];
+}
