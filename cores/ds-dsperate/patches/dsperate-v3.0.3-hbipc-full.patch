+// hbfix19: the deferred popup blended into the frame now, as blit_insets would have (canvas() is handing the frame
+// out to be drawn on, and what is drawn must land on the popup); present() then copies the rows plainly.
+void Display::popup_materialize() {
+  if (pop_view_ < 0) return;
+  const bool timed = pop_timing();
+  const u64 t0 = timed ? SDL_GetPerformanceCounter() : 0;
+  if (pop_view_ < nviews_ && frame_px_) {
+    const View& v = views_[pop_view_];
+    const std::vector<u32>& side = side_[v.screen];
+    for (const PopSpan& s : pop_spans_) {
+      if (side.size() < static_cast<size_t>(s.y + 1) * v.rect.w) break;
+      u32* d = frame_px_ + static_cast<size_t>(s.fy) * frame_pitch_ + v.rect.x + s.a0;
+      const u32* p = side.data() + static_cast<size_t>(s.y) * v.rect.w + s.a0;
+      if (fast_blend()) blend_row_neon(d, p, static_cast<size_t>(s.a1 - s.a0), pop_alpha_);
+      else blend_row(d, p, static_cast<size_t>(s.a1 - s.a0), pop_alpha_);
+    }
+  }
+  pop_view_ = -1; pop_spans_.clear();
+  if (timed) pop_t_.blend += SDL_GetPerformanceCounter() - t0;
+}
