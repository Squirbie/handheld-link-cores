+// hbfam: screen_swap_hold is held like fast_forward -- no queued action, a
+// flag that follows the control, be it an axis (the RG35XX's L2 is
+// +lefttrigger) or a button -- and a release that completes no binding (the
+// modifier let go first) still ends it. Unbound by default, appended after
+// every older action so their names, defaults and order are untouched.
+void test_screen_swap_hold() {
+  const int hold = static_cast<int>(Action::ScreenSwapHold);
+  CHECK(hold == Input::action_count() - 1);
+  CHECK(std::string(action_name(Action::ScreenSwapHold)) == "screen_swap_hold");
+  CHECK(std::string(action_name(Action::FpsToggle)) == "fps" && std::string(action_name(Action::ScreenSwap)) == "screen_swap");
+  CHECK(std::string(Input::key_hot_default(hold)) == "none" && std::string(Input::pad_hot_default(hold)) == "none");
+  { Rig r; Input& in = r.go();                                      // unbound: L2 is nobody's
+    CHECK(!T::pad_axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, false, true));
+    CHECK(!in.screen_swap_held()); }
+  { Rig r; Input& in = r.set("padhotkeys.screen_swap_hold", "+lefttrigger").go();
+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 32767);            // L2 down
+    CHECK(in.screen_swap_held() && in.take_actions().empty());
+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 30000);            // still down: no new edge
+    CHECK(in.screen_swap_held());
+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 0);                // up
+    CHECK(!in.screen_swap_held() && in.take_actions().empty()); }
+  { Rig r; Input& in = r.set("padhotkeys.screen_swap_hold", "l2").go();   // the alias names the same axis
+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 32767); CHECK(in.screen_swap_held());
+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 0);     CHECK(!in.screen_swap_held()); }
+  { Rig r; Input& in = r.set("padhotkeys.screen_swap_hold", "misc1").set("hotkeys.screen_swap_hold", "h").go();
+    CHECK(T::pad(in, SDL_CONTROLLER_BUTTON_MISC1, true));  CHECK(in.screen_swap_held());
+    CHECK(T::pad(in, SDL_CONTROLLER_BUTTON_MISC1, false)); CHECK(!in.screen_swap_held());
+    CHECK(T::key(in, SDLK_h, true));  CHECK(in.screen_swap_held());
+    CHECK(T::key(in, SDLK_h, false)); CHECK(!in.screen_swap_held());
+    CHECK(in.take_actions().empty()); }
+  // Under the modifier: let go of the modifier first, and the release still ends it.
+  { Rig r; Input& in = r.set("padhotkeys.modifier", "guide").set("padhotkeys.screen_swap_hold", "mod+dpup").go();
+    T::pad(in, SDL_CONTROLLER_BUTTON_GUIDE, true);
+    T::pad(in, SDL_CONTROLLER_BUTTON_DPAD_UP, true);
+    CHECK(in.screen_swap_held());
+    CHECK((in.frame().buttons & (1u << B::BTN_UP)) == 0);          // withheld from the game
+    T::pad(in, SDL_CONTROLLER_BUTTON_GUIDE, false);
+    CHECK(in.screen_swap_held());
+    T::pad(in, SDL_CONTROLLER_BUTTON_DPAD_UP, false);
+    CHECK(!in.screen_swap_held()); }
