+// hbfam (hanbang): whether a LAN session is "live" for the frontend -- the
+// state in which save states, fast forward, frameskip, speed and reset are
+// withheld and the pause menu stops being a pause. A guest is live from the
+// moment it joins. A host is live only while a guest is in its session:
+// num_players() counts the host itself plus every guest connected (from the
+// guest's ENet connect to its disconnect), so 1 is a host alone, which is
+// single play with the door open (net.mode auto falls back to it whenever
+// nobody else is on the LAN yet).
+inline bool lan_session_live(bool is_host, int num_players) { return !is_host || num_players > 1; }
+
+// hbfam2 (hanbang): LAN groups. The beacon has no field for one, so the
+// group rides at the end of the session name, the only free text in it:
+// "<player>'s game [<group>]". The wire format stays melonDS's; a melonDS
+// or a stock DSperate just shows the longer name (and, not filtering, may
+// still join), while a grouped console here passes their untagged sessions by.
+// The name field holds 63 bytes: the group always goes in whole, at most
+// kLanGroupMax bytes of it, and the player's name is what gets cut (both on
+// a UTF-8 character boundary).
+constexpr size_t kLanGroupMax = 40;
+std::string lan_group_fit(const std::string& group);   // at most kLanGroupMax bytes
+std::string lan_session_name(const std::string& player, const std::string& group);
+// Whether a session heard is one of `group`'s: its name ends in exactly
+// " [<group>]", so neither "pkm" nor "xpkm5" passes for "pkm5". No group
+// (empty): every session is.
+bool lan_session_in_group(const std::string& session_name, const std::string& group);
+
