+namespace {
+// The longest head of `s` of at most n bytes that ends on a UTF-8 character
+// boundary: a cut never leaves half a character (a file name may be Korean).
+std::string utf8_head(const std::string& s, size_t n) {
+  if (n >= s.size()) return s;
+  while (n > 0 && (static_cast<unsigned char>(s[n]) & 0xC0) == 0x80) --n;
+  return s.substr(0, n);
+}
+} // namespace
+
+std::string lan_group_fit(const std::string& group) { return utf8_head(group, kLanGroupMax); }
