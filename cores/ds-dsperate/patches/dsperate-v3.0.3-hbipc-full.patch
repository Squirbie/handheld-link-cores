+// ---- hbmp: pauses between LAN slices (lan_mp.h) ------------------------------
+bool LanMp::host_frame_queued() const {
+  if (rx_.empty()) return false;
+  const u32 kind = reinterpret_cast<const MpPacketHeader*>(rx_.front()->data)->type & 0xFFFF;
+  return kind == 1 || kind == 3;   // CMD or ACK: only an MP client receives these
+}
+
+bool LanMp::idle_wait(double ms) {
+  if (!host_) return false;
+  using clock = std::chrono::steady_clock;
+  const auto t0 = clock::now();
+  const auto until = t0 + std::chrono::duration_cast<clock::duration>(std::chrono::duration<double, std::milli>(ms > 0 ? ms : 0));
+  bool woke = false;
+  for (int n = 0;; ++n) {
+    process_lan(0);   // what has come: ENet's own traffic and its MP frames (hbguest2: all of them), stamped as process() does
+    if (host_frame_queued()) { woke = true; break; }
+    const auto now = clock::now();
+    if (now >= until) break;
+    if (n >= 64) { std::this_thread::sleep_until(until); break; }   // a flood of other traffic: sleep as stock did
+    const long long left = std::chrono::duration_cast<std::chrono::nanoseconds>(until - now).count();
+    timespec ts{static_cast<time_t>(left / 1000000000LL), static_cast<long>(left % 1000000000LL)};
+    pollfd p{static_cast<int>(host_->socket), POLLIN, 0};
+    if (::ppoll(&p, 1, &ts, nullptr) < 0 && errno != EINTR) { std::this_thread::sleep_until(until); break; }
+  }
+  st_.idle_n++; st_.idle_ms += ms_since(t0);
+  if (woke) st_.wake++;
+  return woke;
+}
+
+// ---- hbmp horizon (lan_mp.h) -----------------------------------------------
+void LanMp::send_hello(ENetPeer* peer) {
+  if (!horizon_on_ || !peer) return;
+  u8 cmd[9];
+  cmd[0] = Cmd_HbHello; put32(cmd + 1, kHbMagic); put32(cmd + 5, 1);
+  enet_peer_send(peer, Chan_Cmd, enet_packet_create(cmd, sizeof cmd, ENET_PACKET_FLAG_RELIABLE));
+}
+
+void LanMp::horizon_forget(int id) {
+  if (id < 0 || id >= 16) return;
+  horizon_peers_ &= static_cast<u16>(~(1u << id));
+  recv_n_[id] = 0; recv_last_ts_[id] = 0;
+  if (horizon_from_ == id) { horizon_from_ = -1; horizon_t_ = 0; }
+}
+
+void LanMp::send_horizon(u64 t) {
+  if (!horizon_on_ || !host_ || !horizon_peers_ || !t) return;
+  // our last frame still covers the clients (a CMD's reply window: they wait for our
+  // ACK; an ACK's runahead), or we promised less than 0.5 ms ago: nothing to add
+  if (granted_ == ~0ull || t <= granted_ || t < horizon_sent_ + 500) return;
+  if (!last_cmd_ts_ || t > last_cmd_ts_ + 100000) return;   // no CMD for 100 ms: no client keeps step with us
+  u8 body[24];
+  std::memcpy(body, &t, 8); std::memcpy(body + 8, &sent_n_, 8); std::memcpy(body + 16, &sent_last_ts_, 8);
+  ENetPacket* pkt = enet_packet_create(nullptr, sizeof(MpPacketHeader) + sizeof body, ENET_PACKET_FLAG_UNSEQUENCED);
+  const MpPacketHeader h{kPacketMagic, static_cast<u32>(me_.id), kTypeHorizon, static_cast<u32>(sizeof body), t};
+  std::memcpy(pkt->data, &h, sizeof h);
+  std::memcpy(pkt->data + sizeof h, body, sizeof body);
+  bool sent = false;
+  for (int i = 0; i < 16; ++i) {
+    if (i == me_.id || !peers_[i] || !(horizon_peers_ & (1u << i))) continue;
+    if (radio_off_mask_ & (1u << i)) continue;   // hbguest2: its radio is off
+    enet_peer_send(peers_[i], Chan_MP, pkt);
+    sent = true;
+  }
+  if (!sent) { enet_packet_destroy(pkt); return; }
+  pin_throttle();
+  enet_host_flush(host_);
+  horizon_sent_ = t;
+  st_.hz_tx++;
+}
+
+// A promise from `sender`: its clock t, frames it sent n, the last one's stamp. Kept
+// only when the last frame it sent is the last we got from it (everything it sent
+// before is in, or lost for good: frames go out in order); fewer counted than it
+// sent = lost on the way, or sent before we joined: count as it does.
+bool LanMp::take_horizon(const u8* b, u32 len, u32 sender) {
+  if (len < 24 || sender >= 16 || !(horizon_peers_ & (1u << sender))) return false;
+  u64 t, n, last;
+  std::memcpy(&t, b, 8); std::memcpy(&n, b + 8, 8); std::memcpy(&last, b + 16, 8);
+  st_.hz_rx++;
+  if (recv_last_ts_[sender] != last || recv_n_[sender] > n) return false;   // its frames are still on the way
+  recv_n_[sender] = n;
+  if (horizon_from_ != static_cast<int>(sender)) { horizon_from_ = static_cast<int>(sender); horizon_t_ = 0; }
+  if (t <= horizon_t_) return false;
+  horizon_t_ = t;
+  st_.hz_take++;
+  return true;
+}
+
+u64 LanMp::host_horizon() {
+  if (!horizon_on_ || !host_ || last_host_id_ < 0 || last_host_id_ >= 16 || !(horizon_peers_ & (1u << last_host_id_))) return 0;
+  process_lan(0);   // what has come: a frame is queued (the core takes it first, as stock), a promise is noted
+  if (!rx_.empty() || horizon_from_ != last_host_id_ || !horizon_t_) return 0;
+  st_.hz_use++;
+  return horizon_t_;
+}
+
+void LanMp::note_rx(int via, int kind, s64 lead_us, int len, u32 ack_runahead) {   // hbtime: diagnostics
+  if (kind == 1) { const int v = via & 3; st_.ld_n[v]++; st_.ld_total[v] += static_cast<double>(lead_us); st_.cl_n++; st_.cl_total += len; }
+  else if (kind == 3) { st_.ra_n++; st_.ra_total += ack_runahead; }
+  else if (kind == 4) st_.fg_n++;   // hbbss
