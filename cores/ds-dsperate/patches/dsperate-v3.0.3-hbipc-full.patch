@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// hbfam2 (hanbang): LAN groups. net.mode auto joins the first session it
+// hears; with a group (LanMp::set_group) only one of its own group, so a
+// console starting another game hosts its own session instead of falling
+// into one it cannot play in. The names and the rule first, then real
+// sessions over the LAN: the same group joins; another group -- even one
+// whose name begins the same, pkm and pkm5, either way round -- is heard and
+// passed by.
+#include "net/lan_mp.h"
+#include "check.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <string>
+#include <thread>
+#include <vector>
+
+using ds::net::LanMp;
+using ds::net::kLanGroupMax;
+using ds::net::lan_group_fit;
+using ds::net::lan_session_in_group;
+using ds::net::lan_session_name;
+
+namespace {
+
+// Whole characters only: no sequence cut short, none left dangling.
+bool valid_utf8(const std::string& s) {
+  for (size_t i = 0; i < s.size();) {
+    const unsigned char c = static_cast<unsigned char>(s[i]);
+    const size_t n = c < 0x80 ? 1 : (c >> 5) == 0x6 ? 2 : (c >> 4) == 0xE ? 3 : (c >> 3) == 0x1E ? 4 : 0;
+    if (n == 0 || i + n > s.size()) return false;
+    for (size_t k = 1; k < n; ++k)
+      if ((static_cast<unsigned char>(s[i + k]) & 0xC0) != 0x80) return false;
+    i += n;
+  }
+  return true;
+}
+
+void test_names() {
+  CHECK(lan_session_name("DevA", "pkm5") == "DevA's game [pkm5]");
+  CHECK(lan_session_name("DevA", "") == "DevA's game");                 // no group: stock's beacon
+  CHECK(lan_session_in_group("DevA's game [pkm5]", "pkm5"));
+  CHECK(!lan_session_in_group("DevA's game [pkm5]", "pkm"));             // the head of a group is not it
+  CHECK(!lan_session_in_group("DevA's game [pkm]", "pkm5"));
+  CHECK(!lan_session_in_group("DevA's game [xpkm5]", "pkm5"));           // nor is its tail
+  CHECK(!lan_session_in_group("DevA's game [PKM5]", "pkm5"));            // exact, case and all
+  CHECK(!lan_session_in_group("DevA's game", "pkm5"));                   // untagged: stock DSperate, melonDS
+  CHECK(!lan_session_in_group("Bob [pkm5]'s game [IRBO]", "pkm5"));      // a player name that looks like one
+  CHECK(lan_session_in_group("DevA's game", "") && lan_session_in_group("DevA's game [pkm5]", ""));
+
+  // The name field holds 63 bytes: the group goes in whole, the player's name is cut.
+  const std::string longname(60, 'n');
+  const std::string s = lan_session_name(longname, "pkm5");
+  CHECK(s.size() == 63 && lan_session_in_group(s, "pkm5"));
+  CHECK(lan_session_name(longname, "").size() == 63);
+  // A group longer than kLanGroupMax is cut to it, the same on both sides.
+  const std::string longgroup = "Pokemon - Black Version 2 (USA, Europe) (NDSi Enhanced)";
+  CHECK(lan_group_fit(longgroup).size() == kLanGroupMax);
+  const std::string s2 = lan_session_name(longname, longgroup);
+  CHECK(s2.size() <= 63 && lan_session_in_group(s2, longgroup));
+  CHECK(!lan_session_in_group(s2, "Pokemon - Black Version 2"));
+
+  // Cuts fall between characters: Hangul is three bytes a character.
+  std::string hangul;
+  for (int i = 0; i < 20; ++i) hangul += "\xea\xb0\x80";               // 20 x U+AC00, 60 bytes
+  const std::string g = lan_group_fit(hangul);
+  CHECK(g.size() == 39 && valid_utf8(g));                                // 13 whole characters, not 40 bytes
+  const std::string s3 = lan_session_name(hangul, "pkm5");
+  CHECK(s3.size() == 62 && valid_utf8(s3) && lan_session_in_group(s3, "pkm5"));   // 16 characters + 14
+  const std::string s4 = lan_session_name("DevA", hangul);
+  CHECK(valid_utf8(s4) && lan_session_in_group(s4, hangul));
+}
+
+// Services `host` (as the frame loop would) until `done` or the time runs out.
+template <class F> bool serve_until(LanMp& host, F done, int ms) {
+  const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(ms);
+  while (std::chrono::steady_clock::now() < end) {
+    host.process();
+    if (done()) return true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+  return done();
+}
+
+// A second console starting up as net.mode auto does (guest: no host
+// fallback), with this thread servicing the host meanwhile.
+struct Scan {
+  LanMp::Role role = LanMp::Role::None;
+  std::string err;
+  std::vector<std::string> heard;   // the sessions it heard, joined or not
+  int host_saw = 0;                 // the host's player count while it was there
+  bool heard_name(const std::string& n) const { for (const auto& h : heard) if (h == n) return true; return false; }
+};
+Scan scan(LanMp& host, const std::string& group, bool host_fallback) {
+  Scan out;
+  std::atomic<int> stage{0};   // 1 scanned, 2 may go, 3 gone
+  std::thread guest([&] {
+    LanMp g;
+    g.set_group(group);
+    out.role = g.start_auto("GUEST", 2500, 16, host_fallback);
+    out.err = g.error();
+    for (const auto& kv : g.sessions()) out.heard.push_back(kv.second.name);
+    stage = 1;
+    while (stage.load() == 1) { if (g.active()) g.process(); std::this_thread::sleep_for(std::chrono::milliseconds(2)); }
+    g.end_session();
+    stage = 3;
+  });
+  serve_until(host, [&] { return stage.load() == 1 && (out.role != LanMp::Role::Guest || host.num_players() == 2); }, 8000);
+  out.host_saw = host.num_players();
+  stage = 2;
+  serve_until(host, [&] { return stage.load() == 3; }, 3000);
+  guest.join();
+  serve_until(host, [&] { return host.num_players() == 1; }, 3000);
+  return out;
+}
+
+void test_sessions() {
+  LanMp host;
+  host.set_group("pkm5");
+  if (!host.ok() || !host.start_host("HOST", 16)) {
+    std::printf("lan group: cannot host here (%s); session part skipped\n", host.error().c_str());
+    return;
+  }
+  // The same group: joined.
+  const Scan same = scan(host, "pkm5", false);
+  if (same.role != LanMp::Role::Guest && same.heard.empty()) {
+    std::printf("lan group: no beacon heard here (no broadcast route?); session part skipped\n");
+    return;
+  }
+  CHECK(same.role == LanMp::Role::Guest && same.host_saw == 2);
+  CHECK(same.heard_name("HOST's game [pkm5]"));
+  std::printf("lan group: \"pkm5\" heard \"HOST's game [pkm5]\" and joined (host saw %d players)\n", same.host_saw);
+
+  // Another group, the head of the host's: heard, passed by, and net.mode
+  // auto hosts its own. On one machine the port is the first host's, so that
+  // ends in "port 7064 busy" here; either way it is nobody's guest.
+  const Scan other = scan(host, "pkm", true);
+  CHECK(other.role != LanMp::Role::Guest && other.host_saw == 1);
+  CHECK(other.role == LanMp::Role::Host ||
+        (other.err.find("7064") != std::string::npos && other.heard_name("HOST's game [pkm5]")));
+  std::printf("lan group: \"pkm\" passed \"HOST's game [pkm5]\" by and went to host (%s)\n",
+              other.role == LanMp::Role::Host ? "hosting" : other.err.c_str());
+
+  // The other way round, the host's group the head of ours, as guest: nothing to join.
+  host.end_session();
+  host.set_group("pkm");
+  CHECK(host.start_host("HOST", 16));
+  const Scan longer = scan(host, "pkm5", false);
+  CHECK(longer.role == LanMp::Role::None && longer.host_saw == 1);
+  CHECK(longer.heard_name("HOST's game [pkm]") && longer.err.find("\"pkm5\"") != std::string::npos);
+  std::printf("lan group: \"pkm5\" passed \"HOST's game [pkm]\" by (%s)\n", longer.err.c_str());
+  host.end_session();
+}
+
+} // namespace
+
+int main() {
+  test_names();
+  test_sessions();
+  std::printf("lan group tests passed\n");
+  return 0;
+}
diff --git a/tests/lan_live_test.cpp b/tests/lan_live_test.cpp
new file mode 100644
index 0000000..67b552a
--- /dev/null
+++ b/tests/lan_live_test.cpp
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// hbfam (hanbang): a LAN host is a live session only while a guest is in it.
+//
+// While a session is live the frontend withholds save states, fast forward,
+// frameskip, speed and reset, and its menu stops pausing (lan_session_live,
+// net/lan_mp.h). A guest is live from the moment it joins; a host only while
+// somebody has joined it, which the frontend reads from num_players(). The
+// second half checks that reading on a real session over 127.0.0.1: alone 1,
+// a guest in 2, the guest gone 1 again -- twice, so a second guest after the
+// first one left is seen too.
+#include "net/lan_mp.h"
+#include "check.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+using ds::net::LanMp;
+using ds::net::lan_session_live;
+
+namespace {
+
+void test_rule() {
+  CHECK(!lan_session_live(true, 1));     // host alone: single play
+  CHECK(lan_session_live(true, 2));      // a guest in
+  CHECK(lan_session_live(true, 16));
+  CHECK(!lan_session_live(true, 0));
+  CHECK(lan_session_live(false, 0));     // a guest: live from the moment it joins
+  CHECK(lan_session_live(false, 3));
+}
+
+// Services `host` (as the frame loop would) until `done` or the time runs out.
+template <class F> bool serve_until(LanMp& host, F done, int ms) {
+  const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(ms);
+  while (std::chrono::steady_clock::now() < end) {
+    host.process();
+    if (done()) return true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+  return done();
+}
+
+void test_session() {
+  LanMp host;
+  if (!host.ok() || !host.start_host("HOST", 16)) {
+    std::printf("lan live: cannot host here (%s); session part skipped\n", host.error().c_str());
+    return;
+  }
+  CHECK(host.is_host() && host.num_players() == 1);
+  CHECK(!lan_session_live(host.is_host(), host.num_players()));
+  for (int round = 0; round < 2; ++round) {
+    // The guest's start_client blocks until the host has let it in, so it
+    // runs on its own thread while this one services the host.
+    std::atomic<int> stage{0};   // 1 joined, 2 asked to leave, 3 left, -1 could not join
+    std::thread guest([&] {
+      LanMp g;
+      if (!g.ok() || !g.start_client("GUEST", "127.0.0.1")) { std::printf("guest: %s\n", g.error().c_str()); stage = -1; return; }
+      if (!lan_session_live(g.is_host(), g.num_players())) { stage = -1; return; }
+      stage = 1;
+      while (stage.load() == 1) { g.process(); std::this_thread::sleep_for(std::chrono::milliseconds(2)); }
+      g.end_session();
+      stage = 3;
+    });
+    const bool joined = serve_until(host, [&] { return stage.load() != 0 && host.num_players() == 2; }, 6000);
+    CHECK(joined && stage.load() == 1);
+    CHECK(lan_session_live(host.is_host(), host.num_players()));
+    std::printf("lan live: round %d: guest in, host sees %d players: live\n", round + 1, host.num_players());
+    stage = 2;
+    CHECK(serve_until(host, [&] { return stage.load() == 3 && host.num_players() == 1; }, 6000));
+    CHECK(!lan_session_live(host.is_host(), host.num_players()));
+    std::printf("lan live: round %d: guest gone, host sees %d player: single play\n", round + 1, host.num_players());
+    guest.join();
+  }
+  host.end_session();
+}
+
+// hbmp (hanbang): LanMp::idle_wait, the pause between LAN slices. With nothing
+// coming it sleeps its whole time; a regular frame does not end it; a CMD from
+// the MP host ends it at once, and the core's peek then gets that CMD as it
+// would have anyway: same bytes, same timestamp.
+void test_idle_wait() {
+  using clk = std::chrono::steady_clock;
+  const auto ms = [](clk::time_point t) { return static_cast<long>(std::chrono::duration_cast<std::chrono::milliseconds>(clk::now() - t).count()); };
+  LanMp host;
+  if (!host.ok() || !host.start_host("HOST", 16)) {
+    std::printf("lan idle: cannot host here (%s); skipped\n", host.error().c_str());
+    return;
+  }
+  std::atomic<int> stage{0};   // 1 joined, 2 go, 3 quiet pause done, 4 regular pause done, 5 CMD pause done, 6 leave, -1 failed
+  std::atomic<long> quiet{-1}, regular{-1}, cmd{-1};
+  std::atomic<int> reg_ok{0}, cmd_ok{0};
+  std::thread guest([&] {
+    LanMp g;
+    if (!g.ok() || !g.start_client("GUEST", "127.0.0.1")) { stage = -1; return; }
+    g.begin();
+    stage = 1;
+    while (stage.load() == 1) { g.process(); std::this_thread::sleep_for(std::chrono::milliseconds(2)); }
+    auto t = clk::now();
+    quiet = g.idle_wait(150) ? -2 : ms(t);
+    stage = 3;
+    while (stage.load() == 3) std::this_thread::sleep_for(std::chrono::milliseconds(1));   // host sends a regular frame
+    t = clk::now();
+    regular = g.idle_wait(200) ? -2 : ms(t);   // (under the 250 ms stale window)
+    { ds::u8 b[2048]; ds::u64 ts = 0; reg_ok = g.recv_packet(b, &ts) == 40 && ts == 777 && b[0] == 0x5A; }
+    stage = 5;   // host: a CMD in about 100 ms
+    t = clk::now();
+    const bool woke = g.idle_wait(2000);
+    cmd = woke ? ms(t) : -2;
+    if (woke && g.host_frame_queued()) { ds::u8 b[2048]; ds::u64 ts = 0; cmd_ok = g.peek_host_packet(b, &ts) == 40 && ts == 12345 && b[0] == 0xC3; }
+    stage = 6;
+    while (stage.load() == 6) { g.process(); std::this_thread::sleep_for(std::chrono::milliseconds(2)); }
+    g.end();
+    g.end_session();
+  });
+  CHECK(serve_until(host, [&] { return stage.load() != 0 && host.num_players() == 2; }, 6000) && stage.load() == 1);
+  host.begin();
+  serve_until(host, [] { return false; }, 300);   // both radios on, both told
+  stage = 2;
+  CHECK(serve_until(host, [&] { return stage.load() == 3; }, 3000));
+  ds::u8 frame[40] = {0x5A};
+  host.send_packet(frame, 40, 777);
+  stage = 4;
+  CHECK(serve_until(host, [&] { return stage.load() == 5; }, 3000));
+  serve_until(host, [] { return false; }, 100);
+  frame[0] = 0xC3;
+  host.send_cmd(frame, 40, 12345);
+  CHECK(serve_until(host, [&] { return stage.load() == 6; }, 3000));
+  std::printf("lan idle: quiet pause %ld ms of 150, with a regular frame %ld ms of 200, a CMD ended a 2000 ms pause after %ld ms\n",
+              quiet.load(), regular.load(), cmd.load());
+  CHECK(quiet.load() >= 140 && quiet.load() < 1000);
+  CHECK(regular.load() >= 190 && regular.load() < 1200 && reg_ok.load() == 1);
+  CHECK(cmd.load() >= 50 && cmd.load() < 1000 && cmd_ok.load() == 1);
+  stage = 7;
+  guest.join();
+  host.end_session();
+}
+
+// hbmp horizon (DSPERATE_MP_HORIZON=1): the hello on the command channel; a
+// promise the client takes once it has every frame the host sent before it
+// (and only after the core took them); a blocking wait for the host cut short
+// by a newer promise. With the guest's horizon off: no promise, not even a
+// stray packet, and the wait runs its course as before.
+void test_horizon(bool guest_on) {
+  using clk = std::chrono::steady_clock;
+  const auto ms = [](clk::time_point t) { return static_cast<long>(std::chrono::duration_cast<std::chrono::milliseconds>(clk::now() - t).count()); };
+  setenv("DSPERATE_MP_HORIZON", "1", 1);
+  LanMp host;
+  if (!host.ok() || !host.start_host("HOST", 16)) {
+    unsetenv("DSPERATE_MP_HORIZON");
+    std::printf("lan horizon: cannot host here (%s); skipped\n", host.error().c_str());
+    return;
+  }
+  setenv("DSPERATE_MP_HORIZON", guest_on ? "1" : "0", 1);
+  std::atomic<int> stage{0}, took{0};
+  std::atomic<long> first{-1}, woke{-1}, wait_ms{-1}, queued{-1}, after_take{-1}, stray{-1};
+  std::thread guest([&] {
+    LanMp g;
+    if (!g.ok() || !g.start_client("GUEST", "127.0.0.1")) { stage = -1; return; }
+    g.begin();
+    stage = 1;
+    const auto serve = [&](int st) { while (stage.load() == st) { g.process(); std::this_thread::sleep_for(std::chrono::milliseconds(1)); } };
+    serve(1);   // host: a CMD (1000) and its ACK (1500, runahead 100)
+    ds::u8 b[2048]; ds::u64 ts = 0;
+    { const auto t = clk::now(); int n = 0;
+      while (n < 2 && ms(t) < 2000) { if (g.peek_host_packet(b, &ts) == 40) ++n; else std::this_thread::sleep_for(std::chrono::milliseconds(1)); }
+      took = n; }
+    stage = 3;   // host: a promise (5000)
+    serve(3);
+    { const auto t = clk::now(); ds::u64 h = 0; while (!(h = g.host_horizon()) && ms(t) < 1000) std::this_thread::sleep_for(std::chrono::milliseconds(1)); first = static_cast<long>(h); }
+    stage = 5;   // host: a newer promise (6000) some 50 ms into this wait
+    { const auto t = clk::now(); const int n = g.recv_host_packet(b, &ts); wait_ms = n == 0 ? ms(t) : -2; woke = static_cast<long>(g.host_horizon()); }
+    stage = 6;   // host: a regular frame (7000), then a promise (8000)
+    serve(6);
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    queued = static_cast<long>(g.host_horizon());   // 0: the frame is the core's first
+    { ds::u64 s = 0; const int n = g.recv_packet(b, &s); after_take = n == 40 && s == 7000 ? static_cast<long>(g.host_horizon()) : -2; }
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    { ds::u64 s = 0; stray = g.recv_packet(b, &s); }   // nothing else came
+    stage = 8;
+    serve(8);
+    g.end();
+    g.end_session();
+  });
+  CHECK(serve_until(host, [&] { return stage.load() != 0 && host.num_players() == 2; }, 6000) && stage.load() == 1);
+  unsetenv("DSPERATE_MP_HORIZON");
+  host.begin();
+  serve_until(host, [] { return false; }, 300);   // radios on, hellos across
+  ds::u8 frame[40] = {0xC3};
+  host.send_cmd(frame, 40, 1000);
+  ds::u8 ack[40] = {100, 0, 0, 0};
+  host.send_ack(ack, 40, 1500);
+  stage = 2;
+  CHECK(serve_until(host, [&] { return stage.load() == 3; }, 3000));
+  host.send_horizon(1550);   // inside the ACK's runahead: nothing to add
+  host.send_horizon(5000);
+  stage = 4;
+  CHECK(serve_until(host, [&] { return stage.load() >= 5; }, 3000));
+  serve_until(host, [] { return false; }, 50);
+  host.send_horizon(5200);   // under 0.5 ms after the last one: not sent
+  host.send_horizon(6000);
+  CHECK(serve_until(host, [&] { return stage.load() == 6; }, 3000));
+  frame[0] = 0x5A;
+  host.send_packet(frame, 40, 7000);
+  host.send_horizon(8000);
+  stage = 7;
+  CHECK(serve_until(host, [&] { return stage.load() == 8; }, 3000));
+  std::printf("lan horizon (guest %s): took %d, promise %ld, wait %ld ms then %ld, with a frame queued %ld, after it %ld, stray %ld\n",
+              guest_on ? "on" : "off", took.load(), first.load(), wait_ms.load(), woke.load(), queued.load(), after_take.load(), stray.load());
+  CHECK(took.load() == 2 && queued.load() == 0 && stray.load() == 0);
+  if (guest_on) CHECK(first.load() == 5000 && woke.load() == 6000 && wait_ms.load() >= 0 && wait_ms.load() < 140 && after_take.load() == 8000);
+  else CHECK(first.load() == 0 && woke.load() == 0 && wait_ms.load() >= 140 && after_take.load() == 0);
+  stage = 9;
+  guest.join();
+  host.end_session();
+}
+
+} // namespace
+
+int main() {
+  test_rule();
+  test_session();
+  test_idle_wait();
+  test_horizon(true);
+  test_horizon(false);
+  std::printf("lan live tests passed\n");
+  return 0;
+}
