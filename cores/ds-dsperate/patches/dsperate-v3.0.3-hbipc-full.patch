+Display::PopTimes Display::take_pop_times() {
+  PopTimes t = pop_t_;
+  t.fused = fuse_on();
+  t.way = copy_way_forced() >= 0 ? copy_way_forced() : copy_way_;
+  pop_t_ = PopTimes{};
+  return t;
