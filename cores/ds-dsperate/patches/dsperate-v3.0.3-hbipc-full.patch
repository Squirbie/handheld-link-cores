+  const int forced = copy_way_forced();
+  const bool picking = forced < 0 && copy_way_ < 0;
+  const int way = forced >= 0 ? forced : picking ? (way_frames_ & 1) : copy_way_;
+  const auto out_row = [way](u32* d, const u32* s, size_t n) { if (way == 1) copy_row_neon(d, s, n); else std::memcpy(d, s, n * sizeof(u32)); };
+  const View* pv = pop_view_ >= 0 && pop_view_ < nviews_ ? &views_[pop_view_] : nullptr;
+  const std::vector<u32>* side = pv ? &side_[pv->screen] : nullptr;
+  size_t k = 0;
+  for (int y = 0; y < lh;) {
+    if (pv && k < pop_spans_.size() && pop_spans_[k].fy == y) {
+      const PopSpan& s = pop_spans_[k++];
+      u32* const drow = dst + static_cast<size_t>(y) * dst_pitch;
+      const u32* const srow = src + static_cast<size_t>(y) * lw;
+      const int c0 = pv->rect.x + s.a0, c1 = pv->rect.x + s.a1;   // the popup's columns on this row (blit_insets clipped them)
+      if (side->size() >= static_cast<size_t>(s.y + 1) * pv->rect.w && 0 <= c0 && c0 < c1 && c1 <= lw) {
+        const u32* const p = side->data() + static_cast<size_t>(s.y) * pv->rect.w + s.a0;
+        out_row(drow, srow, static_cast<size_t>(c0));
+        if (fast_blend()) blend_row3_neon(drow + c0, srow + c0, p, static_cast<size_t>(c1 - c0), pop_alpha_);
+        else blend_row3(drow + c0, srow + c0, p, static_cast<size_t>(c1 - c0), pop_alpha_);
