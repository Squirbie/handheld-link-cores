+// ---- hbwifi (hanbang): idle intervals in one timer event ----------------------
+// The timer fires every 8 us while the radio is up -- 125,000 events a second,
+// each one ending the CPU's slice -- yet with nothing to send and nothing being
+// received most intervals only count (us_timestamp_, the US counter, CMDCOUNT,
+// CONTENTFREE, rx_counter_). plan_idle_steps() looks ahead for the first
+// interval that does more -- polls the transport (rx check, MP client peek or
+// sync), runs a ms timer, may raise IRQ15, ends the power-up delay -- and the
+// next event is put there; the intervals before it are counted in one go when
+// it fires. A register access first counts the intervals due by now (settle);
+// a write then puts the timer back on its next interval (unskip), as it may
+// start a transfer or move a counter. The guest sees the same values, and the
+// same IRQs and polls at the same 8-us ticks, as with the stock timer. The idle
+// loop cut never trusts a Wi-Fi port (idle_loop.cpp), so a poll of one still
+// runs through the window. DS_WIFI_SKIP=0: the stock event per interval.
+namespace {
+bool wifi_skip_on() {
+  static const bool on = [] { const char* e = std::getenv("DS_WIFI_SKIP"); return !e || std::atoi(e) != 0; }();
+  return on;
+}
+} // namespace
+
+s32 Wifi::next_delay(s32& err) {
+  s32 cycles = 33513982 * kTimerInterval;   // as schedule_timer: error-diffused
+  cycles -= err;
+  const s32 delay = (cycles + 999999) / 1000000;
+  err = delay * 1000000 - cycles;
+  return delay;
+}
+
+// How many of the coming intervals only count. The tests mirror us_timer()'s,
+// on the values each interval would see; the first interval that would act
+// runs as an ordinary event.
+u32 Wifi::plan_idle_steps() const {
+  if (!wifi_skip_on() || !on_ || com_status_ || reg(W_TXBusy)) return 0;
+  if (!mp_ || !mp_->linked()) return 0;   // hblink: alone, the stock timer (an event every 8 us)
+  constexpr u32 kMax = 128;   // 1024 us
+  const bool client = is_mp_client_;
+  const bool uscount = reg(W_USCountCnt) != 0, uscompare = reg(W_USCompareCnt) != 0;
+  const u32 pre = reg(W_PreBeacon) & kTimeCheckMask;
+  const u32 bc1 = static_cast<u32>(reg(W_BeaconCount1)) << 10;   // changes only in ms_timer: a stop
+  for (u32 j = 1; j <= kMax; ++j) {
+    const u64 ts = us_timestamp_ + u64{kTimerInterval} * j;   // after that interval's increment
+    if (client) {
+      if (rx_timestamp_ && ts >= rx_timestamp_) return j - 1;   // start_rx
+      if (ts >= next_sync_) return j - 1;                        // check_rx(2)
+      if (!rx_timestamp_ && !(ts & 0x38)) return j - 1;          // check_rx(3), the 64-us peek
+    }
+    if (!(ts & 0x3FF & kTimeCheckMask)) return j - 1;            // ap_ms_timer
+    if (us_until_power_on_ < 0 && us_until_power_on_ + static_cast<s32>(kTimerInterval * j) >= 0) return j - 1;
+    if (uscount) {
+      const u32 uspart = static_cast<u32>((us_counter_ + u64{kTimerInterval} * j) & 0x3FF);
+      if (uscompare && ((bc1 | (0x3FF - uspart)) & kTimeCheckMask) == pre) return j - 1;   // IRQ15
+      if (!(uspart & kTimeCheckMask)) return j - 1;              // ms_timer
+    }
+    const u32 rc = rx_counter_ + kTimerInterval * (j - 1);       // before that interval's increment
+    if ((!client || ts > next_sync_) && !(rc & 0x1FF & kTimeCheckMask)) return j - 1;   // check_rx(0)
+  }
+  return kMax;
+}
+
+// n intervals of an idle us_timer(): only the counters move.
+void Wifi::idle_advance(u32 n) {
+  const u32 us = kTimerInterval * n;
+  us_timestamp_ += us;
+  if (us_until_power_on_ < 0) us_until_power_on_ += static_cast<s32>(us);   // its end is never inside a skip
+  if (reg(W_USCountCnt)) us_counter_ += us;
+  if ((reg(W_CmdCountCnt) & 1) && cmd_counter_ > 0) cmd_counter_ = cmd_counter_ > us ? cmd_counter_ - us : 0;
+  if (reg(W_ContentFree) != 0) reg(W_ContentFree) = reg(W_ContentFree) > us ? static_cast<u16>(reg(W_ContentFree) - us) : 0;
+  rx_counter_ += us;
+}
+
+// End of us_timer(): the next event at the next interval, or past the idle
+// intervals ahead.
+void Wifi::schedule_next() {
+  if (wifi_skip_on() && mp_ && mp_->linked() != linked_seen_) {   // hblink: say when the skipping starts or stops
+    linked_seen_ = !linked_seen_;
+    std::fprintf(stderr, linked_seen_ ? "hblink: another console joined: idle Wi-Fi timer intervals counted in one go\n"
+                                      : "hblink: alone again: the Wi-Fi timer runs every 8 us\n");
+  }
+  const u32 n = plan_idle_steps();
+  if (!n) { schedule_timer(false); return; }
+  const u64 base = nds_.sched.event_time();
+  skip_base_ = base; skip_err_ = timer_err_;
+  u64 at = base;
+  for (u32 i = 0; i <= n; ++i) at += static_cast<u64>(next_delay(timer_err_)) * 2;
+  pending_skip_ = n;
+  nds_.sched.schedule(EventId::Wifi, at, [](NDS& m, u32) { m.io.wifi.us_timer(); }, 0);
+}
+
+// Count the skipped intervals whose tick is due by now.
+void Wifi::settle() {
+  if (!pending_skip_) return;
+  const u64 now = nds_.sched.now();
+  u32 m = 0; u64 t = skip_base_; s32 err = skip_err_;
+  while (m < pending_skip_) {
+    s32 e = err;
+    const u64 next = t + static_cast<u64>(next_delay(e)) * 2;
+    if (next > now) break;
+    t = next; err = e; ++m;
+  }
+  if (!m) return;
+  idle_advance(m);
+  pending_skip_ -= m; skip_base_ = t; skip_err_ = err;
+}
+
+// After settle(): the rest of the window goes back to an event at the next
+// interval, which plans again.
+void Wifi::unskip() {
+  if (!pending_skip_) return;
+  pending_skip_ = 0;
+  s32 err = skip_err_;
+  const u64 at = skip_base_ + static_cast<u64>(next_delay(err)) * 2;
+  timer_err_ = err;
+  nds_.sched.schedule(EventId::Wifi, at, [](NDS& m, u32) { m.io.wifi.us_timer(); }, 0);
+}
+
+// us_timestamp_ as of now, without counting anything in.
+u64 Wifi::settled_us() const {
+  if (!pending_skip_) return us_timestamp_;
+  const u64 now = nds_.sched.now();
+  u32 m = 0; u64 t = skip_base_; s32 err = skip_err_;
+  while (m < pending_skip_) {
+    s32 e = err;
+    const u64 next = t + static_cast<u64>(next_delay(e)) * 2;
+    if (next > now) break;
+    t = next; err = e; ++m;
+  }
+  return us_timestamp_ + u64{kTimerInterval} * m;
+}
