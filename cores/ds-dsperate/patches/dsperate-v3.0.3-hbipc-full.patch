+// hbfix19 (display.h): what stage_wanted asks, whatever HB_POPUP_DIRECT says -- the frames the DS_FPS popup line is about
+bool Display::popup_big() const {
+  if (!scaled_ || disp_ || inset_alpha_ == 255) return false;
+  const long area = static_cast<long>(scaled_w_) * scaled_h_;
+  for (int i = 0; i < nviews_; ++i) {
+    const View& v = views_[i];
+    if (!v.direct && v.shown && 4L * v.rect.w * v.rect.h >= area) return true;
