+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 0);
+    in.set_menu_open(false);
+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 32767); CHECK(in.screen_swap_held());
+    in.set_menu_open(true);
+    T::axis(in, SDL_CONTROLLER_AXIS_TRIGGERLEFT, 0);     CHECK(!in.screen_swap_held()); }
+  // "mod" alone is refused, as for every held action.
+  { Rig r; Input& in = r.set("padhotkeys.modifier", "guide").set("padhotkeys.screen_swap_hold", "mod").go();
+    T::tap_pad(in, SDL_CONTROLLER_BUTTON_GUIDE);
+    CHECK(in.take_actions().empty() && !in.screen_swap_held()); }
+  // The shipped defaults bind nothing new: no warning, nothing hidden.
+  { Rig r; Input& in = r.go();
+    for (const std::string& w : in.collisions()) CHECK(w.find("screen_swap_hold") == std::string::npos); }
