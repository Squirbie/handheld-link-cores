+/* 안쪽 코어가 부르는 환경 함수: 옵션 · 입력 설명 · 화면 정보는 래퍼가 맡고, 나머지는 프런트엔드로 */
+static bool innerEnvironment(int m, unsigned cmd, void *data)
+{
+   switch (cmd)
+   {
+      case RETRO_ENVIRONMENT_GET_CORE_OPTIONS_VERSION:
+         *(unsigned *)data = 0;
+         return true;
+      case RETRO_ENVIRONMENT_SET_VARIABLES:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_INTL:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2_INTL:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_DISPLAY:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_UPDATE_DISPLAY_CALLBACK:
+      case RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS:
+      case RETRO_ENVIRONMENT_SET_CONTENT_INFO_OVERRIDE:
+      case RETRO_ENVIRONMENT_SET_PERFORMANCE_LEVEL:
+      case RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO:
+      case RETRO_ENVIRONMENT_SET_GEOMETRY:
+         return true;
+      case RETRO_ENVIRONMENT_GET_VARIABLE:
+      {
+         struct retro_variable *var = (struct retro_variable *)data;
+         if (var && var->key && !strcmp(var->key, "ngp_language"))
+         {
+            var->value = language;   /* 두 기기가 같아야 해서 래퍼가 고정 */
+            return true;
+         }
+         if (var)
+            var->value = NULL;
+         return false;
+      }
+      case RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE:
+         *(bool *)data = false;
+         return true;
+      case RETRO_ENVIRONMENT_GET_GAME_INFO_EXT:
+         if (m == 1 && p2Partner)
+            return false;            /* 2P 가 다른 롬이면 경로 · 데이터로 넘김 */
+         return environCallback ? environCallback(cmd, data) : false;
+      default:
+         return environCallback ? environCallback(cmd, data) : false;
+   }
+}
+
+static bool envA(unsigned cmd, void *data) { return innerEnvironment(0, cmd, data); }
+static bool envB(unsigned cmd, void *data) { return innerEnvironment(1, cmd, data); }
+
+static const char *getVar(const char *key)
+{
+   struct retro_variable var;
+   var.key = key;
+   var.value = NULL;
+   if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+      return var.value;
+   return NULL;
+}
+
+static void readScreenOption(void)
+{
+   const char *v = getVar("ngp_dual_screen");
+   int s = (v && !strcmp(v, "2P")) ? 1 : 0;
+   if (s != screen)
+      logf_(RETRO_LOG_INFO, "화면 %dP", s + 1);
+   screen = s;
+   stats.screen = (uint32_t)screen;
+}
+
+static uint8_t readPad(unsigned port)
+{
+   static const unsigned map[7] = {
+      RETRO_DEVICE_ID_JOYPAD_UP, RETRO_DEVICE_ID_JOYPAD_DOWN, RETRO_DEVICE_ID_JOYPAD_LEFT, RETRO_DEVICE_ID_JOYPAD_RIGHT,
+      RETRO_DEVICE_ID_JOYPAD_B, RETRO_DEVICE_ID_JOYPAD_A, RETRO_DEVICE_ID_JOYPAD_START,
+   };
+   int16_t ret = 0;
+   uint8_t out = 0;
+   unsigned i;
+   if (useBitmasks)
+      ret = inputStateCallback(port, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_MASK);
+   else
+      for (i = 0; i <= RETRO_DEVICE_ID_JOYPAD_R3; i++)
+         if (inputStateCallback(port, RETRO_DEVICE_JOYPAD, 0, i))
+            ret |= (int16_t)(1 << i);
+   for (i = 0; i < 7; i++)
+      if (ret & (1 << map[i]))
+         out |= (uint8_t)(1 << i);
+   return out;
+}
+
+static void *readWholeFile(const char *path, size_t *size)
+{
+   FILE *f = fopen(path, "rb");
+   long n;
+   void *buf;
+   if (!f)
+      return NULL;
+   if (fseek(f, 0, SEEK_END) || (n = ftell(f)) <= 0 || fseek(f, 0, SEEK_SET))
+   {
+      fclose(f);
+      return NULL;
+   }
+   buf = malloc((size_t)n);
+   if (buf && fread(buf, 1, (size_t)n, f) != (size_t)n)
+   {
+      free(buf);
+      buf = NULL;
+   }
+   fclose(f);
+   if (buf)
+      *size = (size_t)n;
+   return buf;
+}
+
+/* 세이브 폴더 · 롬 이름(확장자 뺌) — 안쪽 코어와 같은 규칙(GAME_INFO_EXT 이름, 없으면 경로) */
+static void contentBase(const struct retro_game_info *info, char *base, size_t len)
+{
+   struct retro_game_info_ext *ext = NULL;
+   const char *p = NULL, *slash, *dot;
+   base[0] = '\0';
+   if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_GAME_INFO_EXT, &ext) && ext && ext->name)
+   {
+      snprintf(base, len, "%s", ext->name);
+      return;
+   }
+   p = info ? info->path : NULL;
+   if (!p)
+      return;
+   slash = strrchr(p, '/');
+   if (!slash)
+      slash = strrchr(p, '\\');
+   snprintf(base, len, "%s", slash ? slash + 1 : p);
+   dot = strrchr(base, '.');
+   if (dot)
+      base[dot - base] = '\0';
+}
