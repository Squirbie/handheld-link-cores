+}
+
+/* 가로 줄 하나가 끝날 때까지 — 원래 Emulate 고리와 같은 차례(명령 → 시계 → Z80). 장이 끝났으면 1 */
+int hb_ngp_run_line(void)
+{
+   uint32_t seq = hb_line_seq;
+   bool done = false;
+   do
+   {
+      int32 timetime = (uint8)TLCS900h_interpret();
+      done |= updateTimers(surf, timetime);
+      z80_runtime += timetime;
+
+      while(z80_runtime > 0)
+      {
+         int z80rantime = Z80_RunOP();
+
+         if (z80rantime < 0) /* Z80 inactive, so take up all run time! */
+         {
+            z80_runtime = 0;
+            break;
+         }
+
+         z80_runtime -= z80rantime << 1;
+      }
+   } while (seq == hb_line_seq);
+   return done;
+}
+
+/* 한 장 끝: 소리(스테레오 장 수) */
+int hb_ngp_frame_end(int16_t *buf, int maxFrames)
+{
+   return MDFNNGPCSOUND_Flush(buf, maxFrames);
+}
+
+const uint16_t *hb_ngp_framebuffer(void)
+{
+   return surf ? (const uint16_t *)surf->pixels : NULL;
+}
+
+uint8_t *hb_ngp_ram(void)
+{
+   return CPUExRAM;
+}
+
+const struct hb_link_stats *hb_ngp_link_stats(void)
+{
+   return &hb_link_stat;
+}
+
+/* 상태: 실제 길이를 돌려줌(남는 칸은 0 으로) — 원래 retro_serialize 는 남는 칸에 쓰레기가 남을 수 있음 */
+size_t hb_ngp_serialize(uint8_t *buf, size_t cap)
+{
+   StateMem st;
+   size_t n = 0;
+   memset(&st, 0, sizeof(st));
+   if (!MDFNSS_SaveSM(&st, 0, 0, NULL, NULL, NULL))
+   {
+      free(st.data);
+      return 0;
+   }
+   n = st.len;
+   if (buf)
+   {
+      if (n > cap)
+      {
+         free(st.data);
+         return 0;
+      }
+      memcpy(buf, st.data, n);
+      memset(buf + n, 0, cap - n);
+   }
+   free(st.data);
+   return n;
+}
+
+int hb_ngp_unserialize(const uint8_t *buf, size_t len)
+{
+   StateMem st;
+   memset(&st, 0, sizeof(st));
+   st.data = (uint8_t *)buf;
+   st.len  = len;
+   MDFNSS_LoadSM(&st, 0, 0);
+   return 1;
+}
+
