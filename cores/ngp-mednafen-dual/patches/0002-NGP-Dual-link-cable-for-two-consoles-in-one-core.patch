diff --git a/mednafen/ngp/hb_link.c b/mednafen/ngp/hb_link.c
new file mode 100644
index 0000000..faac1fc
--- /dev/null
+++ b/mednafen/ngp/hb_link.c
@@ -0,0 +1,383 @@
+/* 한방(hanbang) 두 대 연결 — 네오지오 포켓 직렬 0(통신 케이블) 흉내 (10/21)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * 설명은 hb_link.h. 근거(롬에서 읽음 — analysis/ngp_dual_1021/REPORT.md):
+ *  - KOF R-2 · SNK vs 캡콤(밀레니엄) · 카드 파이터즈는 켤 때 바이오스 COMINIT 뒤 사용자 벡터 0x6FE4 에 '받기' 처리기
+ *    (SC0CR 오류 비트 → SC0BUF 를 0x6CC0 고리에, 개수 0x6D01, 55 넘으면 0x6D05=FF 로 RTS 를 끈 채 둠),
+ *    0x6FE8 에 '보냄 끝' 처리기(0x6D00 개수가 남았으면 0x6C80 고리에서 다음 바이트를 SC0BUF 에 씀, 없으면 0x6D04=0)를 깜.
+ *    → 하드웨어 INTRX0 = 0x6FE4(색인 11, 미세 DMA 0x18), INTTX0 = 0x6FE8(색인 12, 0x19).
+ *  - 메뉴에서 상대 찾기: 2장마다 COMGETDATA → COMSENDSTATUS → COMCREATEDATA(KOF 0x91 · SvC 0x92) → COMSENDSTART.
+ *    COMGETDATA 의 돌려줌 RA3 = 0 이면 받음, 1 이면 비었음(게임이 1 과 비교).
+ */
+#include <string.h>
+
+#include "hb_link.h"
+#include "mem.h"
+#include "interrupt.h"
+#include "TLCS-900h/TLCS900h_registers.h"
+#include "../state.h"
+#include "../state_helpers.h"
+
+uint8_t hb_link_on;
+uint8_t hb_link_cts;
+int64_t hb_rtc_base;
+uint64_t hb_rtc_cycles;
+struct hb_link_stats hb_link_stat;
+
+/* 직렬 0 상태(상태 저장에 들어감) */
+static uint8_t sio_mod = 0x69, sio_br = 0x15, sio_cr = 0x20, sio_err;
+static uint8_t sio_rxbuf, sio_rxfull;
+static uint8_t sio_txbyte, sio_txnext, sio_txhasnext, sio_txwait;
+static int32_t sio_txleft = -1;            /* 보내는 중이면 남은 사이클, 쉬면 -1 */
+static uint8_t sio_out[16];                /* 다 보낸 바이트(래퍼가 상대로 넘김) */
+static uint8_t sio_outn;
+
+/* 바이오스 작업 메모리(SNK 직렬 처리기와 같은 자리) */
+#define COM_TXBUF  0x6C80
+#define COM_RXBUF  0x6CC0
+#define COM_TXCNT  0x6D00
+#define COM_RXCNT  0x6D01
+#define COM_TXHEAD 0x6D02
+#define COM_RXHEAD 0x6D03
+#define COM_TXBUSY 0x6D04
+#define COM_RXSTOP 0x6D05
+#define COM_ERR    0x6D06
+
+#define VECT_COMINIT          0xFF2BBD
+#define VECT_COMSENDSTART     0xFF2C0C
+#define VECT_COMRECIVESTART   0xFF2C44
+#define VECT_COMCREATEDATA    0xFF2C86
+#define VECT_COMGETDATA       0xFF2CB4
+#define VECT_COMONRTS         0xFF2D27
+#define VECT_COMOFFRTS        0xFF2D33
+#define VECT_COMSENDSTATUS    0xFF2D3A
+#define VECT_COMRECIVESTATUS  0xFF2D4E
+#define VECT_COMCREATEBUFDATA 0xFF2D6C
+#define VECT_COMGETBUFDATA    0xFF2D85
+
+#define COM_BUF_OK    0
+#define COM_BUF_EMPTY 1
+#define COM_BUF_OVER  2
+
+void hb_sio_reset(void)
+{
+   sio_mod = 0x69;
+   sio_br = 0x15;
+   sio_cr = 0x20;
+   sio_err = 0;
+   sio_rxbuf = 0;
+   sio_rxfull = 0;
+   sio_txbyte = sio_txnext = sio_txhasnext = sio_txwait = 0;
+   sio_txleft = -1;
+   sio_outn = 0;
+}
+
+/* 한 바이트 보내는 시간(CPU 사이클 6.144MHz). BR0CR 0x15(φT2 ÷5) = 19200bps = 비트 320 사이클을 기준으로
+ * 입력 클록(φT0 · φT2 · φT8 · φT32 = 1 : 4 : 16 : 64)과 나눗수에 비례. 시작 + 8 + 정지 = 10비트(9비트 모드면 11). */
+static int32_t byte_cycles(void)
+{
+   static const int32_t pre[4] = { 1, 4, 16, 64 };
+   int32_t n = sio_br & 0x0F;
+   int32_t bit;
+   if (!n)
+      n = 16;
+   bit = 320 * pre[(sio_br >> 4) & 3] * n / 20;
+   if (bit < 16)
+      bit = 16;
+   return bit * ((((sio_mod >> 2) & 3) == 3) ? 11 : 10);
+}
+
+static void tx_start(uint8_t data)
+{
+   sio_txbyte = data;
+   if ((sio_mod & 0x40) && !hb_link_cts)
+   {
+      sio_txwait = 1;            /* CTSE: 상대가 받을 준비(RTS 켬)가 될 때까지 */
+      sio_txleft = -1;
+      hb_link_stat.ctsWaits++;
+   }
+   else
+   {
+      sio_txwait = 0;
+      sio_txleft = byte_cycles();
+   }
+}
+
+int hb_sio_io_read(uint32_t address, uint8_t *out)
+{
+   if (!hb_link_on)
+      return 0;
+   switch (address)
+   {
+      case 0x50:
+         *out = sio_rxbuf;
+         sio_rxfull = 0;
+         return 1;
+      case 0x51:
+         *out = (uint8_t)((sio_cr & 0xE3) | sio_err);
+         sio_err = 0;            /* 읽으면 오류 비트 지움 */
+         return 1;
+      case 0x52:
+         *out = sio_mod;
+         return 1;
+      case 0x53:
+         *out = sio_br;
+         return 1;
+      case 0xB2:
+         *out = COMMStatus;
+         return 1;
+   }
+   return 0;
+}
+
+int hb_sio_io_write(uint32_t address, uint8_t data)
+{
+   if (!hb_link_on)
+      return 0;
+   switch (address)
+   {
+      case 0x50:
+         if (sio_txleft < 0 && !sio_txwait)
+            tx_start(data);
+         else
+         {
+            if (sio_txhasnext)
+               hb_link_stat.txOverflow++;
+            sio_txnext = data;   /* 보내는 중이면 한 칸 기다림 */
+            sio_txhasnext = 1;
+         }
+         return 1;
+      case 0x51:
+         sio_cr = data;
+         return 1;
+      case 0x52:
+         sio_mod = data;
+         return 1;
+      case 0x53:
+         sio_br = data;
+         return 1;
+   }
+   return 0;
+}
+
+void hb_sio_tick(int32_t cycles)
+{
+   hb_rtc_cycles += (uint32_t)cycles;
+   if (sio_txwait)
+   {
+      if (!(sio_mod & 0x40) || hb_link_cts)
+      {
+         sio_txwait = 0;
+         sio_txleft = byte_cycles();
+      }
+      else
+         return;
+   }
+   if (sio_txleft < 0)
+      return;
+   sio_txleft -= cycles;
+   if (sio_txleft > 0)
+      return;
+   /* 한 바이트 다 보냄 → 상대로(래퍼) + INTTX0 */
+   sio_txleft = -1;
+   if (sio_outn < sizeof(sio_out))
+      sio_out[sio_outn++] = sio_txbyte;
+   hb_link_stat.txBytes++;
+   if (sio_txhasnext)
+   {
+      sio_txhasnext = 0;
+      tx_start(sio_txnext);
+   }
+   TestIntHDMA(12, 0x19);
+}
+
+void hb_sio_receive(uint8_t data)
+{
+   if (!(sio_mod & 0x20))
+   {
+      hb_link_stat.rxOff++;      /* 받기 꺼짐(RXE=0): 실제 기계처럼 버림 */
+      return;
+   }
+   if (sio_rxfull)
+   {
+      sio_err |= 0x10;           /* OERR: 안 읽은 바이트 위에 새 바이트 */
+      hb_link_stat.overruns++;
+   }
+   sio_rxbuf = data;
+   sio_rxfull = 1;
+   hb_link_stat.rxBytes++;
+   TestIntHDMA(11, 0x18);
+}
+
+int hb_sio_take(uint8_t *data)
+{
+   if (!sio_outn)
+      return 0;
+   *data = sio_out[0];
+   memmove(sio_out, sio_out + 1, --sio_outn);
+   return 1;
+}
+
+uint8_t hb_sio_rts(void)
+{
+   return (COMMStatus & 1) == 0;
+}
+
+/* ---- 바이오스 COM 함수(연결 켬일 때만) ---- */
+
+static void com_kick_tx(void)
+{
+   uint8_t cnt, head;
+   if (loadB(COM_TXBUSY))
+      return;                    /* 이미 보내는 중 — 0x6FE8 처리기가 이어서 보냄 */
+   cnt = loadB(COM_TXCNT);
+   if (!cnt)
+      return;
+   head = loadB(COM_TXHEAD);
+   storeB(COM_TXBUSY, 0xFF);
+   storeB(COM_TXCNT, (uint8_t)(cnt - 1));
+   storeB(COM_TXHEAD, (uint8_t)(head + 1));
+   storeB(0x50, loadB(COM_TXBUF + (head & 0x3F)));
+}
+
+static int com_put(uint8_t data)
+{
+   uint8_t cnt = loadB(COM_TXCNT);
+   if (cnt >= 64)
+   {
+      hb_link_stat.txOverflow++;
+      return 0;
+   }
+   storeB(COM_TXBUF + ((loadB(COM_TXHEAD) + cnt) & 0x3F), data);
+   storeB(COM_TXCNT, (uint8_t)(cnt + 1));
+   return 1;
+}
+
+static int com_get(uint8_t *data)
+{
+   uint8_t cnt = loadB(COM_RXCNT), head;
+   if (!cnt)
+      return 0;
+   head = loadB(COM_RXHEAD);
+   *data = loadB(COM_RXBUF + (head & 0x3F));
+   storeB(COM_RXHEAD, (uint8_t)(head + 1));
+   storeB(COM_RXCNT, (uint8_t)(cnt - 1));
+   /* 받은 고리가 거의 차서 0x6FE4 처리기가 RTS 를 끈 채 두었으면, 충분히 비었을 때 다시 켬 */
+   if (loadB(COM_RXSTOP) == 0xFF && cnt - 1 < 0x20)
+   {
+      storeB(COM_RXSTOP, 0);
+      COMMStatus &= ~1;
+   }
+   return 1;
+}
+
+int hb_com_hle(uint32_t vector)
+{
+   uint8_t data;
+   if (!hb_link_on)
+      return 0;
+   hb_link_stat.comCalls++;
+   switch (vector)
+   {
+      case VECT_COMINIT:
+         sio_mod = 0x69;         /* 8비트 UART · 받기 켬 · CTS 손잡기 · 보율 발생기 */
+         sio_br = 0x15;
+         sio_err = 0;
+         sio_rxfull = 0;
+         sio_txleft = -1;
+         sio_txwait = 0;
+         sio_txhasnext = 0;
+         {
+            uint32_t a;
+            for (a = COM_TXCNT; a <= COM_ERR; a++)
+               storeB(a, 0);
+         }
+         rCodeB(0x30) = COM_BUF_OK;
+         return 1;
+      case VECT_COMSENDSTART:
+         com_kick_tx();
+         return 1;
+      case VECT_COMRECIVESTART:
+         sio_mod |= 0x20;
+         return 1;
+      case VECT_COMCREATEDATA:
+         rCodeB(0x30) = com_put(rCodeB(0x35)) ? COM_BUF_OK : COM_BUF_OVER;
+         return 1;
+      case VECT_COMGETDATA:
+         if (com_get(&data))
+         {
+            rCodeB(0x35) = data;
+            rCodeB(0x30) = COM_BUF_OK;
+         }
+         else
+            rCodeB(0x30) = COM_BUF_EMPTY;
+         return 1;
+      case VECT_COMONRTS:
+         COMMStatus &= ~1;
+         return 1;
+      case VECT_COMOFFRTS:
+         COMMStatus |= 1;
+         return 1;
+      case VECT_COMSENDSTATUS:
+         rCodeW(0x30) = loadB(COM_TXCNT);
+         return 1;
+      case VECT_COMRECIVESTATUS:
+         rCodeW(0x30) = loadB(COM_RXCNT);
+         return 1;
+      case VECT_COMCREATEBUFDATA:
+         while (rCodeB(0x35) > 0)
+         {
+            if (!com_put(loadB(rCodeL(0x3C))))
+               break;
+            rCodeL(0x3C)++;
+            rCodeB(0x35)--;
+         }
+         rCodeB(0x30) = rCodeB(0x35) ? COM_BUF_OVER : COM_BUF_OK;
+         return 1;
+      case VECT_COMGETBUFDATA:
+         while (rCodeB(0x35) > 0)
+         {
+            if (!com_get(&data))
+               break;
+            storeB(rCodeL(0x3C), data);
+            rCodeL(0x3C)++;
+            rCodeB(0x35)--;
+         }
+         rCodeB(0x30) = rCodeB(0x35) ? COM_BUF_EMPTY : COM_BUF_OK;
+         return 1;
+   }
+   return 0;
+}
+
+int hb_sio_StateAction(void *data, int load, int data_only)
+{
+   SFORMAT StateRegs[] =
+   {
+      SFVARN(sio_mod, "mod"),
+      SFVARN(sio_br, "br"),
+      SFVARN(sio_cr, "cr"),
+      SFVARN(sio_err, "err"),
+      SFVARN(sio_rxbuf, "rxbuf"),
+      SFVARN(sio_rxfull, "rxfull"),
+      SFVARN(sio_txbyte, "txbyte"),
+      SFVARN(sio_txnext, "txnext"),
+      SFVARN(sio_txhasnext, "txhasnext"),
+      SFVARN(sio_txwait, "txwait"),
+      SFVARN(sio_txleft, "txleft"),
+      SFARRAY(sio_out, sizeof(sio_out)),
+      SFVARN(sio_outn, "outn"),
+      SFVARN(COMMStatus, "COMMStatus"),
+      SFVARN(hb_rtc_base, "rtcbase"),
+      SFVARN(hb_rtc_cycles, "rtccycles"),
+      SFEND
+   };
+   if (!MDFNSS_StateAction(data, load, data_only, StateRegs, "HBSL", true))
+      return 0;
+   if (load && sio_outn > sizeof(sio_out))
+      sio_outn = sizeof(sio_out);
+   return 1;
+}
diff --git a/mednafen/ngp/hb_link.h b/mednafen/ngp/hb_link.h
new file mode 100644
index 0000000..3394164
--- /dev/null
+++ b/mednafen/ngp/hb_link.h
@@ -0,0 +1,53 @@
+/* 한방(hanbang) 두 대 연결 — 네오지오 포켓 직렬 0(통신 케이블) 흉내 (10/21)
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * hb_link_on = 0(기본)이면 원래 NeoPop 동작 그대로(직렬 레지스터 = 버퍼 한 칸, 바이오스 COM = system_comms_* 빈 함수).
+ * hb_link_on = 1 이면(두 대 코어가 켬):
+ *  - 직렬 0 레지스터(0x50 SC0BUF · 0x51 SC0CR · 0x52 SC0MOD · 0x53 BR0CR)를 실제처럼: 보내는 바이트 · 받은 바이트 따로,
+ *    한 바이트 = 10비트 시간(BR0CR 0x15 = 19200bps 기준), 다 보내면 INTTX0(사용자 벡터 0x6FE8),
+ *    받으면 INTRX0(사용자 벡터 0x6FE4), 안 읽은 바이트 위에 또 오면 넘침(OERR).
+ *  - 0xB2 비트0 = 내 RTS(0 = 받을 준비). SC0MOD 의 CTSE 가 켜져 있으면 상대 RTS 가 켜질 때까지 다음 바이트를 안 보냄.
+ *  - 바이오스 COM 함수(COMINIT ~ COMGETBUFDATA)를 게임이 까는 SNK 직렬 처리기와 같은 바이오스 작업 메모리
+ *    (보낼 고리 0x6C80 · 받은 고리 0x6CC0 · 개수 0x6D00/0x6D01 · 머리 0x6D02/0x6D03 · 보내는 중 0x6D04 · 받기 멈춤 0x6D05 · 오류 0x6D06)로.
+ */
+#ifndef HB_LINK_H
+#define HB_LINK_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern uint8_t hb_link_on;   /* 1 = 연결 흉내 켬(게임 켤 때 래퍼가 정함, 상태에 안 들어감) */
+extern uint8_t hb_link_cts;  /* 상대 RTS 가 켜져 있음(받을 준비) — 래퍼가 줄마다 넣음 */
+/* 연결 켬일 때 시계(RTC): 기기 시각을 읽을 때마다 쓰지 않고 '켤 때 시각(지역 시간을 UTC 처럼) + 흐른 CPU 사이클'로 —
+ * 두 기기가 같은 값을 읽게(넷플레이 결정성). 기준 시각 · 흐른 사이클은 상태에 들어감. */
+extern int64_t hb_rtc_base;
+extern uint64_t hb_rtc_cycles;
+
+struct hb_link_stats
+{
+   uint32_t txBytes, rxBytes, overruns, rxOff, ctsWaits, comCalls, txOverflow, reserved;
+};
+extern struct hb_link_stats hb_link_stat;
+
+void    hb_sio_reset(void);
+int     hb_sio_io_read(uint32_t address, uint8_t *out);  /* 처리했으면 1 */
+int     hb_sio_io_write(uint32_t address, uint8_t data);  /* 처리했으면 1 */
+void    hb_sio_tick(int32_t cycles);
+void    hb_sio_receive(uint8_t data);
+int     hb_sio_take(uint8_t *data);
+uint8_t hb_sio_rts(void);
+int     hb_com_hle(uint32_t vector);                      /* 처리했으면 1 (RET 은 부른 쪽) */
+int     hb_sio_StateAction(void *data, int load, int data_only);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
