+
+static void transfer(int from)
+{
+   uint8_t byte;
+   uint32_t n = 0;
+   while (inner[from].take(&byte))
+   {
+      inner[!from].receive(byte);
+      stats.bytes[from]++;
+      n++;
+   }
+   if (n > stats.maxQueue)
+      stats.maxQueue = n;
+}
+
+void retro_run(void)
+{
+   bool updated = false;
+   int doneA = 0, doneB = 0, lines = 0, nA, nB = 0, total, shown;
+   const int16_t *snd;
+
+   if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated) && updated)
+      readScreenOption();
+   inputPollCallback();
+
+   inner[0].frame_begin(readPad(0));
+   if (linkOn)
+      inner[1].frame_begin(readPad(1));
+
+   if (!linkOn)
+   {
+      while (!inner[0].run_line() && ++lines < 4096)
+         ;
+   }
+   else
+   {
+      while ((!doneA || !doneB) && ++lines < 4096)
+      {
+         if (!doneA)
+         {
+            inner[0].set_cts(inner[1].rts());
+            doneA = inner[0].run_line();
+            transfer(0);
+         }
+         if (!doneB)
+         {
+            inner[1].set_cts(inner[0].rts());
+            doneB = inner[1].run_line();
+            transfer(1);
+         }
+      }
+   }
+
+   nA = inner[0].frame_end(soundBuf[0], 0x10000);
+   if (linkOn)
+      nB = inner[1].frame_end(soundBuf[1], 0x10000);
+
+   shown = (linkOn && screen == 1) ? 1 : 0;
+   videoCallback(inner[shown].framebuffer(), FB_W, FB_H, FB_W * 2);
+   snd = soundBuf[shown];
+   total = shown ? nB : nA;
+   {
+      int done = 0;
+      while (done < total)
+      {
+         size_t k = audioBatchCallback(snd + done * 2, (size_t)(total - done));
+         if (!k)
+            break;
+         done += (int)k;
+      }
+   }
+
+   stats.frames++;
+   if (traceFile && stats.frames % 60 == 0)
+   {
+      const struct hb_link_stats *a = inner[0].link_stats(), *b = inner[1].link_stats();
+      fprintf(traceFile, "f=%u 넘김 1P->2P %u 2P->1P %u | 1P 보냄 %u 받음 %u 넘침 %u CTS기다림 %u COM %u | 2P 보냄 %u 받음 %u 넘침 %u CTS기다림 %u COM %u | 밖에서온상태 %u\n",
+            stats.frames, stats.bytes[0], stats.bytes[1], a->txBytes, a->rxBytes, a->overruns, a->ctsWaits, a->comCalls,
+            b->txBytes, b->rxBytes, b->overruns, b->ctsWaits, b->comCalls, stats.outsideLoads);
+      fflush(traceFile);
+   }
+}
+
+size_t retro_serialize_size(void)
+{
+   return STATE_HEADER + SLOT_SIZE * (linkOn ? 2 : 1);
+}
+
+static void put32(uint8_t *p, uint32_t v)
+{
+   p[0] = (uint8_t)v;
+   p[1] = (uint8_t)(v >> 8);
+   p[2] = (uint8_t)(v >> 16);
+   p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t get32(const uint8_t *p)
+{
+   return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+bool retro_serialize(void *data, size_t size)
+{
+   uint8_t *out = (uint8_t *)data;
+   size_t lenA, lenB = 0;
+   if (size < retro_serialize_size())
+      return false;
+   memset(out, 0, STATE_HEADER);
+   memcpy(out, STATE_MAGIC, 8);
+   put32(out + 8, 1);
+   put32(out + 12, (uint32_t)linkOn);
+   put32(out + 16, SLOT_SIZE);
+   lenA = inner[0].serialize(out + STATE_HEADER, SLOT_SIZE);
+   if (!lenA)
+   {
+      logf_(RETRO_LOG_ERROR, "1P 상태가 칸(%u)보다 큼", (unsigned)SLOT_SIZE);
+      return false;
+   }
+   if (linkOn)
+   {
+      lenB = inner[1].serialize(out + STATE_HEADER + SLOT_SIZE, SLOT_SIZE);
+      if (!lenB)
+      {
+         logf_(RETRO_LOG_ERROR, "2P 상태가 칸(%u)보다 큼", (unsigned)SLOT_SIZE);
+         return false;
+      }
+   }
+   put32(out + 20, (uint32_t)lenA);
+   put32(out + 24, (uint32_t)lenB);
+   if (size > retro_serialize_size())
+      memset(out + retro_serialize_size(), 0, size - retro_serialize_size());
+   return true;
+}
+
+bool retro_unserialize(const void *data, size_t size)
+{
+   const uint8_t *in = (const uint8_t *)data;
+   uint32_t lenA, lenB;
+   if (size < STATE_HEADER || memcmp(in, STATE_MAGIC, 8) || get32(in + 8) != 1 || get32(in + 16) != SLOT_SIZE)
+   {
+      logf_(RETRO_LOG_ERROR, "상태 머리가 다름");
+      return false;
+   }
+   if ((int)get32(in + 12) != linkOn)
+   {
+      logf_(RETRO_LOG_ERROR, "상태의 link(%u)가 지금(%d)과 다름", get32(in + 12), linkOn);
+      return false;
+   }
+   if (size < retro_serialize_size())
+      return false;
+   lenA = get32(in + 20);
+   lenB = get32(in + 24);
+   if (!lenA || lenA > SLOT_SIZE || lenB > SLOT_SIZE || (linkOn && !lenB))
+      return false;
+   inner[0].unserialize(in + STATE_HEADER, lenA);
+   if (linkOn)
+      inner[1].unserialize(in + STATE_HEADER + SLOT_SIZE, lenB);
+   stats.outsideLoads++;
+   return true;
+}
+
+void *retro_get_memory_data(unsigned id)
+{
+   switch (id)
+   {
+      case RETRO_MEMORY_SYSTEM_RAM:
+      case DUAL_MEMORY_RAM:
+         return inner[0].ram();
+      case DUAL_MEMORY_RAM + 1:
+         return linkOn ? inner[1].ram() : NULL;
+      case DUAL_MEMORY_FRAME:
+         return (void *)inner[0].framebuffer();
+      case DUAL_MEMORY_FRAME + 1:
+         return linkOn ? (void *)inner[1].framebuffer() : NULL;
+      case DUAL_MEMORY_STATS:
+         memcpy(&stats.m[0], inner[0].link_stats(), sizeof(stats.m[0]));
+         memcpy(&stats.m[1], inner[1].link_stats(), sizeof(stats.m[1]));
+         return &stats;
+   }
+   return NULL;
+}
+
+size_t retro_get_memory_size(unsigned id)
+{
+   switch (id)
+   {
+      case RETRO_MEMORY_SYSTEM_RAM:
+      case DUAL_MEMORY_RAM:
+         return 16384;
+      case DUAL_MEMORY_RAM + 1:
+         return linkOn ? 16384 : 0;
+      case DUAL_MEMORY_FRAME:
+         return FB_W * FB_H * 2;
+      case DUAL_MEMORY_FRAME + 1:
+         return linkOn ? FB_W * FB_H * 2 : 0;
+      case DUAL_MEMORY_STATS:
+         return sizeof(stats);
+   }
+   return 0;
+}
