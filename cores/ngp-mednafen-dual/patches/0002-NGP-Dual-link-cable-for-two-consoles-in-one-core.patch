@@ -0,0 +1,73 @@
+# Beetle NeoPop Dual 빌드(한방 10/21) — VM hbbuild(Debian 12 aarch64, gcc 12)에서:
+#   nice -n 19 make -j1 -f dual/Makefile.dual [GIT_VERSION=" abcd1234"]
+# 결과(build_dual/):
+#   mednafen_ngp_dual_libretro.so  두 대 코어(기기용, retro_* 만 내보냄)
+#   mednafen_ngp_hb_libretro.so    안쪽 코어 한 대짜리(시험용 — 연결 꺼짐 = 원래 NeoPop 동작)
+# 방법: 안쪽 오브젝트를 한 번 컴파일 → ld -r 로 하나 → objcopy 로 전역 이름 전부에 ngpA_/ngpB_ 를 붙인 두 벌
+#       (C++ 이름도 그대로 되므로 #define 앞붙이기보다 단순) → 래퍼와 묶음. libstdc++ · libgcc_s 는 기기 순정 코어처럼 동적(정적이면 GLIBC 2.35~2.36 기호가 딸려 옴).
+CC  ?= gcc
+CXX ?= g++
+B   := build_dual
+ARCH_FLAGS ?= -mcpu=cortex-a53
+GIT_VERSION ?=
+DEFS := -DNDEBUG -DWANT_16BPP -DFRONTEND_SUPPORTS_RGB565 -DLOAD_FROM_MEMORY -DMEDNAFEN_VERSION_NUMERIC=931 \
+        -DSTDC_HEADERS -D__STDC_LIMIT_MACROS -D__LIBRETRO__ -DINLINE=inline '-DGIT_VERSION=" $(strip $(GIT_VERSION))"'
+INCS := -I. -Imednafen -Imednafen/include -Imednafen/intl -Imednafen/hw_sound -Imednafen/hw_cpu -Imednafen/hw_misc -Ilibretro-common/include
+CFLAGS_ALL   := -O2 -fPIC $(ARCH_FLAGS) $(DEFS) $(INCS) -w
+CXXFLAGS_ALL := $(CFLAGS_ALL)
+
+CORE_EMU := mednafen/ngp
+SRC_CXX := $(CORE_EMU)/sound.cpp $(CORE_EMU)/T6W28_Apu.cpp mednafen/sound/Blip_Buffer.cpp mednafen/mempatcher.cpp mednafen/sound/Stereo_Buffer.cpp
+SRC_C := $(CORE_EMU)/biosHLE.c $(CORE_EMU)/hb_link.c $(CORE_EMU)/bios.c $(CORE_EMU)/flash.c $(CORE_EMU)/dma.c $(CORE_EMU)/gfx.c \
+  $(CORE_EMU)/interrupt.c $(CORE_EMU)/mem.c $(CORE_EMU)/rom.c $(CORE_EMU)/system.c \
+  $(CORE_EMU)/TLCS-900h/TLCS900h_interpret.c $(CORE_EMU)/TLCS-900h/TLCS900h_interpret_dst.c \
+  $(CORE_EMU)/TLCS-900h/TLCS900h_interpret_reg.c $(CORE_EMU)/TLCS-900h/TLCS900h_interpret_single.c \
+  $(CORE_EMU)/TLCS-900h/TLCS900h_interpret_src.c $(CORE_EMU)/TLCS-900h/TLCS900h_registers.c \
+  mednafen/hw_cpu/z80-fuse/z80_ops.c mednafen/hw_cpu/z80-fuse/z80.c $(CORE_EMU)/rtc.c $(CORE_EMU)/Z80_interface.c \
+  mednafen/state.c libretro.c \
+  libretro-common/streams/file_stream.c libretro-common/compat/fopen_utf8.c libretro-common/compat/compat_strl.c \
+  libretro-common/compat/compat_snprintf.c libretro-common/encodings/encoding_utf.c libretro-common/vfs/vfs_implementation.c \
+  libretro-common/file/file_path.c libretro-common/time/rtime.c libretro-common/string/stdstring.c \
+  libretro-common/compat/compat_posix_string.c mednafen/settings.c
+
+# 시험용: 원래 소스(139fe34)로 같은 옵션 한 대짜리를 만들 때 EXCLUDE=mednafen/ngp/hb_link.c
+EXCLUDE ?=
+SRC_C := $(filter-out $(EXCLUDE),$(SRC_C))
+
+OBJ := $(patsubst %.c,$(B)/o/%.o,$(SRC_C)) $(patsubst %.cpp,$(B)/o/%.o,$(SRC_CXX))
+
+all: $(B)/mednafen_ngp_dual_libretro.so $(B)/mednafen_ngp_hb_libretro.so
+
+$(B)/o/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS_ALL) -c -o $@ $<
+
+$(B)/o/%.o: %.cpp
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXFLAGS_ALL) -c -o $@ $<
+
+$(B)/inner_all.o: $(OBJ) dual/Makefile.dual
+	ld -r --force-group-allocation -o $@ $(OBJ)
+
+# 안쪽 전역 이름(약한 이름 · C++ 템플릿 포함) 전부에 ngpA_/ngpB_ 를 붙임 — COMDAT 묶음 이름도 바뀌어
+# 두 벌이 서로 합쳐지지 않음. 최종 .so 는 판 스크립트로 retro_* 만 밖에 보임.
+$(B)/inner_%.o: $(B)/inner_all.o dual/Makefile.dual
+	nm -g --defined-only $< | awk 'NF==3 {print $$3}' | sort -u | awk '{print $$1" ngp$*_"$$1}' > $(B)/rename_$*.txt
+	objcopy --redefine-syms=$(B)/rename_$*.txt $< $@
+
+$(B)/dual_wrapper.o: dual/libretro_dual.c mednafen/ngp/hb_link.h
+	@mkdir -p $(B)
+	$(CC) $(CFLAGS_ALL) -c -o $@ $<
+
+$(B)/mednafen_ngp_dual_libretro.so: $(B)/dual_wrapper.o $(B)/inner_A.o $(B)/inner_B.o
+	$(CXX) -shared -o $@ $^ -Wl,--version-script=dual/link_dual.T -Wl,--no-undefined -lm
+	strip --strip-unneeded $@
+
+$(B)/mednafen_ngp_hb_libretro.so: $(OBJ)
+	$(CXX) -shared -o $@ $(OBJ) -Wl,--version-script=link.T -Wl,--no-undefined -lm
+	strip --strip-unneeded $@
+
+clean:
+	rm -rf $(B)
+
+.PHONY: all clean
