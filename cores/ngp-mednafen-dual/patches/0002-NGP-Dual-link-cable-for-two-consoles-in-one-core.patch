+bool retro_load_game(const struct retro_game_info *info)
+{
+   enum retro_pixel_format fmt = RETRO_PIXEL_FORMAT_RGB565;
+   static const struct retro_input_descriptor desc[] = {
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_LEFT, "D-Pad Left" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_UP, "D-Pad Up" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_DOWN, "D-Pad Down" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_RIGHT, "D-Pad Right" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_B, "A" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_A, "B" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_START, "Option" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_LEFT, "D-Pad Left" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_UP, "D-Pad Up" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_DOWN, "D-Pad Down" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_RIGHT, "D-Pad Right" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_B, "A" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_A, "B" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_START, "Option" },
+      { 0, 0, 0, 0, NULL },
+   };
+   const char *v, *dir = NULL;
+   char base[1024], fallback[2048];
+   bool host;
+
+   if (!info)
+      return false;
+   environCallback(RETRO_ENVIRONMENT_SET_PIXEL_FORMAT, &fmt);
+   environCallback(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, (void *)desc);
+
+   v = getVar("ngp_dual_link");
+   linkOn = !(v && !strcmp(v, "off"));
+   v = getVar("ngp_dual_language");
+   language = (v && !strcmp(v, "japanese")) ? "japanese" : "english";
+   readScreenOption();
+   host = (screen == 0);
+
+   memset(&stats, 0, sizeof(stats));
+   stats.magic = 0x4E475044; /* 'NGPD' */
+   stats.version = 1;
+   stats.linkOn = (uint32_t)linkOn;
+   stats.screen = (uint32_t)screen;
+
+   /* 1P 기계: 원래 코어와 같은 세이브 이름 */
+   inner[0].save_config("", "", "", host);
+   inner[0].set_link(linkOn);
+   if (!inner[0].load_game(info))
+   {
+      logf_(RETRO_LOG_ERROR, "1P 기계 불러오기 실패");
+      return false;
+   }
+
+   if (linkOn)
+   {
+      struct retro_game_info p2info = *info;
+      const char *p2 = getenv("NGP_DUAL_P2_ROM");
+      v = getVar("ngp_dual_p2_rom");
+      p2Partner = 0;
+      if ((p2 && p2[0]) || (v && !strcmp(v, "partner")))
+      {
+         snprintf(p2RomPath, sizeof(p2RomPath), "%s", (p2 && p2[0]) ? p2 : P2_TMP_ROM);
+         p2RomData = readWholeFile(p2RomPath, &p2RomSize);
+         if (p2RomData)
+         {
+            p2Partner = 1;
+            p2info.path = p2RomPath;
+            p2info.data = p2RomData;
+            p2info.size = p2RomSize;
+            p2info.meta = NULL;
+         }
+         else
+            logf_(RETRO_LOG_WARN, "2P 롬 %s 없음 → 같은 롬", p2RomPath);
+      }
+      stats.p2Loaded = (uint32_t)p2Partner;
+      contentBase(info, base, sizeof(base));
+      fallback[0] = '\0';
+      if (!p2Partner && environCallback(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &dir) && dir && dir[0] && base[0])
+         snprintf(fallback, sizeof(fallback), "%s/%s.flash", dir, base);
+      /* 2P: <롬 이름>.p2.flash, 처음이면 1P 세이브로 시작(같은 롬일 때만) */
+      inner[1].save_config(base, ".p2", fallback, host);
+      inner[1].set_link(1);
+      if (!inner[1].load_game(&p2info))
+      {
+         logf_(RETRO_LOG_ERROR, "2P 기계 불러오기 실패");
+         inner[0].unload_game();
+         return false;
+      }
+   }
+   if (linkOn)
+   {
+      /* 시계: 켤 때 지역 시각 하나를 두 기계에(넷플레이 손님은 방장 상태로 같은 값을 받음) */
+      time_t now = time(NULL);
+      struct tm lt;
+      int64_t base = (int64_t)now;
+      const char *fixed = getenv("NGP_DUAL_RTC_BASE");
+      if (localtime_r(&now, &lt))
+         base += (int64_t)lt.tm_gmtoff;
+      if (fixed && fixed[0])
+         base = (int64_t)strtoll(fixed, NULL, 10);
+      inner[0].set_rtc_base(base);
+      inner[1].set_rtc_base(base);
+   }
+   loaded = true;
+   logf_(RETRO_LOG_INFO, "켬 %s link=%s 화면=%dP 언어=%s 2P롬=%s 상태 기계당 %u 바이트(지금 1P %u)", DUAL_VERSION,
+         linkOn ? "on" : "off", screen + 1, language, p2Partner ? p2RomPath : "same", (unsigned)SLOT_SIZE,
+         (unsigned)inner[0].serialize(NULL, 0));
+   return true;
+}
