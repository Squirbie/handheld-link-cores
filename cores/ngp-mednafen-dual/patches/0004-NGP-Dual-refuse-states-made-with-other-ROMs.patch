From 754f2344d47dffa71a71eb9eaad3bef002040574 Mon Sep 17 00:00:00 2001
From: hanbang <hanbang@localhost>
Date: Wed, 21 Oct 2026 23:43:13 +0900
Subject: [PATCH 4/4] NGP Dual: refuse states made with other ROMs

The state header now carries a FNV-1a hash of each console ROM, so a
netplay peer (or a slot) with a different 1P game or 2P version is
rejected with a log line instead of silently desyncing.

---
 dual/libretro_dual.c | 24 +++++++++++++++++++-----
 libretro.c           | 15 +++++++++++++++
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/dual/libretro_dual.c b/dual/libretro_dual.c
index e35f347..74b8845 100644
--- a/dual/libretro_dual.c
+++ b/dual/libretro_dual.c
@@ -65,7 +65,8 @@
    int P##hb_ngp_unserialize(const uint8_t *, size_t); \
    int P##hb_sio_take(uint8_t *); \
    void P##hb_sio_receive(uint8_t); \
-   uint8_t P##hb_sio_rts(void);
+   uint8_t P##hb_sio_rts(void); \
+   uint32_t P##hb_ngp_rom_hash(void);
 DECL(ngpA_)
 DECL(ngpB_)
 
@@ -93,12 +94,13 @@ struct Inner
    int (*take)(uint8_t *);
    void (*receive)(uint8_t);
    uint8_t (*rts)(void);
+   uint32_t (*rom_hash)(void);
 };
 
 #define TAB(P) { P##retro_set_environment, P##retro_init, P##retro_deinit, P##retro_load_game, P##retro_unload_game, \
    P##retro_reset, P##hb_ngp_save_config, P##hb_ngp_set_flash_write, P##hb_ngp_set_link, P##hb_ngp_set_cts, P##hb_ngp_set_rtc_base, \
    P##hb_ngp_frame_begin, P##hb_ngp_run_line, P##hb_ngp_frame_end, P##hb_ngp_framebuffer, P##hb_ngp_ram, \
-   P##hb_ngp_link_stats, P##hb_ngp_serialize, P##hb_ngp_unserialize, P##hb_sio_take, P##hb_sio_receive, P##hb_sio_rts }
+   P##hb_ngp_link_stats, P##hb_ngp_serialize, P##hb_ngp_unserialize, P##hb_sio_take, P##hb_sio_receive, P##hb_sio_rts, P##hb_ngp_rom_hash }
 
 static const struct Inner inner[2] = { TAB(ngpA_), TAB(ngpB_) };
 
@@ -128,6 +130,7 @@ static void *p2RomData;
 static size_t p2RomSize;
 static char p2RomPath[1024];
 static bool loaded;
+static uint32_t romHash[2];   /* 상태 머리에 넣어 다른 롬(판) 상태를 거절 */
 static struct DualStats stats;
 static int16_t soundBuf[2][0x10000];
 static FILE *traceFile;
@@ -460,6 +463,9 @@ bool retro_load_game(const struct retro_game_info *info)
          return false;
       }
    }
+   romHash[0] = inner[0].rom_hash();
+   romHash[1] = linkOn ? inner[1].rom_hash() : 0;
+
    if (linkOn)
    {
       /* 시계: 켤 때 지역 시각 하나를 두 기계에(넷플레이 손님은 방장 상태로 같은 값을 받음) */
@@ -475,9 +481,9 @@ bool retro_load_game(const struct retro_game_info *info)
       inner[1].set_rtc_base(base);
    }
    loaded = true;
-   logf_(RETRO_LOG_INFO, "켬 %s link=%s 화면=%dP 언어=%s 2P롬=%s 상태 기계당 %u 바이트(지금 1P %u)", DUAL_VERSION,
-         linkOn ? "on" : "off", screen + 1, language, p2Partner ? p2RomPath : "same", (unsigned)SLOT_SIZE,
-         (unsigned)inner[0].serialize(NULL, 0));
+   logf_(RETRO_LOG_INFO, "켬 %s link=%s 화면=%dP 언어=%s 2P롬=%s 롬지문 %08x/%08x 상태 기계당 %u 바이트(지금 1P %u)", DUAL_VERSION,
+         linkOn ? "on" : "off", screen + 1, language, p2Partner ? p2RomPath : "same", romHash[0], romHash[1],
+         (unsigned)SLOT_SIZE, (unsigned)inner[0].serialize(NULL, 0));
    return true;
 }
 
@@ -628,6 +634,8 @@ bool retro_serialize(void *data, size_t size)
    put32(out + 8, 1);
    put32(out + 12, (uint32_t)linkOn);
    put32(out + 16, SLOT_SIZE);
+   put32(out + 28, romHash[0]);
+   put32(out + 32, romHash[1]);
    lenA = inner[0].serialize(out + STATE_HEADER, SLOT_SIZE);
    if (!lenA)
    {
@@ -666,6 +674,12 @@ bool retro_unserialize(const void *data, size_t size)
    }
    if (size < retro_serialize_size())
       return false;
+   if (get32(in + 28) != romHash[0] || get32(in + 32) != romHash[1])
+   {
+      logf_(RETRO_LOG_ERROR, "상태의 롬 지문(%08x/%08x)이 지금 롬(%08x/%08x)과 다름 — 두 기기 롬 · 2P 판을 같게",
+            get32(in + 28), get32(in + 32), romHash[0], romHash[1]);
+      return false;
+   }
    lenA = get32(in + 20);
    lenB = get32(in + 24);
    if (!lenA || lenA > SLOT_SIZE || lenB > SLOT_SIZE || (linkOn && !lenB))
diff --git a/libretro.c b/libretro.c
index 5cda70f..c812960 100644
--- a/libretro.c
+++ b/libretro.c
@@ -875,6 +875,21 @@ int hb_ngp_frame_end(int16_t *buf, int maxFrames)
    return MDFNNGPCSOUND_Flush(buf, maxFrames);
 }
 
+/* 롬 지문(FNV-1a 32, 원본 롬 전체) — 래퍼가 상태 머리에 넣어 다른 롬끼리 상태를 섞지 않게 */
+uint32_t hb_ngp_rom_hash(void)
+{
+   uint32_t h = 2166136261u;
+   size_t i;
+   if (!ngpc_rom.orig_data)
+      return 0;
+   for (i = 0; i < ngpc_rom.length; i++)
+   {
+      h ^= ngpc_rom.orig_data[i];
+      h *= 16777619u;
+   }
+   return h;
+}
+
 const uint16_t *hb_ngp_framebuffer(void)
 {
    return surf ? (const uint16_t *)surf->pixels : NULL;
-- 
2.39.5

