From 50a716b5071fe5324241376b25da6986aa4b6903 Mon Sep 17 00:00:00 2001
From: hanbang <hanbang@localhost>
Date: Wed, 21 Oct 2026 23:40:21 +0900
Subject: [PATCH 3/4] NGP: deterministic flash state (rollback/netplay)

- flash_optimise_blocks: a block lying inside the previous one used to
  shrink it (FIXME std::max), e.g. the erased 32KB save sector became a
  few hundred bytes after a later write; since every savestate calls it,
  loading a state restored a different save area. Use the larger end and
  never merge past the 16-bit length.
- Loading a state without flash data now restores the ROM and clears the
  block list (they were left from the newer timeline).
- memory_flash_command (pending 0x5555/0x2AAA command) is saved (HBSL).
Seen as rollback mismatches in Card Fighters Clash right after New Game.

---
 mednafen/ngp/flash.c   | 21 +++++++++++++++------
 mednafen/ngp/flash.h   |  1 +
 mednafen/ngp/hb_link.c |  3 +++
 mednafen/ngp/rom.c     |  7 +++++++
 mednafen/ngp/system.c  | 11 ++++++++++-
 5 files changed, 36 insertions(+), 7 deletions(-)

diff --git a/mednafen/ngp/flash.c b/mednafen/ngp/flash.c
index e7b398f..d7454de 100644
--- a/mednafen/ngp/flash.c
+++ b/mednafen/ngp/flash.c
@@ -88,15 +88,18 @@ void flash_optimise_blocks(void)
    //blocks to be compared to the newly expanded block.
    for (i = 0; i < block_count - 1; /**/)
    {
+      uint32_t end_i = blocks[i].start_address + blocks[i].data_length;
+      uint32_t end_n = blocks[i+1].start_address + blocks[i+1].data_length;
+      uint32_t new_end = (end_n > end_i) ? end_n : end_i;
+
       //Next block lies within (or borders) this one?
-      if (blocks[i+1].start_address <=
-            (blocks[i].start_address + blocks[i].data_length))
+      /* 한방: 원래는 다음 블록 끝으로 길이를 정해, 다음 블록이 안에 들어 있으면 앞 블록이 줄어들었음(FIXME: std::max) —
+       * 지운 32KB 칸이 몇백 바이트로 줄어 상태를 불러오면 세이브 칸이 달라지고, 저장 때마다 이 함수가 불려 넷플레이 ·
+       * 되감기가 어긋났음(카드 파이터즈 새 게임). 끝은 둘 중 큰 쪽, 길이(16비트)를 넘으면 합치지 않음. */
+      if (blocks[i+1].start_address <= end_i && new_end - blocks[i].start_address <= 0xFFFF)
       {
          //Extend the first block
-         blocks[i].data_length = 
-            (uint16_t)((blocks[i+1].start_address + blocks[i+1].data_length) - 
-                  blocks[i].start_address);
-         //FIXME: std::max
+         blocks[i].data_length = (uint16_t)(new_end - blocks[i].start_address);
 
          //Remove the next one.
          for (j = i+2; j < block_count; j++)
@@ -113,6 +116,12 @@ void flash_optimise_blocks(void)
    }
 }
 
+/* 한방: 플래시 블록 목록 비우기(플래시 없는 상태를 불러올 때) */
+void flash_clear_blocks(void)
+{
+   block_count = 0;
+}
+
 void do_flash_read(uint8_t *flashdata)
 {
    FlashFileHeader header;
diff --git a/mednafen/ngp/flash.h b/mednafen/ngp/flash.h
index 7873e10..f1c5a27 100644
--- a/mednafen/ngp/flash.h
+++ b/mednafen/ngp/flash.h
@@ -35,6 +35,7 @@ void flash_commit(void);
 int FLASH_StateAction(void *data, int load, int data_only);
 
 void do_flash_read(uint8_t *flashdata);
+void flash_clear_blocks(void);
 
 #ifdef __cplusplus
 }
diff --git a/mednafen/ngp/hb_link.c b/mednafen/ngp/hb_link.c
index faac1fc..acbc09c 100644
--- a/mednafen/ngp/hb_link.c
+++ b/mednafen/ngp/hb_link.c
@@ -373,6 +373,9 @@ int hb_sio_StateAction(void *data, int load, int data_only)
       SFVARN(COMMStatus, "COMMStatus"),
       SFVARN(hb_rtc_base, "rtcbase"),
       SFVARN(hb_rtc_cycles, "rtccycles"),
+      /* 플래시 명령(0x5555/0x2AAA 쓰기) 뒤 다음 쓰기를 기다리는 중인지 — 원래 상태에 없어서 켠 뒤 처음 불러오기 전후로
+       * 카드 파이터즈 새 게임 세이브 쓰기가 달라졌음(되감기 어긋남) */
+      SFVARN_BOOL(memory_flash_command, "flashcmd"),
       SFEND
    };
    if (!MDFNSS_StateAction(data, load, data_only, StateRegs, "HBSL", true))
diff --git a/mednafen/ngp/rom.c b/mednafen/ngp/rom.c
index f7ef010..8cbb40d 100644
--- a/mednafen/ngp/rom.c
+++ b/mednafen/ngp/rom.c
@@ -53,6 +53,13 @@ static void rom_hack(void)
       ngpc_rom.data[0x23] = 0x00;	/* Fix ROM header */
 }
 
+/* 한방: 상태를 불러올 때 롬(플래시가 쓴 칸 포함)을 원본으로 되돌림 — 롬 고침(rom_hack)도 다시 */
+void hb_rom_restore(void)
+{
+   memcpy(ngpc_rom.data, ngpc_rom.orig_data, ngpc_rom.length);
+   rom_hack();
+}
+
 void rom_loaded(uint8_t *buf, size_t len)
 {
    int i;
diff --git a/mednafen/ngp/system.c b/mednafen/ngp/system.c
index dbe0eef..615d979 100644
--- a/mednafen/ngp/system.c
+++ b/mednafen/ngp/system.c
@@ -10,6 +10,8 @@
 
 #include <streams/file_stream.h>
 
+void hb_rom_restore(void); /* rom.c */
+
 bool system_comms_read(uint8_t* buffer) { return 0; }
 bool system_comms_poll(uint8_t* buffer) { return 0; }
 void system_comms_write(uint8_t data) { }
@@ -92,6 +94,13 @@ int FLASH_StateAction(void *data, int load, int data_only)
    {
       if(flashdata)
          free(flashdata);
+      /* 한방: 플래시가 없는 상태를 불러오면 지금 롬에 남은 플래시 쓰기 · 블록 목록도 지워야 함 — 원래는 그대로 남아
+       * 새 게임 세이브를 쓴 뒤 그 전 상태로 되감으면 롬 · 세이브 칸이 달라졌음(카드 파이터즈 되감기 어긋남) */
+      if (load)
+      {
+         hb_rom_restore();
+         flash_clear_blocks();
+      }
       return 1;
    }
 
@@ -109,7 +118,7 @@ int FLASH_StateAction(void *data, int load, int data_only)
 
    if(load)
    {
-      memcpy(ngpc_rom.data, ngpc_rom.orig_data, ngpc_rom.length);
+      hb_rom_restore();
       do_flash_read(flashdata);
    }
 
