+/* 네오지오 포켓 롬 머리(0x00 'COPYRIGHT BY SNK CORPORATION' 또는 ' LICENSED BY SNK CORPORATION') */
+static bool ngpLooksLikeRom(const uint8_t *rom, size_t size)
+{
+   return size >= 0x40 && (!memcmp(rom, "COPYRIGHT BY SNK CORPORATION", 28) ||
+                           !memcmp(rom, " LICENSED BY SNK CORPORATION", 28));
+}
+
+/* 짝 게임 손님: /tmp/hb_dual_p2rom(한 줄 = 2P 롬 경로)이 막 생겼고 넷플레이 손님(--connect)일 때만 그 롬 */
+static void p2RomFromPairFile(void)
+{
+   struct stat st;
+   char line[1100];
+   long long age;
+   ssize_t n;
+   size_t size = 0;
+   int fd;
+   void *rom;
+   if (stat(HB_P2ROM_FILE, &st) != 0)
+      return;
+   if (!hb_launched_as_guest())
+   {
+      logf_(RETRO_LOG_INFO, "2P 짝 롬 파일이 있지만 넷플레이 손님(--connect)이 아님 — 무시");
+      return;
+   }
+   age = (long long)time(NULL) - (long long)st.st_mtime;
+   if (!S_ISREG(st.st_mode) || st.st_size < 2 || st.st_size >= (off_t)sizeof(line) || age < -5 || age > HB_P2ROM_AGE)
+   {
+      logf_(RETRO_LOG_WARN, "2P 짝 롬 파일 형식 오류 · 오래됨(%lld초) — 무시", age);
+      return;
+   }
+   fd = open(HB_P2ROM_FILE, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   n = read(fd, line, sizeof(line) - 1);
+   close(fd);
+   if (n < 2)
+      return;
+   line[n] = '\0';
+   while (n && (line[n - 1] == '\n' || line[n - 1] == '\r'))
+      line[--n] = '\0';
+   if (n < 2 || line[0] != '/' || strlen(line) != (size_t)n)
+   {
+      logf_(RETRO_LOG_WARN, "2P 짝 롬 파일 내용 오류 — 무시");
+      return;
+   }
+   rom = readWholeFile(line, &size);
+   if (!rom || !ngpLooksLikeRom((const uint8_t *)rom, size))
+   {
+      logf_(RETRO_LOG_ERROR, "2P 짝 롬을 못 읽음 · 네오지오 롬 아님: %s — 같은 롬으로 켬(방장 짝 상태는 거절됨)", line);
+      free(rom);
+      return;
+   }
+   free(p2RomData);
+   p2RomData = rom;
+   p2RomSize = size;
+   snprintf(p2RomPath, sizeof(p2RomPath), "%s", line);
+   p2Partner = 1;
+   logf_(RETRO_LOG_INFO, "2P 짝 롬: %s (CRC %08x, %u 바이트)", line, (unsigned)hb_crc32(rom, size), (unsigned)size);
+}
