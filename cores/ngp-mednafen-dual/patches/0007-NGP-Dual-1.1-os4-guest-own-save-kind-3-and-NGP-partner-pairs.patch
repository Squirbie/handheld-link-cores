+/* 원본 롬(파일 그대로) — 래퍼가 롬 CRC32 를 셈 */
+const uint8_t *hb_ngp_rom_data(size_t *size)
+{
+   *size = ngpc_rom.orig_data ? ngpc_rom.length : 0;
+   return ngpc_rom.orig_data;
+}
