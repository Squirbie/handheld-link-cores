+       !inner[1].flash_apply(data, size))
+   {
+      bool back;
+      logf_(RETRO_LOG_ERROR, "짝 롬으로 2P 를 못 켬 · 손님 세이브가 그 판에 안 맞음 — 원래 2P 로 되돌림");
+      inner[1].unload_game();
