+/* ---- 한방 각자 세이브(10/22): 플래시 세이브 사본 만들기 · 넣기 ----
+ * 세이브 파일 꼴은 원래 <롬>.flash 와 같음(flash.c make_flash_commit): 머리 8(0x0053 · 블록 수 · 전체 길이) +
+ * 블록마다 머리 8(시작 주소 4 · 길이 2 · 0 2) + 내용. 내용은 롬 버퍼(ngpc_rom.data)에서 바로 읽음 — loadB 는 플래시
+ * 상태 읽기 모드를 바꿀 수 있고 블록 목록 정리(flash_optimise_blocks)도 에뮬 상태라, 사본은 둘 다 건드리지 않음. */
+#define HB_FLASH_ID 0x0053
+#define HB_FLASH_MAXBLOCKS 256
+#include <stdlib.h>
+void hb_rom_restore(void); /* rom.c */
+
+static uint8_t *hb_flash_ptr(uint32_t address, uint32_t length)
+{
+   uint32_t offset;
+   if (!ngpc_rom.data)
+      return NULL;
+   if (address >= 0x200000 && address < 0x400000)
+      offset = address - 0x200000;
+   else if (address >= 0x800000 && address < 0xA00000)
+      offset = 0x200000 + (address - 0x800000);
+   else
+      return NULL;
+   if (offset + length > ngpc_rom.length)
+      return NULL;
+   return ngpc_rom.data + offset;
+}
+
+/* 지금 플래시 세이브를 원래 .flash 꼴로 out 에. 돌려줌 = 길이(블록 없으면 0, cap 보다 크면 (size_t)-1) */
+size_t hb_ngp_flash_image(uint8_t *out, size_t cap)
+{
+   static uint32_t start[HB_FLASH_MAXBLOCKS];
+   static uint16_t len[HB_FLASH_MAXBLOCKS];
+   int count = hb_flash_get_blocks(start, len, HB_FLASH_MAXBLOCKS), i, j;
+   size_t total = 8, at;
+   if (count <= 0)
+      return 0;
+   if (count > HB_FLASH_MAXBLOCKS)
+      return (size_t)-1;
+   /* flash_optimise_blocks 와 같은 차례(주소 순 · 겹치거나 붙은 블록 합치기, 끝은 큰 쪽 · 16비트 넘으면 안 합침)를 사본에 */
+   for (i = 0; i < count - 1; i++)
+      for (j = i + 1; j < count; j++)
+         if (start[i] > start[j])
+         {
+            uint32_t t32 = start[i]; uint16_t t16 = len[i];
+            start[i] = start[j]; len[i] = len[j];
+            start[j] = t32; len[j] = t16;
+         }
+   for (i = 0; i < count - 1;)
+   {
+      uint32_t end_i = start[i] + len[i], end_n = start[i + 1] + len[i + 1];
+      uint32_t new_end = end_n > end_i ? end_n : end_i;
+      if (start[i + 1] <= end_i && new_end - start[i] <= 0xFFFF)
+      {
+         len[i] = (uint16_t)(new_end - start[i]);
+         for (j = i + 2; j < count; j++)
+         {
+            start[j - 1] = start[j];
+            len[j - 1] = len[j];
+         }
+         count--;
+      }
+      else
+         i++;
+   }
+   for (i = 0; i < count; i++)
+      total += 8 + len[i];
+   if (total > cap)
+      return (size_t)-1;
+   out[0] = HB_FLASH_ID & 0xFF; out[1] = HB_FLASH_ID >> 8;
+   out[2] = (uint8_t)count; out[3] = (uint8_t)(count >> 8);
+   out[4] = (uint8_t)total; out[5] = (uint8_t)(total >> 8); out[6] = (uint8_t)(total >> 16); out[7] = (uint8_t)(total >> 24);
+   at = 8;
+   for (i = 0; i < count; i++)
+   {
+      const uint8_t *src = hb_flash_ptr(start[i], len[i]);
+      out[at + 0] = (uint8_t)start[i]; out[at + 1] = (uint8_t)(start[i] >> 8);
+      out[at + 2] = (uint8_t)(start[i] >> 16); out[at + 3] = (uint8_t)(start[i] >> 24);
+      out[at + 4] = (uint8_t)len[i]; out[at + 5] = (uint8_t)(len[i] >> 8);
+      out[at + 6] = out[at + 7] = 0;
+      at += 8;
+      if (src)
+         memcpy(out + at, src, len[i]);
+      else
+         memset(out + at, 0xFF, len[i]);
+      at += len[i];
+   }
+   return total;
+}
+
+/* .flash 꼴이 맞는지(머리 · 블록 수 · 길이 · 주소가 이 카트 안) */
+int hb_ngp_flash_valid(const uint8_t *data, size_t size)
+{
+   uint32_t count, total, at = 8, i;
+   if (!size)
+      return 1;
+   if (size < 8 || (data[0] | (data[1] << 8)) != HB_FLASH_ID)
+      return 0;
+   count = data[2] | (data[3] << 8);
+   total = data[4] | (data[5] << 8) | ((uint32_t)data[6] << 16) | ((uint32_t)data[7] << 24);
+   if (total != size || !count || count > HB_FLASH_MAXBLOCKS)
+      return 0;
+   for (i = 0; i < count; i++)
+   {
+      uint32_t start, length;
+      if (at + 8 > size)
+         return 0;
+      start = data[at] | (data[at + 1] << 8) | ((uint32_t)data[at + 2] << 16) | ((uint32_t)data[at + 3] << 24);
+      length = data[at + 4] | (data[at + 5] << 8);
+      at += 8;
+      if (at + length > size || !hb_flash_ptr(start, length))
+         return 0;
+      at += length;
+   }
+   return at == size;
+}
+
+/* 이 기계의 플래시 세이브를 data(.flash 꼴, 0 바이트 = 세이브 없는 새 카트)로 바꿈 — 롬을 원본으로 되돌린 뒤 넣음.
+ * 전원은 부른 쪽이 다시 켬(retro_reset). */
+int hb_ngp_flash_apply(const uint8_t *data, size_t size)
+{
+   uint8_t *copy;
+   if (!ngpc_rom.data || !hb_ngp_flash_valid(data, size))
+      return 0;
+   hb_rom_restore();
+   flash_clear_blocks();
+   memory_flash_command = false;
+   if (!size)
+      return 1;
+   copy = (uint8_t *)malloc(size);
+   if (!copy)
+      return 0;
+   memcpy(copy, data, size);
+   do_flash_read(copy);
+   free(copy);
+   return 1;
+}
