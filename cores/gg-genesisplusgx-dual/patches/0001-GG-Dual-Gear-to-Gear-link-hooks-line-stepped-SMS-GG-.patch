+{
+   return hb_frame_sms_line();
+}
+
+/* 한 장 끝(원래 retro_run 의 뒷부분 — 화면 · 소리 콜백) */
+void hb_gg_frame_end(void)
+{
+   hb_run_tail(hb_do_skip);
+}
+
+/* 통신 고리 켜기 · 끄기(ops == NULL 이면 끔) */
+void hb_gg_set_link(const struct hb_gg_link_ops *ops)
+{
+   if (ops)
+   {
+      hb_gg_link = *ops;
+      hb_gg_link_on = 1;
