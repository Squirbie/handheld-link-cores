+static void sendAudio(const int16_t *snd, size_t total)
+{
+   size_t done = 0;
+   while (done < total && audioBatchCallback)
+   {
+      size_t k = audioBatchCallback(snd + done * 2, total - done);
+      if (!k)
+         break;
+      done += k;
+   }
+}
+
+void retro_run(void)
+{
+   bool updated = false;
+   int shown;
+
+   if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE, &updated) && updated)
+      readScreenOption();
+   inputPollCallback();
+   soundFrames[0] = soundFrames[1] = 0;
+
+   if (!linkOn)
+   {
+      /* 혼자: 원래 Genesis Plus GX 의 retro_run 그대로 */
+      inner[0].run();
+   }
+   else
+   {
+      int doneA = 0, doneB = 0, lines = 0;
+      inner[0].frame_begin();
+      inner[1].frame_begin();
+      while ((!doneA || !doneB) && ++lines < 4096)
+      {
+         runLine(0, &doneA);
+         runLine(1, &doneB);
+      }
+      inner[0].frame_end();
+      inner[1].frame_end();
+      if (p2Countdown && --p2Countdown == 0)
+      {
+         writeP2Save("주기");
+         p2Countdown = P2_WRITE_EVERY;
+      }
+   }
+
+   shown = (linkOn && screen == 1) ? 1 : 0;
+   stats.fbW = frameW[shown];
+   stats.fbH = frameH[shown];
+   if (videoCallback)
+   {
+      if (frameSeen[shown])
+         videoCallback(frameBuf[shown], frameW[shown] < FB_W ? frameW[shown] : FB_W,
+               frameH[shown] < FB_H ? frameH[shown] : FB_H, FB_W * 2);
+      else
+         videoCallback(NULL, FB_W, FB_H, FB_W * 2);
+   }
+   sendAudio(soundBuf[shown], soundFrames[shown]);
+
+   stats.frames++;
+   if (traceFile && stats.frames % 60 == 0)
+   {
+      fprintf(traceFile, "f=%u 넘김 1P->2P %u 2P->1P %u 기다림 %u/%u 버림 %u/%u NMI %u/%u 병렬NMI %u/%u 밖에서온상태 %u\n",
+            stats.frames, stats.bytes[0], stats.bytes[1], stats.waits[0], stats.waits[1], stats.drops[0], stats.drops[1],
+            stats.nmis[0], stats.nmis[1], stats.parNmis[0], stats.parNmis[1], stats.outsideLoads);
+      fflush(traceFile);
+   }
+}
+
+size_t retro_serialize_size(void)
+{
+   return HEADER_SIZE + LINK_SIZE + SLOT_SIZE * (linkOn ? 2 : 1);
+}
+
+static void put32(uint8_t *p, uint32_t v)
+{
+   p[0] = (uint8_t)v;
+   p[1] = (uint8_t)(v >> 8);
+   p[2] = (uint8_t)(v >> 16);
+   p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t get32(const uint8_t *p)
+{
+   return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static void putLink(uint8_t *p)
+{
+   int m;
+   memset(p, 0, LINK_SIZE);
+   for (m = 0; m < 2; m++)
+   {
+      uint8_t *q = p + m * 16;
+      q[0] = side[m].txActive;
+      q[1] = side[m].txByte;
+      q[2] = side[m].pendNmi;
+      q[3] = side[m].pc6Seen;
+      put32(q + 4, side[m].txLines);
+   }
+}
+
+static void getLink(const uint8_t *p)
+{
+   int m;
+   for (m = 0; m < 2; m++)
+   {
+      const uint8_t *q = p + m * 16;
+      side[m].txActive = q[0];
+      side[m].txByte = q[1];
+      side[m].pendNmi = q[2];
+      side[m].pc6Seen = q[3];
+      side[m].txLines = get32(q + 4);
+   }
+}
+
+static bool saveSlot(int m, uint8_t *slot, uint32_t *len)
+{
+   static uint8_t tmp[0x100000];     /* Genesis Plus GX 상태 최대(STATE_SIZE 0xfd000)보다 큼 */
+   int n = inner[m].state_save(tmp);
+   if (n <= 0 || n > SLOT_STATE_MAX)
+   {
+      logf_(RETRO_LOG_ERROR, "%dP 상태 %d 바이트가 칸(%u)보다 큼", m + 1, n, (unsigned)SLOT_STATE_MAX);
+      return false;
+   }
+   memcpy(slot, tmp, (size_t)n);
+   memset(slot + n, 0, SLOT_STATE_MAX - (size_t)n);
+   memcpy(slot + SLOT_STATE_MAX, inner[m].sram(), SRAM_SAVE);
+   *len = (uint32_t)n;
+   return true;
+}
+
+bool retro_serialize(void *data, size_t size)
+{
+   uint8_t *out = (uint8_t *)data;
+   uint32_t lenA = 0, lenB = 0;
+   if (size < retro_serialize_size())
+      return false;
+   memset(out, 0, HEADER_SIZE);
+   memcpy(out, STATE_MAGIC, 8);
+   put32(out + 8, STATE_VERSION);
+   put32(out + 12, (uint32_t)linkOn);
+   put32(out + 16, SLOT_SIZE);
+   put32(out + 28, romHash);
+   putLink(out + HEADER_SIZE);
+   if (!saveSlot(0, out + HEADER_SIZE + LINK_SIZE, &lenA))
+      return false;
+   if (linkOn && !saveSlot(1, out + HEADER_SIZE + LINK_SIZE + SLOT_SIZE, &lenB))
+      return false;
+   put32(out + 20, lenA);
+   put32(out + 24, lenB);
+   if (size > retro_serialize_size())
+      memset(out + retro_serialize_size(), 0, size - retro_serialize_size());
+   return true;
+}
+
+bool retro_unserialize(const void *data, size_t size)
+{
+   const uint8_t *in = (const uint8_t *)data;
+   uint32_t lenA, lenB;
+   if (size < HEADER_SIZE || memcmp(in, STATE_MAGIC, 8) || get32(in + 8) != STATE_VERSION || get32(in + 16) != SLOT_SIZE)
+   {
+      logf_(RETRO_LOG_ERROR, "상태 머리가 다름(다른 코어 · 다른 판의 상태?)");
+      return false;
+   }
+   if ((int)get32(in + 12) != linkOn)
+   {
+      logf_(RETRO_LOG_ERROR, "상태의 link(%u)가 지금(%d)과 다름", get32(in + 12), linkOn);
+      return false;
+   }
+   if (size < retro_serialize_size())
+      return false;
+   if (get32(in + 28) != romHash)
+   {
+      logf_(RETRO_LOG_ERROR, "상태의 롬 지문 %08x 이 지금 롬 %08x 과 다름 — 두 기기 롬을 같게", get32(in + 28), romHash);
+      return false;
+   }
+   lenA = get32(in + 20);
+   lenB = get32(in + 24);
+   if (!lenA || lenA > SLOT_STATE_MAX || lenB > SLOT_STATE_MAX || (linkOn && !lenB))
+      return false;
+   if (!inner[0].state_load(in + HEADER_SIZE + LINK_SIZE))
+      return false;
+   memcpy(inner[0].sram(), in + HEADER_SIZE + LINK_SIZE + SLOT_STATE_MAX, SRAM_SAVE);
+   if (linkOn)
+   {
+      if (!inner[1].state_load(in + HEADER_SIZE + LINK_SIZE + SLOT_SIZE))
+         return false;
+      memcpy(inner[1].sram(), in + HEADER_SIZE + LINK_SIZE + SLOT_SIZE + SLOT_STATE_MAX, SRAM_SAVE);
+      getLink(in + HEADER_SIZE);
+   }
+   stats.outsideLoads++;
+   return true;
+}
+
+void *retro_get_memory_data(unsigned id)
+{
+   switch (id)
+   {
+      case RETRO_MEMORY_SAVE_RAM:
+      case RETRO_MEMORY_SYSTEM_RAM:
+         return inner[0].get_memory_data(id);
+      case DUAL_MEMORY_RAM:
+         return inner[0].work_ram();
+      case DUAL_MEMORY_RAM + 1:
+         return linkOn ? inner[1].work_ram() : NULL;
+      case DUAL_MEMORY_FRAME:
+         return frameBuf[0];
+      case DUAL_MEMORY_FRAME + 1:
+         return linkOn ? frameBuf[1] : NULL;
+      case DUAL_MEMORY_IOREG:
+         return inner[0].io_reg();
+      case DUAL_MEMORY_IOREG + 1:
+         return linkOn ? inner[1].io_reg() : NULL;
+      case DUAL_MEMORY_STATS:
+         return &stats;
+   }
+   return NULL;
+}
+
+size_t retro_get_memory_size(unsigned id)
+{
+   switch (id)
+   {
+      case RETRO_MEMORY_SAVE_RAM:
+      case RETRO_MEMORY_SYSTEM_RAM:
+         return inner[0].get_memory_size(id);
+      case DUAL_MEMORY_RAM:
+         return 0x2000;
+      case DUAL_MEMORY_RAM + 1:
+         return linkOn ? 0x2000 : 0;
+      case DUAL_MEMORY_FRAME:
+         return FB_W * FB_H * 2;
+      case DUAL_MEMORY_FRAME + 1:
+         return linkOn ? FB_W * FB_H * 2 : 0;
+      case DUAL_MEMORY_IOREG:
+         return 16;
+      case DUAL_MEMORY_IOREG + 1:
+         return linkOn ? 16 : 0;
+      case DUAL_MEMORY_STATS:
+         return sizeof(stats);
+   }
+   return 0;
+}
+
+unsigned retro_get_region(void)
+{
+   return RETRO_REGION_NTSC;
+}
+
+/* 치트는 두 기계에 같이(넷플레이에서 두 기기가 같아야 함) */
+void retro_cheat_reset(void)
+{
+   inner[0].cheat_reset();
+   if (linkOn)
+      inner[1].cheat_reset();
+}
+
+void retro_cheat_set(unsigned index, bool enabled, const char *code)
+{
+   inner[0].cheat_set(index, enabled, code);
+   if (linkOn)
+      inner[1].cheat_set(index, enabled, code);
+}
