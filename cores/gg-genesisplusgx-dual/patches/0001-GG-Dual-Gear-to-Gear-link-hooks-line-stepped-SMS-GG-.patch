diff --git a/core/hb_gglink.h b/core/hb_gglink.h
new file mode 100644
index 0000000..f9b1e05
--- /dev/null
+++ b/core/hb_gglink.h
@@ -0,0 +1,43 @@
+/***************************************************************************************
+ *  한방 10/22: 게임기어 두 대 통신(기어 투 기어 케이블) 고리
+ *
+ *  이 파일의 고리는 dual/libretro_dual.c(Genesis Plus GX GG Dual)만 씀.
+ *  hb_gg_link_on == 0(기본)이면 io_ctrl.c 의 게임기어 포트 0x01~0x05 는 원래 Genesis Plus GX 와
+ *  한 글자도 다르지 않게 돔(혼자 = 원래 코어와 같은 그림 · 소리).
+ *
+ *  실기 근거(SMS Power "Gear to Gear Cable" · 1993 개발 문서 jon.txt):
+ *   - 포트 0x01 병렬 7비트(PC0~PC6), 0x02 방향(1 = 입력) · 비트7 NMI 허용,
+ *     케이블이 비트를 엇갈려 이음: 0<->2, 1<->3, 4<->5, 6<->6
+ *   - 포트 0x03 보낼 바이트, 0x04 받은 바이트, 0x05 상태/설정:
+ *     비트0 보내는 중 · 비트1 받은 바이트 있음 · 비트2 상대 꺼짐/오류 · 비트3 받으면 NMI ·
+ *     비트4 보내기(PC4=TX) · 비트5 받기(PC5=RX) · 비트6~7 속도(4800/2400/1200/300bps)
+ *
+ *  Copyright (C) 2026 hanbang — Genesis Plus GX 라이선스(LICENSE.txt, 비상업)를 따름.
+ ****************************************************************************************/
+#ifndef _HB_GGLINK_H_
+#define _HB_GGLINK_H_
+
+#include <stdint.h>
+
+struct hb_gg_link_ops
+{
+  /* 상대가 내 핀에 보이는 병렬 값(케이블 엇갈림 적용, 비트0~6, 아무도 안 모는 줄 = 1) */
+  uint8_t (*par_in)(void *ctx);
+  /* 내 포트 0x01/0x02 를 썼음(PC6 → 상대 NMI 판단용) */
+  void (*par_out)(void *ctx);
+  /* 포트 0x03 을 썼음(보내기 시작) */
+  void (*tx)(void *ctx, uint8_t data);
+  /* 포트 0x04 를 읽었음(받은 바이트를 가져감) */
+  void (*rx_read)(void *ctx);
+  /* 포트 0x05 를 썼음 */
+  void (*ctrl)(void *ctx);
+  void *ctx;
+};
+
+/* 0 이면 원래 동작. 래퍼가 게임을 켤 때 1 로 */
+extern int hb_gg_link_on;
+extern struct hb_gg_link_ops hb_gg_link;
+/* 시험용 기록: 포트 0x01~0x05 읽기쓰기를 래퍼에 알림(NULL 이면 안 함) */
+extern void (*hb_gg_port_trace)(void *ctx, int write, unsigned port, unsigned value);
+
+#endif
diff --git a/core/io_ctrl.c b/core/io_ctrl.c
index e4799ec..34f85a7 100644
--- a/core/io_ctrl.c
+++ b/core/io_ctrl.c
@@ -49,9 +49,15 @@
 #include "paddle.h"
 #include "sportspad.h"
 #include "graphic_board.h"
+#include "hb_gglink.h"
 
 uint8 io_reg[0x10];
 
+/* 한방 10/22: 게임기어 두 대 통신 고리(hb_gglink.h). 꺼져 있으면(기본) 원래 동작 */
+int hb_gg_link_on = 0;
+struct hb_gg_link_ops hb_gg_link;
+void (*hb_gg_port_trace)(void *ctx, int write, unsigned port, unsigned value) = 0;
+
 uint8 region_code = REGION_USA;
 
 static struct port_t
@@ -603,21 +609,45 @@ unsigned int io_z80_read(unsigned int offset)
 
 void io_gg_write(unsigned int offset, unsigned int data)
 {
+  if (hb_gg_port_trace && (offset >= 1) && (offset <= 5))
+  {
+    hb_gg_port_trace(hb_gg_link.ctx, 1, offset, data);
+  }
+
   switch (offset)
   {
     case 1: /* Parallel data register */
       io_reg[1] = data;
+      if (hb_gg_link_on)
+      {
+        hb_gg_link.par_out(hb_gg_link.ctx);
+      }
       return;
 
     case 2: /* Data direction register and NMI enable */
       io_reg[2] = data;
+      if (hb_gg_link_on)
+      {
+        hb_gg_link.par_out(hb_gg_link.ctx);
+      }
       return;
 
     case 3: /* Transmit data buffer */
       io_reg[3] = data;
+      if (hb_gg_link_on)
+      {
+        hb_gg_link.tx(hb_gg_link.ctx, data);
+      }
       return;
 
     case 5: /* Serial control (bits 0-2 are read-only) */
+      if (hb_gg_link_on)
+      {
+        /* 한방: 상태 비트0~2 는 래퍼가 관리 — 쓰기로 지우지 않음 */
+        io_reg[5] = (data & 0xF8) | (io_reg[5] & 0x07);
+        hb_gg_link.ctrl(hb_gg_link.ctx);
+        return;
+      }
       io_reg[5] = data & 0xF8;
       return;
 
@@ -631,7 +661,44 @@ void io_gg_write(unsigned int offset, unsigned int data)
   }
 }
 
+static unsigned int io_gg_read_orig(unsigned int offset);
+
 unsigned int io_gg_read(unsigned int offset)
+{
+  unsigned int data;
+
+  /* 한방 10/22: 연결 꺼짐 · 기록 없음이면 원래 함수 그대로 */
+  if (!hb_gg_link_on && !hb_gg_port_trace)
+  {
+    return io_gg_read_orig(offset);
+  }
+
+  if (hb_gg_link_on && (offset == 1))
+  {
+    /* 입력으로 둔 핀(방향 비트 1)은 케이블 건너편이 모는 값(아무도 안 몰면 1) */
+    unsigned int in = hb_gg_link.par_in(hb_gg_link.ctx) & 0x7F;
+    data = (io_reg[1] & ~(io_reg[2] & 0x7F)) | (io_reg[2] & 0x7F & in);
+  }
+  else
+  {
+    data = io_gg_read_orig(offset);
+  }
+
+  if (hb_gg_link_on && (offset == 4))
+  {
+    /* 받은 바이트를 가져감 → 받음 비트를 끄고 다음 바이트를 받을 수 있게 */
+    hb_gg_link.rx_read(hb_gg_link.ctx);
+  }
+
+  if (hb_gg_port_trace && (offset >= 1) && (offset <= 5))
+  {
+    hb_gg_port_trace(hb_gg_link.ctx, 0, offset, data);
+  }
+
+  return data;
+}
+
+static unsigned int io_gg_read_orig(unsigned int offset)
 {
   switch (offset)
   {
diff --git a/core/system.c b/core/system.c
index 669f22d..04d09af 100644
--- a/core/system.c
+++ b/core/system.c
@@ -1394,3 +1394,457 @@ void system_frame_sms(int do_skip)
   input_end_frame(mcycles_vdp);
   Z80.cycles -= mcycles_vdp;
 }
+
+
+/*--------------------------------------------------------------------------*/
+/* 한방 10/22: system_frame_sms 를 가로줄 하나씩 나눈 판                    */
+/*                                                                          */
+/* 게임기어 두 대를 한 코어에서 돌릴 때 두 기계를 줄마다 번갈아 돌리려고    */
+/* 만듦. 하는 일은 위 system_frame_sms 와 같고(같은 차례 · 같은 계산), 한 장 */
+/* = hb_frame_sms_begin() 한 번 + hb_frame_sms_line() 이 1 을 돌려줄 때까지 */
+/* (lines_per_frame 번). 장 가운데의 값은 상태 저장에 안 들어가므로 장이    */
+/* 끝난 뒤에만 상태를 저장 · 불러와야 함(레트로아크는 늘 장 사이에서 함).   */
+/*--------------------------------------------------------------------------*/
+static int hb_sms_phase, hb_sms_line_no, hb_sms_start, hb_sms_end, hb_sms_skip;
+
+void hb_frame_sms_begin(int do_skip)
+{
+  /* reset frame cycle count */
+  mcycles_vdp = 0;
+
+  /* reset VDP FIFO */
+  fifo_write_cnt = 0;
+  fifo_slots = 0;
+
+  /* check if display settings has changed during previous frame */
+  if (bitmap.viewport.changed & 2)
+  {
+    bitmap.viewport.changed &= ~2;
+
+    if (system_hw & SYSTEM_MD)
+    {
+      /* interlaced modes */
+      int old_interlaced = interlaced;
+      interlaced = (reg[12] & 0x02) >> 1;
+
+      if (old_interlaced != interlaced)
+      {
+        /* double resolution mode */
+        im2_flag = ((reg[12] & 0x06) == 0x06);
+
+        /* reset field status flag */
+        odd_frame = interlaced;
+
+        /* video mode has changed */
+        bitmap.viewport.changed = 5;
+
+        /* update rendering mode */
+        if (reg[1] & 0x04)
+        {
+          if (im2_flag)
+          {
+            render_bg = (reg[11] & 0x04) ? render_bg_m5_im2_vs : render_bg_m5_im2;
+            render_obj = (reg[12] & 0x08) ? render_obj_m5_im2_ste : render_obj_m5_im2;
+          }
+          else
+          {
+            render_bg = (reg[11] & 0x04) ? render_bg_m5_vs : render_bg_m5;
+            render_obj = (reg[12] & 0x08) ? render_obj_m5_ste : render_obj_m5;
+          }
+        }
+      }
+
+      /* active screen height */
+      if (reg[1] & 0x04)
+      {
+        /* Mode 5 */
+        if (reg[1] & 0x08)
+        {
+          /* 240 active lines */
+          bitmap.viewport.h = 240;
+          bitmap.viewport.y = (config.overscan & 1) * 24 * vdp_pal;
+        }
+        else
+        {
+          /* 224 active lines */
+          bitmap.viewport.h = 224;
+          bitmap.viewport.y = (config.overscan & 1) * (8 + (24 * vdp_pal));
+        }
+      }
+      else
+      {
+        bitmap.viewport.h = 192;
+        bitmap.viewport.y = (config.overscan & 1) * 24 * (vdp_pal + 1);
+      }
+    }
+    else
+    {
+      /* check for VDP extended modes */
+      int mode = (reg[0] & 0x06) | (reg[1] & 0x18);
+
+      /* update active height */
+      if (mode == 0x0E)
+      {
+        bitmap.viewport.h = 240;
+      }
+      else if (mode == 0x16)
+      {
+        bitmap.viewport.h = 224;
+      }
+      else
+      {
+        bitmap.viewport.h = 192;
+      }
+
+      /* update vertical overscan */
+      if (config.overscan & 1)
+      {
+        bitmap.viewport.y = (240 + 48*vdp_pal - bitmap.viewport.h) >> 1;
+      }
+      else
+      {
+        if ((system_hw == SYSTEM_GG) && !config.gg_extra)
+        {
+          /* Display area reduced to 160x144 */
+          bitmap.viewport.y = (144 - bitmap.viewport.h) / 2;
+        }
+        else
+        {
+          bitmap.viewport.y = 0;
+        }
+      }
+    }
+
+    /* active screen width */
+    bitmap.viewport.w = 256 + ((reg[12] & 0x01) << 6);
+
+    /* check viewport changes */
+    if (bitmap.viewport.h != bitmap.viewport.oh)
+    {
+      bitmap.viewport.oh = bitmap.viewport.h;
+      bitmap.viewport.changed |= 1;
+    }
+  }
+
+  /* initialize VCounter */
+  v_counter = bitmap.viewport.h;
+
+  /* first line of overscan */
+  if (bitmap.viewport.y > 0)
+  {
+    blank_line(v_counter, -bitmap.viewport.x, bitmap.viewport.w + 2*bitmap.viewport.x);
+  }
+
+  /* Mega Drive VDP specific */
+  if (system_hw & SYSTEM_MD)
+  {
+    /* clear DMA Busy & field flags */
+    status &= 0xED;
+
+    /* set VBLANK flag */
+    status |= 0x08;
+
+    /* interlaced modes only */
+    if (interlaced)
+    {
+      /* switch even/odd field flag */
+      odd_frame ^= 1;
+      status |= (odd_frame << 4);
+    }
+
+    /* run VDP DMA */
+    if (dma_length)
+    {
+      vdp_dma_update(0);
+    }
+  }
+
+  /* update 6-Buttons & Lightguns */
+  input_refresh();
+
+  /* H-Int counter */
+  if (h_counter == 0)
+  {
+    /* Horizontal Interrupt is pending */
+    hint_pending = 0x10;
+    if (reg[0] & 0x10)
+    {
+      /* Cycle-accurate HINT */
+      /* IRQ line is latched between instructions, during instruction last cycle.       */
+      /* This means that if Z80 cycle count is exactly a multiple of MCYCLES_PER_LINE,  */
+      /* interrupt should be triggered AFTER the next instruction.                      */
+      if ((Z80.cycles % MCYCLES_PER_LINE) == 0)
+      {
+        z80_run(Z80.cycles + 1);
+      }
+
+      /* Z80 interrupt */
+      Z80.irq_state = ASSERT_LINE;
+    }
+  }
+
+  /* refresh inputs just before VINT */
+  osd_input_update();
+
+  hb_sms_skip = do_skip;
+  hb_sms_phase = 0;
+}
+
+int hb_frame_sms_line(void)
+{
+  switch (hb_sms_phase)
+  {
+    case 0:
+    {
+      /* run Z80 until end of line */
+      z80_run(MCYCLES_PER_LINE);
+
+      /* make sure VINT flag was not read (then cleared) by last instruction */
+      if (v_counter == bitmap.viewport.h)
+      {
+        /* Set VINT flag */
+        status |= 0x80;
+
+        /* Vertical Interrupt */
+        vint_pending = 0x20;
+        if (reg[1] & 0x20)
+        {
+          Z80.irq_state = ASSERT_LINE;
+        }
+      }
+
+      /* update VDP cycle count */
+      mcycles_vdp = MCYCLES_PER_LINE;
+
+      /* initialize line count */
+      hb_sms_line_no = bitmap.viewport.h + 1;
+
+      /* initialize overscan area */
+      hb_sms_start = lines_per_frame - bitmap.viewport.y;
+      hb_sms_end   = bitmap.viewport.h + bitmap.viewport.y;
+
+      hb_sms_phase = 1;
+      return 0;
+    }
+
+    case 1:
+    {
+      int line = hb_sms_line_no;
+
+      /* Vertical Blanking (do-while body) */
+
+      /* update VCounter */
+      v_counter = line;
+
+      /* render overscan */
+      if ((line < hb_sms_end) || (line >= hb_sms_start))
+      {
+        /* Master System & Game Gear VDP specific */
+        if ((system_hw < SYSTEM_MD) && (line > (lines_per_frame - 16)))
+        {
+          /* Sprites are still processed during top border */
+          if (reg[1] & 0x40)
+          {
+            render_obj((line - lines_per_frame) & 1);
+          }
+
+          /* Sprites pre-processing occurs even when display is disabled */
+          parse_satb(line - lines_per_frame);
+        }
+
+        blank_line(line, -bitmap.viewport.x, bitmap.viewport.w + 2*bitmap.viewport.x);
+      }
+
+      /* update 6-Buttons & Lightguns */
+      input_refresh();
+
+      /* run Z80 until end of line */
+      z80_run(mcycles_vdp + MCYCLES_PER_LINE);
+
+      /* update VDP cycle count */
+      mcycles_vdp += MCYCLES_PER_LINE;
+
+      if (++hb_sms_line_no >= (lines_per_frame - 1))
+      {
+        hb_sms_phase = 2;
+      }
+      return 0;
+    }
+
+    case 2:
+    {
+      int line = hb_sms_line_no;
+
+      /* update VCounter */
+      v_counter = line;
+
+      /* last line of overscan */
+      if (bitmap.viewport.y > 0)
+      {
+        /* Master System & Game Gear VDP specific */
+        if (system_hw < SYSTEM_MD)
+        {
+          /* Sprites are still processed during top border */
+          if (reg[1] & 0x40)
+          {
+            render_obj(1);
+          }
+        }
+
+        blank_line(line, -bitmap.viewport.x, bitmap.viewport.w + 2*bitmap.viewport.x);
+      }
+
+      /* reload H-Int counter */
+      h_counter = reg[10];
+
+      /* Detect pause button input (in Game Gear Mode, NMI is not generated) */
+      if (system_hw != SYSTEM_GG)
+      {
+        if (input.pad[0] & INPUT_START)
+        {
+          /* NMI is edge-triggered */
+          if (!pause_b)
+          {
+            pause_b = 1;
+            z80_set_nmi_line(ASSERT_LINE);
+            z80_set_nmi_line(CLEAR_LINE);
+          }
+        }
+        else
+        {
+          pause_b = 0;
+        }
+      }
+
+      /* 3-D glasses faking: skip rendering of left lens frame */
+      hb_sms_skip |= (work_ram[0x1ffb] & cart.special & HW_3D_GLASSES);
+
+      /* Mega Drive VDP specific */
+      if (system_hw & SYSTEM_MD)
+      {
+        /* clear VBLANK flag */
+        status &= ~0x08;
+
+        /* run VDP DMA */
+        if (dma_length)
+        {
+          vdp_dma_update(mcycles_vdp);
+        }
+
+        /* parse first line of sprites */
+        if (reg[1] & 0x40)
+        {
+          parse_satb(-1);
+        }
+      }
+
+      /* Master System & Game Gear VDP specific */
+      else
+      {
+        /* Sprites pre-processing occurs even when display is disabled */
+        parse_satb(-1);
+      }
+
+      /* update 6-Buttons & Lightguns */
+      input_refresh();
+
+      /* run Z80 until end of line */
+      z80_run(mcycles_vdp + MCYCLES_PER_LINE);
+
+      /* update VDP cycle count */
+      mcycles_vdp += MCYCLES_PER_LINE;
+
+      /* latch Vertical Scroll register */
+      vscroll = reg[9];
+
+      /* reset line count */
+      hb_sms_line_no = 0;
+
+      hb_sms_phase = 3;
+      return 0;
+    }
+
+    default:
+    {
+      int line = hb_sms_line_no;
+
+      /* Active Display (do-while body) */
+
+      /* run VDP DMA (Mega Drive VDP specific) */
+      if (dma_length)
+      {
+        vdp_dma_update(mcycles_vdp);
+      }
+
+      /* make sure that line has not already been rendered */
+      if (v_counter != line)
+      {
+        /* update VCounter */
+        v_counter = line;
+
+        /* render scanline */
+        if (!hb_sms_skip)
+        {
+          render_line(line);
+        }
+      }
+
+      /* update 6-Buttons & Lightguns */
+      input_refresh();
+
+      /* H-Int counter */
+      if (h_counter == 0)
+      {
+        /* reload H-Int counter */
+        h_counter = reg[10];
+
+        /* Horizontal Interrupt is pending */
+        hint_pending = 0x10;
+        if (reg[0] & 0x10)
+        {
+          /* Cycle-accurate HINT */
+          /* IRQ line is latched between instructions, during instruction last cycle.       */
+          /* This means that if Z80 cycle count is exactly a multiple of MCYCLES_PER_LINE,  */
+          /* interrupt should be triggered AFTER the next instruction.                      */
+          if ((Z80.cycles % MCYCLES_PER_LINE) == 0)
+          {
+            z80_run(Z80.cycles + 1);
+          }
+
+          /* assert Z80 interrupt */
+          Z80.irq_state = ASSERT_LINE;
+        }
+      }
+      else
+      {
+        /* decrement H-Int counter */
+        h_counter--;
+      }
+
+      /* run Z80 until end of line */
+      z80_run(mcycles_vdp + MCYCLES_PER_LINE);
+
+      /* update VDP cycle count */
+      mcycles_vdp += MCYCLES_PER_LINE;
+
+      if (++hb_sms_line_no < bitmap.viewport.h)
+      {
+        return 0;
+      }
+
+      /* check viewport changes */
+      if (bitmap.viewport.w != bitmap.viewport.ow)
+      {
+        bitmap.viewport.ow = bitmap.viewport.w;
+        bitmap.viewport.changed |= 1;
+      }
+
+      /* adjust timings for next frame */
+      input_end_frame(mcycles_vdp);
+      Z80.cycles -= mcycles_vdp;
+
+      hb_sms_phase = 4;
+      return 1;
+    }
+  }
+}
diff --git a/core/system.h b/core/system.h
index fb6ca76..ab5cef3 100644
--- a/core/system.h
+++ b/core/system.h
@@ -116,5 +116,8 @@ extern void system_reset(void);
 extern void system_frame_gen(int do_skip);
