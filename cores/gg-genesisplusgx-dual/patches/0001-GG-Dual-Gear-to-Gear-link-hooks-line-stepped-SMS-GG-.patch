--- /dev/null
+++ b/dual/build_dual.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+# Genesis Plus GX GG Dual 빌드(한방 10/22) — VM hbbuild(Debian 12 aarch64 · gcc 12)에서, 이 소스 맨 위 폴더에서:
+#   nice -n 19 bash dual/build_dual.sh [GIT_VERSION 글자, 예: -a1b2c3d]
+# 1) 원래 Makefile.libretro 로 안쪽 오브젝트를 만듦(기기 KNULLI 와 같은 platform=unix 옵션, -j1)
+#    → 덤으로 genesis_plus_gx_libretro.so = 한방 고리가 든 한 대짜리(고리 꺼짐 = 원래 동작, 시험용)
+# 2) 안쪽 오브젝트를 ld -r 로 하나 → objcopy 로 전역 이름 전부에 ggA_ / ggB_ 를 붙인 두 벌
+# 3) 래퍼(dual/libretro_dual.c)와 묶어 build_dual/genesisplusgx_gg_dual_libretro.so (retro_* 만 밖에 보임)
+set -euo pipefail
+GV="${1:-}"
+ARCH_FLAGS="${ARCH_FLAGS:--mcpu=cortex-a53}"
+B=build_dual
+mkdir -p "$B"
+echo "== 1) 안쪽 오브젝트 (make -f Makefile.libretro platform=unix -j1)"
+CFLAGS="$ARCH_FLAGS" make -f Makefile.libretro platform=unix GIT_VERSION="$GV" -j1 >"$B/make_inner.log" 2>&1 || { tail -40 "$B/make_inner.log"; exit 1; }
+OBJS=$(find . -name '*.o' -not -path "./$B/*" | sort)
+echo "   오브젝트 $(echo "$OBJS" | wc -l)개"
+echo "== 2) 두 벌(ggA_ · ggB_)"
+ld -r -o "$B/inner_all.o" $OBJS
+for P in A B; do
+  nm -g --defined-only "$B/inner_all.o" | awk 'NF==3 {print $3}' | sort -u | awk -v p="gg${P}_" '{print $1" "p$1}' > "$B/rename_$P.txt"
+  objcopy --redefine-syms="$B/rename_$P.txt" "$B/inner_all.o" "$B/inner_$P.o"
+done
+echo "   바꾼 이름 $(wc -l < "$B/rename_A.txt")개"
+echo "== 3) 래퍼 + 묶기"
+gcc -O2 -fPIC $ARCH_FLAGS -DNDEBUG "-DGIT_VERSION=\"$GV\"" -Ilibretro/libretro-common/include -Wall -Wno-unused-function \
+  -c -o "$B/dual_wrapper.o" dual/libretro_dual.c
+gcc -shared -o "$B/genesisplusgx_gg_dual_libretro.so" "$B/dual_wrapper.o" "$B/inner_A.o" "$B/inner_B.o" \
+  -Wl,--version-script=dual/link_dual.T -Wl,--no-undefined -lm
+strip --strip-unneeded "$B/genesisplusgx_gg_dual_libretro.so"
+cp genesis_plus_gx_libretro.so "$B/genesis_plus_gx_hb_libretro.so"
+strip --strip-unneeded "$B/genesis_plus_gx_hb_libretro.so"
+md5sum "$B/genesisplusgx_gg_dual_libretro.so" "$B/genesis_plus_gx_hb_libretro.so"
