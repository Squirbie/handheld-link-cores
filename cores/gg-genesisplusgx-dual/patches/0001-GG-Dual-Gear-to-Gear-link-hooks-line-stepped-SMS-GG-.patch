+/* Genesis Plus GX GG Dual — 게임기어 두 대를 한 코어로, 기어 투 기어 케이블로 이음 (한방 10/22)
+ *
+ * Genesis Plus GX(Eke-Eke) 라이선스(LICENSE.txt, 비상업 · 고친 소스 전부 공개)를 따름.
+ *
+ * 구조(원더스완 Dual · 네오지오 포켓 Dual 과 같은 꼴):
+ *  - 안쪽 코어(Genesis Plus GX 302fe82 + 한방 고리)를 두 번 넣음. 빌드가 안쪽 전역 이름에 ggA_ / ggB_ 를
+ *    붙여(objcopy) 전역 변수가 따로인 두 대.
+ *  - 한 장 안에서 두 기계를 '가로줄 하나씩' 번갈아 돌림(262줄). 줄 사이에서 케이블을 처리:
+ *      병렬(포트 0x01/0x02): 읽을 때마다 상대 출력 핀을 엇갈림(0<->2, 1<->3, 4<->5, 6<->6)으로 보여 줌.
+ *      직렬(포트 0x03~0x05): 보낸 바이트는 속도(4800/2400/1200/300bps, 10비트)만큼 줄이 지난 뒤
+ *      상대 받기 칸으로 — 상대가 아직 안 읽었으면 읽을 때까지 기다림(손 맞춤 · 바이트 안 버림).
+ *      상대가 받기를 켰고(비트5) NMI 허용(비트3)이면 그 기계 다음 줄 앞에서 NMI.
+ *  - 0번 패드 = 1P 기계(방장), 1번 패드 = 2P 기계(손님). 보이는 화면 · 소리 = gg_dual_screen(에뮬엔 영향 없음).
+ *  - gg_dual_link = off 면 2P 기계를 아예 안 돌리고 1P 는 원래 retro_run 그대로 = 원래 코어와 같은 그림 · 소리.
+ *  - 세이브: 1P = 보통 .srm(레트로아크가 RETRO_MEMORY_SAVE_RAM 으로) · 2P = <세이브 폴더>/<롬 이름>.p2.sav —
+ *    방장(1P 화면 · link on)만 읽고 씀(없으면 새 카트 = 1P 세이브를 복사하지 않음, 원칙 '각자 자기 세이브').
+ *  - 상태 = 머리 64 + 케이블 64 + 기계마다 고정 칸(SLOT_SIZE: Genesis Plus GX 상태 + 세이브 램 32KB).
+ *    Z80 구조체 속 함수 포인터는 0 으로 저장(실행마다 주소가 달라 넷플레이 CRC 가 어긋나지 않게).
+ *  - 시험용 환경 변수: GG_DUAL_TRACE=<파일>(60장마다 넘긴 바이트 · 밖에서 온 상태)
+ *                      GG_DUAL_PORTLOG=<파일>(포트 0x01~0x05 읽기쓰기 전부 — 느림)
+ */
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "libretro.h"
+#include "../core/hb_gglink.h"
+
+#ifndef GIT_VERSION
+#define GIT_VERSION ""
+#endif
+#define DUAL_LIBRARY_NAME "Genesis Plus GX GG Dual"
+#define DUAL_VERSION "1.0-hb" GIT_VERSION
+/* 넷플레이 버전 칸은 끝 글자 포함 32바이트 */
+typedef char hb_version_fits_netplay[(sizeof(DUAL_VERSION) <= 32) ? 1 : -1];
+
+#define DUAL_MEMORY_RAM   0x5700  /* +0 1P · +1 2P: 작업 램 8KB(0xC000~0xDFFF) */
+#define DUAL_MEMORY_FRAME 0x5720  /* +0 1P · +1 2P: 화면(FB_W×FB_H RGB565, 줄 FB_W*2) */
+#define DUAL_MEMORY_STATS 0x5730
+#define DUAL_MEMORY_IOREG 0x5740  /* +0 1P · +1 2P: io_reg[16] */
+
+#define FB_W 160
+#define FB_H 144
+#define SRAM_SAVE 0x8000          /* 상태에 넣는 세이브 램(세가 매퍼 최대 32KB) */
+#define SLOT_SIZE 0x24000         /* 기계 한 대 칸: 앞 = Genesis Plus GX 상태, 뒤 32KB = 세이브 램 */
+#define SLOT_STATE_MAX (SLOT_SIZE - SRAM_SAVE)
+#define STATE_MAGIC "HBGGDU1"
+#define STATE_VERSION 1
+#define HEADER_SIZE 64
+#define LINK_SIZE 64
+#define P2_WRITE_EVERY 7200       /* 장(약 2분)마다 2P 세이브가 바뀌었으면 씀 */
+
+#define DECL(P) \
