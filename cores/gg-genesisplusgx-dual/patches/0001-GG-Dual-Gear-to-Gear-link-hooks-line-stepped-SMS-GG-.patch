+};
+
+#define TAB(P) { P##retro_set_environment, P##retro_set_video_refresh, P##retro_set_audio_sample, \
+   P##retro_set_audio_sample_batch, P##retro_set_input_poll, P##retro_set_input_state, P##retro_init, P##retro_deinit, \
+   P##retro_load_game, P##retro_unload_game, P##retro_run, P##retro_reset, P##retro_get_system_av_info, \
+   P##retro_get_memory_data, P##retro_get_memory_size, P##retro_cheat_reset, P##retro_cheat_set, \
+   P##hb_gg_is_8bit, P##hb_gg_system_hw, P##hb_gg_frame_begin, P##hb_gg_run_line, P##hb_gg_frame_end, \
+   P##hb_gg_set_link, P##hb_gg_set_trace, P##hb_gg_io_reg, P##hb_gg_nmi, P##hb_gg_work_ram, P##hb_gg_sram, \
+   P##hb_gg_sram_on, P##hb_gg_z80_pc, P##hb_gg_rom_hash, P##hb_gg_state_save, P##hb_gg_state_load }
+
+static const struct Inner inner[2] = { TAB(ggA_), TAB(ggB_) };
+
+/* 케이블 상태(상태 저장에 들어감 — LINK_SIZE 칸) */
+struct LinkSide
+{
+   uint8_t txActive;    /* 보내는 중(포트 5 비트0) */
+   uint8_t txByte;
+   uint8_t pendNmi;     /* 이 기계 다음 줄 앞에서 NMI */
+   uint8_t pc6Seen;     /* 이 기계 PC6 핀에 보인 마지막 값(병렬 NMI 가장자리) */
+   uint32_t txLines;    /* 남은 줄 */
+};
+
+struct DualStats
+{
+   uint32_t magic, version, frames, linkOn, screen;
+   uint32_t bytes[2];        /* 1P→2P · 2P→1P 넘긴 바이트 */
+   uint32_t waits[2];        /* 상대가 아직 안 읽어 기다린 줄 수 */
+   uint32_t drops[2];        /* 상대가 받기를 안 켜서 버린 바이트 */
+   uint32_t nmis[2];         /* 기계마다 받은 NMI(직렬) */
+   uint32_t parNmis[2];      /* 기계마다 받은 NMI(병렬 PC6) */
+   uint32_t parReads[2];     /* 병렬 포트 읽기 */
+   uint32_t outsideLoads;    /* 불러온 상태 수 */
+   uint32_t p2Loaded, p2Writes;
+   uint32_t fbW, fbH;
+   uint32_t lastTx[2];       /* 마지막 보낸 바이트 */
+};
+
+static retro_environment_t environCallback;
+static retro_video_refresh_t videoCallback;
+static retro_audio_sample_batch_t audioBatchCallback;
+static retro_input_poll_t inputPollCallback;
+static retro_input_state_t inputStateCallback;
+static retro_log_printf_t logCallback;
+
+static int linkOn = 1;           /* 켤 때 정함 */
+static int screen;               /* 0 = 1P, 1 = 2P */
+static bool loaded;
+static uint32_t romHash;
+static struct LinkSide side[2];
+static struct DualStats stats;
+static FILE *traceFile, *portLog;
+static int parNmiOn = 1;         /* 병렬 PC6 NMI(시험용 GG_DUAL_PARNMI=0 으로 끔) */
+static int byteLinesFixed;       /* 시험용 GG_DUAL_BYTE_LINES=<줄> — 0 이면 속도대로 */
+
+/* 기계마다 화면 · 소리 받기 */
+static uint16_t frameBuf[2][FB_W * FB_H];
+static unsigned frameW[2], frameH[2];
+static int16_t soundBuf[2][8192 * 2];
+static size_t soundFrames[2];
+static bool frameSeen[2];
+
+/* 2P 세이브 */
+static char p2SavePath[2048];
+static uint32_t p2SaveHash;
+static unsigned p2Countdown;
+
+/* 안쪽 옵션 기본값(안쪽이 SET_VARIABLES 로 알려 준 첫 값) */
+struct InnerVar { char key[64]; char value[64]; };
+static struct InnerVar innerVars[96];
+static int nInnerVars;
+
+static void logf_(enum retro_log_level level, const char *fmt, ...)
+{
+   char buf[1024];
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(buf, sizeof(buf), fmt, ap);
+   va_end(ap);
+   if (logCallback)
+      logCallback(level, "[GG Dual] %s\n", buf);
+   if (traceFile)
+   {
+      fprintf(traceFile, "f=%u %s\n", stats.frames, buf);
+      fflush(traceFile);
+   }
+}
+
+static uint32_t fnv32(const uint8_t *p, size_t n)
+{
+   uint32_t h = 2166136261u;
+   size_t i;
+   for (i = 0; i < n; i++)
+   {
+      h ^= p[i];
+      h *= 16777619u;
+   }
+   return h;
+}
+
+/* ---- 안쪽 코어가 부르는 환경 함수 ---- */
+static void rememberInnerVars(const struct retro_variable *vars)
+{
+   for (; vars && vars->key; vars++)
+   {
+      const char *semi, *v;
+      size_t n;
+      int i;
+      if (!vars->value)
+         continue;
+      for (i = 0; i < nInnerVars; i++)
+         if (!strcmp(innerVars[i].key, vars->key))
+            break;
+      if (i == nInnerVars)
+      {
+         if (nInnerVars >= (int)(sizeof(innerVars) / sizeof(innerVars[0])))
+            continue;
+         nInnerVars++;
+      }
+      snprintf(innerVars[i].key, sizeof(innerVars[i].key), "%s", vars->key);
+      semi = strchr(vars->value, ';');
+      v = semi ? semi + 1 : vars->value;
+      while (*v == ' ')
+         v++;
+      n = strcspn(v, "|");
+      if (n >= sizeof(innerVars[i].value))
+         n = sizeof(innerVars[i].value) - 1;
+      memcpy(innerVars[i].value, v, n);
+      innerVars[i].value[n] = '\0';
+   }
+}
+
+static bool innerEnvironment(int m, unsigned cmd, void *data)
+{
+   int shown = (linkOn && screen == 1) ? 1 : 0;
+   switch (cmd)
+   {
+      case RETRO_ENVIRONMENT_GET_CORE_OPTIONS_VERSION:
+         *(unsigned *)data = 0;       /* 안쪽은 옛 방식(SET_VARIABLES)으로 — 기본값만 기억 */
+         return true;
+      case RETRO_ENVIRONMENT_SET_VARIABLES:
+         rememberInnerVars((const struct retro_variable *)data);
+         return true;
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_INTL:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_V2_INTL:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_DISPLAY:
+      case RETRO_ENVIRONMENT_SET_CORE_OPTIONS_UPDATE_DISPLAY_CALLBACK:
+      case RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS:
+      case RETRO_ENVIRONMENT_SET_CONTROLLER_INFO:
+      case RETRO_ENVIRONMENT_SET_CONTENT_INFO_OVERRIDE:
+      case RETRO_ENVIRONMENT_SET_PERFORMANCE_LEVEL:
+      case RETRO_ENVIRONMENT_SET_MEMORY_MAPS:
+      case RETRO_ENVIRONMENT_SET_SUPPORT_ACHIEVEMENTS:
+      case RETRO_ENVIRONMENT_SET_MINIMUM_AUDIO_LATENCY:
+      case RETRO_ENVIRONMENT_SET_DISK_CONTROL_INTERFACE:
+         return true;
+      case RETRO_ENVIRONMENT_SET_AUDIO_BUFFER_STATUS_CALLBACK:
+         return false;                /* 프레임 건너뛰기 없음(두 기기 같아야 함) */
+      case RETRO_ENVIRONMENT_SET_SERIALIZATION_QUIRKS:
+         return true;                 /* 래퍼가 따로 알림 */
+      case RETRO_ENVIRONMENT_SET_PIXEL_FORMAT:
+         if (m == 0)
+            return environCallback ? environCallback(cmd, data) : false;
+         return *(const enum retro_pixel_format *)data == RETRO_PIXEL_FORMAT_RGB565;
+      case RETRO_ENVIRONMENT_SET_SYSTEM_AV_INFO:
+      case RETRO_ENVIRONMENT_SET_GEOMETRY:
+         if (m == shown && loaded)
+            return environCallback ? environCallback(cmd, data) : false;
+         return true;
+      case RETRO_ENVIRONMENT_GET_VARIABLE:
+      {
+         struct retro_variable *var = (struct retro_variable *)data;
+         int i;
+         if (!var || !var->key)
+            return false;
+         var->value = NULL;
+         /* 두 기기가 같아야 해서 모든 안쪽 옵션은 기본값으로 고정(프레임 건너뛰기 · 오버클록 등 없음) */
+         for (i = 0; i < nInnerVars; i++)
+            if (!strcmp(innerVars[i].key, var->key))
+            {
+               var->value = innerVars[i].value;
+               return true;
+            }
+         return false;
+      }
+      case RETRO_ENVIRONMENT_GET_VARIABLE_UPDATE:
+         *(bool *)data = false;
+         return true;
+      default:
+         return environCallback ? environCallback(cmd, data) : false;
+   }
+}
+
+static bool envA(unsigned cmd, void *data) { return innerEnvironment(0, cmd, data); }
+static bool envB(unsigned cmd, void *data) { return innerEnvironment(1, cmd, data); }
+
+static void storeFrame(int m, const void *data, unsigned width, unsigned height, size_t pitch)
+{
+   unsigned y, w = width < FB_W ? width : FB_W, h = height < FB_H ? height : FB_H;
+   if (!data)
+      return;
+   for (y = 0; y < h; y++)
+      memcpy(frameBuf[m] + y * FB_W, (const uint8_t *)data + y * pitch, w * 2);
+   frameW[m] = width;
+   frameH[m] = height;
+   frameSeen[m] = true;
+}
+
+static void videoA(const void *d, unsigned w, unsigned h, size_t p) { storeFrame(0, d, w, h, p); }
+static void videoB(const void *d, unsigned w, unsigned h, size_t p) { storeFrame(1, d, w, h, p); }
+
+static size_t storeSound(int m, const int16_t *data, size_t frames)
+{
+   size_t room = 8192 - soundFrames[m];
+   size_t n = frames < room ? frames : room;
+   memcpy(soundBuf[m] + soundFrames[m] * 2, data, n * 4);
+   soundFrames[m] += n;
+   return frames;
+}
+
+static size_t audioA(const int16_t *d, size_t f) { return storeSound(0, d, f); }
+static size_t audioB(const int16_t *d, size_t f) { return storeSound(1, d, f); }
+static void sampleA(int16_t l, int16_t r) { int16_t s[2] = { l, r }; storeSound(0, s, 1); }
+static void sampleB(int16_t l, int16_t r) { int16_t s[2] = { l, r }; storeSound(1, s, 1); }
+static void pollNone(void) { }
+
+/* 1P 기계: link off 면 원래처럼(포트 그대로), on 이면 0번 패드만 · 2P 기계: 1번 패드를 안쪽 0번으로 */
+static int16_t inputA(unsigned port, unsigned device, unsigned index, unsigned id)
+{
+   if (!inputStateCallback)
+      return 0;
+   if (linkOn && port != 0)
+      return 0;
+   return inputStateCallback(port, device, index, id);
+}
+
+static int16_t inputB(unsigned port, unsigned device, unsigned index, unsigned id)
+{
+   if (!inputStateCallback || port != 0)
+      return 0;
+   return inputStateCallback(1, device, index, id);
+}
+
+static const char *getVar(const char *key)
+{
+   struct retro_variable var;
+   var.key = key;
+   var.value = NULL;
+   if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
+      return var.value;
+   return NULL;
+}
+
+static void readScreenOption(void)
+{
+   const char *v = getVar("gg_dual_screen");
+   int s = (v && !strcmp(v, "2P")) ? 1 : 0;
+   if (s != screen)
+      logf_(RETRO_LOG_INFO, "화면 %dP", s + 1);
+   screen = s;
+   stats.screen = (uint32_t)screen;
+}
+
+/* ---- 케이블 ---- */
+static unsigned byteLines(int m)
+{
+   /* 10비트(시작 + 8 + 끝) ÷ 속도, 한 줄 = 228 Z80 사이클(3.579545MHz) → 4800bps 33줄 · 2400 66 · 1200 131 · 300 524 */
+   static const unsigned lines[4] = { 33, 66, 131, 524 };
+   if (byteLinesFixed > 0)
+      return (unsigned)byteLinesFixed;
+   return lines[(inner[m].io_reg()[5] >> 6) & 3];
+}
+
+/* 상대(o)가 모는 핀을 m 쪽 핀 차례로(엇갈림) — 입력으로 둔 핀 · 직렬로 쓰는 핀은 1 */
+static uint8_t pinsSeenBy(int m)
+{
+   int o = !m;
+   const uint8_t *r = inner[o].io_reg();
+   uint8_t drive = (uint8_t)((r[1] | r[2]) & 0x7F);   /* 방향 1(입력)이면 1(끌어올림) */
+   uint8_t in = 0;
+   if (r[5] & 0x10)
+      drive |= 0x10;                                   /* PC4 = TX(쉴 때 1) */
+   if (r[5] & 0x20)
+      drive |= 0x20;                                   /* PC5 = RX(입력) */
+   if (drive & 0x01) in |= 0x04;
+   if (drive & 0x02) in |= 0x08;
+   if (drive & 0x04) in |= 0x01;
+   if (drive & 0x08) in |= 0x02;
+   if (drive & 0x10) in |= 0x20;
+   if (drive & 0x20) in |= 0x10;
+   if (drive & 0x40) in |= 0x40;
+   (void)m;
+   return in;
+}
+
+static uint8_t linkParIn(void *ctx)
+{
+   int m = (int)(intptr_t)ctx;
+   stats.parReads[m]++;
+   return pinsSeenBy(m);
+}
+
+/* PC6(NMI 핀, 케이블에서 곧게 이음): 상대가 1→0 으로 내리면, 내 PC6 이 입력이고 NMI 허용(포트 2 비트7 = 0)이면 NMI */
+static void checkPc6(int m)
+{
+   const uint8_t *r = inner[m].io_reg();
+   uint8_t level = (uint8_t)((pinsSeenBy(m) >> 6) & 1);
+   if (parNmiOn && side[m].pc6Seen && !level && (r[2] & 0x40) && !(r[2] & 0x80))
+   {
+      side[m].pendNmi = 1;
+      stats.parNmis[m]++;
+   }
+   side[m].pc6Seen = level;
+}
+
+static void linkParOut(void *ctx)
+{
+   int m = (int)(intptr_t)ctx;
+   checkPc6(!m);
+   checkPc6(m);
+}
+
+static void linkTx(void *ctx, uint8_t data)
+{
+   int m = (int)(intptr_t)ctx;
+   uint8_t *r = inner[m].io_reg();
+   stats.lastTx[m] = data;
+   if (!(r[5] & 0x10))
+      return;                         /* 보내기(비트4) 꺼짐 — 아무것도 안 나감 */
+   side[m].txByte = data;
+   if (!side[m].txActive)
+   {
+      side[m].txActive = 1;
+      side[m].txLines = byteLines(m);
+   }
+   r[5] |= 0x01;
+}
+
+static void linkRxRead(void *ctx)
+{
+   int m = (int)(intptr_t)ctx;
+   inner[m].io_reg()[5] &= (uint8_t)~0x02;
+}
+
+static void linkCtrl(void *ctx)
+{
+   int m = (int)(intptr_t)ctx;
+   (void)m;
+}
+
+static const struct hb_gg_link_ops linkOps[2] = {
+   { linkParIn, linkParOut, linkTx, linkRxRead, linkCtrl, (void *)(intptr_t)0 },
+   { linkParIn, linkParOut, linkTx, linkRxRead, linkCtrl, (void *)(intptr_t)1 },
+};
+
+/* 줄 하나가 지난 뒤 m 이 보내는 바이트 처리 */
+static void tickTx(int m)
+{
+   int o = !m;
+   uint8_t *r, *ro;
+   if (!side[m].txActive)
+      return;
+   if (side[m].txLines > 1)
+   {
+      side[m].txLines--;
+      return;
+   }
+   side[m].txLines = 0;
+   r = inner[m].io_reg();
+   ro = inner[o].io_reg();
+   if (!(ro[5] & 0x20))
+   {
+      /* 상대 받기 꺼짐 → 선 위로 나가고 사라짐 */
+      side[m].txActive = 0;
+      r[5] &= (uint8_t)~0x01;
+      stats.drops[m]++;
+      return;
+   }
+   if (ro[5] & 0x02)
+   {
+      /* 상대가 앞 바이트를 아직 안 읽음 → 기다림(손 맞춤) */
+      stats.waits[m]++;
+      return;
+   }
+   ro[4] = side[m].txByte;
+   ro[5] |= 0x02;
+   if (ro[5] & 0x08)
+      side[o].pendNmi = 1;
+   side[m].txActive = 0;
+   r[5] &= (uint8_t)~0x01;
+   stats.bytes[m]++;
+}
+
+static void runLine(int m, int *done)
+{
+   if (*done)
+      return;
+   if (side[m].pendNmi)
+   {
+      side[m].pendNmi = 0;
+      stats.nmis[m]++;
+      inner[m].nmi();
+   }
+   *done = inner[m].run_line();
+   tickTx(m);
+}
+
+static void portTrace(void *ctx, int write, unsigned port, unsigned value)
+{
+   int m = (int)(intptr_t)ctx;
+   if (portLog)
+      fprintf(portLog, "f=%u %dP %s %02X=%02X pc=%04X\n", stats.frames, m + 1, write ? "W" : "R", port, value,
+            inner[m].z80_pc());
+}
+
+/* ---- 2P 세이브 ---- */
+static void contentBase(const struct retro_game_info *info, char *base, size_t len)
+{
+   struct retro_game_info_ext *ext = NULL;
+   const char *p, *slash, *dot;
+   base[0] = '\0';
+   if (environCallback && environCallback(RETRO_ENVIRONMENT_GET_GAME_INFO_EXT, &ext) && ext && ext->name)
+   {
+      snprintf(base, len, "%s", ext->name);
+      return;
+   }
+   p = info ? info->path : NULL;
+   if (!p)
+      return;
+   slash = strrchr(p, '/');
+   snprintf(base, len, "%s", slash ? slash + 1 : p);
+   dot = strrchr(base, '.');
+   if (dot)
+      base[dot - base] = '\0';
+}
+
+/* 레트로아크가 .srm 을 쓰는 크기와 같게: 마지막으로 0xFF 가 아닌 바이트까지 */
+static size_t sramUsed(const uint8_t *s)
+{
+   size_t i;
+   for (i = 0x10000; i > 0; i--)
+      if (s[i - 1] != 0xFF)
+         return i;
+   return 0;
+}
+
+static void loadP2Save(void)
+{
+   FILE *f;
+   size_t n;
+   uint8_t *s = inner[1].sram();
+   if (!p2SavePath[0])
+      return;
+   f = fopen(p2SavePath, "rb");
+   if (!f)
+   {
+      logf_(RETRO_LOG_INFO, "2P 세이브 없음 → 새 카트(1P 세이브는 복사하지 않음): %s", p2SavePath);
+      p2SaveHash = fnv32(s, 0x10000);
+      return;
+   }
+   n = fread(s, 1, 0x10000, f);
+   fclose(f);
+   stats.p2Loaded = 1;
+   p2SaveHash = fnv32(s, 0x10000);
+   logf_(RETRO_LOG_INFO, "2P 세이브 읽음 %u 바이트: %s", (unsigned)n, p2SavePath);
+}
+
+static void writeP2Save(const char *why)
+{
+   const uint8_t *s = inner[1].sram();
+   uint32_t h;
+   size_t n;
+   char tmp[2100];
+   FILE *f;
+   int ok;
+   if (!p2SavePath[0] || !linkOn || screen != 0)
+      return;
+   h = fnv32(s, 0x10000);
+   if (h == p2SaveHash)
+      return;
+   n = sramUsed(s);
+   if (!n)
+      return;
+   snprintf(tmp, sizeof(tmp), "%s.tmp", p2SavePath);
+   f = fopen(tmp, "wb");
+   if (!f)
+   {
+      logf_(RETRO_LOG_WARN, "2P 세이브 임시 파일 못 엶: %s", tmp);
+      return;
+   }
+   ok = fwrite(s, 1, n, f) == n;
+   ok = (fflush(f) == 0) && ok;
+   ok = (fsync(fileno(f)) == 0) && ok;
+   ok = (fclose(f) == 0) && ok;
+   if (!ok || rename(tmp, p2SavePath) != 0)
+   {
+      /* 이름 바꾸기가 안 되는 곳이면 제자리 */
+      remove(tmp);
+      f = fopen(p2SavePath, "wb");
+      if (!f)
+         return;
+      ok = fwrite(s, 1, n, f) == n;
+      fflush(f);
+      fsync(fileno(f));
+      fclose(f);
+      if (!ok)
+         return;
+   }
+   p2SaveHash = h;
+   stats.p2Writes++;
+   logf_(RETRO_LOG_INFO, "2P 세이브 씀(%s) %u 바이트", why, (unsigned)n);
+}
