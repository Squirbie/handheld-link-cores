+/* 롬 지문(FNV-1a 32) — 상태 머리에 넣어 다른 롬의 상태를 거절 */
+uint32_t hb_gg_rom_hash(void)
+{
+   uint32_t h = 2166136261u;
+   uint32_t i;
+   for (i = 0; i < cart.romsize; i++)
+   {
+      h ^= cart.rom[i];
+      h *= 16777619u;
+   }
+   return h ^ cart.romsize;
+}
+
+/* 상태 저장: Z80 구조체 안의 함수 · 표 포인터(실행 때마다 주소가 다름)를 0 으로 두고 저장 —
+ * 같은 장면이면 두 기기 · 두 실행이 같은 바이트(넷플레이 CRC). 불러오기는 원래처럼 콜백을 되돌림 */
+int hb_gg_state_save(uint8_t *buf)
+{
+   const struct z80_irq_daisy_chain *daisy = Z80.daisy;
+   int (*cb)(int) = Z80.irq_callback;
+   int size;
+   Z80.daisy = NULL;
+   Z80.irq_callback = NULL;
+   size = state_save(buf);
+   Z80.daisy = daisy;
+   Z80.irq_callback = cb;
+   return size;
+}
+
+int hb_gg_state_load(const uint8_t *buf)
+{
+   const struct z80_irq_daisy_chain *daisy = Z80.daisy;
+   if (!state_load((uint8_t *)buf))
+      return 0;
+   Z80.daisy = daisy;
+#ifdef HAVE_OVERCLOCK
+   update_overclock();
+#endif
+   return 1;
+}
