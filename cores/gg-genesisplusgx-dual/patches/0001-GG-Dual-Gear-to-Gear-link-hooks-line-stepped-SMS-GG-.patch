+bool retro_load_game(const struct retro_game_info *info)
+{
+   static const struct retro_input_descriptor desc[] = {
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_LEFT, "D-Pad Left" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_UP, "D-Pad Up" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_DOWN, "D-Pad Down" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_RIGHT, "D-Pad Right" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_B, "Button 1" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_A, "Button 2" },
+      { 0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_START, "Start" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_LEFT, "D-Pad Left" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_UP, "D-Pad Up" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_DOWN, "D-Pad Down" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_RIGHT, "D-Pad Right" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_B, "Button 1" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_A, "Button 2" },
+      { 1, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_START, "Start" },
+      { 0, 0, 0, 0, NULL },
+   };
+   const char *v, *dir = NULL;
+   char base[1024];
+
+   if (!info)
+      return false;
+   v = getVar("gg_dual_link");
+   linkOn = !(v && !strcmp(v, "off"));
+   readScreenOption();
+
+   memset(&stats, 0, sizeof(stats));
+   memset(side, 0, sizeof(side));
+   stats.magic = 0x47474444; /* 'GGDD' */
+   stats.version = 1;
+   p2SavePath[0] = '\0';
+
+   if (!inner[0].load_game(info))
+   {
+      logf_(RETRO_LOG_ERROR, "1P 기계 불러오기 실패");
+      return false;
+   }
+   if (linkOn && !inner[0].is_8bit())
+   {
+      logf_(RETRO_LOG_WARN, "8비트(게임기어 · 마스터 시스템) 롬이 아님 → 한 대로만 돎");
+      linkOn = 0;
+   }
+   if (linkOn && !inner[1].load_game(info))
+   {
+      logf_(RETRO_LOG_ERROR, "2P 기계 불러오기 실패");
+      inner[0].unload_game();
+      return false;
+   }
+   environCallback(RETRO_ENVIRONMENT_SET_INPUT_DESCRIPTORS, (void *)desc);
+   stats.linkOn = (uint32_t)linkOn;
+   romHash = inner[0].rom_hash();
+
+   if (linkOn)
+   {
+      int m;
+      for (m = 0; m < 2; m++)
+      {
+         inner[m].set_link(&linkOps[m]);
+         side[m].pc6Seen = (uint8_t)((pinsSeenBy(m) >> 6) & 1);
+      }
+      /* 2P 세이브: 방장(1P 화면)만 */
+      if (screen == 0)
+      {
+         contentBase(info, base, sizeof(base));
+         if (environCallback(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &dir) && dir && dir[0] && base[0])
+            snprintf(p2SavePath, sizeof(p2SavePath), "%s/%s.p2.sav", dir, base);
+         loadP2Save();
+      }
+      p2Countdown = P2_WRITE_EVERY;
+   }
+   if (portLog)
+   {
+      inner[0].set_trace(portTrace, (void *)(intptr_t)0);
+      if (linkOn)
+         inner[1].set_trace(portTrace, (void *)(intptr_t)1);
+   }
+   loaded = true;
+   logf_(RETRO_LOG_INFO, "켬 %s link=%s 화면=%dP 롬지문 %08x 기계 %02x 상태 %u 바이트", DUAL_VERSION, linkOn ? "on" : "off",
+         screen + 1, romHash, inner[0].system_hw(), (unsigned)(HEADER_SIZE + LINK_SIZE + SLOT_SIZE * (linkOn ? 2 : 1)));
+   return true;
+}
