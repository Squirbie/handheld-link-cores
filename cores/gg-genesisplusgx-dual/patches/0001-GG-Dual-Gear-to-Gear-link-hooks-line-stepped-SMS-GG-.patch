+/* ---------------------------------------------------------------------------
+ * 한방 10/22: 두 대 래퍼(Genesis Plus GX GG Dual)가 쓰는 함수 — 빌드가 이 코어 전체 이름에
+ * ggA_ / ggB_ 를 붙여 두 벌을 한 .so 에 넣음. 8비트 기계(게임기어 · 마스터 시스템)에서만 씀.
+ * ------------------------------------------------------------------------- */
+static int hb_do_skip;
+
+int hb_gg_is_8bit(void)
+{
+   return (system_hw != SYSTEM_MCD) && ((system_hw & SYSTEM_PBC) != SYSTEM_MD);
+}
+
+int hb_gg_system_hw(void)
+{
+   return system_hw;
+}
+
+/* 한 장 시작(원래 retro_run 의 앞부분 + 장 머리) */
+void hb_gg_frame_begin(void)
+{
+   hb_do_skip = hb_run_head();
+   hb_frame_sms_begin(hb_do_skip);
+}
+
+/* 가로줄 하나. 장이 끝나면 1 */
