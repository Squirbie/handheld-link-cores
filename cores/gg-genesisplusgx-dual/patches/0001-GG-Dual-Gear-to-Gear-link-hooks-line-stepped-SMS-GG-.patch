+void retro_set_environment(retro_environment_t env)
+{
+   /* 메뉴 글씨: 기기 레트로아크 글꼴에 한글이 없을 수 있어 영어(다른 Dual 과 같음) */
+   static const struct retro_variable vars[] = {
+      { "gg_dual_screen", "Screen and sound (host/solo = 1P, guest = 2P); 1P|2P" },
+      { "gg_dual_link", "2P Game Gear on the Gear-to-Gear cable (off = solo, one console; restart); on|off" },
+      { NULL, NULL },
+   };
+   static const struct retro_controller_description pads[] = {
+      { "Game Gear", RETRO_DEVICE_JOYPAD },
+   };
+   static const struct retro_controller_info ports[] = {
+      { pads, 1 }, { pads, 1 }, { NULL, 0 },
+   };
+
+   environCallback = env;
+   env(RETRO_ENVIRONMENT_SET_VARIABLES, (void *)vars);
+   env(RETRO_ENVIRONMENT_SET_CONTROLLER_INFO, (void *)ports);
+   inner[0].set_environment(envA);
+   inner[1].set_environment(envB);
+}
+
+void retro_set_video_refresh(retro_video_refresh_t cb) { videoCallback = cb; }
+void retro_set_audio_sample(retro_audio_sample_t cb) { (void)cb; }
+void retro_set_audio_sample_batch(retro_audio_sample_batch_t cb) { audioBatchCallback = cb; }
+void retro_set_input_poll(retro_input_poll_t cb) { inputPollCallback = cb; }
+void retro_set_input_state(retro_input_state_t cb) { inputStateCallback = cb; }
+void retro_set_controller_port_device(unsigned port, unsigned device) { (void)port; (void)device; }
+
+void retro_init(void)
+{
+   struct retro_log_callback log;
+   uint64_t quirks = RETRO_SERIALIZATION_QUIRK_PLATFORM_DEPENDENT;
+   const char *e;
+   int m;
+   logCallback = (environCallback && environCallback(RETRO_ENVIRONMENT_GET_LOG_INTERFACE, &log)) ? log.log : NULL;
+   if (environCallback)
+      environCallback(RETRO_ENVIRONMENT_SET_SERIALIZATION_QUIRKS, &quirks);
+   e = getenv("GG_DUAL_TRACE");
+   if (e && e[0] && !traceFile)
+      traceFile = fopen(e, "w");
+   e = getenv("GG_DUAL_PORTLOG");
+   if (e && e[0] && !portLog)
+      portLog = fopen(e, "w");
+   e = getenv("GG_DUAL_PARNMI");
+   parNmiOn = !(e && !strcmp(e, "0"));
+   e = getenv("GG_DUAL_BYTE_LINES");
+   byteLinesFixed = (e && e[0]) ? atoi(e) : 0;
+   for (m = 0; m < 2; m++)
+   {
+      inner[m].set_video_refresh(m ? videoB : videoA);
+      inner[m].set_audio_sample(m ? sampleB : sampleA);
+      inner[m].set_audio_sample_batch(m ? audioB : audioA);
+      inner[m].set_input_poll(pollNone);
+      inner[m].set_input_state(m ? inputB : inputA);
+      inner[m].init();
+   }
+}
+
+void retro_deinit(void)
+{
+   inner[0].deinit();
+   inner[1].deinit();
+   if (traceFile)
+   {
+      fclose(traceFile);
+      traceFile = NULL;
+   }
+   if (portLog)
+   {
+      fclose(portLog);
+      portLog = NULL;
+   }
+}
