+/* hanbang 10/21: after a state load rebuild what the MMC3 registers imply
+   (PRG window is memcpy'd into the ROM area, which the save state does not hold) */
+static void mapper4_postload(void)
+{
+	mapper4_set_prg();
+	mapper4_set_chr();
+	if (MMC3_mirror_reg >= 0)
+	{
+		if (MMC3_mirror_reg & 0x40)
+			ppu2c03b_set_mirroring(0, PPU_MIRROR_HIGH);
+		else if (MMC3_mirror_reg & 0x01)
+			ppu2c03b_set_mirroring(0, PPU_MIRROR_HORZ);
+		else
+			ppu2c03b_set_mirroring(0, PPU_MIRROR_VERT);
+	}
+	ppu2c03b_set_scanline_callback(0, IRQ_enable ? mapper4_irq : 0);
+}
+
 /* Common init for MMC3 games */
