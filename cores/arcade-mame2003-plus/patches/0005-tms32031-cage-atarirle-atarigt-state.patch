+static void atarigt_postload(void)
+{
+	int i;
+
+	for (i = 0; i < MRAM_ENTRIES; i++)
+	{
+		expanded_mram[0 * MRAM_ENTRIES + i] = (atarigt_colorram[0x20000 + i] >> 8) << rshift;
+		expanded_mram[1 * MRAM_ENTRIES + i] = (atarigt_colorram[0x20000 + i] & 0xff) << gshift;
+		expanded_mram[2 * MRAM_ENTRIES + i] = (atarigt_colorram[0x30000 + i] & 0xff) << bshift;
+	}
+
+	tilemap_set_scrollx(atarigen_playfield_tilemap, 0, playfield_xscroll);
+	tilemap_set_scrolly(atarigen_playfield_tilemap, 0, playfield_yscroll);
+	tilemap_set_palette_offset(atarigen_playfield_tilemap, (playfield_color_bank & 0x1f) << 8);
+	tilemap_mark_all_tiles_dirty(atarigen_playfield_tilemap);
+	tilemap_mark_all_tiles_dirty(atarigen_alpha_tilemap);
+}
