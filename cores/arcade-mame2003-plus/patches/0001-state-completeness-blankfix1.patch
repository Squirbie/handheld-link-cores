+void timer_save_register(const char *module, int instance, const char *name, mame_timer *which)
+{
+	char field[128];
+	if (!which) return;
+	which->save_registered = 1;
+	snprintf(field, sizeof(field), "%s.order", name);
+	state_save_register_int(module, instance, field, &which->save_order);
+	snprintf(field, sizeof(field), "%s.param", name);
+	state_save_register_int(module, instance, field, &which->callback_param);
+	snprintf(field, sizeof(field), "%s.enabled", name);
+	state_save_register_UINT8(module, instance, field, &which->enabled, 1);
+	snprintf(field, sizeof(field), "%s.period", name);
+	state_save_register_double(module, instance, field, &which->period, 1);
+	snprintf(field, sizeof(field), "%s.start", name);
+	state_save_register_double(module, instance, field, &which->start, 1);
+	snprintf(field, sizeof(field), "%s.expire", name);
+	state_save_register_double(module, instance, field, &which->expire, 1);
+}
+
+static void timer_presave(void)
+{
+	mame_timer *timer;
+	int order = 0;
+	for (timer = timer_head; timer; timer = timer->next)
+		timer->save_order = order++;
+}
+
+static void timer_postload(void)
+{
+	mame_timer *list[MAX_TIMERS], *timer;
+	int order[MAX_TIMERS], count = 0, i, j, key;
+	/* Restored deadlines need a new ordering; never deserialize native pointers. */
+	for (timer = timer_head; timer; timer = timer->next)
+	{
+		order[count] = timer->save_registered ? timer->save_order : count;
+		list[count++] = timer;
+	}
+	/* timer_list_insert treats deadlines within 1 ns as equal. Preserve their
+	 * original order too, otherwise vblank/scanline IRQs can swap after load. */
+	for (i = 1; i < count; i++)
+	{
+		timer = list[i];
+		key = order[i];
+		for (j = i; j > 0 && order[j-1] > key; j--)
+		{
+			list[j] = list[j-1];
+			order[j] = order[j-1];
+		}
+		list[j] = timer;
+		order[j] = key;
+	}
+	timer_head = NULL;
+	for (i = 0; i < count; i++)
+		timer_list_insert(list[i]);
+}
+
 
 
