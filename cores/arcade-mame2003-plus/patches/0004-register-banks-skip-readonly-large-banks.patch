diff --git a/src/mame-memory.c b/src/mame-memory.c
--- a/src/mame-memory.c
+++ b/src/mame-memory.c
@@ -1639,11 +1639,13 @@
 	int cpunum, i;
 	int banksize[MAX_BANKS];
 	int bankcpu[MAX_BANKS];
+	int bankwrite[MAX_BANKS]; /* hanbang 10/21: bank appears in a write map */
 
 	for (i=0; i<MAX_BANKS; i++)
 	{
 		banksize[i] = 0;
 		bankcpu[i] = -1;
+		bankwrite[i] = 0;
