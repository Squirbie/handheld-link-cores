#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# KNULLI service: keeps /userdata/system/claude/hb_pspadhoc.py running - a PPSSPP ad-hoc server (port 27312) that writes
# the server all devices on the same Wi-Fi agree on to /etc/hosts as "hbpsp" (v2, 2026-11-24: only devices running an
# ad-hoc game are candidates, a server with players stays the server, works with v1 devices). Point PPSSPP at it with
# psp.ppsspp.Network.proAdhocServer=hbpsp in knulli.conf; the game hook (nds_save_sync.sh) reports ad-hoc games, i.e. games
# whose EnableWlan is True (the per-game psp["<ROM file name>"] line, else the system-wide psp.ppsspp line, else [Network]
# in PPSSPP's own ppsspp.ini). Details at the top of hb_pspadhoc.py.
# Enable: add "hb_pspadhoc" to system.services in /userdata/system/knulli.conf (S99userservices starts it at boot).
# Disable: remove that word and reboot. Install this file as /userdata/system/services/hb_pspadhoc
# 2026-11-23: starts once the EmulationStation menu is ready (/tmp/emulationstation.ready), or after 60 s at the latest
# (charge screen, no ES), so this Python helper does not compete with ES for CPU and the card while the game lists load at boot.
# The PID file holds the same PID while it waits (the wait ends in exec), so stop works at any time.
P=/var/run/hb_pspadhoc.pid
case "$1" in
  start|"")
    if [ -f "$P" ] && kill -0 "$(cat "$P")" 2>/dev/null; then
      exit 0
    fi
    ( i=0; while [ ! -e /tmp/emulationstation.ready ] && [ $i -lt 120 ]; do sleep 0.5; i=$((i+1)); done
      exec python3 /userdata/system/claude/hb_pspadhoc.py ) >> /tmp/hb_pspadhoc.log 2>&1 < /dev/null &
    echo $! > "$P"
    ;;
  stop)
    if [ -f "$P" ]; then
      p=$(cat "$P")
      kill "$p" 2>/dev/null
      # 2026-11-24 (v2): wait up to 1 s while the service says goodbye on the Wi-Fi (two "leaving" messages 0.2 s apart)
      # and removes its sleep hold (hbpsp.pause). At shutdown rcK stops S99userservices first, so this fits in.
      i=0; while [ $i -lt 10 ] && kill -0 "$p" 2>/dev/null; do sleep 0.1; i=$((i+1)); done
    fi
    rm -f "$P"
    ;;
esac
exit 0
