#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# KNULLI service: at boot, runs /userdata/system/claude/hb_dsmac.py once. Only when the card moved to another device
# (the Wi-Fi MAC changed) does it give the DS firmware that device's own MAC. Details at the top of hb_dsmac.py.
# Enable: add "hb_dsmac" to system.services in /userdata/system/knulli.conf (S99userservices starts it at boot).
# Disable: remove that word and reboot. Install this file as /userdata/system/services/hb_dsmac
# 2026-11-23: starts once the EmulationStation menu is ready (/tmp/emulationstation.ready), or after 60 s at the latest
# (charge screen, no ES), so this Python helper does not compete with ES for CPU and the card while the game lists load at boot.
# DS games only start from the menu, so the MAC is in place before one can run.
case "$1" in
  start|"")
    ( i=0; while [ ! -e /tmp/emulationstation.ready ] && [ $i -lt 120 ]; do sleep 0.5; i=$((i+1)); done
      exec python3 /userdata/system/claude/hb_dsmac.py ) >> /tmp/hb_dsmac.log 2>&1 < /dev/null &
    ;;
  stop)
    ;;
esac
exit 0
