#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# KNULLI service: turns off background Wi-Fi scanning while connected, so netplay does not stall every few minutes
# (runs /userdata/system/claude/hb_wifimem.py; it only reads knulli.conf). Details at the top of hb_wifimem.py.
# Enable: add "hb_wifimem" to system.services in /userdata/system/knulli.conf (S99userservices starts it at boot).
# Disable: remove that word and reboot. Install this file as /userdata/system/services/hb_wifimem
# 2026-11-23: starts once the EmulationStation menu is ready (/tmp/emulationstation.ready), or after 60 s at the latest
# (charge screen, no ES), so this Python helper does not compete with ES for CPU and the card while the game lists load at boot.
# The first connection at boot is made by connman itself, and the helper judges by uptime and sleep time, so a later start
# changes nothing. The PID file holds the same PID while it waits (exec), so stop works at any time.
P=/var/run/hb_wifimem.pid
PY=/userdata/system/claude/hb_wifimem.py

case "$1" in
  start|"")
    if [ -f "$P" ] && kill -0 "$(cat "$P")" 2>/dev/null; then
      exit 0
    fi
    [ -f "$PY" ] || exit 0
    ( i=0; while [ ! -e /tmp/emulationstation.ready ] && [ $i -lt 120 ]; do sleep 0.5; i=$((i+1)); done
      exec python3 "$PY" ) >/dev/null 2>&1 < /dev/null &
    echo $! > "$P"
    ;;
  stop)
    if [ -f "$P" ]; then
      kill "$(cat "$P")" 2>/dev/null
      rm -f "$P"
    fi
    ;;
esac
exit 0
