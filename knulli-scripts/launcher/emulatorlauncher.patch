+        # hb_lobbycore: a guest joining from the ES netplay lobby gets "-core <system default>" (e.g. mame078plus, mgba),
+        # which overrides the per-game core line (patched mame2003_plus, mgba_dual, gpsp ...), so host and guest would run
+        # different cores. For a netplay client, prefer this game's own core line from knulli.conf (the host uses it too).
+        if args.netplaymode == "client" and romConfiguration is not None:
+            try:
+                _hbkey = f'{systemName}["{os.path.basename(romConfiguration)}"].core='
+                with open('/userdata/system/knulli.conf', encoding='utf-8', errors='ignore') as _hbf:
+                    _hbpg = [l.strip()[len(_hbkey):] for l in _hbf if l.startswith(_hbkey)]
+                if _hbpg and _hbpg[-1] and _hbpg[-1] != args.core:
+                    eslog.info(f"hb_lobbycore: client core {args.core} -> {_hbpg[-1]} (game line)")
+                    system.config["core"] = _hbpg[-1]
